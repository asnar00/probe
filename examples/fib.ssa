; naive recursion — exercises call/bl fixups and the frame discipline
fn fib(n: i64) -> i64 {
entry:
    two: i64 = iconst 2
    small: u1 = icmp.lt n, two
    br small, base, rec
base:
    ret n
rec:
    one: i64 = iconst 1
    n1: i64 = sub n, one
    a: i64 = fib(n1)
    n2: i64 = sub n, two
    b: i64 = fib(n2)
    r: i64 = add a, b
    ret r
}
