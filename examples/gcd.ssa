; Euclid's algorithm — exercises srem and a swap-shaped loop-carried pair
fn gcd(a: int, b: int) -> int {
^entry:
    jmp ^loop(a, b)
^loop(x: int, y: int):
    zero: int = iconst 0
    done: u1 = icmp.eq y, zero
    br done, ^exit, ^step
^step:
    r: int = rem x, y
    jmp ^loop(y, r)
^exit:
    ret x
}
