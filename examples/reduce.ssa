; a reduction: each group of threads sums its ids through threadgroup
; memory, halving at every barrier; lane 0 writes the group's sum
;   probe compile examples/reduce.ssa air
;   python3 tools/driver_metal.py --kernel reduce.metallib reduce.air.json 256 64
; -> [2016, 6112, 10208, 14304, 0, ...]: the sums of 0..63, 64..127, ...
; (the driver prints n words; a group writes one)

fn __kernel(mem: ptr, area: ptr, id: i64, lane: i64, group: i64) {
    off: i64 = mul lane, 8
    group_store(id, off)
    group_sync()
    loop(half: i64 = 32) {
        done: u1 = cmp.eq half, 0
        if done {
            break
        }
        below: u1 = cmp.lt lane, half
        if below {
            other: i64 = add lane, half
            ooff: i64 = mul other, 8
            a: i64 = group_load(off)
            b: i64 = group_load(ooff)
            s: i64 = add a, b
            group_store(s, off)
        }
        group_sync()
        h2: i64 = shr half, 1
        continue h2
    }
    first: u1 = cmp.eq lane, 0
    if first {
        total: i64 = group_load(0)
        store total, area, group, 8
    }
    ret
}
