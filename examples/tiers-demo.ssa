; a function with obvious slack: constant chains that fold away, dead
; computation, and structured ifs whose lowered arms are pure forwarders
;! shipping 3 -> 1940
fn @shipping(%items: i64) -> i64 {
    ; constant configuration, foldable to nothing
    %base: i64 = iconst 500
    %per_kg: i64 = iconst 12
    %kg_per_item: i64 = iconst 40
    %rate: i64 = imul %per_kg, %kg_per_item
    %surcharge: i64 = iconst 17
    %unused: i64 = imul %surcharge, %rate    ; dead: never used
    %cost0: i64 = imul %rate, %items
    %cost: i64 = iadd %cost0, %base
    ; forwarding-arm if: lowered arms are empty jumps
    %limit: i64 = iconst 100000
    %big: u1 = icmp.gt %cost, %limit
    %capped: i64 = if %big {
        yield %limit
    } else {
        yield %cost
    }
    ret %capped
}
