; an arena: bump allocation over memory the program declared — a data
; array, or a caller's buffer. Three words: where it starts, how big it
; is, how much is used. Allocation moves the count forward and hands
; back where it was; a reset moves it back to zero; a mark remembers a
; count to release back to. Nothing is ever freed on its own, so an
; arena is reset only at a moment when nothing points into it any
; more — a period boundary, a call's end — and a pointer kept past
; that moment is the program's bug. Running out is a failed check.
; The size, the count and a mark are byte counts, so they are `index`,
; as wide as the policy says memory is (fm3 log 121); each still has a
; word of eight bytes to itself, at 8 and at 16, whatever that width,
; so the three words below are where the functions look and not how
; wide they read.
type arena = struct
    base: ptr
    size: i64
    used: i64

; the memory given may start anywhere; the arena starts at its first
; 16-aligned byte, so every allocation is 16-aligned absolutely
fn arena_init(a: ptr, base: ptr, size: index)
    b: u64 = cast base
    b15: u64 = add b, 15
    aligned: u64 = and b15, -16
    skip: u64 = sub aligned, b
    skipi: index = conv skip
    left: index = sub size, skipi
    start: ptr = cast aligned
    store start, a
    store left, a, 8
    store 0: index, a, 16
    ret

; n bytes, 16-aligned; the arena must have room
fn arena_alloc(a: ptr, n: index) -> ptr
    base: ptr = load a
    size: index = load a, 8
    used: index = load a, 16
    n15: index = add n, 15
    rounded: index = and n15, -16
    end: index = add used, rounded
    fits: u1 = cmp.le end, size
    check fits
    store end, a, 16
    p: ptr = ptradd base, used
    ret p

fn arena_used(a: ptr) -> index
    used: index = load a, 16
    ret used

; the stack flavour: a mark is a count to come back to
fn arena_mark(a: ptr) -> index
    used: index = load a, 16
    ret used
fn arena_release(a: ptr, m: index)
    used: index = load a, 16
    ok: u1 = cmp.le m, used
    check ok
    store m, a, 16
    ret

; the frame flavour: everything at once
fn arena_reset(a: ptr)
    store 0: index, a, 16
    ret
