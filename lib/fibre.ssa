; lib/fibre.ssa: fibres — several bodies sharing one thread by turns.
; `fibres_run(count, stacks, stack_bytes, body)` runs body(0) ..
; body(count - 1), each on a stack of its own, round-robin: a body runs
; until it calls `fibre_yield()` or returns, then the next runs. Every
; body has yielded (or finished) before any runs again, which is what a
; barrier between them needs (lib/gpu.ssa's `group_sync` yields when
; fibres are running). The switch itself is the platform's
; (`fibre_switch`: the callee-saved registers and sp saved and loaded;
; targets/arm64.platform, riscv64.platform); a platform with one stack
; (wasm: `fibre_stacks = 0`) runs the bodies one after another instead.
; At most 64 fibres. Frames are 128 bytes; the lr and sp words are where
; the platform says. The scheduler's state, its frame, the fibres'
; frames and their done flags live in the current thread's block
; (lib/thread.ssa), so every thread has a scheduler of its own.

; the block's parts: [count, current, active, body] at 0, the
; scheduler's frame at 64, the frames at 192, the done flags at 8384,
; a word per fibre at 9728 (zero when it starts; lib/gpu.ssa counts
; simdgroup operations in it)
fn fibre_state() -> ptr {
    t: ptr = thread()
    ret t
}
fn fibre_sched() -> ptr {
    t: ptr = thread()
    p: ptr = ptradd t, 64
    ret p
}
fn fibre_done_flags() -> ptr {
    t: ptr = thread()
    p: ptr = ptradd t, 8384
    ret p
}

; the platform's; a no-op where there is no rule
fn fibre_switch(save: ptr, to: ptr) {
    ret
}

fn fibre_frame(k: i64) -> ptr {
    t: ptr = thread()
    off0: i64 = mul k, 128
    off: i64 = add off0, 192
    p: ptr = ptradd t, off
    ret p
}

fn fibres_active() -> u1 {
    st: ptr = fibre_state()
    a: u64 = load st, 16
    r: u1 = cmp.ne a, 0
    ret r
}

fn fibre_current() -> i64 {
    st: ptr = fibre_state()
    c: u64 = load st, 8
    r: i64 = cast c
    ret r
}

; the current fibre gives up its turn
fn fibre_yield() {
    a: u1 = fibres_active()
    if a {
        k: i64 = fibre_current()
        mine: ptr = fibre_frame(k)
        sched: ptr = fibre_sched()
        fibre_switch(mine, sched)
    }
    ret
}

; where a fresh fibre begins: its body, then done for good
fn fibre_entry() {
    k: i64 = fibre_current()
    st: ptr = fibre_state()
    b: u64 = load st, 24
    body: fn(i64) = cast b
    body(k)
    d: ptr = fibre_done_flags()
    store 1: u64, d, k, 8
    mine: ptr = fibre_frame(k)
    sched: ptr = fibre_sched()
    fibre_switch(mine, sched)
    ret
}

fn fibre_word(k: i64) -> ptr {
    t: ptr = thread()
    off: i64 = mul k, 8
    p: ptr = ptradd t, 9728
    w: ptr = ptradd p, off
    ret w
}

fn fibres_run(count: i64, stacks: ptr, stack_bytes: i64, body: fn(i64)) {
    ok: u1 = cmp.le count, 64
    check ok
    loop(z: i64 = 0) {
        zdone: u1 = cmp.ge z, count
        if zdone {
            break
        }
        zw: ptr = fibre_word(z)
        store 0: i64, zw
        z1: i64 = add z, 1
        continue z1
    }
    st: ptr = fibre_state()
    c64: u64 = cast count
    store c64, st, 0
    b: u64 = cast body
    store b, st, 24
    stacked: i64 = platform fibre_stacks
    one_stack: u1 = cmp.eq stacked, 0
    if one_stack {
        ; one after another, no turns
        loop(q: i64 = 0) {
            last: u1 = cmp.ge q, count
            if last {
                break
            }
            body(q)
            q1: i64 = add q, 1
            continue q1
        }
        ret
    }
    lr_off: i64 = platform fibre_lr
    sp_off: i64 = platform fibre_sp
    e: fn() = addr fibre_entry
    entry: u64 = cast e
    d: ptr = fibre_done_flags()
    loop(k: i64 = 0) {
        done: u1 = cmp.ge k, count
        if done {
            break
        }
        fr: ptr = fibre_frame(k)
        k1: i64 = add k, 1
        top_off: i64 = mul k1, stack_bytes
        top: ptr = ptradd stacks, top_off
        topv: u64 = cast top
        store topv, fr, sp_off, 1
        store entry, fr, lr_off, 1
        store 0: u64, d, k, 8
        continue k1
    }
    store 1: u64, st, 16
    sched: ptr = fibre_sched()
    loop() {
        live: u1 = loop(j: i64 = 0, any: u1 = 0) {
            at_end: u1 = cmp.ge j, count
            if at_end {
                break any
            }
            dj: u64 = load d, j, 8
            finished: u1 = cmp.ne dj, 0
            j1: i64 = add j, 1
            if finished {
                continue j1, any
            }
            jj: u64 = cast j
            store jj, st, 8
            frj: ptr = fibre_frame(j)
            fibre_switch(sched, frj)
            continue j1, 1
        }
        if live {
            continue
        }
        break
    }
    store 0: u64, st, 16
    ret
}
