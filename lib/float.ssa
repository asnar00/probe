; The float family, float(E, M): 1 sign bit, E exponent bits, M
; mantissa bits. float(8, 23) is f32 and float(11, 52) is f64; other
; instances (float(4, 3) fp8 e4m3, float(5, 10) fp16, float(8, 7) bf16)
; are storage formats. IEEE-style: top exponent is inf/NaN (the
; finite-only "FN" e4m3 variant is future work); NaN payloads collapse
; to the canonical quiet NaN.

; the bitfield view of any float(E, M) — also what value.frac /
; value.exp / value.sign field access on a float value desugars to
type $fp(E, M) = { frac: u(M), exp: u(E), sign: u1 }

; ---------------------------------------------------------------------------
; The softfloat group: the default implementation of float arithmetic,
; used whenever the target has no native instruction for the format.
; A platform exposing a native op (f32/f64 on FPU targets) shadows
; these; everything else falls through here and compiles to integer
; code.
;
; No temporary is a machine word: every value carries its TRUE width as
; an expression of E and M (the significand with guard/round/sticky
; bits is u(M+5); a product is u(2*M+2); signed exponent arithmetic is
; i(max(E, 8) + 2), wide enough for subnormal-normalized exponents at
; any format). Mapping these onto a target's words is the width
; lowering's job — 64-bit words today, and nothing here assumes them.
; The verifier's word bound enforces each op's true limit: add needs
; M + 5 <= 64 (every format including f64), mul needs 2*M + 2 <= 64
; (M <= 31: f32 and below).
;
; Width-conversion discipline, applied mechanically: quantities widen
; (ext) into a computation width chosen to fit everything compared;
; shift amounts pass through u(6) — wide enough for any amount up to
; 63 — so every conversion has a fixed direction at every (E, M).

group softfloat {

; canonical quiet NaN
fn qnan() -> float(E, M) {
    ret float(E, M)(1 << (M - 1), (1 << E) - 1, 0)
}

; shared tail: round to nearest even on the 3 extra bits, pack, detect
; overflow. xe is the biased exponent (floor 1); ms holds the
; significand with its top (implicit) bit at position M+3. (xe comes
; first so the parameters read (E, M) — a generic function's width
; parameters bind in order of first appearance in its signature.)
fn round_pack(xe: u(E+1), ms: u(M+5), rs: u1) -> float(E, M) {
    lsb: u(M+5) = ms >> 3 & 1
    g: u(M+5) = ms >> 2 & 1
    rr: u(M+5) = ms >> 1 & 1
    stk: u(M+5) = ms & 1
    rup: u(M+5) = g & (rr | stk | lsb)
    ms2: u(M+5) = (ms >> 3) + rup
    ; pack exponent and fraction arithmetically: the implicit bit makes
    ; a rounding carry land as exponent + 1, and a subnormal rounding
    ; up to 2^M lands exactly on the minimum normal encoding
    isn: u1 = ms2 >> M != 0
    ; assembled one bit wide of the format, so every widening is real
    xew: u(E+M+2) = ext xe
    msw: u(E+M+2) = ext ms2
    packed: u(E+M+2) = if isn {
        pn: u(E+M+2) = ((xew - 1) << M) + msw
        yield pn
    } else {
        yield msw
    }
    ; overflow (including overflow by rounding): infinity
    ef: u(E+M+2) = packed >> M
    if ef >= (1 << E) - 1 { ret float(E, M)(0, (1 << E) - 1, rs) }
    rsw: u(E+M+2) = ext rs
    res: u(E+M+2) = rsw << (E + M) | packed
    rb: u(E+M+1) = trunc res
    out: float(E, M) = bitcast rb
    ret out
}

fn add(a: float(E, M), b: float(E, M)) -> float(E, M) {
    ; unpack: a float's fields are directly accessible, at their own
    ; widths
    sa: u1 = a.sign
    sb: u1 = b.sign
    ea: u(E) = a.exp
    eb: u(E) = b.exp
    fa: u(M) = a.frac
    fb: u(M) = b.frac
    ; NaN in, canonical quiet NaN out
    if ea == (1 << E) - 1 {
        if fa != 0 { ret qnan(E, M)() }
    }
    if eb == (1 << E) - 1 {
        if fb != 0 { ret qnan(E, M)() }
    }
    ; infinities pass through; opposite-sign inf + inf is NaN
    if ea == (1 << E) - 1 {
        if eb == (1 << E) - 1 {
            if sa != sb { ret qnan(E, M)() }
        }
        ret a
    }
    if eb == (1 << E) - 1 { ret b }
    ; order so x has the larger magnitude — IEEE layouts compare as
    ; plain integers
    eaw: u(E+M) = ext ea
    ebw: u(E+M) = ext eb
    faw: u(E+M) = ext fa
    fbw: u(E+M) = ext fb
    maga: u(E+M) = eaw << M | faw
    magb: u(E+M) = ebw << M | fbw
    swap: u1 = maga < magb
    xe0: u(E), xf: u(M), xs: u1, ye0: u(E), yf: u(M), ys: u1 = if swap {
        yield eb, fb, sb, ea, fa, sa
    } else {
        yield ea, fa, sa, eb, fb, sb
    }
    ; significands with the implicit bit; subnormals live at exponent 1
    xfw: u(M+1) = ext xf
    yfw: u(M+1) = ext yf
    mx: u(M+1), xe: u(E) = if xe0 == 0 {
        one1: u(E) = 1
        yield xfw, one1
    } else {
        mi1: u(M+1) = xfw | 1 << M
        yield mi1, xe0
    }
    my: u(M+1), ye: u(E) = if ye0 == 0 {
        one2: u(E) = 1
        yield yfw, one2
    } else {
        mi2: u(M+1) = yfw | 1 << M
        yield mi2, ye0
    }
    ; alignment distance, compared at a width that also holds M + 4
    ; (and strictly exceeds E, so the widening is real at every format)
    xec: u(max(E, 8) + 1) = ext xe
    yec: u(max(E, 8) + 1) = ext ye
    dc: u(max(E, 8) + 1) = xec - yec
    ; three extra bits: guard, round, sticky
    mxg: u(M+5) = ext mx
    myg: u(M+5) = ext my
    mx3: u(M+5) = mxg << 3
    my3i: u(M+5) = myg << 3
    my3: u(M+5) = if dc > M + 4 {
        ; too far apart: the smaller operand is pure sticky
        nz: u1 = my3i != 0
        st1: u(M+5) = ext nz
        yield st1
    } else {
        d6: u(6) = trunc dc
        amt: u(M+5) = ext d6
        low1: u(M+5) = my3i & (1 << amt) - 1
        ls1: u1 = low1 != 0
        lv1: u(M+5) = ext ls1
        shp: u(M+5) = my3i >> amt | lv1
        yield shp
    }
    ; effective add or subtract, by sign agreement
    ms0: u(M+5), rs: u1 = if xs == ys {
        msum: u(M+5) = mx3 + my3
        yield msum, xs
    } else {
        mdiff: u(M+5) = mx3 - my3
        yield mdiff, xs
    }
    if ms0 == 0 {
        ; exact cancellation is +0, but -0 + -0 keeps its sign
        zs: u1 = if xs == ys {
            yield xs
        } else {
            z0: u1 = 0
            yield z0
        }
        ret float(E, M)(0, 0, zs)
    }
    ; renormalize: a carry shifts right once (sticky-preserving), a
    ; cancellation shifts left until normal or the subnormal floor
    ms1: u(M+5), xe1: u(E) = if ms0 >> (M + 4) == 1 {
        stb: u(M+5) = ms0 & 1
        msr2: u(M+5) = ms0 >> 1 | stb
        xer: u(E) = xe + 1
        yield msr2, xer
    } else {
        msl2: u(M+5), xel: u(E) = loop(mm: u(M+5) = ms0, ee: u(E) = xe) {
            topb: u(M+5) = mm >> (M + 3)
            if topb == 1 { break mm, ee }
            if ee == 1 { break mm, ee }
            mm2: u(M+5) = mm << 1
            ee2: u(E) = ee - 1
            continue mm2, ee2
        }
        yield msl2, xel
    }
    xp: u(E+1) = ext xe1
    ret round_pack(E, M)(xp, ms1, rs)
}

; subtraction is addition with b's sign flipped
fn sub(a: float(E, M), b: float(E, M)) -> float(E, M) {
    ns: u1 = if b.sign == 1 {
        z0: u1 = 0
        yield z0
    } else {
        o1: u1 = 1
        yield o1
    }
    nb: float(E, M) = float(E, M)(b.frac, b.exp, ns)
    ret add(nb, a)
}

fn mul(a: float(E, M), b: float(E, M)) -> float(E, M) {
    sa: u1 = a.sign
    sb: u1 = b.sign
    ea: u(E) = a.exp
    eb: u(E) = b.exp
    fa: u(M) = a.frac
    fb: u(M) = b.frac
    sr: u1 = if sa == sb {
        z0: u1 = 0
        yield z0
    } else {
        o1: u1 = 1
        yield o1
    }
    if ea == (1 << E) - 1 {
        if fa != 0 { ret qnan(E, M)() }
    }
    if eb == (1 << E) - 1 {
        if fb != 0 { ret qnan(E, M)() }
    }
    eaw: u(E+M) = ext ea
    ebw: u(E+M) = ext eb
    faw: u(E+M) = ext fa
    fbw: u(E+M) = ext fb
    maga: u(E+M) = eaw << M | faw
    magb: u(E+M) = ebw << M | fbw
    if ea == (1 << E) - 1 {
        ; inf * 0 is NaN, inf * x is inf with the product sign
        if magb == 0 { ret qnan(E, M)() }
        ret float(E, M)(0, (1 << E) - 1, sr)
    }
    if eb == (1 << E) - 1 {
        if maga == 0 { ret qnan(E, M)() }
        ret float(E, M)(0, (1 << E) - 1, sr)
    }
    if maga == 0 { ret float(E, M)(0, 0, sr) }
    if magb == 0 { ret float(E, M)(0, 0, sr) }
    ; normalized significands with signed exponents, wide enough for
    ; subnormal-normalized exponents at any format
    faq: u(M+1) = ext fa
    fbq: u(M+1) = ext fb
    ma: u(M+1), xea: i(max(E, 8) + 2) = if ea == 0 {
        mn1: u(M+1), kk1: u(6) = loop(mm: u(M+1) = faq, k: u(6) = 0) {
            top: u(M+1) = mm >> M
            if top == 1 { break mm, k }
            mm2: u(M+1) = mm << 1
            k2: u(6) = k + 1
            continue mm2, k2
        }
        kw1: i(max(E, 8) + 2) = ext kk1
        en1: i(max(E, 8) + 2) = 1 - kw1
        yield mn1, en1
    } else {
        mi1: u(M+1) = faq | 1 << M
        eaq: i(max(E, 8) + 2) = ext ea
        yield mi1, eaq
    }
    mb: u(M+1), xeb: i(max(E, 8) + 2) = if eb == 0 {
        mn2: u(M+1), kk2: u(6) = loop(mmb: u(M+1) = fbq, kb: u(6) = 0) {
            topx: u(M+1) = mmb >> M
            if topx == 1 { break mmb, kb }
            mmb2: u(M+1) = mmb << 1
            kb2: u(6) = kb + 1
            continue mmb2, kb2
        }
        kw2: i(max(E, 8) + 2) = ext kk2
        en2: i(max(E, 8) + 2) = 1 - kw2
        yield mn2, en2
    } else {
        mi2: u(M+1) = fbq | 1 << M
        ebq: i(max(E, 8) + 2) = ext eb
        yield mi2, ebq
    }
    ; the double-width product — its type states the 2M+2 requirement;
    ; the +1 keeps it strictly wider than u(M+5), fixing conversion
    ; directions at every format
    maw: u(max(2*M+2, M+5) + 1) = ext ma
    mbw: u(max(2*M+2, M+5) + 1) = ext mb
    prod: u(max(2*M+2, M+5) + 1) = maw * mbw
    pe: i(max(E, 8) + 2) = xea + xeb - ((1 << (E - 1)) - 1)
    if pe >= (1 << E) - 1 {
        ret float(E, M)(0, (1 << E) - 1, sr)
    }
    ; bring the top bit to position M+3, folding underflow into the
    ; same shift (the exponent floor is 1)
    top2: u(max(2*M+2, M+5) + 1) = prod >> (2 * M + 1)
    sh0: i(max(E, 8) + 2), pe0: i(max(E, 8) + 2) = if top2 == 1 {
        s1: i(max(E, 8) + 2) = M - 2
        p1: i(max(E, 8) + 2) = pe + 1
        yield s1, p1
    } else {
        s2: i(max(E, 8) + 2) = M - 3
        yield s2, pe
    }
    need: i(max(E, 8) + 2) = if pe0 < 1 {
        n1: i(max(E, 8) + 2) = 1 - pe0
        yield n1
    } else {
        n0: i(max(E, 8) + 2) = 0
        yield n0
    }
    sh1: i(max(E, 8) + 2) = sh0 + need
    pe1: i(max(E, 8) + 2) = pe0 + need
    if pe1 >= (1 << E) - 1 {
        ret float(E, M)(0, (1 << E) - 1, sr)
    }
    if sh1 >= 2 * M + 2 {
        ; the product (< 2^(2M+2)) would shift to nothing — and larger
        ; shifts would wrap at the type width, so this MUST be caught
        ; here: the whole product is sticky, which rounds to zero at
        ; the exponent floor
        one5: u(M+5) = 1
        pz: u(E+1) = trunc pe1
        ret round_pack(E, M)(pz, one5, sr)
    }
    ms1: u(M+5) = if sh1 <= 0 {
        lsi: i(max(E, 8) + 2) = 0 - sh1
        ls6: u(6) = trunc lsi
        lsa: u(max(2*M+2, M+5) + 1) = ext ls6
        msl: u(max(2*M+2, M+5) + 1) = prod << lsa
        mst: u(M+5) = trunc msl
        yield mst
    } else {
        sh6: u(6) = trunc sh1
        sha: u(max(2*M+2, M+5) + 1) = ext sh6
        low: u(max(2*M+2, M+5) + 1) = prod & (1 << sha) - 1
        hs: u1 = low != 0
        shifted: u(max(2*M+2, M+5) + 1) = prod >> sha
        shn: u(M+5) = trunc shifted
        hv: u(M+5) = ext hs
        msr: u(M+5) = shn | hv
        yield msr
    }
    pw: u(E+1) = trunc pe1
    ret round_pack(E, M)(pw, ms1, sr)
}

; small float -> f64, exactly (u64 here is the true width of the
; TARGET format, not an assumption about the machine)
fn to_f64(bits: u(E+M+1)) -> f64 {
    b: u64 = ext bits
    s: u64 = b >> (E + M) & 1
    e: u64 = b >> M & ((1 << E) - 1)
    f: u64 = b & ((1 << M) - 1)
    sd: u64 = s << 63
    emax: u64 = (1 << E) - 1
    if e == emax {
        ; inf / NaN: top exponent, payload up-shifted
        fd: u64 = f << (52 - M)
        r1: u64 = sd | 0x7ff0000000000000 | fd
        x1: f64 = bitcast r1
        ret x1
    }
    bias: u64 = (1 << (E - 1)) - 1
    if e == 0 {
        if f == 0 {
            xz: f64 = bitcast sd
            ret xz
        }
    }
    en: u64, fm: u64 = if e == 0 {
        ; subnormal: normalize to 1.xxx, adjusting the exponent
        nl: u64, nf: u64 = loop(k: u64 = 0, ff: u64 = f) {
            top: u64 = ff >> M
            if top == 1 { break k, ff }
            ff2: u64 = ff << 1
            k2: u64 = k + 1
            continue k2, ff2
        }
        ed: u64 = 1024 - bias - nl
        fs: u64 = nf & ((1 << M) - 1)
        yield ed, fs
    } else {
        ed2: u64 = e - bias + 1023
        yield ed2, f
    }
    fd2: u64 = fm << (52 - M)
    r: u64 = sd | en << 52 | fd2
    x: f64 = bitcast r
    ret x
}

; f64 -> small float, round to nearest, ties to even. f64 subnormal
; inputs round to zero (below every practical target's range).
fn from_f64(x: f64) -> u(E+M+1) {
    b: u64 = bitcast x
    s: u64 = b >> 63 & 1
    ed: u64 = b >> 52 & 0x7ff
    fd: u64 = b & 0xfffffffffffff
    st: u64 = s << (E + M)
    emaxt: u64 = (1 << E) - 1
    if ed == 0x7ff {
        ; f64 inf/NaN -> target inf / quiet NaN
        ff: u64 = if fd == 0 {
            z0: u64 = 0
            yield z0
        } else {
            q: u64 = 1 << (M - 1)
            yield q
        }
        r1: u64 = st | emaxt << M | ff
        o1: u(E+M+1) = trunc r1
        ret o1
    }
    if ed == 0 {
        o0: u(E+M+1) = trunc st
        ret o0
    }
    bias: u64 = (1 << (E - 1)) - 1
    edi: i64 = bitcast ed
    biasi: i64 = bitcast bias
    et: i64 = edi - 1023 + biasi
    emaxi: i64 = bitcast emaxt
    if et >= emaxi {
        ri: u64 = st | emaxt << M
        oi: u(E+M+1) = trunc ri
        ret oi
    }
    m53: u64 = fd | 1 << 52
    if et >= 1 {
        ; normal target: round the 53-bit mantissa to M+1 bits
        sh: u64 = 52 - M
        keep: u64 = m53 >> sh
        dropped: u64 = m53 & ((1 << sh) - 1)
        %half: u64 = 1 << (sh - 1)
        rup: u1 = dropped > %half
        tie: u1 = dropped == %half
        ru: u64 = ext rup
        ti: u64 = ext tie
        odd: u64 = keep & 1
        inc: u64 = ru | ti & odd
        keep2: u64 = keep + inc
        eu: u64 = bitcast et
        r2: u64 = st + ((eu - 1) << M) + keep2
        o2: u(E+M+1) = trunc r2
        ret o2
    }
    ; subnormal target: shift further by the exponent deficit
    extrai: i64 = 1 - et
    shi: i64 = 52 - M + extrai
    if shi >= 54 {
        o3: u(E+M+1) = trunc st
        ret o3
    }
    shu: u64 = bitcast shi
    keep3: u64 = m53 >> shu
    drop3: u64 = m53 & ((1 << shu) - 1)
    half3: u64 = 1 << (shu - 1)
    rup3: u1 = drop3 > half3
    tie3: u1 = drop3 == half3
    ru3: u64 = ext rup3
    ti3: u64 = ext tie3
    odd3: u64 = keep3 & 1
    inc3: u64 = ru3 | ti3 & odd3
    keep4: u64 = keep3 + inc3
    r4: u64 = st | keep4
    o4: u(E+M+1) = trunc r4
    ret o4
}

}
