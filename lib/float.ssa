; the small-float conversion library, generic over the format: an
; IEEE-style float(E, M) has 1 sign bit, E exponent bits, M mantissa
; bits — float(8, 23) is f32, float(11, 52) is f64, float(5, 10) is
; fp16, float(8, 7) is bf16, float(4, 3) is fp8 e4m3 (IEEE-style: top
; exponent reserved for inf/NaN; the finite-only "FN" variant is future
; work). add/sub/mul are DIRECT bitwise algorithms (fp_add/fp_sub/
; fp_mul below): pure integer code, generic over the format, verified
; exhaustively at fp8 and bit-for-bit against the M1 FPU at (8, 23).
; div (and comparisons/conversions) still route through f64 via
; fp_to_f64/fp_from_f64 — correctly rounded for every M <= 24 by the
; double-rounding theorem (2(M+1)+2 <= 53).
;
; Width parameters appear as widths (u(E+M+1)) and as VALUES (shift
; amounts, masks) — instantiation is explicit (fp_to_f64(4, 3)(b))
; because E and M cannot be inferred from the total width alone.
;
; Scope notes (documented, verified): f64 subnormal inputs to
; fp_from_f64 round to zero (they are below every practical target's
; range); NaN payloads collapse to a quiet NaN.

; the bitfield view of any float(E, M) — also what value.frac /
; value.exp / value.sign field access on a float value desugars to
type $fp(E, M) = { frac: u(M), exp: u(E), sign: u1 }

; small float -> f64 (exact: every float(E<=11, M<=52) value is an f64)
fn fp_to_f64(bits: u(E+M+1)) -> f64 {
    b: u64 = ext bits
    s: u64 = b >> (E + M) & 1
    e: u64 = b >> M & ((1 << E) - 1)
    f: u64 = b & ((1 << M) - 1)
    sd: u64 = s << 63
    emax: u64 = (1 << E) - 1
    if e == emax {
        ; inf / NaN: top exponent, payload up-shifted
        fd: u64 = f << (52 - M)
        r1: u64 = sd | 0x7ff0000000000000 | fd
        x1: f64 = bitcast r1
        ret x1
    }
    bias: u64 = (1 << (E - 1)) - 1
    if e == 0 {
        if f == 0 {
            xz: f64 = bitcast sd
            ret xz
        }
    }
    en: u64, fm: u64 = if e == 0 {
        ; subnormal: normalize to 1.xxx, adjusting the exponent
        nl: u64, nf: u64 = loop(k: u64 = 0, ff: u64 = f) {
            top: u64 = ff >> M
            if top == 1 { break k, ff }
            ff2: u64 = ff << 1
            k2: u64 = k + 1
            continue k2, ff2
        }
        ed: u64 = 1024 - bias - nl
        fs: u64 = nf & ((1 << M) - 1)
        yield ed, fs
    } else {
        ed2: u64 = e - bias + 1023
        yield ed2, f
    }
    fd2: u64 = fm << (52 - M)
    r: u64 = sd | en << 52 | fd2
    x: f64 = bitcast r
    ret x
}

; f64 -> small float, round to nearest, ties to even
fn fp_from_f64(x: f64) -> u(E+M+1) {
    b: u64 = bitcast x
    s: u64 = b >> 63 & 1
    ed: u64 = b >> 52 & 0x7ff
    fd: u64 = b & 0xfffffffffffff
    st: u64 = s << (E + M)
    emaxt: u64 = (1 << E) - 1
    if ed == 0x7ff {
        ; f64 inf/NaN -> target inf / quiet NaN
        ff: u64 = if fd == 0 {
            z0: u64 = 0
            yield z0
        } else {
            q: u64 = 1 << (M - 1)
            yield q
        }
        r1: u64 = st | emaxt << M | ff
        o1: u(E+M+1) = trunc r1
        ret o1
    }
    if ed == 0 {
        ; f64 subnormals sit far below the target's range: signed zero
        o0: u(E+M+1) = trunc st
        ret o0
    }
    bias: u64 = (1 << (E - 1)) - 1
    edi: i64 = bitcast ed
    biasi: i64 = bitcast bias
    et: i64 = edi - 1023 + biasi
    emaxi: i64 = bitcast emaxt
    if et >= emaxi {
        ; overflow: infinity
        ri: u64 = st | emaxt << M
        oi: u(E+M+1) = trunc ri
        ret oi
    }
    m53: u64 = fd | 1 << 52
    if et >= 1 {
        ; normal target: round the 53-bit mantissa to M+1 bits
        sh: u64 = 52 - M
        keep: u64 = m53 >> sh
        dropped: u64 = m53 & ((1 << sh) - 1)
        %half: u64 = 1 << (sh - 1)
        rup: u1 = dropped > %half
        tie: u1 = dropped == %half
        ru: u64 = ext rup
        ti: u64 = ext tie
        odd: u64 = keep & 1
        inc: u64 = ru | ti & odd
        keep2: u64 = keep + inc
        ; the implicit bit makes the exponent arithmetic absorb a
        ; rounding carry: st + (et-1)<<M + keep2 encodes the result,
        ; and a carry to 2^(M+1) lands as et+1 automatically (et+1 =
        ; emax then encodes infinity, which is the correct overflow)
        eu: u64 = bitcast et
        r2: u64 = st + ((eu - 1) << M) + keep2
        o2: u(E+M+1) = trunc r2
        ret o2
    }
    ; subnormal target: shift further by the exponent deficit
    extrai: i64 = 1 - et
    shi: i64 = 52 - M + extrai
    if shi >= 54 {
        ; everything rounds away: signed zero
        o3: u(E+M+1) = trunc st
        ret o3
    }
    shu: u64 = bitcast shi
    keep3: u64 = m53 >> shu
    drop3: u64 = m53 & ((1 << shu) - 1)
    half3: u64 = 1 << (shu - 1)
    rup3: u1 = drop3 > half3
    tie3: u1 = drop3 == half3
    ru3: u64 = ext rup3
    ti3: u64 = ext tie3
    odd3: u64 = keep3 & 1
    inc3: u64 = ru3 | ti3 & odd3
    keep4: u64 = keep3 + inc3
    ; a round-up to 2^M lands exactly on the minimum normal encoding
    r4: u64 = st | keep4
    o4: u(E+M+1) = trunc r4
    ret o4
}

; ---------------------------------------------------------------------------
; DIY arithmetic: direct bitwise add/sub/mul, generic over the format,
; pure integer code — no f64 detour, no FPU assumption. This is the
; universal fallthrough of the platform model: when a target exposes a
; native instruction for a format (f32/f64 on FPU targets), that
; shadows these; otherwise the ops lower to calls to these instances.
; Full subnormal support, round to nearest even via guard/round/sticky.
; fp_add works for every M <= 52 (f64 included); fp_mul needs the
; double-width product to fit u64, so M <= 31 (f32 and below).
;
; Signatures are over float(E, M) itself, so call sites infer the
; format from their arguments; a float's fields are read directly
; (a.sign, a.exp, a.frac) and results build with the float(E, M)(...)
; constructor — both are sugar over the $fp(E, M) view above.

; canonical quiet NaN
fn fp_qnan() -> float(E, M) {
    ret float(E, M)(1 << (M - 1), (1 << E) - 1, 0)
}

; shared tail: round to nearest even on 3 extra bits, pack, overflow to
; infinity. The implicit bit makes the exponent arithmetic absorb a
; rounding carry, and a subnormal that rounds up to 2^M lands exactly
; on the minimum normal encoding.
fn fp_pack(ms1: u64, xe1: u64, rs: u64) -> float(E, M) {
    lsb: u64 = ms1 >> 3 & 1
    g: u64 = ms1 >> 2 & 1
    rr: u64 = ms1 >> 1 & 1
    stk: u64 = ms1 & 1
    rup: u64 = g & (rr | stk | lsb)
    ms2: u64 = (ms1 >> 3) + rup
    emax: u64 = (1 << E) - 1
    isn: u1 = ms2 >> M != 0
    packed: u64 = if isn {
        pn: u64 = ((xe1 - 1) << M) + ms2
        yield pn
    } else {
        yield ms2
    }
    sgn: u1 = trunc rs
    ef: u64 = packed >> M
    if ef >= emax { ret float(E, M)(0, (1 << E) - 1, sgn) }
    res: u64 = rs << (E + M) | packed
    rb: u(E+M+1) = trunc res
    out: float(E, M) = bitcast rb
    ret out
}

fn fp_add(a: float(E, M), b: float(E, M)) -> float(E, M) {
    ; unpack: a float's fields are directly accessible
    sa: u1 = a.sign
    sb: u1 = b.sign
    ea: u64 = ext a.exp
    eb: u64 = ext b.exp
    fa: u64 = ext a.frac
    fb: u64 = ext b.frac
    emax: u64 = (1 << E) - 1
    ; NaN in, canonical quiet NaN out
    if ea == emax {
        if fa != 0 { ret fp_qnan(E, M)() }
    }
    if eb == emax {
        if fb != 0 { ret fp_qnan(E, M)() }
    }
    ; infinities pass through; opposite-sign inf + inf is NaN
    if ea == emax {
        if eb == emax {
            if sa != sb { ret fp_qnan(E, M)() }
        }
        ret a
    }
    if eb == emax { ret b }
    ; order so x has the larger magnitude — IEEE layouts compare as
    ; plain integers
    maga: u64 = ea << M | fa
    magb: u64 = eb << M | fb
    swap: u1 = maga < magb
    xe0: u64, xf: u64, xs: u1, ye0: u64, yf: u64, ys: u1 = if swap {
        yield eb, fb, sb, ea, fa, sa
    } else {
        yield ea, fa, sa, eb, fb, sb
    }
    ; significands with the implicit bit; subnormals live at exponent 1
    mx: u64, xe: u64 = if xe0 == 0 {
        one1: u64 = 1
        yield xf, one1
    } else {
        mi1: u64 = xf | 1 << M
        yield mi1, xe0
    }
    my: u64, ye: u64 = if ye0 == 0 {
        one2: u64 = 1
        yield yf, one2
    } else {
        mi2: u64 = yf | 1 << M
        yield mi2, ye0
    }
    ; align the smaller operand, keeping guard/round/sticky bits
    mx3: u64 = mx << 3
    my3i: u64 = my << 3
    d: u64 = xe - ye
    my3: u64 = if d > M + 4 {
        nz: u1 = my3i != 0
        st1: u64 = ext nz
        yield st1
    } else {
        low1: u64 = my3i & ((1 << d) - 1)
        ls1: u1 = low1 != 0
        lv1: u64 = ext ls1
        shp: u64 = my3i >> d | lv1
        yield shp
    }
    ; effective add or subtract, by sign agreement
    ms0: u64, rs: u1 = if xs == ys {
        msum: u64 = mx3 + my3
        yield msum, xs
    } else {
        mdiff: u64 = mx3 - my3
        yield mdiff, xs
    }
    if ms0 == 0 {
        ; exact cancellation is +0, but -0 + -0 keeps its sign
        zs: u1 = if xs == ys {
            yield xs
        } else {
            z0: u1 = 0
            yield z0
        }
        ret float(E, M)(0, 0, zs)
    }
    ; renormalize: a carry shifts right once (sticky-preserving), a
    ; cancellation shifts left until normal or the subnormal floor
    ms1: u64, xe1: u64 = if ms0 >> (M + 4) == 1 {
        stb: u64 = ms0 & 1
        msr2: u64 = ms0 >> 1 | stb
        xer: u64 = xe + 1
        yield msr2, xer
    } else {
        msl2: u64, xel: u64 = loop(mm: u64 = ms0, ee: u64 = xe) {
            topb: u64 = mm >> (M + 3)
            if topb == 1 { break mm, ee }
            if ee == 1 { break mm, ee }
            mm2: u64 = mm << 1
            ee2: u64 = ee - 1
            continue mm2, ee2
        }
        yield msl2, xel
    }
    rs64: u64 = ext rs
    ret fp_pack(E, M)(ms1, xe1, rs64)
}

; subtraction is addition with b's sign flipped
fn fp_sub(a: float(E, M), b: float(E, M)) -> float(E, M) {
    ns: u1 = if b.sign == 1 {
        z0: u1 = 0
        yield z0
    } else {
        o1: u1 = 1
        yield o1
    }
    nb: float(E, M) = float(E, M)(b.frac, b.exp, ns)
    ret fp_add(nb, a)
}

fn fp_mul(a: float(E, M), b: float(E, M)) -> float(E, M) {
    sa: u1 = a.sign
    sb: u1 = b.sign
    ea: u64 = ext a.exp
    eb: u64 = ext b.exp
    fa: u64 = ext a.frac
    fb: u64 = ext b.frac
    emax: u64 = (1 << E) - 1
    sr: u1 = if sa == sb {
        z0: u1 = 0
        yield z0
    } else {
        o1: u1 = 1
        yield o1
    }
    if ea == emax {
        if fa != 0 { ret fp_qnan(E, M)() }
    }
    if eb == emax {
        if fb != 0 { ret fp_qnan(E, M)() }
    }
    maga: u64 = ea << M | fa
    magb: u64 = eb << M | fb
    if ea == emax {
        ; inf * 0 is NaN, inf * x is inf with the product sign
        if magb == 0 { ret fp_qnan(E, M)() }
        ret float(E, M)(0, (1 << E) - 1, sr)
    }
    if eb == emax {
        if maga == 0 { ret fp_qnan(E, M)() }
        ret float(E, M)(0, (1 << E) - 1, sr)
    }
    if maga == 0 { ret float(E, M)(0, 0, sr) }
    if magb == 0 { ret float(E, M)(0, 0, sr) }
    ; normalized significands with signed exponents (subnormals go
    ; negative after normalization)
    ma: u64, xea: i64 = if ea == 0 {
        mn1: u64, kk1: u64 = loop(mm: u64 = fa, k: u64 = 0) {
            top: u64 = mm >> M
            if top == 1 { break mm, k }
            mm2: u64 = mm << 1
            k2: u64 = k + 1
            continue mm2, k2
        }
        ki1: i64 = bitcast kk1
        en1: i64 = 1 - ki1
        yield mn1, en1
    } else {
        mi1: u64 = fa | 1 << M
        ei1: i64 = bitcast ea
        yield mi1, ei1
    }
    mb: u64, xeb: i64 = if eb == 0 {
        mn2: u64, kk2: u64 = loop(mmb: u64 = fb, kb: u64 = 0) {
            topx: u64 = mmb >> M
            if topx == 1 { break mmb, kb }
            mmb2: u64 = mmb << 1
            kb2: u64 = kb + 1
            continue mmb2, kb2
        }
        ki2: i64 = bitcast kk2
        en2: i64 = 1 - ki2
        yield mn2, en2
    } else {
        mi2: u64 = fb | 1 << M
        ei2: i64 = bitcast eb
        yield mi2, ei2
    }
    prod: u64 = ma * mb
    biasi: i64 = (1 << (E - 1)) - 1
    pe: i64 = xea + xeb - biasi
    ; bring the top bit to position M+3, folding underflow into the
    ; same shift (the exponent floor is 1)
    top2: u64 = prod >> (2 * M + 1)
    sh0: i64, pe0: i64 = if top2 == 1 {
        s1: i64 = M - 2
        p1: i64 = pe + 1
        yield s1, p1
    } else {
        s2: i64 = M - 3
        yield s2, pe
    }
    need: i64 = if pe0 < 1 {
        n1: i64 = 1 - pe0
        yield n1
    } else {
        n0: i64 = 0
        yield n0
    }
    sh1: i64 = sh0 + need
    pe1: i64 = pe0 + need
    if sh1 >= 54 {
        ; deep underflow: everything rounds away
        ret float(E, M)(0, 0, sr)
    }
    ms1: u64 = if sh1 <= 0 {
        lsh: i64 = 0 - sh1
        lshu: u64 = bitcast lsh
        msl: u64 = prod << lshu
        yield msl
    } else {
        shu: u64 = bitcast sh1
        low: u64 = prod & ((1 << shu) - 1)
        hs: u1 = low != 0
        hv: u64 = ext hs
        msr: u64 = prod >> shu | hv
        yield msr
    }
    peu: u64 = bitcast pe1
    sr64: u64 = ext sr
    ret fp_pack(E, M)(ms1, peu, sr64)
}
