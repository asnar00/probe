; lib/gpu.ssa: what a program running as many threads has and a
; program running as one does not — memory a threadgroup shares, and
; the barrier that orders its use. On a GPU these are the platform's
; (targets/air.platform: an addrspace(3) array and air.wg.barrier);
; here they are a buffer in data and nothing, so the same program
; parses and runs everywhere as a group of one. Offsets are in bytes;
; the values are words.

data __group: array(i64, 2048)

fn group_load(off: i64) -> i64 {
    g: ptr = addr __group
    v: i64 = load g, off, 1
    ret v
}
fn group_store(v: i64, off: i64) {
    g: ptr = addr __group
    store v, g, off, 1
    ret
}
fn group_sync() {
    ret
}
