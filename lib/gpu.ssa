; lib/gpu.ssa: what a program running as many threads has and a
; program running as one does not. A `group` item is memory a
; threadgroup shares (`group tmp: array(i64, 64)`, reached through
; `addr` like data); `group_sync()` is the barrier that orders its use.
; On a GPU the barrier is the platform's (targets/air.platform:
; air.wg.barrier); here it is nothing, so the same program parses and
; runs everywhere as a group of one — a machine's group items are data.

; the barrier: with fibres running (lib/fibre.ssa), a turn given up —
; every fibre reaches its next sync before any goes on
fn group_sync() {
    a: u1 = fibres_active()
    if a {
        fibre_yield()
    }
    ret
}

; a simdgroup: the lanes that execute in lockstep (32 on an Apple GPU),
; with operations across them — sums, extremes, prefix sums, shuffles
; and votes, on 32-bit lanes and half (targets/air.platform names
; Apple's). A lane or delta is an i64 (`three: i64 = const 3` before
; `simd_shuffle x, three`).
;
; On one thread the simdgroup is that thread: a lane is 0, the width
; 1, every reduction is its argument, a shuffle the value, a vote the
; one vote. With fibres running a group (lib/fibre.ssa, a kernel
; directive), the simdgroup is 32 consecutive lanes of the group and
; an operation is an exchange through a table in the thread's block:
; every lane puts its word in its slot and yields — a round, so every
; lane has put — reads what it needs, and yields again so no lane
; writes over a word another has yet to read. Every lane of a
; simdgroup must reach the same operation, as on the hardware.

; the exchange table: 64 words at 9216 in the block
fn simd_slots() -> ptr {
    t: ptr = thread()
    p: ptr = ptradd t, 9216
    ret p
}
; my lane's simdgroup: its first lane, and how many lanes it has
fn simd_base() -> i64 {
    k: i64 = fibre_current()
    b: i64 = and k, -32
    ret b
}
fn simd_active() -> i64 {
    b: i64 = simd_base()
    st: ptr = fibre_state()
    c64: u64 = load st, 0
    count: i64 = cast c64
    rest: i64 = sub count, b
    more: u1 = cmp.gt rest, 32
    if more {
        ret 32
    }
    ret rest
}
fn simd_put(w: u64) {
    k: i64 = fibre_current()
    s: ptr = simd_slots()
    store w, s, k, 8
    fibre_yield()
    ret
}
fn simd_get(lane: i64) -> u64 {
    s: ptr = simd_slots()
    w: u64 = load s, lane, 8
    ret w
}
fn simd_done() {
    fibre_yield()
    ret
}

fn simd_lane() -> i64 {
    a: u1 = fibres_active()
    if a {
        k: i64 = fibre_current()
        l: i64 = and k, 31
        ret l
    }
    ret 0
}
fn simd_size() -> i64 {
    a: u1 = fibres_active()
    if a {
        ret 32
    }
    ret 1
}
fn simd_first() -> u1 {
    l: i64 = simd_lane()
    f: u1 = cmp.eq l, 0
    ret f
}
fn simd_all(c: u1) -> u1 {
    a: u1 = fibres_active()
    if a {
        b: u64 = simd_ballot(c)
        n: i64 = simd_active()
        nu: u64 = cast n
        full: u64 = shl 1: u64, nu
        every: u64 = sub full, 1
        r: u1 = cmp.eq b, every
        ret r
    }
    ret c
}
fn simd_any(c: u1) -> u1 {
    a: u1 = fibres_active()
    if a {
        b: u64 = simd_ballot(c)
        r: u1 = cmp.ne b, 0
        ret r
    }
    ret c
}
fn simd_ballot(c: u1) -> u64 {
    a: u1 = fibres_active()
    if a {
        w: u64 = conv c
        simd_put(w)
        base: i64 = simd_base()
        n: i64 = simd_active()
        bits: u64 = loop(i: i64 = 0, acc: u64 = 0) {
            done: u1 = cmp.ge i, n
            if done {
                break acc
            }
            at: i64 = add base, i
            v: u64 = simd_get(at)
            iu: u64 = cast i
            bit: u64 = shl v, iu
            acc1: u64 = or acc, bit
            i1: i64 = add i, 1
            continue i1, acc1
        }
        simd_done()
        ret bits
    }
    r: u64 = conv c
    ret r
}

; --- floats: the word is the bits ---
fn simd_sum(E, M)(x: float(E, M)) -> float(E, M) {
    a: u1 = fibres_active()
    if a {
        xb: u(E + M + 1) = cast x
        w: u64 = conv xb
        simd_put(w)
        base: i64 = simd_base()
        n: i64 = simd_active()
        zero: float(E, M) = pack 0, 0, 0
        acc: float(E, M) = loop(i: i64 = 0, s: float(E, M) = zero) {
            done: u1 = cmp.ge i, n
            if done {
                break s
            }
            at: i64 = add base, i
            v: u64 = simd_get(at)
            vb: u(E + M + 1) = conv v
            f: float(E, M) = cast vb
            s1: float(E, M) = add s, f
            i1: i64 = add i, 1
            continue i1, s1
        }
        simd_done()
        ret acc
    }
    ret x
}
fn simd_product(E, M)(x: float(E, M)) -> float(E, M) {
    a: u1 = fibres_active()
    if a {
        xb: u(E + M + 1) = cast x
        w: u64 = conv xb
        simd_put(w)
        base: i64 = simd_base()
        n: i64 = simd_active()
        one: float(E, M) = conv 1: i64
        acc: float(E, M) = loop(i: i64 = 0, s: float(E, M) = one) {
            done: u1 = cmp.ge i, n
            if done {
                break s
            }
            at: i64 = add base, i
            v: u64 = simd_get(at)
            vb: u(E + M + 1) = conv v
            f: float(E, M) = cast vb
            s1: float(E, M) = mul s, f
            i1: i64 = add i, 1
            continue i1, s1
        }
        simd_done()
        ret acc
    }
    ret x
}
