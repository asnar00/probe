        me: i64 = fibre_current()
        zero: float(E, M) = pack 0, 0, 0
        acc: float(E, M) = loop(i: i64 = base, s: float(E, M) = zero) {
            done: u1 = cmp.gt i, me
            if done {
                break s
            }
            v: u64 = simd_get(i)
            vb: u(E + M + 1) = conv v
            f: float(E, M) = cast vb
            s1: float(E, M) = add s, f
            i1: i64 = add i, 1
            continue i1, s1
