; a word from another lane: its slot, or my own value off the group
fn simd_fetch(x: u64, lane: i64) -> u64 {
    base: i64 = simd_base()
    n: i64 = simd_active()
    simd_put(x)
    inside0: u1 = cmp.ge lane, 0
    inside1: u1 = cmp.lt lane, n
    inside: u1 = and inside0, inside1
    r: u64 = if inside {
        at: i64 = add base, lane
        v: u64 = simd_get(at)
        yield v
    } else {
        yield x
    }
    simd_done()
    ret r
}
fn simd_shuffle(E, M)(x: float(E, M), lane: i64) -> float(E, M) {
    a: u1 = fibres_active()
    if a {
        xb: u(E + M + 1) = cast x
        w: u64 = conv xb
        v: u64 = simd_fetch(w, lane)
        vb: u(E + M + 1) = conv v
        f: float(E, M) = cast vb
        ret f
    }
    ret x
}
fn simd_broadcast(E, M)(x: float(E, M), lane: i64) -> float(E, M) {
    r: float(E, M) = simd_shuffle x, lane
    ret r
}
fn simd_shuffle_xor(E, M)(x: float(E, M), mask: i64) -> float(E, M) {
    l: i64 = simd_lane()
    other: i64 = xor l, mask
    r: float(E, M) = simd_shuffle x, other
    ret r
}
fn simd_shuffle_down(E, M)(x: float(E, M), delta: i64) -> float(E, M) {
    l: i64 = simd_lane()
    other: i64 = add l, delta
    r: float(E, M) = simd_shuffle x, other
    ret r
}
fn simd_shuffle_up(E, M)(x: float(E, M), delta: i64) -> float(E, M) {
    l: i64 = simd_lane()
    other: i64 = sub l, delta
    r: float(E, M) = simd_shuffle x, other
    ret r
}

; --- integers: the word is the value, sign-extended ---
fn simd_sum(N)(x: i(N)) -> i(N) {
    a: u1 = fibres_active()
    if a {
        xw: i64 = conv x
        w: u64 = cast xw
        simd_put(w)
        base: i64 = simd_base()
        n: i64 = simd_active()
        acc: i64 = loop(i: i64 = 0, s: i64 = 0) {
            done: u1 = cmp.ge i, n
            if done {
                break s
            }
            at: i64 = add base, i
            v: u64 = simd_get(at)
            vi: i64 = cast v
            s1: i64 = add s, vi
            i1: i64 = add i, 1
            continue i1, s1
        }
        simd_done()
        r: i(N) = conv acc
        ret r
    }
    ret x
}
