; lib/gpu.ssa: what a program running as many threads has and a
; program running as one does not. A `group` item is memory a
; threadgroup shares (`group tmp: array(i64, 64)`, reached through
; `addr` like data); `group_sync()` is the barrier that orders its use.
; On a GPU the barrier is the platform's (targets/air.platform:
; air.wg.barrier); here it is nothing, so the same program parses and
; runs everywhere as a group of one — a machine's group items are data.

fn group_sync() {
    ret
}

; a simdgroup: the lanes that execute in lockstep (32 on an Apple GPU),
; with operations across them — sums, extremes, prefix sums, shuffles
; and votes, on 32-bit lanes and half (targets/air.platform names
; Apple's). On one thread the simdgroup is that thread: a lane is 0,
; the width 1, every reduction is its argument, a shuffle is the
; value itself, a vote is the one vote. A lane or delta is an i64
; (`three: i64 = const 3` before `simd_shuffle x, three`).

fn simd_lane() -> i64 {
    ret 0
}
fn simd_size() -> i64 {
    ret 1
}
fn simd_first() -> u1 {
    one: u1 = const 1
    ret one
}
fn simd_all(c: u1) -> u1 {
    ret c
}
fn simd_any(c: u1) -> u1 {
    ret c
}
fn simd_ballot(c: u1) -> u64 {
    r: u64 = conv c
    ret r
}

