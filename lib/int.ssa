; lib/int.ssa — min, max, abs and neg over every number, defined once:
; `number` is the top of the tower of abstract types (number over int,
; uint and scalar; scalar over the number libraries), and a function
; over it is a template bound by its argument's type at each call. A
; library that means something different keeps its own — lib/float.ssa's
; min and max propagate a NaN, its abs and neg work the sign bit — and
; the most specific definition wins. A platform with an instruction for
; an instance substitutes it (arm64: cmp and csel; NEON and RVV: smin/
; umin, vmin/vminu, abs and neg over vectors); elsewhere these bodies
; are what runs, and what the instructions are checked against.

fn min(a: number, b: number) -> number {
    lt: u1 = cmp.lt a, b
    r: number = if lt {
        yield a
    } else {
        yield b
    }
    ret r
}
fn max(a: number, b: number) -> number {
    gt: u1 = cmp.gt a, b
    r: number = if gt {
        yield a
    } else {
        yield b
    }
    ret r
}
; -a; the most negative value stays itself, as the machines have it
fn neg(a: number) -> number {
    r: number = sub 0, a
    ret r
}
fn abs(a: number) -> number {
    negative: u1 = cmp.lt a, 0
    r: number = if negative {
        m: number = sub 0, a
        yield m
    } else {
        yield a
    }
    ret r
}
