; the rational-number library: $rat plus its operations, all ordinary
; SSA - no compiler support. Canonical form: den > 0, gcd(|num|, den) = 1,
; sign in the numerator. den == 0 is NaR (not-a-rational): it propagates,
; and compares false (except ne). Exact-or-NaR semantics: results are
; reduced, and anything unrepresentable in the fields becomes NaR rather
; than silently approximating. This file is linked in textually wherever
; rat_* or $rat is used, and is the 'scalar -> rat' policy's runtime.
;
; The library is width-agnostic: fields are `half`/`uhalf` (half the
; `int` policy's width) and intermediates are `int`/`uint`, so the
; invariant the arithmetic rests on - cross products need TWICE the
; field width - holds under every policy. int=int gives i32/u32
; rationals with int math; int=i32 gives i16/u16 rationals with i32
; math. Range checks are trunc/ext round-trips, so no width appears as
; a constant anywhere.

type $rat = { num: half, den: uhalf }

fn rat_gcd(a: uint, b: uint) -> uint {
    g: uint = loop(x: uint = a, y: uint = b) {
        if y == 0 { break x }
        r: uint = x % y
        continue y, r
    }
    ret g
}

fn rat_abs(v: int) -> uint {
    neg: u1 = v < 0
    a: int = if neg {
        m: int = 0 - v
        yield m
    } else {
        yield v
    }
    u: uint = bitcast a
    ret u
}

fn rat_nar() -> $rat {
    n: half = 0
    d: uhalf = 0
    r: $rat = pack n, d
    ret r
}

fn rat_is_nar(a: $rat) -> u1 {
    d: uhalf = extract a, den
    r: u1 = d == 0
    ret r
}

; unpack to 64-bit working values (num sign-extended, den zero-extended)
fn rat_parts(a: $rat) -> (int, uint) {
    n32: half = extract a, num
    d32: uhalf = extract a, den
    n: int = ext n32
    d: uint = ext d32
    ret n, d
}

; reduce and range-check a 64-bit num/den pair; den must be nonzero
fn rat_fit(n: int, d: uint) -> $rat {
    a: uint = rat_abs(n)
    anz: u1 = a != 0
    ; gcd(0, d) = d, which normalizes 0/d to 0/1
    g: uint = if anz {
        g0: uint = rat_gcd(a, d)
        yield g0
    } else {
        yield d
    }
    ar: uint = a / g
    dr: uint = d / g
    neg: u1 = n < 0
    ari: int = bitcast ar
    nsig: int = if neg {
        m: int = 0 - ari
        yield m
    } else {
        yield ari
    }
    ; range checks are trunc/ext round-trips: a value fits its field
    ; exactly when narrowing and re-widening gives it back (this also
    ; handles the asymmetric signed range for free)
    n32: half = trunc nsig
    nback: int = ext n32
    if nback != nsig { ret rat_nar() }
    d32: uhalf = trunc dr
    dback: uint = ext d32
    if dback != dr { ret rat_nar() }
    r: $rat = pack n32, d32
    ret r
}

fn rat_make(n0: int, d0: int) -> $rat {
    if d0 == 0 { ret rat_nar() }
    dneg: u1 = d0 < 0
    n: int, d: int = if dneg {
        nn: int = 0 - n0
        nd: int = 0 - d0
        yield nn, nd
    } else {
        yield n0, d0
    }
    du: uint = bitcast d
    ret rat_fit(n, du)
}

; a/b + c/d = (a*(d/g) + c*(b/g)) / ((b/g)*d), g = gcd(b, d); the
; pre-gcd keeps the cross products small, rat_fit finishes the reduction
fn rat_add(x: $rat, y: $rat) -> $rat {
    if rat_is_nar(x) { ret rat_nar() }
    if rat_is_nar(y) { ret rat_nar() }
    a: int, b: uint = rat_parts(x)
    c: int, d: uint = rat_parts(y)
    g: uint = rat_gcd(b, d)
    bg: uint = b / g
    dg: uint = d / g
    bgi: int = bitcast bg
    dgi: int = bitcast dg
    t: int = a * dgi + c * bgi
    den: uint = bg * d
    ret rat_fit(t, den)
}

fn rat_neg(x: $rat) -> $rat {
    if rat_is_nar(x) { ret rat_nar() }
    n: int, d: uint = rat_parts(x)
    m: int = 0 - n
    ret rat_fit(m, d)
}

fn rat_sub(x: $rat, y: $rat) -> $rat {
    ny: $rat = rat_neg(y)
    ret rat_add(x, ny)
}

; canonical operands keep the plain cross products in range:
; |num product| <= 2^62, den product < 2^64
fn rat_mul(x: $rat, y: $rat) -> $rat {
    if rat_is_nar(x) { ret rat_nar() }
    if rat_is_nar(y) { ret rat_nar() }
    a: int, b: uint = rat_parts(x)
    c: int, d: uint = rat_parts(y)
    n: int = a * c
    den: uint = b * d
    ret rat_fit(n, den)
}

; multiply by the reciprocal, sign moved to the numerator; done on
; 64-bit parts because the reciprocal itself may not fit $rat
fn rat_div(x: $rat, y: $rat) -> $rat {
    if rat_is_nar(x) { ret rat_nar() }
    if rat_is_nar(y) { ret rat_nar() }
    c: int, d: uint = rat_parts(y)
    if c == 0 { ret rat_nar() }
    a: int, b: uint = rat_parts(x)
    di: int = bitcast d
    cneg: u1 = c < 0
    rn: int, rdi: int = if cneg {
        nd: int = 0 - di
        nc: int = 0 - c
        yield nd, nc
    } else {
        yield di, c
    }
    n: int = a * rn
    rdu: uint = bitcast rdi
    den: uint = b * rdu
    ret rat_fit(n, den)
}

; a/b < c/d  <=>  a*d < c*b (dens positive); NaR compares false
fn rat_lt(x: $rat, y: $rat) -> u1 {
    if rat_is_nar(x) { ret 0 }
    if rat_is_nar(y) { ret 0 }
    a: int, b: uint = rat_parts(x)
    c: int, d: uint = rat_parts(y)
    bi: int = bitcast b
    di: int = bitcast d
    r: u1 = a * di < c * bi
    ret r
}

; canonical forms are unique, so equality is bit equality (minus NaR)
fn rat_eq(x: $rat, y: $rat) -> u1 {
    if rat_is_nar(x) { ret 0 }
    if rat_is_nar(y) { ret 0 }
    xb: uint = bitcast x
    yb: uint = bitcast y
    r: u1 = xb == yb
    ret r
}

; derived comparisons. NaR is false for le (like every ordered float
; comparison) and true for ne (the une convention); with NaR excluded
; the order is total, so le is lt with the operands swapped, negated
fn rat_le(x: $rat, y: $rat) -> u1 {
    if rat_is_nar(x) { ret 0 }
    if rat_is_nar(y) { ret 0 }
    if rat_lt(y, x) { ret 0 }
    ret 1
}

fn rat_ne(x: $rat, y: $rat) -> u1 {
    if rat_eq(x, y) { ret 0 }
    ret 1
}

; truncates toward zero; NaR -> 0
fn rat_to_int(x: $rat) -> int {
    if rat_is_nar(x) { ret 0 }
    n: int, d: uint = rat_parts(x)
    di: int = bitcast d
    r: int = n / di
    ret r
}

; NaR -> 0.0/0.0 = NaN, for free
fn rat_to_float(x: $rat) -> float {
    n: int, d: uint = rat_parts(x)
    nf: float = itof n
    df: float = itof d
    r: float = nf / df
    ret r
}
