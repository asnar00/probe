; the rational-number library: $rat plus its operations, all ordinary
; SSA - no compiler support. Canonical form: den > 0, gcd(|num|, den) = 1,
; sign in the numerator. den == 0 is NaR (not-a-rational): it propagates,
; and compares false (except ne). Exact-or-NaR semantics: results are
; reduced, and anything unrepresentable in i32/u32 becomes NaR rather
; than silently approximating. This file is linked in textually wherever
; @rat_* or $rat is used, and is the 'scalar -> rat' policy's runtime.

type $rat = { num: i32, den: u32 }

fn @rat_gcd(%a: u64, %b: u64) -> u64 {
    %g: u64 = loop(%x: u64 = %a, %y: u64 = %b) {
        if %y == 0 { break %x }
        %r: u64 = %x % %y
        continue %y, %r
    }
    ret %g
}

fn @rat_abs(%v: i64) -> u64 {
    %neg: u1 = %v < 0
    %a: i64 = if %neg {
        %m: i64 = 0 - %v
        yield %m
    } else {
        yield %v
    }
    %u: u64 = bitcast %a
    ret %u
}

fn @rat_nar() -> $rat {
    %n: i32 = 0
    %d: u32 = 0
    %r: $rat = pack %n, %d
    ret %r
}

fn @rat_is_nar(%a: $rat) -> u1 {
    %d: u32 = extract %a, den
    %r: u1 = %d == 0
    ret %r
}

; unpack to 64-bit working values (num sign-extended, den zero-extended)
fn @rat_parts(%a: $rat) -> (i64, u64) {
    %n32: i32 = extract %a, num
    %d32: u32 = extract %a, den
    %n: i64 = ext %n32
    %d: u64 = ext %d32
    ret %n, %d
}

; reduce and range-check a 64-bit num/den pair; den must be nonzero
fn @rat_fit(%n: i64, %d: u64) -> $rat {
    %a: u64 = call @rat_abs(%n)
    %anz: u1 = %a != 0
    ; gcd(0, d) = d, which normalizes 0/d to 0/1
    %g: u64 = if %anz {
        %g0: u64 = call @rat_gcd(%a, %d)
        yield %g0
    } else {
        yield %d
    }
    %ar: u64 = %a / %g
    %dr: u64 = %d / %g
    %neg: u1 = %n < 0
    ; range check: num in i32 (asymmetric by sign), den in u32
    %numlim: u64 = if %neg {
        %l1: u64 = 0x80000000
        yield %l1
    } else {
        %l2: u64 = 0x7fffffff
        yield %l2
    }
    if %ar > %numlim { ret call @rat_nar() }
    if %dr > 0xffffffff { ret call @rat_nar() }
    %ari: i64 = bitcast %ar
    %nsig: i64 = if %neg {
        %m: i64 = 0 - %ari
        yield %m
    } else {
        yield %ari
    }
    %n32: i32 = trunc %nsig
    %d32: u32 = trunc %dr
    %r: $rat = pack %n32, %d32
    ret %r
}

fn @rat_make(%n0: i64, %d0: i64) -> $rat {
    if %d0 == 0 { ret call @rat_nar() }
    %dneg: u1 = %d0 < 0
    %n: i64, %d: i64 = if %dneg {
        %nn: i64 = 0 - %n0
        %nd: i64 = 0 - %d0
        yield %nn, %nd
    } else {
        yield %n0, %d0
    }
    %du: u64 = bitcast %d
    ret call @rat_fit(%n, %du)
}

; a/b + c/d = (a*(d/g) + c*(b/g)) / ((b/g)*d), g = gcd(b, d); the
; pre-gcd keeps the cross products small, rat_fit finishes the reduction
fn @rat_add(%x: $rat, %y: $rat) -> $rat {
    if call @rat_is_nar(%x) { ret call @rat_nar() }
    if call @rat_is_nar(%y) { ret call @rat_nar() }
    %a: i64, %b: u64 = call @rat_parts(%x)
    %c: i64, %d: u64 = call @rat_parts(%y)
    %g: u64 = call @rat_gcd(%b, %d)
    %bg: u64 = %b / %g
    %dg: u64 = %d / %g
    %bgi: i64 = bitcast %bg
    %dgi: i64 = bitcast %dg
    %t: i64 = %a * %dgi + %c * %bgi
    %den: u64 = %bg * %d
    ret call @rat_fit(%t, %den)
}

fn @rat_neg(%x: $rat) -> $rat {
    if call @rat_is_nar(%x) { ret call @rat_nar() }
    %n: i64, %d: u64 = call @rat_parts(%x)
    %m: i64 = 0 - %n
    ret call @rat_fit(%m, %d)
}

fn @rat_sub(%x: $rat, %y: $rat) -> $rat {
    %ny: $rat = call @rat_neg(%y)
    ret call @rat_add(%x, %ny)
}

; canonical operands keep the plain cross products in range:
; |num product| <= 2^62, den product < 2^64
fn @rat_mul(%x: $rat, %y: $rat) -> $rat {
    if call @rat_is_nar(%x) { ret call @rat_nar() }
    if call @rat_is_nar(%y) { ret call @rat_nar() }
    %a: i64, %b: u64 = call @rat_parts(%x)
    %c: i64, %d: u64 = call @rat_parts(%y)
    %n: i64 = %a * %c
    %den: u64 = %b * %d
    ret call @rat_fit(%n, %den)
}

; multiply by the reciprocal, sign moved to the numerator; done on
; 64-bit parts because the reciprocal itself may not fit $rat
fn @rat_div(%x: $rat, %y: $rat) -> $rat {
    if call @rat_is_nar(%x) { ret call @rat_nar() }
    if call @rat_is_nar(%y) { ret call @rat_nar() }
    %c: i64, %d: u64 = call @rat_parts(%y)
    if %c == 0 { ret call @rat_nar() }
    %a: i64, %b: u64 = call @rat_parts(%x)
    %di: i64 = bitcast %d
    %cneg: u1 = %c < 0
    %rn: i64, %rdi: i64 = if %cneg {
        %nd: i64 = 0 - %di
        %nc: i64 = 0 - %c
        yield %nd, %nc
    } else {
        yield %di, %c
    }
    %n: i64 = %a * %rn
    %rdu: u64 = bitcast %rdi
    %den: u64 = %b * %rdu
    ret call @rat_fit(%n, %den)
}

; a/b < c/d  <=>  a*d < c*b (dens positive); NaR compares false
fn @rat_lt(%x: $rat, %y: $rat) -> u1 {
    if call @rat_is_nar(%x) { ret 0 }
    if call @rat_is_nar(%y) { ret 0 }
    %a: i64, %b: u64 = call @rat_parts(%x)
    %c: i64, %d: u64 = call @rat_parts(%y)
    %bi: i64 = bitcast %b
    %di: i64 = bitcast %d
    %r: u1 = %a * %di < %c * %bi
    ret %r
}

; canonical forms are unique, so equality is bit equality (minus NaR)
fn @rat_eq(%x: $rat, %y: $rat) -> u1 {
    if call @rat_is_nar(%x) { ret 0 }
    if call @rat_is_nar(%y) { ret 0 }
    %xb: u64 = bitcast %x
    %yb: u64 = bitcast %y
    %r: u1 = %xb == %yb
    ret %r
}

; derived comparisons. NaR is false for le (like every ordered float
; comparison) and true for ne (the une convention); with NaR excluded
; the order is total, so le is lt with the operands swapped, negated
fn @rat_le(%x: $rat, %y: $rat) -> u1 {
    if call @rat_is_nar(%x) { ret 0 }
    if call @rat_is_nar(%y) { ret 0 }
    if call @rat_lt(%y, %x) { ret 0 }
    ret 1
}

fn @rat_ne(%x: $rat, %y: $rat) -> u1 {
    if call @rat_eq(%x, %y) { ret 0 }
    ret 1
}

; truncates toward zero; NaR -> 0
fn @rat_to_int(%x: $rat) -> i64 {
    if call @rat_is_nar(%x) { ret 0 }
    %n: i64, %d: u64 = call @rat_parts(%x)
    %di: i64 = bitcast %d
    %r: i64 = %n / %di
    ret %r
}

; NaR -> 0.0/0.0 = NaN, for free
fn @rat_to_float(%x: $rat) -> float {
    %n: i64, %d: u64 = call @rat_parts(%x)
    %nf: float = itof %n
    %df: float = itof %d
    %r: float = %nf / %df
    ret %r
}
