; lib/reduce.ssa — the horizontals: what a vector's lanes come to
; together. `sum`, `min` and `max` of a vector of any number, and `all`
; and `any` of a mask (generics over `u(N)xn`, so that each lane count
; has its own) — written as operations, `s: i32 = sum v`, the vector's
; type choosing the instance. Each is a tree over the lanes — (l0 + l1)
; + (l2 + l3) — which is the order a pairwise instruction takes too
; (NEON faddp), and so the meaning a platform's rule is checked against;
; a machine whose instruction sums in another order, or takes NaN
; differently, has no rule and runs this body.


; --- 2 lanes ---
fn sum(v: numberx2) -> number {
    l0: number, l1: number = unpack v
    t0: number = add l0, l1
    ret t0
}
fn min(v: numberx2) -> number {
    l0: number, l1: number = unpack v
    t0: number = min l0, l1
    ret t0
}
fn max(v: numberx2) -> number {
    l0: number, l1: number = unpack v
    t0: number = max l0, l1
    ret t0
}
fn all(N)(v: u(N)x2) -> u(N) {
    l0: u(N), l1: u(N) = unpack v
    t0: u(N) = and l0, l1
    ret t0
}
fn any(N)(v: u(N)x2) -> u(N) {
    l0: u(N), l1: u(N) = unpack v
    t0: u(N) = or l0, l1
    ret t0
}

