    ret t0
}
fn max(W)(v: u(W)x2) -> u(W) {
    l0: u(W), l1: u(W) = unpack v
    t0: u(W) = max l0, l1
    ret t0
}
fn sum(E, M)(v: float(E, M)x2) -> float(E, M) {
    l0: float(E, M), l1: float(E, M) = unpack v
    t0: float(E, M) = add l0, l1
    ret t0
}
fn min(E, M)(v: float(E, M)x2) -> float(E, M) {
    l0: float(E, M), l1: float(E, M) = unpack v
