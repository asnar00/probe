    ret t0
}
fn max(E, M)(v: float(E, M)x2) -> float(E, M) {
    l0: float(E, M), l1: float(E, M) = unpack v
    t0: float(E, M) = max l0, l1
    ret t0
}
fn all(N)(v: u(N)x2) -> u(N) {
    l0: u(N), l1: u(N) = unpack v
    t0: u(N) = and l0, l1
    ret t0
}
