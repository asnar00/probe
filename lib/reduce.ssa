; lib/reduce.ssa — the horizontals: what a vector's lanes come to
; together. `sum(v)`, `min(v)`, `max(v)` over a vector of any lane type,
; and `all(m)`, `any(m)` over a mask (generics over `u(N)xn` so that
; each lane count has its own) — written as operations, `s: i32 = sum v`,
; the vector's type choosing the generic. Each is a tree
; over the lanes — (l0 + l1) + (l2 + l3) — which is the order a pairwise
; instruction takes too (NEON faddp), and so the meaning a platform's
; rule is checked against; a machine whose instruction sums in another
; order, or takes NaN differently, has no rule and runs this body.


; --- 2 lanes ---
fn sum(W)(v: i(W)x2) -> i(W) {
    l0: i(W), l1: i(W) = unpack v
    t0: i(W) = add l0, l1
    ret t0
}
fn min(W)(v: i(W)x2) -> i(W) {
    l0: i(W), l1: i(W) = unpack v
    t0: i(W) = min l0, l1
    ret t0
}
fn max(W)(v: i(W)x2) -> i(W) {
    l0: i(W), l1: i(W) = unpack v
    t0: i(W) = max l0, l1
    ret t0
}
fn sum(W)(v: u(W)x2) -> u(W) {
    l0: u(W), l1: u(W) = unpack v
    t0: u(W) = add l0, l1
    ret t0
}
fn min(W)(v: u(W)x2) -> u(W) {
    l0: u(W), l1: u(W) = unpack v
