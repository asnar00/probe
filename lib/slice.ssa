; --- buffers from a heap (lib/heap.ssa): the header and the elements
; in one region, given back by the header's own numbers ---
fn buffer_take(h: ptr, elem: i64, cap: i64) -> ptr {
    bytes: i64 = mul elem, cap
    total: i64 = add bytes, 16
    p: ptr = heap_take(h, total)
    buffer_init(p, elem, cap)
    ret p
}
fn buffer_give(h: ptr, p: ptr) {
    elem: i64 = load p
    cap: i64 = load p, 8
    bytes: i64 = mul elem, cap
    total: i64 = add bytes, 16
    heap_give(h, p, total)
    ret
}
