; --- reductions: sum from zero, min and max from the first element ---

fn sum(a: number[]) -> number {
    n: i64 = len a
    pa: ptr(number) = ptr a
    s: number = loop(i: i64 = 0, acc: number = 0) {
        done: u1 = cmp.ge i, n
        if done {
            break acc
        }
        x: number = load pa, i
        acc2: number = add acc, x
        i2: i64 = add i, 1
        continue i2, acc2
    }
    ret s
}

fn min(a: number[]) -> number {
    n: i64 = len a
    some: u1 = cmp.gt n, 0
    check some
    pa: ptr(number) = ptr a
    first: number = load pa, 0
    s: number = loop(i: i64 = 1, acc: number = first) {
        done: u1 = cmp.ge i, n
        if done {
            break acc
        }
        x: number = load pa, i
        acc2: number = min acc, x
        i2: i64 = add i, 1
        continue i2, acc2
    }
    ret s
}

fn max(a: number[]) -> number {
    n: i64 = len a
    some: u1 = cmp.gt n, 0
    check some
    pa: ptr(number) = ptr a
    first: number = load pa, 0
    s: number = loop(i: i64 = 1, acc: number = first) {
        done: u1 = cmp.ge i, n
        if done {
            break acc
        }
        x: number = load pa, i
        acc2: number = max acc, x
        i2: i64 = add i, 1
        continue i2, acc2
    }
    ret s
}
