        partial: u1 = cmp.lt m, k
        if partial {
            break i
        }
        store ks, vc, ci
        i2: i64 = add i, k
        ci2: i64 = add ci, 1
        continue i2, ci2
    }
    loop(j: i64 = stop) {
        done: u1 = cmp.ge j, n
        if done {
            break
        }
        ixc: i64 = mul j, stc
        store s, pc, ixc
        j2: i64 = add j, 1
        continue j2
    }
    ret
}

