; lib/slice.ssa — operations on slices. A slice `T[]` is a view into a
; buffer: its data (a typed pointer) and its length; a buffer is memory
; with a header — the element size and the capacity, a word each — then
; the elements (`data buf: buffer(f32, 1024)`; `buffer_init` for one
; carved at run time). `slice p` takes the whole buffer, checking the
; element size; `view a, off, n` a part, checked to lie within; `len`,
; `ptr` read the two words. An operation on slices is written like a
; store — `add c, a, b`, `mul c, a, 2.0`, `neg c, a`, `fill c, 0`,
; `copy c, a` — and writes into its first operand; a reduction —
; `s: f32 = sum a` — gives a scalar.
;
; Each body takes the elements a chunk at a time — `chunk(number)`: as
; many lanes as this platform's vector register holds, one where it has
; none — while a whole chunk is left (`fit`), then one at a time to the
; end. On a platform without vector registers a chunk is one element
; and the first loop is the definition; with them the chunk loop is
; the vector instructions, checked against it by the other paths.





fn buffer_init(p: ptr, elem: i64, cap: i64) {
    store elem, p
    store cap, p, 8
    ret
}


; --- add ---

fn add(c: number[], a: number[], b: number[]) {
    n: i64 = len c
    n1: i64 = len a
    ok1: u1 = cmp.eq n, n1
    check ok1
    n2: i64 = len b
    ok2: u1 = cmp.eq n, n2
    check ok2
    pc: ptr(number) = ptr c
    vc: ptr(chunk(number)) = cast pc
    pa: ptr(number) = ptr a
    va: ptr(chunk(number)) = cast pa
    pb: ptr(number) = ptr b
    vb: ptr(chunk(number)) = cast pb
    k: i64 = lanes chunk(number)
    stop: i64 = loop(i: i64 = 0, ci: i64 = 0) {
        left: i64 = sub n, i
        m: i64 = fit number, left
        partial: u1 = cmp.lt m, k
        if partial {
            break i
        }
        x: chunk(number) = load va, ci
        y: chunk(number) = load vb, ci
        z: chunk(number) = add x, y
        store z, vc, ci
        i2: i64 = add i, k
        ci2: i64 = add ci, 1
        continue i2, ci2
    }
    loop(j: i64 = stop) {
        done: u1 = cmp.ge j, n
        if done {
            break
        }
        xt: number = load pa, j
        yt: number = load pb, j
        zt: number = add xt, yt
        store zt, pc, j
        j2: i64 = add j, 1
        continue j2
    }
    ret
}

