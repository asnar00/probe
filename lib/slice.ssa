; lib/slice.ssa — operations on slices. A slice `T[]` is a view into a
; buffer: its data (a typed pointer) and its length; a buffer is memory
; with a header — the element size and the capacity, a word each — then
; the elements (`data buf: buffer(f32, 1024)`; `buffer_init` for one
; carved at run time). `slice p` takes the whole buffer, checking the
; element size; `view a, off, n` a part, checked to lie within; `len`,
; `ptr` read the two words. An operation on slices is written like a
; store — `add c, a, b`, `mul c, a, 2.0`, `neg c, a`, `fill c, 0`,
; `copy c, a` — and writes into its first operand; a reduction —
; `s: f32 = sum a` — gives a scalar. A view carries its shape: a count
; and a stride per axis (`f32[]` rank 1, `f32[,]` rank 2, `f32[,,]`
; rank 3), so `at a, i` is a row, `transpose a` a free view whose rows
; are the columns, `block` a rectangle, `view` a part of a row; an
; operation of rank 2 or 3 is the rank below it over each row, and a
; reduction into a view one rank down — `sum c, a` — is one per row.
;
; Each body takes the elements a chunk at a time — `chunk(number)`: as
; many lanes as this platform's vector register holds, one where it has
; none — while a whole chunk is left (`fit`), then one at a time to the
; end. On a platform without vector registers a chunk is one element
; and the first loop is the definition; with them the chunk loop is
; the vector instructions, checked against it by the other paths.







fn buffer_init(p: ptr, elem: i64, cap: i64) {
    store elem, p
    store cap, p, 8
    ret
}


; --- add ---

fn add(c: number[], a: number[], b: number[]) {
    n: i64 = len c
    n1: i64 = len a
    ok1: u1 = cmp.eq n, n1
    check ok1
    n2: i64 = len b
    ok2: u1 = cmp.eq n, n2
    check ok2
    pc: ptr(number) = ptr c
    vc: ptr(chunk(number)) = cast pc
    stc: i64 = stride c
    pa: ptr(number) = ptr a
    va: ptr(chunk(number)) = cast pa
    sta: i64 = stride a
    pb: ptr(number) = ptr b
    vb: ptr(chunk(number)) = cast pb
    stb: i64 = stride b
    cc: u1 = cmp.eq stc, 1
    ca: u1 = cmp.eq sta, 1
    cb: u1 = cmp.eq stb, 1
    cc1: u1 = and cc, ca
    cc2: u1 = and cc1, cb
    contig: u1 = cast cc2
    limit: i64 = if contig {
        yield n
    } else {
        yield 0
    }
    k: i64 = lanes chunk(number)
    stop: i64 = loop(i: i64 = 0, ci: i64 = 0) {
        left: i64 = sub limit, i
        m: i64 = fit number, left
        partial: u1 = cmp.lt m, k
        if partial {
            break i
        }
        x: chunk(number) = load va, ci
        y: chunk(number) = load vb, ci
        z: chunk(number) = add x, y
        store z, vc, ci
        i2: i64 = add i, k
        ci2: i64 = add ci, 1
        continue i2, ci2
    }
    loop(j: i64 = stop) {
        done: u1 = cmp.ge j, n
        if done {
            break
        }
        ixc: i64 = mul j, stc
        ixa: i64 = mul j, sta
        ixb: i64 = mul j, stb
        xt: number = load pa, ixa
        yt: number = load pb, ixb
        zt: number = add xt, yt
        store zt, pc, ixc
        j2: i64 = add j, 1
        continue j2
    }
    ret
}

fn add(c: number[,], a: number[,], b: number[,]) {
    n0: i64 = shape c, 0
    m1: i64 = shape a, 0
    ok1: u1 = cmp.eq n0, m1
    check ok1
    m2: i64 = shape b, 0
    ok2: u1 = cmp.eq n0, m2
    check ok2
    loop(i: i64 = 0) {
        done: u1 = cmp.ge i, n0
        if done {
            break
        }
        rc: number[] = at c, i
        ra: number[] = at a, i
        rb: number[] = at b, i
        add rc, ra, rb
        i2: i64 = add i, 1
        continue i2
    }
    ret
}

