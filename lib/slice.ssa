; --- reductions to a scalar: a chunk of partial results while the view is
; contiguous, then its lanes, then the rest one at a time; min and max
; from the first element; a view of rank 2 or 3 row by row ---

fn sum(a: number[]) -> number {
    n: i64 = len a
    zero: chunk(number) = splat 0
    pa: ptr(number) = ptr a
    va: ptr(chunk(number)) = cast pa
    sta: i64 = stride a
    ca: u1 = cmp.eq sta, 1
    contig: u1 = cast ca
    limit: i64 = if contig {
        yield n
    } else {
        yield 0
    }
    k: i64 = lanes chunk(number)
    stop: i64, total: chunk(number) = loop(i: i64 = 0, ci: i64 = 0, acc: chunk(number) = zero) {
        left: i64 = sub limit, i
        m: i64 = fit number, left
        partial: u1 = cmp.lt m, k
        if partial {
            break i, acc
        }
        x: chunk(number) = load va, ci
        acc2: chunk(number) = add acc, x
        i2: i64 = add i, k
        ci2: i64 = add ci, 1
        continue i2, ci2, acc2
    }
    s0: number = sum total
    s: number = loop(j: i64 = stop, t: number = s0) {
        done: u1 = cmp.ge j, n
        if done {
            break t
        }
        ixa: i64 = mul j, sta
        xt: number = load pa, ixa
        t2: number = add t, xt
        j2: i64 = add j, 1
        continue j2, t2
    }
    ret s
}

fn min(a: number[]) -> number {
    n: i64 = len a
    some: u1 = cmp.gt n, 0
