; --- reductions: a chunk of partial results, then its lanes, then the
; tail; min and max from the first element ---

fn sum(a: number[]) -> number {
    n: i64 = len a
    zero: chunk(number) = splat 0
    pa: ptr(number) = ptr a
    va: ptr(chunk(number)) = cast pa
    k: i64 = lanes chunk(number)
    stop: i64, total: chunk(number) = loop(i: i64 = 0, ci: i64 = 0, acc: chunk(number) = zero) {
        left: i64 = sub n, i
        m: i64 = fit number, left
        partial: u1 = cmp.lt m, k
        if partial {
            break i, acc
        }
        x: chunk(number) = load va, ci
        acc2: chunk(number) = add acc, x
        i2: i64 = add i, k
        ci2: i64 = add ci, 1
        continue i2, ci2, acc2
    }
    s0: number = sum total
    s: number = loop(j: i64 = stop, t: number = s0) {
        done: u1 = cmp.ge j, n
        if done {
            break t
        }
        xt: number = load pa, j
        t2: number = add t, xt
        j2: i64 = add j, 1
        continue j2, t2
    }
    ret s
}

fn min(a: number[]) -> number {
    n: i64 = len a
    some: u1 = cmp.gt n, 0
    check some
    pfirst: ptr(number) = ptr a
    first: number = load pfirst, 0
    seed: chunk(number) = splat first
    pa: ptr(number) = ptr a
    va: ptr(chunk(number)) = cast pa
    k: i64 = lanes chunk(number)
    stop: i64, total: chunk(number) = loop(i: i64 = 0, ci: i64 = 0, acc: chunk(number) = seed) {
        left: i64 = sub n, i
        m: i64 = fit number, left
        partial: u1 = cmp.lt m, k
        if partial {
            break i, acc
        }
        x: chunk(number) = load va, ci
        acc2: chunk(number) = min acc, x
        i2: i64 = add i, k
        ci2: i64 = add ci, 1
        continue i2, ci2, acc2
    }
    s0: number = min total
    s: number = loop(j: i64 = stop, t: number = s0) {
        done: u1 = cmp.ge j, n
        if done {
            break t
        }
        xt: number = load pa, j
        t2: number = min t, xt
        j2: i64 = add j, 1
        continue j2, t2
    }
    ret s
}

fn max(a: number[]) -> number {
    n: i64 = len a
    some: u1 = cmp.gt n, 0
    check some
    pfirst: ptr(number) = ptr a
    first: number = load pfirst, 0
    seed: chunk(number) = splat first
    pa: ptr(number) = ptr a
    va: ptr(chunk(number)) = cast pa
    k: i64 = lanes chunk(number)
    stop: i64, total: chunk(number) = loop(i: i64 = 0, ci: i64 = 0, acc: chunk(number) = seed) {
        left: i64 = sub n, i
        m: i64 = fit number, left
        partial: u1 = cmp.lt m, k
        if partial {
            break i, acc
        }
        x: chunk(number) = load va, ci
        acc2: chunk(number) = max acc, x
        i2: i64 = add i, k
        ci2: i64 = add ci, 1
        continue i2, ci2, acc2
    }
    s0: number = max total
    s: number = loop(j: i64 = stop, t: number = s0) {
        done: u1 = cmp.ge j, n
        if done {
            break t
        }
        xt: number = load pa, j
        t2: number = max t, xt
        j2: i64 = add j, 1
        continue j2, t2
    }
    ret s
}
