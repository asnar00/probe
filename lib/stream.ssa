; lib/stream.ssa — streams: values over time. A stream `T$` is a
; reader's view of a ring of T: the ring, the position this reader has
; read to, a sampling rule and an edge rule. The ring is the producer's:
; its header holds how many items have been pushed and where the
; resident ones start, the values buffer, and the ring's clock — a rate
; in hz, and for a regular ring the step in ticks between items and the
; tick of the first; an irregular ring has a buffer of a tick per item
; instead. Several streams may view one ring, each with its own
; position and rules — a stream is to a ring what a slice is to a buffer.
;
; Time inside a ring is integer ticks of its clock: what the machine's
; counter and a device's sample index are. `time` — exact seconds — is
; the boundary type: a tick becomes a time by dividing by the rate
; (`time_at`), a time becomes ticks by multiplying (`sample`, `window`),
; once per call and never per item; and two rings on different clocks
; meet by one such conversion at the point they meet. So a producer's
; push and a reader's frame do integer work only.
;
; The resident items stay contiguous: the buffers are twice the
; capacity, and when they fill the newer half slides down over the
; older, so at least the last cap/2 items are always a view. A reader
; that falls further behind than that fails a check (its items are
; gone); a sample before the first resident item fails a check unless
; the stream's edge rule is clamp (1), which gives the first.
;
; Rules: nearest (0) takes the item whose tick is nearest t; hold (1)
; takes the last item at or before t — a sample-and-hold; linear (2)
; weighs the two items around t, exactly in rational arithmetic, and
; rounds once into the element's type. Producers `push s, tick, v` on an
; irregular ring (ticks non-decreasing, checked) and `push s, v` or
; `push s, block` on a regular one; consumers take a `frame` (everything
; since they last looked, as a view, with the index of its first item,
; and the stream advanced), `count`, `latest`, `peek` and `advance`,
; `behind` and `last` for history, `sample s, t`, or a
; `window s, t1, t2` of the items with t1 <= t < t2.

; --- the ring: [pushed, base, values, ticks, hz, step, t0] ---
; an irregular ring: a tick per item, from a clock at hz
fn ring_init(r: ptr, vb: ptr, tb: ptr, hz: i64) {
    store 0: i64, r
    store 0: i64, r, 8
    store vb, r, 16
    store tb, r, 24
    store hz, r, 32
    store 0: i64, r, 40
    store 0: i64, r, 48
    ret
}
; a regular ring: item k at tick t0 + k * step, no ticks stored
fn ring_regular(r: ptr, vb: ptr, hz: i64, step: i64, t0: i64) {
    positive: u1 = cmp.gt step, 0
    check positive
    store 0: i64, r
    store 0: i64, r, 8
    store vb, r, 16
    none: ptr = const 0
    store none, r, 24
    store hz, r, 32
    store step, r, 40
    store t0, r, 48
    ret
}

; a stream over a ring: at its start, nearest, failing at the edges
fn stream(r: ptr) -> number$ {
    s: number$ = pack r, 0, 0, 0
    ret s
}
fn sampling(s: number$, rule: i64) -> number$ {
    s2: number$ = set s, rule, rule
    ret s2
}
fn edges(s: number$, edge: i64) -> number$ {
    s2: number$ = set s, edge, edge
    ret s2
}

; the ring's values and ticks as whole views
fn ring_values(r: ptr) -> number[] {
    vb: ptr = load r, 16
    v: number[] = slice vb
    ret v
}
fn ring_ticks(r: ptr) -> i64[] {
    tb: ptr = load r, 24
    t: i64[] = slice tb
    ret t
}
; the stream's clock, in hz
fn clock(s: number$) -> i64 {
    r: ptr = get s, ring
    hz: i64 = load r, 32
    ret hz
}
; the tick of the k-th item ever pushed: by arithmetic on a regular
; ring, from the ticks buffer (the item must be resident) on an
; irregular one
fn tick_of(s: number$, k: i64) -> i64 {
    r: ptr = get s, ring
    step: i64 = load r, 40
    regular: u1 = cmp.gt step, 0
    t: i64 = if regular {
        t0: i64 = load r, 48
        d: i64 = mul k, step
        tr: i64 = add t0, d
        yield tr
    } else {
        base: i64 = load r, 8
        pushed: i64 = load r
        resident: u1 = cmp.ge k, base
        check resident
        inside: u1 = cmp.lt k, pushed
        check inside
        ticks: i64[] = ring_ticks(r)
        i: i64 = sub k, base
        ti: i64 = load ticks, i
        yield ti
    }
    ret t
}

; --- the boundary: ticks to seconds and back ---
fn time_at(s: number$, k: i64) -> time {
    t: i64 = tick_of(s, k)
    hz: i64 = clock(s)
    ts: time = seconds(t)
    p: time = period(hz)
    r: time = mul ts, p
    ret r
}
; a time in ticks of the stream's clock, fraction kept
fn ticks(s: number$, t: time) -> time {
    hz: i64 = clock(s)
    h: time = seconds(hz)
    x: time = mul t, h
    ret x
}
; the first whole tick at or after x (x >= 0)
fn ceil_tick(x: time) -> i64 {
    q: i64 = conv x
    qr: time = conv q
    more: u1 = cmp.gt x, qr
    m: i64 = conv more
    c: i64 = add q, m
    ret c
}

; --- the producer's side ---
; room for one more: the newer half slid down when the ring is full;
; the slot for the item
fn ring_slot(s: number$) -> i64 {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    vals: number[] = ring_values(r)
    cap: i64 = len vals
    held: i64 = sub pushed, base
    full: u1 = cmp.eq held, cap
    base2: i64 = if full {
        half: i64 = div cap, 2
        hi: number[] = view vals, half, half
        lo: number[] = view vals, 0, half
        copy lo, hi
        tb: ptr = load r, 24
        has_ticks: u1 = cmp.ne tb, 0
        if has_ticks {
            ticks: i64[] = ring_ticks(r)
            thi: i64[] = view ticks, half, half
            tlo: i64[] = view ticks, 0, half
            copy tlo, thi
        }
        b: i64 = add base, half
        store b, r, 8
        yield b
    } else {
        yield base
    }
    slot: i64 = sub pushed, base2
    ret slot
}
; an irregular ring's producer: an item at a tick, ticks never going back
fn push(s: number$, tick: i64, v: number) {
    r: ptr = get s, ring
    step: i64 = load r, 40
    irregular: u1 = cmp.eq step, 0
    check irregular
    slot: i64 = ring_slot(s)
    ticks: i64[] = ring_ticks(r)
    some: u1 = cmp.gt slot, 0
    if some {
        prev: i64 = sub slot, 1
        pt: i64 = load ticks, prev
        ordered: u1 = cmp.ge tick, pt
        check ordered
    }
    vals: number[] = ring_values(r)
    store v, vals, slot
    store tick, ticks, slot
    pushed: i64 = load r
    next: i64 = add pushed, 1
    store next, r
    ret
}
; a regular ring's producer: the next sample
fn push(s: number$, v: number) {
    r: ptr = get s, ring
    step: i64 = load r, 40
    regular: u1 = cmp.gt step, 0
    check regular
    slot: i64 = ring_slot(s)
    vals: number[] = ring_values(r)
    store v, vals, slot
    pushed: i64 = load r
    next: i64 = add pushed, 1
    store next, r
    ret
}
; ... a block at a time
fn push(s: number$, block: number[]) {
    n: i64 = len block
    loop(i: i64 = 0) {
        done: u1 = cmp.ge i, n
        if done {
            break
        }
        v: number = load block, i
        push(s, v)
        i2: i64 = add i, 1
        continue i2
    }
    ret
}

; --- the consumer's side ---
fn count(s: number$) -> i64 {
    r: ptr = get s, ring
    pushed: i64 = load r
    pos: i64 = get s, pos
    n: i64 = sub pushed, pos
    ret n
}
; everything since this reader last looked: the values, the index of
; the first (its tick is `tick_of`, its time `time_at`), and the
; stream moved on
fn frame(s: number$) -> (number[], i64, number$) {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    pos: i64 = get s, pos
    resident: u1 = cmp.ge pos, base
    check resident
    vals: number[] = ring_values(r)
    start: i64 = sub pos, base
    n: i64 = sub pushed, pos
    f: number[] = view vals, start, n
    s2: number$ = set s, pos, pushed
    ret f, pos, s2
}
fn latest(s: number$) -> number {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    some: u1 = cmp.gt pushed, base
    check some
    vals: number[] = ring_values(r)
    last: i64 = sub pushed, base
    i: i64 = sub last, 1
    v: number = load vals, i
    ret v
}
; the i-th unread item, the reader not moved; and the reader moved on n
fn peek(s: number$, i: i64) -> number {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    pos: i64 = get s, pos
    resident: u1 = cmp.ge pos, base
    check resident
    at: i64 = add pos, i
    inside: u1 = cmp.lt at, pushed
    check inside
    vals: number[] = ring_values(r)
    k: i64 = sub at, base
    v: number = load vals, k
    ret v
}
fn advance(s: number$, n: i64) -> number$ {
    r: ptr = get s, ring
    pushed: i64 = load r
    pos: i64 = get s, pos
    pos2: i64 = add pos, n
    inside: u1 = cmp.le pos2, pushed
    check inside
    s2: number$ = set s, pos, pos2
    ret s2
}
; the k items before this reader's position — fewer at the start of
; the stream: the history a filter reads behind its frame
fn behind(s: number$, k: i64) -> number[] {
    r: ptr = get s, ring
    base: i64 = load r, 8
    pos: i64 = get s, pos
    resident: u1 = cmp.ge pos, base
    check resident
    have: i64 = sub pos, base
    n: i64 = min(k, have)
    vals: number[] = ring_values(r)
    start: i64 = sub pos, n
    from: i64 = sub start, base
    h: number[] = view vals, from, n
    ret h
}
; the last k items pushed — fewer when there are not k yet: the
; history a producer reads behind its own output
fn last(s: number$, k: i64) -> number[] {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    have: i64 = sub pushed, base
    n: i64 = min(k, have)
    vals: number[] = ring_values(r)
    from: i64 = sub have, n
    h: number[] = view vals, from, n
    ret h
}
; the k-th item from the end of a history, or 0 before the beginning
fn tail(h: number[], k: i64) -> number {
    n: i64 = len h
    short: u1 = cmp.lt n, k
    v: number = if short {
        yield 0
    } else {
        i: i64 = sub n, k
        x: number = load h, i
        yield x
    }
    ret v
}

; --- sampling by time ---
; the index (from base) of the last resident item at or before a tick,
; or -1 when the tick is before them all: by arithmetic on a regular
; ring, by binary search over the ticks (sorted by construction) otherwise
fn before(s: number$, tick: i64) -> i64 {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    n: i64 = sub pushed, base
    step: i64 = load r, 40
    regular: u1 = cmp.gt step, 0
    found: i64 = if regular {
        t0: i64 = load r, 48
        early: u1 = cmp.lt tick, t0
        k: i64 = if early {
            yield -1
        } else {
            rel: i64 = sub tick, t0
            q: i64 = div rel, step
            ki: i64 = sub q, base
            last: i64 = sub n, 1
            beyond: u1 = cmp.gt ki, last
            kc: i64 = if beyond {
                yield last
            } else {
                yield ki
            }
            gone: u1 = cmp.lt kc, -1
            kd: i64 = if gone {
                yield -1
            } else {
                yield kc
            }
            yield kd
        }
        yield k
    } else {
        ticks: i64[] = ring_ticks(r)
        at: i64 = loop(lo: i64 = 0, hi: i64 = n, best: i64 = -1) {
            done: u1 = cmp.ge lo, hi
            if done {
                break best
            }
            span: i64 = sub hi, lo
            half: i64 = div span, 2
            mid: i64 = add lo, half
            tm: i64 = load ticks, mid
            past: u1 = cmp.gt tm, tick
            if past {
                continue lo, mid, best
            }
            mid1: i64 = add mid, 1
            continue mid1, hi, mid
        }
        yield at
    }
    ret found
}
; a + (b - a) * w, exactly, rounded once into the element's type
fn lerp(a: number, b: number, w: time) -> number {
    down: u1 = cmp.lt b, a
    r: number = if down {
        d: number = sub a, b
        dr: time = conv d
        pr: time = mul dr, w
        p: number = conv pr
        v: number = sub a, p
        yield v
    } else {
        d2: number = sub b, a
        dr2: time = conv d2
        pr2: time = mul dr2, w
        p2: number = conv pr2
        v2: number = add a, p2
        yield v2
    }
    ret r
}
; the value at t, by the stream's rule: the time becomes ticks once,
; the item is found in integers, and only a weight is rational
fn sample(s: number$, t: time) -> number {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    n: i64 = sub pushed, base
    some: u1 = cmp.gt n, 0
    check some
    vals: number[] = ring_values(r)
    x: time = ticks(s, t)
    tick: i64 = conv x
    lo: i64 = before(s, tick)
    early: u1 = cmp.lt lo, 0
    v: number = if early {
        edge: i64 = get s, edge
        clamp: u1 = cmp.eq edge, 1
        check clamp
        first: number = load vals, 0
        yield first
    } else {
        rule: i64 = get s, rule
        hi: i64 = add lo, 1
        has_hi: u1 = cmp.lt hi, n
        vl: number = load vals, lo
        y: number = if has_hi {
            kl: i64 = add base, lo
            kh: i64 = add base, hi
            tl: i64 = tick_of(s, kl)
            th: i64 = tick_of(s, kh)
            vh: number = load vals, hi
            tlr: time = seconds(tl)
            thr: time = seconds(th)
            dl: time = sub x, tlr
            dh: time = sub thr, x
            nearest: u1 = cmp.eq rule, 0
            linear: u1 = cmp.eq rule, 2
            z: number = if nearest {
                closer: u1 = cmp.lt dh, dl
                z1: number = if closer {
                    yield vh
                } else {
                    yield vl
                }
                yield z1
            } else {
                z2: number = if linear {
                    span: time = sub thr, tlr
                    w: time = div dl, span
                    m: number = lerp(vl, vh, w)
                    yield m
                } else {
                    yield vl
                }
                yield z2
            }
            yield z
        } else {
            yield vl
        }
        yield y
    }
    ret v
}
; the items with t1 <= t < t2, as a view: the times become whole
; ticks once, then the ticks are compared
fn window(s: number$, t1: time, t2: time) -> number[] {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    n: i64 = sub pushed, base
    vals: number[] = ring_values(r)
    x1: time = ticks(s, t1)
    x2: time = ticks(s, t2)
    c1: i64 = ceil_tick(x1)
    c2: i64 = ceil_tick(x2)
    first: i64 = loop(i: i64 = 0) {
        done: u1 = cmp.ge i, n
        if done {
            break i
        }
        ki: i64 = add base, i
        ti: i64 = tick_of(s, ki)
        inside: u1 = cmp.ge ti, c1
        if inside {
            break i
        }
        i2: i64 = add i, 1
        continue i2
    }
    end: i64 = loop(j: i64 = first) {
        done2: u1 = cmp.ge j, n
        if done2 {
            break j
        }
        kj: i64 = add base, j
        tj: i64 = tick_of(s, kj)
        past: u1 = cmp.ge tj, c2
        if past {
            break j
        }
        j2: i64 = add j, 1
        continue j2
    }
    m: i64 = sub end, first
    w: number[] = view vals, first, m
    ret w
}
