; lib/stream.ssa — streams: values over time. A stream `T$` is a
; reader's view of a ring of T: the ring, the position this reader has
; read to, a sampling rule and an edge rule. The ring is the producer's:
; its header holds how many items have been pushed, the values buffer,
; and the ring's clock — a rate
; in hz, and for a regular ring the step in ticks between items and the
; tick of the first; an irregular ring has a buffer of a tick per item
; instead. Several streams may view one ring, each with its own
; position and rules — a stream is to a ring what a slice is to a buffer.
;
; Time inside a ring is integer ticks of its clock: what the machine's
; counter and a device's sample index are. `time` — exact seconds — is
; the boundary type: a tick becomes a time by dividing by the rate
; (`time_at`), a time becomes ticks by multiplying (`sample`, `window`),
; once per call and never per item; and two rings on different clocks
; meet by one such conversion at the point they meet. So a producer's
; push and a reader's frame do integer work only.
;
; A place is not a time. How many items have been pushed, a reader's
; position, a capacity, the index of the item in a slot, an index
; handed to `peek` and a count handed to `advance` are `index`, as
; wide as the policy says memory is (fm3 log 121); a tick, a rate, a
; step and `t0` are `i64` on every machine, and so are the `ended`
; word and a reader's two rules, which count nothing. Where one
; becomes the other — item k of a regular ring is at `t0 + k·step`,
; and a tick divided by the step is an item — there is one `conv`.
; The header is eight words of eight bytes whatever the width: a word
; that holds an index holds it in its low bytes, read and written at
; the width of `index`, and nothing reads the rest.
;
; A ring is not the only storage. A stream is a **queue** unless a
; history word or a time word names it (question 47): a queue holds an
; item only until its reader has passed it, so its slots come back and
; its capacity bounds what is unread rather than what is written. It
; shares this header and this reader's view, but not the ring's
; arithmetic: a queue is a plain run of slots with the index of the
; first one in its header, so a push is a store and a count, a block
; lands in one copy, and a reader that has passed everything gives
; every slot back at once. The ring is what keeps history, and the
; rest of this note is the ring's.
;
; The resident items stay contiguous and nothing ever slides: the
; buffers are twice the capacity and each item is stored in both halves,
; item k at slot k mod half and again half further on, so the last half
; items are always one view wherever the seam falls, and a push is two
; stores and a count. Where the resident items start is not stored: it
; is `pushed - half` once the ring has filled and 0 before, which a
; reader that has both in hand computes in two (`ring_base`, log 86). A reader that falls further behind than that
; fails a check (its items are gone); a sample before the first
; resident item fails a check unless the stream's edge rule is clamp
; (1), which gives the first.
;
; Rules: nearest (0) takes the item whose tick is nearest t; hold (1)
; takes the last item at or before t — a sample-and-hold; linear (2)
; weighs the two items around t, exactly in rational arithmetic, and
; rounds once into the element's type. Producers `push s, tick, v` on an
; irregular ring (ticks non-decreasing, checked) and `push s, v` or
; `push s, block` on a regular one; consumers take a `frame` (everything
; since they last looked, as a view, with the index of its first item,
; and the stream advanced), `count`, `latest`, `peek` and `advance`,
; `behind` and `last` for history, `sample s, t`, or a
; `window s, t1, t2` of the items with t1 <= t < t2.

; --- the ring: [pushed, (spare), values, ticks, hz, step, t0, ended] ---
; an irregular ring: a tick per item, from a clock at hz
fn ring_init(r: ptr, vb: ptr, tb: ptr, hz: i64)
    store 0: index, r
    store 0: index, r, 8
    store vb, r, 16
    store tb, r, 24
    store hz, r, 32
    store 0: i64, r, 40
    store 0: i64, r, 48
    store 0: i64, r, 56
    ret
; a regular ring: item k at tick t0 + k * step, no ticks stored
fn ring_regular(r: ptr, vb: ptr, hz: i64, step: i64, t0: i64)
    positive: u1 = cmp.gt step, 0
    check positive
    store 0: index, r
    store 0: index, r, 8
    store vb, r, 16
    none: ptr = const 0
    store none, r, 24
    store hz, r, 32
    store step, r, 40
    store t0, r, 48
    store 0: i64, r, 56
    ret

; the producer closes the ring: nothing more will come, and a push
; after it fails a check; every reader can see it
fn end(s: any$)
    r: ptr = get s, ring
    store 1: i64, r, 56
    ret
fn ended(s: any$) -> u1
    r: ptr = get s, ring
    e: i64 = load r, 56
    closed: u1 = cmp.ne e, 0
    ret closed
fn open(s: any$)
    r: ptr = get s, ring
    e: i64 = load r, 56
    still: u1 = cmp.eq e, 0
    check still
    ret

; a stream over a ring: at its start, nearest, failing at the edges
fn stream(r: ptr) -> any$
    s: any$ = pack r, 0, 0, 0
    ret s
fn sampling(s: any$, rule: i64) -> any$
    s2: any$ = set s, rule, rule
    ret s2
fn edges(s: any$, edge: i64) -> any$
    s2: any$ = set s, edge, edge
    ret s2

; the ring's values and ticks as whole views
fn ring_values(r: ptr) -> any[]
    vb: ptr = load r, 16
    v: any[] = slice vb
    ret v
fn ring_ticks(r: ptr) -> i64[]
    tb: ptr = load r, 24
    t: i64[] = slice tb
    ret t
; the stream's clock, in hz
fn clock(s: any$) -> i64
    r: ptr = get s, ring
    hz: i64 = load r, 32
    ret hz
; the tick of the k-th item ever pushed: by arithmetic on a regular
; ring, from the ticks buffer (the item must be resident) on an
; irregular one
fn tick_of(s: any$, k: index) -> i64
    r: ptr = get s, ring
    step: i64 = load r, 40
    regular: u1 = cmp.gt step, 0
    t: i64 = if regular
        t0: i64 = load r, 48
        kt: i64 = conv k
        d: i64 = mul kt, step
        tr: i64 = add t0, d
        yield tr
    else
        base: index = ring_base(r)
        pushed: index = load r
        resident: u1 = cmp.ge k, base
        check resident
        inside: u1 = cmp.lt k, pushed
        check inside
        ticks: i64[] = ring_ticks(r)
        i: index = ring_index(s, k)
        ti: i64 = load ticks, i
        yield ti
    ret t

; --- the boundary: ticks to seconds and back ---
fn time_at(s: any$, k: index) -> time
    t: i64 = tick_of(s, k)
    hz: i64 = clock(s)
    ts: time = seconds(t)
    p: time = period(hz)
    r: time = mul ts, p
    ret r
; a time in ticks of the stream's clock, fraction kept
fn ticks(s: any$, t: time) -> time
    hz: i64 = clock(s)
    h: time = seconds(hz)
    x: time = mul t, h
    ret x
; the first whole tick at or after x (x >= 0)
fn ceil_tick(x: time) -> i64
    q: i64 = conv x
    qr: time = conv q
    more: u1 = cmp.gt x, qr
    m: i64 = conv more
    c: i64 = add q, m
    ret c

; --- the producer's side ---
; where the resident items start (log 86): the push no longer stores
; it, since it is `pushed - half` whenever the ring has filled, and a
; reader that has `pushed` and `half` in hand computes it in two
fn ring_base(r: ptr) -> index
    pushed: index = load r
    vb: ptr = load r, 16
    cap: index = load vb, 8
    half: index = div cap, 2
    over: index = sub pushed, half
    b: index = max(over, 0: index)
    ret b
; the slot of item k: the buffer holds twice the resident count, and
; an item sits in both halves, so any half consecutive items are one view
fn ring_index(s: any$, k: index) -> index
    r: ptr = get s, ring
    vb: ptr = load r, 16
    cap: index = load vb, 8
    half: index = div cap, 2
    i: index = rem k, half
    ret i
; an irregular ring's producer: an item at a tick, ticks never going
; back. A push stores through a pointer to the buffer's elements: its
; slot is under half by construction, so the view's checks would prove
; nothing; then the count, and where the resident items start
fn push(s: any$, tick: i64, v: any)
    r: ptr = get s, ring
    e: i64 = load r, 56
    still: u1 = cmp.eq e, 0
    check still
    step: i64 = load r, 40
    irregular: u1 = cmp.eq step, 0
    check irregular
    pushed: index = load r
    vb: ptr = load r, 16
    cap: index = load vb, 8
    half: index = div cap, 2
    slot: index = rem pushed, half
    twin: index = add slot, half
    tb: ptr = load r, 24
    traw: ptr = ptradd tb, 16
    ticks: ptr(i64) = cast traw
    some: u1 = cmp.gt pushed, 0
    if some
        prev: index = sub pushed, 1
        pi: index = rem prev, half
        pt: i64 = load ticks, pi
        ordered: u1 = cmp.ge tick, pt
        check ordered
    raw: ptr = ptradd vb, 16
    q: ptr(any) = cast raw
    store v, q, slot
    store v, q, twin
    store tick, ticks, slot
    store tick, ticks, twin
    next: index = add pushed, 1
    store next, r
    ret
; a regular ring's producer: the next sample, after the ring's two
; checks — not ended, and regular, since a push without a tick into a
; ticked ring would leave its tick stale (`irregular_push`)
fn push(s: any$, v: any)
    r: ptr = get s, ring
    e: i64 = load r, 56
    still: u1 = cmp.eq e, 0
    check still
    step: i64 = load r, 40
    regular: u1 = cmp.gt step, 0
    check regular
    pushed: index = load r
    vb: ptr = load r, 16
    cap: index = load vb, 8
    half: index = div cap, 2
    slot: index = rem pushed, half
    twin: index = add slot, half
    raw: ptr = ptradd vb, 16
    q: ptr(any) = cast raw
    store v, q, slot
    store v, q, twin
    next: index = add pushed, 1
    store next, r
    ret
; --- the queue (question 47, zero.md section 9) ---
; A stream is a queue unless a history word or a time word names it.
; A queue holds an item only until its reader has passed it, and then
; the slot comes back, so a push into one is a store and a count and
; nothing else. It shares this header and this reader's view, but not
; the ring's arithmetic: there is no mirror and no wrap, because there
; is nothing to wrap around — the slots are a plain run, and the
; header's spare word (8, free since log 86) holds `origin`, the index
; of the item in slot 0, while the ticks pointer (24), a queue having
; no ticks, holds `cap`, how many slots there are. And where a ring's
; header keeps the address of its buffer (16), a queue's keeps where
; slot 0 is, the address past the buffer's own header, added once when
; the queue is made and loaded as a typed pointer by every word below
; that touches a slot, where each loaded the buffer, added sixteen and
; cast (fm3 log 115). A queue never reads its buffer's header, its
; capacity being its own word, so nothing looks for the buffer there:
; the ring's words that touch a slot are never applied to a queue (for
; a while a new stream's fill was, and the word was kept apart in a
; ninth, fm3 log 119). Item k is at slot
; `k - origin`, so every view of the unread items is one run with no
; seam to split and a block lands in one copy. When a reader has
; passed everything the front end calls `free_queue` and the origin
; moves to it: the slots come back. Step is 1 and t0 is 0, and the
; words that do not touch a slot — `count`, `advance`, `position`,
; `received`, `ended`, `end`, `open` — are the ring's, unchanged. The
; words that do touch one have a queue's form below, and the front end
; takes them where nothing in the store keeps history.
fn ring_queue(r: ptr, vb: ptr, hz: i64, cap: index)
    positive: u1 = cmp.gt cap, 0
    check positive
    store 0: index, r
    store 0: index, r, 8
    slots: ptr = ptradd vb, 16
    store slots, r, 16
    store cap, r, 24
    store hz, r, 32
    store 1: i64, r, 40
    store 0: i64, r, 48
    store 0: i64, r, 56
    ret
; the queue's producer: the ended check, a check that there is a slot
; — which is the queue's whole promise, and is why its readers need no
; residency check — the store, and the count
fn push_queue(s: any$, v: any)
    r: ptr = get s, ring
    e: i64 = load r, 56
    still: u1 = cmp.eq e, 0
    check still
    pushed: index = load r
    origin: index = load r, 8
    slot: index = sub pushed, origin
    cap: index = load r, 24
    room: u1 = cmp.lt slot, cap
    check room
    q: ptr(any) = load r, 16
    store v, q, slot
    next: index = add pushed, 1
    store next, r
    ret
; ... and a block of them in one copy, there being no seam: into the
; slots from the next one, reached as the item's push reaches its own,
; through the buffer's typed pointer. The check above has proved the
; run lies inside the slots, so no view of the whole buffer is made
; only to be checked again (fm3 log 105)
fn push_queue(s: any$, block: any[])
    r: ptr = get s, ring
    e: i64 = load r, 56
    still: u1 = cmp.eq e, 0
    check still
    n: index = len block
    pushed: index = load r
    origin: index = load r, 8
    slot: index = sub pushed, origin
    cap: index = load r, 24
    after: index = add slot, n
    fits: u1 = cmp.le after, cap
    check fits
    q: ptr(any) = load r, 16
    p: ptr(any) = index q, slot
    d: any[] = pack p, n, 1
    copy d, block
    next: index = add pushed, n
    store next, r
    ret
; ... and a few items straight from where they lie, `n` of them at
; `src`, one at a time (fm3 log 109): what a block too short for a
; chunked copy to pay is given, a string literal of a few bytes being
; the case. The caller answers for there being `n` items of the
; stream's type at `src`. The same two checks as a block, so the same
; pushes fail, and the same items in the same slots
fn push_queue_few(s: any$, src: ptr, n: index)
    r: ptr = get s, ring
    e: i64 = load r, 56
    still: u1 = cmp.eq e, 0
    check still
    pushed: index = load r
    origin: index = load r, 8
    slot: index = sub pushed, origin
    cap: index = load r, 24
    after: index = add slot, n
    fits: u1 = cmp.le after, cap
    check fits
    q: ptr(any) = load r, 16
    d: ptr(any) = index q, slot
    p: ptr(any) = cast src
    loop(j: index = 0)
        done: u1 = cmp.ge j, n
        if done
            break
        x: any = load p, j
        store x, d, j
        j2: index = add j, 1
        continue j2
    next: index = add pushed, n
    store next, r
    ret
; the same two pushes for a queue that cannot have ended (fm3 log 108):
; `ended` is written by `end` alone, so where the compiler can see that
; no `end` in the program reaches a stream of this type, the test is
; dead and is not made. The room check stands, being the queue's promise
fn push_queue_open(s: any$, v: any)
    r: ptr = get s, ring
    pushed: index = load r
    origin: index = load r, 8
    slot: index = sub pushed, origin
    cap: index = load r, 24
    room: u1 = cmp.lt slot, cap
    check room
    q: ptr(any) = load r, 16
    store v, q, slot
    next: index = add pushed, 1
    store next, r
    ret
fn push_queue_open(s: any$, block: any[])
    r: ptr = get s, ring
    n: index = len block
    pushed: index = load r
    origin: index = load r, 8
    slot: index = sub pushed, origin
    cap: index = load r, 24
    after: index = add slot, n
    fits: u1 = cmp.le after, cap
    check fits
    q: ptr(any) = load r, 16
    p: ptr(any) = index q, slot
    d: any[] = pack p, n, 1
    copy d, block
    next: index = add pushed, n
    store next, r
    ret
; this reader has passed everything, so every slot comes back and the
; run starts again at the beginning. Only the front end calls it, and
; only where it can see that this reader is the queue's only one
; (question 48): a view is a value, several may read one ring, and no
; reader can take the minimum over the others
fn free_queue(s: any$)
    r: ptr = get s, ring
    pushed: index = load r
    pos: index = get s, pos
    drained: u1 = cmp.eq pos, pushed
    if drained
        store pos, r, 8
    ret
; the queue's own readers: the slot is the index less the origin, and
; there is no residency check, the push having proved there was a slot
fn peek_queue(s: any$, i: index) -> any
    r: ptr = get s, ring
    pushed: index = load r
    pos: index = get s, pos
    at: index = add pos, i
    inside: u1 = cmp.lt at, pushed
    check inside
    origin: index = load r, 8
    k: index = sub at, origin
    q: ptr(any) = load r, 16
    v: any = load q, k
    ret v
fn latest_queue(s: any$) -> any
    r: ptr = get s, ring
    pushed: index = load r
    some: u1 = cmp.gt pushed, 0
    check some
    origin: index = load r, 8
    last: index = sub pushed, 1
    k: index = sub last, origin
    q: ptr(any) = load r, 16
    v: any = load q, k
    ret v
fn unread_queue(s: any$) -> any[]
    r: ptr = get s, ring
    pushed: index = load r
    pos: index = get s, pos
    origin: index = load r, 8
    start: index = sub pos, origin
    q: ptr(any) = load r, 16
    p: ptr(any) = index q, start
    n: index = sub pushed, pos
    f: any[] = pack p, n, 1
    ret f
fn frame_queue(s: any$) -> (any[], index, any$)
    r: ptr = get s, ring
    pushed: index = load r
    pos: index = get s, pos
    origin: index = load r, 8
    start: index = sub pos, origin
    q: ptr(any) = load r, 16
    p: ptr(any) = index q, start
    n: index = sub pushed, pos
    f: any[] = pack p, n, 1
    s2: any$ = set s, pos, pushed
    ret f, pos, s2
; ... a block at a time (log 69, 80): copied whole into the slots from
; the next one — the slot is under half and the block at most half, so
; it never reaches the end; past the seam it lands on the twin positions
; — and again half further on, split where that reaches the end, the
; rest into the start of the buffer: three copies, and the count moves
; once; a block longer than half could never be resident whole and fails
fn push(s: any$, block: any[])
    r: ptr = get s, ring
    e: i64 = load r, 56
    still: u1 = cmp.eq e, 0
    check still
    step: i64 = load r, 40
    regular: u1 = cmp.gt step, 0
    check regular
    n: index = len block
    pushed: index = load r
    vals: any[] = ring_values(r)
    cap: index = len vals
    half: index = div cap, 2
    fits: u1 = cmp.le n, half
    check fits
    slot: index = rem pushed, half
    d1: any[] = view vals, slot, n
    copy d1, block
    twin: index = add slot, half
    room: index = sub half, slot
    first: index = min(n, room)
    a: any[] = view block, 0, first
    d2: any[] = view vals, twin, first
    copy d2, a
    rest: index = sub n, first
    some: u1 = cmp.gt rest, 0
    if some
        b: any[] = view block, first, rest
        d3: any[] = view vals, 0, rest
        copy d3, b
    next: index = add pushed, n
    store next, r
    ret
; ... and into an irregular ring, every item at one tick
fn push(s: any$, tick: i64, block: any[])
    r: ptr = get s, ring
    e: i64 = load r, 56
    still: u1 = cmp.eq e, 0
    check still
    step: i64 = load r, 40
    irregular: u1 = cmp.eq step, 0
    check irregular
    n: index = len block
    pushed: index = load r
    vals: any[] = ring_values(r)
    ticks: i64[] = ring_ticks(r)
    cap: index = len vals
    half: index = div cap, 2
    fits: u1 = cmp.le n, half
    check fits
    some0: u1 = cmp.gt pushed, 0
    if some0
        prev: index = sub pushed, 1
        pi: index = rem prev, half
        pt: i64 = load ticks, pi
        ordered: u1 = cmp.ge tick, pt
        check ordered
    slot: index = rem pushed, half
    d1: any[] = view vals, slot, n
    copy d1, block
    t1: i64[] = view ticks, slot, n
    fill t1, tick
    twin: index = add slot, half
    room: index = sub half, slot
    first: index = min(n, room)
    a: any[] = view block, 0, first
    d2: any[] = view vals, twin, first
    copy d2, a
    t2: i64[] = view ticks, twin, first
    fill t2, tick
    rest: index = sub n, first
    some: u1 = cmp.gt rest, 0
    if some
        b: any[] = view block, first, rest
        d3: any[] = view vals, 0, rest
        copy d3, b
        t3: i64[] = view ticks, 0, rest
        fill t3, tick
    next: index = add pushed, n
    store next, r
    ret

; --- the consumer's side ---
; where this reader stands: the index of the next unread item, and
; its tick — by arithmetic on a regular ring; on an irregular one the
; item's own, or -1 when nothing is unread, there being no such tick
fn position(s: any$) -> (index, i64)
    r: ptr = get s, ring
    pos: index = get s, pos
    step: i64 = load r, 40
    regular: u1 = cmp.gt step, 0
    pushed: index = load r
    unread: u1 = cmp.lt pos, pushed
    known: u1 = or regular, unread
    t: i64 = if known
        tk: i64 = tick_of(s, pos)
        yield tk
    else
        yield -1
    ret pos, t
fn count(s: any$) -> index
    r: ptr = get s, ring
    pushed: index = load r
    pos: index = get s, pos
    n: index = sub pushed, pos
    ret n
; how many items the ring has received, whoever reads it
fn received(s: any$) -> index
    r: ptr = get s, ring
    n: index = load r
    ret n
; everything since this reader last looked: the values, the index of
; the first (its tick is `tick_of`, its time `time_at`), and the
; stream moved on
; ... the view packed from the buffer's typed pointer at the reader's
; slot (log 75): the unread items are at most half, so they lie inside
; the buffer whole once the reader is resident, and nothing is checked
; twice
fn frame(s: any$) -> (any[], index, any$)
    r: ptr = get s, ring
    pushed: index = load r
    pos: index = get s, pos
    vb: ptr = load r, 16
    cap: index = load vb, 8
    half: index = div cap, 2
    over: index = sub pushed, half
    base: index = max(over, 0: index)
    resident: u1 = cmp.ge pos, base
    check resident
    start: index = rem pos, half
    raw: ptr = ptradd vb, 16
    q: ptr(any) = cast raw
    p: ptr(any) = index q, start
    n: index = sub pushed, pos
    f: any[] = pack p, n, 1
    s2: any$ = set s, pos, pushed
    ret f, pos, s2
; the unread items as a view, the reader not moved: what `frame` gives
; without the move, for a reader that looks without taking
fn unread(s: any$) -> any[]
    r: ptr = get s, ring
    pushed: index = load r
    pos: index = get s, pos
    vb: ptr = load r, 16
    cap: index = load vb, 8
    half: index = div cap, 2
    over: index = sub pushed, half
    base: index = max(over, 0: index)
    resident: u1 = cmp.ge pos, base
    check resident
    start: index = rem pos, half
    raw: ptr = ptradd vb, 16
    q: ptr(any) = cast raw
    p: ptr(any) = index q, start
    n: index = sub pushed, pos
    f: any[] = pack p, n, 1
    ret f
; one item read through the buffer's typed pointer at its slot, as the
; push stored it, after the checks a reader is owed: no view packed
fn latest(s: any$) -> any
    r: ptr = get s, ring
    pushed: index = load r
    some: u1 = cmp.gt pushed, 0
    check some
    vb: ptr = load r, 16
    cap: index = load vb, 8
    half: index = div cap, 2
    last: index = sub pushed, 1
    i: index = rem last, half
    raw: ptr = ptradd vb, 16
    q: ptr(any) = cast raw
    v: any = load q, i
    ret v
; the i-th unread item, the reader not moved; and the reader moved on n
fn peek(s: any$, i: index) -> any
    r: ptr = get s, ring
    pushed: index = load r
    pos: index = get s, pos
    at: index = add pos, i
    inside: u1 = cmp.lt at, pushed
    check inside
    vb: ptr = load r, 16
    cap: index = load vb, 8
    half: index = div cap, 2
    over: index = sub pushed, half
    base: index = max(over, 0: index)
    resident: u1 = cmp.ge pos, base
    check resident
    k: index = rem at, half
    raw: ptr = ptradd vb, 16
    q: ptr(any) = cast raw
    v: any = load q, k
    ret v
fn advance(s: any$, n: index) -> any$
    r: ptr = get s, ring
    pushed: index = load r
    pos: index = get s, pos
    pos2: index = add pos, n
    inside: u1 = cmp.le pos2, pushed
    check inside
    s2: any$ = set s, pos, pos2
    ret s2
; the k items before this reader's position — fewer at the start of
; the stream: the history a filter reads behind its frame
fn behind(s: any$, k: index) -> any[]
    r: ptr = get s, ring
    base: index = ring_base(r)
    pos: index = get s, pos
    resident: u1 = cmp.ge pos, base
    check resident
    have: index = sub pos, base
    n: index = min(k, have)
    vals: any[] = ring_values(r)
    start: index = sub pos, n
    from: index = ring_index(s, start)
    h: any[] = view vals, from, n
    ret h
; the last k items pushed — fewer when there are not k yet: the
; history a producer reads behind its own output
fn last(s: any$, k: index) -> any[]
    r: ptr = get s, ring
    pushed: index = load r
    base: index = ring_base(r)
    have: index = sub pushed, base
    n: index = min(k, have)
    vals: any[] = ring_values(r)
    start: index = sub pushed, n
    from: index = ring_index(s, start)
    h: any[] = view vals, from, n
    ret h
; the k-th item from the end of a history, or 0 before the beginning
fn tail(h: any[], k: index) -> any
    n: index = len h
    short: u1 = cmp.lt n, k
    v: any = if short
        yield 0
    else
        i: index = sub n, k
        x: any = load h, i
        yield x
    ret v

; --- sampling by time ---
; the index (from base) of the last resident item at or before a tick,
; or -1 when the tick is before them all: by arithmetic on a regular
; ring, by binary search over the ticks (sorted by construction) otherwise
fn before(s: any$, tick: i64) -> index
    r: ptr = get s, ring
    pushed: index = load r
    base: index = ring_base(r)
    n: index = sub pushed, base
    step: i64 = load r, 40
    regular: u1 = cmp.gt step, 0
    found: index = if regular
        t0: i64 = load r, 48
        early: u1 = cmp.lt tick, t0
        k: index = if early
            yield -1
        else
            rel: i64 = sub tick, t0
            q: i64 = div rel, step
            qi: index = conv q
            ki: index = sub qi, base
            last: index = sub n, 1
            beyond: u1 = cmp.gt ki, last
            kc: index = if beyond
                yield last
            else
                yield ki
            gone: u1 = cmp.lt kc, -1
            kd: index = if gone
                yield -1
            else
                yield kc
            yield kd
        yield k
    else
        all: i64[] = ring_ticks(r)
        first: index = ring_index(s, base)
        ticks: i64[] = view all, first, n
        at: index = loop(lo: index = 0, hi: index = n, best: index = -1)
            done: u1 = cmp.ge lo, hi
            if done
                break best
            span: index = sub hi, lo
            half: index = div span, 2
            mid: index = add lo, half
            tm: i64 = load ticks, mid
            past: u1 = cmp.gt tm, tick
            if past
                continue lo, mid, best
            mid1: index = add mid, 1
            continue mid1, hi, mid
        yield at
    ret found
; a + (b - a) * w, exactly, rounded once into the element's type
fn lerp(a: number, b: number, w: time) -> number
    down: u1 = cmp.lt b, a
    r: number = if down
        d: number = sub a, b
        dr: time = conv d
        pr: time = mul dr, w
        p: number = conv pr
        v: number = sub a, p
        yield v
    else
        d2: number = sub b, a
        dr2: time = conv d2
        pr2: time = mul dr2, w
        p2: number = conv pr2
        v2: number = add a, p2
        yield v2
    ret r
; the value at t, by the stream's rule: the time becomes ticks once,
; the item is found in integers, and only a weight is rational
fn sample(s: number$, t: time) -> number
    r: ptr = get s, ring
    pushed: index = load r
    base: index = ring_base(r)
    n: index = sub pushed, base
    some: u1 = cmp.gt n, 0
    check some
    vals: number[] = ring_values(r)
    x: time = ticks(s, t)
    tick: i64 = conv x
    lo: index = before(s, tick)
    early: u1 = cmp.lt lo, 0
    v: number = if early
        edge: i64 = get s, edge
        clamp: u1 = cmp.eq edge, 1
        check clamp
        b0: index = ring_index(s, base)
        first: number = load vals, b0
        yield first
    else
        rule: i64 = get s, rule
        hi: index = add lo, 1
        has_hi: u1 = cmp.lt hi, n
        kl: index = add base, lo
        il: index = ring_index(s, kl)
        vl: number = load vals, il
        y: number = if has_hi
            kh: index = add base, hi
            tl: i64 = tick_of(s, kl)
            th: i64 = tick_of(s, kh)
            ih: index = ring_index(s, kh)
            vh: number = load vals, ih
            tlr: time = seconds(tl)
            thr: time = seconds(th)
            dl: time = sub x, tlr
            dh: time = sub thr, x
            nearest: u1 = cmp.eq rule, 0
            linear: u1 = cmp.eq rule, 2
            z: number = if nearest
                closer: u1 = cmp.lt dh, dl
                z1: number = if closer
                    yield vh
                else
                    yield vl
                yield z1
            else
                z2: number = if linear
                    span: time = sub thr, tlr
                    w: time = div dl, span
                    m: number = lerp(vl, vh, w)
                    yield m
                else
                    yield vl
                yield z2
            yield z
        else
            yield vl
        yield y
    ret v
; the items with t1 <= t < t2, as a view: the times become whole
; ticks once, then the ticks are compared
fn window(s: any$, t1: time, t2: time) -> any[]
    r: ptr = get s, ring
    pushed: index = load r
    base: index = ring_base(r)
    n: index = sub pushed, base
    vals: any[] = ring_values(r)
    x1: time = ticks(s, t1)
    x2: time = ticks(s, t2)
    c1: i64 = ceil_tick(x1)
    c2: i64 = ceil_tick(x2)
    first: index = loop(i: index = 0)
        done: u1 = cmp.ge i, n
        if done
            break i
        ki: index = add base, i
        ti: i64 = tick_of(s, ki)
        inside: u1 = cmp.ge ti, c1
        if inside
            break i
        i2: index = add i, 1
        continue i2
    end: index = loop(j: index = first)
        done2: u1 = cmp.ge j, n
        if done2
            break j
        kj: index = add base, j
        tj: i64 = tick_of(s, kj)
        past: u1 = cmp.ge tj, c2
        if past
            break j
        j2: index = add j, 1
        continue j2
    m: index = sub end, first
    kf: index = add base, first
    from: index = ring_index(s, kf)
    w: any[] = view vals, from, m
    ret w
