; lib/stream.ssa — streams: values over time. A stream `T$` is a
; reader's view of a ring of T: the ring, the position this reader has
; read to, dt and t0 (0 and 0 for an irregular stream, which carries a
; time per item), a sampling rule and an edge rule. The ring is the
; producer's: its header holds how many items have been pushed and
; where the resident ones start, and two buffers hold the values and
; their times. Several streams may view one ring, each with its own
; position and rules — a stream is to a ring what a slice is to a buffer.
;
; The resident items stay contiguous: the buffers are twice the
; capacity, and when they fill the newer half slides down over the
; older, so at least the last cap/2 items are always a view. A reader
; that falls further behind than that fails a check (its items are
; gone); a sample before the first resident item fails a check unless
; the stream's edge rule is clamp (1), which gives the first.
;
; Rules: nearest (0) takes the item whose time is nearest t; hold (1)
; takes the last item at or before t — a sample-and-hold; linear (2)
; weighs the two items around t, exactly in rational arithmetic, and
; rounds once into the element's type. Producers `push s, t, v` (times
; non-decreasing, checked); consumers take a `frame` (everything since
; they last looked, as views of the values and their times, and the
; stream advanced), `count`, `latest`, `sample s, t`, or a
; `window s, t1, t2` of the items with t1 <= t < t2.
;
; A regular stream (`regular(s, dt, t0)`) has a sample every dt from
; t0: its producer says `push s, v` and the time is computed, and a
; sample at t finds its item by arithmetic rather than search. Its ring
; still holds a time per item, so every reader's operation is the same.

; --- the ring: [pushed, base, values buffer, times buffer] ---
fn ring_init(r: ptr, vb: ptr, tb: ptr) {
    store 0: i64, r
    store 0: i64, r, 8
    store vb, r, 16
    store tb, r, 24
    ret
}

; a stream over a ring: at its start, nearest, failing at the edges
fn stream(r: ptr) -> number$ {
    zero: time = seconds(0)
    s: number$ = pack r, 0, zero, zero, 0, 0
    ret s
}
fn sampling(s: number$, rule: i64) -> number$ {
    s2: number$ = set s, rule, rule
    ret s2
}
fn edges(s: number$, edge: i64) -> number$ {
    s2: number$ = set s, edge, edge
    ret s2
}
; the same ring seen as regular: a sample every dt from t0
fn regular(s: number$, dt: time, t0: time) -> number$ {
    s2: number$ = set s, dt, dt
    s3: number$ = set s2, t0, t0
    ret s3
}
; the time of a regular stream's k-th item
fn time_of(s: number$, k: i64) -> time {
    dt: time = get s, dt
    t0: time = get s, t0
    kt: time = conv k
    d: time = mul kt, dt
    t: time = add t0, d
    ret t
}

; the ring's values and times as whole views, and the resident range
fn ring_values(r: ptr) -> number[] {
    vb: ptr = load r, 16
    v: number[] = slice vb
    ret v
}
fn ring_times(r: ptr) -> time[] {
    tb: ptr = load r, 24
    t: time[] = slice tb
    ret t
}

; --- the producer's side ---
fn push(s: number$, t: time, v: number) {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    vals: number[] = ring_values(r)
    times: time[] = ring_times(r)
    cap: i64 = len vals
    held: i64 = sub pushed, base
    full: u1 = cmp.eq held, cap
    base2: i64 = if full {
        half: i64 = div cap, 2
        hi: number[] = view vals, half, half
        lo: number[] = view vals, 0, half
        copy lo, hi
        thi: time[] = view times, half, half
        tlo: time[] = view times, 0, half
        copy tlo, thi
        b: i64 = add base, half
        store b, r, 8
        yield b
    } else {
        yield base
    }
    slot: i64 = sub pushed, base2
    some: u1 = cmp.gt slot, 0
    if some {
        prev: i64 = sub slot, 1
        pt: time = load times, prev
        ordered: u1 = cmp.ge t, pt
        check ordered
    }
    store v, vals, slot
    store t, times, slot
    next: i64 = add pushed, 1
    store next, r
    ret
}

; a regular stream's producer: the next sample, its time computed
fn push(s: number$, v: number) {
    dt: time = get s, dt
    zero: time = seconds(0)
    is_regular: u1 = cmp.ne dt, zero
    check is_regular
    r: ptr = get s, ring
    pushed: i64 = load r
    t: time = time_of(s, pushed)
    push(s, t, v)
    ret
}

; --- the consumer's side ---
fn count(s: number$) -> i64 {
    r: ptr = get s, ring
    pushed: i64 = load r
    pos: i64 = get s, pos
    n: i64 = sub pushed, pos
    ret n
}
; everything since this reader last looked: the values, their times,
; and the stream moved on
fn frame(s: number$) -> (number[], time[], number$) {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    pos: i64 = get s, pos
    resident: u1 = cmp.ge pos, base
    check resident
    vals: number[] = ring_values(r)
    times: time[] = ring_times(r)
    start: i64 = sub pos, base
    n: i64 = sub pushed, pos
    f: number[] = view vals, start, n
    ft: time[] = view times, start, n
    s2: number$ = set s, pos, pushed
    ret f, ft, s2
}
fn latest(s: number$) -> number {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    some: u1 = cmp.gt pushed, base
    check some
    vals: number[] = ring_values(r)
    last: i64 = sub pushed, base
    i: i64 = sub last, 1
    v: number = load vals, i
    ret v
}
; the index (from base) of the last resident item at or before t, or
; -1 when t is before them all: by arithmetic on a regular stream, by
; binary search over the times otherwise (they are sorted by construction)
fn before(s: number$, t: time) -> i64 {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    n: i64 = sub pushed, base
    dt: time = get s, dt
    zero: time = seconds(0)
    is_regular: u1 = cmp.ne dt, zero
    found: i64 = if is_regular {
        t0: time = get s, t0
        early: u1 = cmp.lt t, t0
        k: i64 = if early {
            yield -1
        } else {
            rel: time = sub t, t0
            q: time = div rel, dt
            qi: i64 = conv q
            ki: i64 = sub qi, base
            last: i64 = sub n, 1
            beyond: u1 = cmp.gt ki, last
            kc: i64 = if beyond {
                yield last
            } else {
                yield ki
            }
            gone: u1 = cmp.lt kc, -1
            kd: i64 = if gone {
                yield -1
            } else {
                yield kc
            }
            yield kd
        }
        yield k
    } else {
        times: time[] = ring_times(r)
        at: i64 = loop(lo: i64 = 0, hi: i64 = n, best: i64 = -1) {
            done: u1 = cmp.ge lo, hi
            if done {
                break best
            }
            span: i64 = sub hi, lo
            half: i64 = div span, 2
            mid: i64 = add lo, half
            tm: time = load times, mid
            past: u1 = cmp.gt tm, t
            if past {
                continue lo, mid, best
            }
            mid1: i64 = add mid, 1
            continue mid1, hi, mid
        }
        yield at
    }
    ret found
}
; a + (b - a) * w, exactly, rounded once into the element's type
fn lerp(a: number, b: number, w: time) -> number {
    down: u1 = cmp.lt b, a
    r: number = if down {
        d: number = sub a, b
        dr: time = conv d
        pr: time = mul dr, w
        p: number = conv pr
        v: number = sub a, p
        yield v
    } else {
        d2: number = sub b, a
        dr2: time = conv d2
        pr2: time = mul dr2, w
        p2: number = conv pr2
        v2: number = add a, p2
        yield v2
    }
    ret r
}
fn sample(s: number$, t: time) -> number {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    n: i64 = sub pushed, base
    some: u1 = cmp.gt n, 0
    check some
    vals: number[] = ring_values(r)
    times: time[] = ring_times(r)
    lo: i64 = before(s, t)
    early: u1 = cmp.lt lo, 0
    v: number = if early {
        edge: i64 = get s, edge
        clamp: u1 = cmp.eq edge, 1
        check clamp
        first: number = load vals, 0
        yield first
    } else {
        rule: i64 = get s, rule
        hi: i64 = add lo, 1
        has_hi: u1 = cmp.lt hi, n
        vl: number = load vals, lo
        x: number = if has_hi {
            tl: time = load times, lo
            th: time = load times, hi
            vh: number = load vals, hi
            dl: time = sub t, tl
            dh: time = sub th, t
            nearest: u1 = cmp.eq rule, 0
            linear: u1 = cmp.eq rule, 2
            y: number = if nearest {
                closer: u1 = cmp.lt dh, dl
                z: number = if closer {
                    yield vh
                } else {
                    yield vl
                }
                yield z
            } else {
                z2: number = if linear {
                    span: time = sub th, tl
                    w: time = div dl, span
                    m: number = lerp(vl, vh, w)
                    yield m
                } else {
                    yield vl
                }
                yield z2
            }
            yield y
        } else {
            yield vl
        }
        yield x
    }
    ret v
}
; the items with t1 <= t < t2, as a view
fn window(s: number$, t1: time, t2: time) -> number[] {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    n: i64 = sub pushed, base
    times: time[] = ring_times(r)
    vals: number[] = ring_values(r)
    first: i64 = loop(i: i64 = 0) {
        done: u1 = cmp.ge i, n
        if done {
            break i
        }
        ti: time = load times, i
        inside: u1 = cmp.ge ti, t1
        if inside {
            break i
        }
        i2: i64 = add i, 1
        continue i2
    }
    end: i64 = loop(j: i64 = first) {
        done2: u1 = cmp.ge j, n
        if done2 {
            break j
        }
        tj: time = load times, j
        past: u1 = cmp.ge tj, t2
        if past {
            break j
        }
        j2: i64 = add j, 1
        continue j2
    }
    m: i64 = sub end, first
    w: number[] = view vals, first, m
    ret w
}

; --- a reader taking less than a frame: the i-th unread item, and the
; reader moved on by n ---
fn peek(s: number$, i: i64) -> number {
    r: ptr = get s, ring
    pushed: i64 = load r
    base: i64 = load r, 8
    pos: i64 = get s, pos
    resident: u1 = cmp.ge pos, base
    check resident
    at: i64 = add pos, i
    inside: u1 = cmp.lt at, pushed
    check inside
    vals: number[] = ring_values(r)
    k: i64 = sub at, base
    v: number = load vals, k
    ret v
}
fn advance(s: number$, n: i64) -> number$ {
    r: ptr = get s, ring
    pushed: i64 = load r
    pos: i64 = get s, pos
    pos2: i64 = add pos, n
    inside: u1 = cmp.le pos2, pushed
    check inside
    s2: number$ = set s, pos, pos2
    ret s2
}
