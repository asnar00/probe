fn ne(N)(a: sunit(N), b: sunit(N)) -> u1 {
    av: i(N) = get a, v
    bv: i(N) = get b, v
    r: u1 = cmp.ne av, bv
    ret r
}
fn min(N)(a: sunit(N), b: sunit(N)) -> sunit(N) {
    lt: u1 = cmp.lt a, b
    if lt {
        ret a
    }
    ret b
}
fn max(N)(a: sunit(N), b: sunit(N)) -> sunit(N) {
    gt: u1 = cmp.gt a, b
    if gt {
        ret a
    }
    ret b
}
fn conv(N, E, M)(a: sunit(N)) -> float(E, M) {
    av: i(N) = get a, v
    f: float(E, M) = conv av
    max_i: i64 = const (1 << (N - 1)) - 1
    max_f: float(E, M) = conv max_i
    r: float(E, M) = div f, max_f
    ret r
}
fn conv(E, M, N)(a: float(E, M)) -> sunit(N) {
    max_i: i64 = const (1 << (N - 1)) - 1
    max_f: float(E, M) = conv max_i
    neg: u1 = cmp.lt a, 0.0
    half: float(E, M) = if neg {
        yield -0.5
    } else {
        yield 0.5
    }
    y: float(E, M) = fma a, max_f, half
    i: i64 = conv y
    r: sunit(N) = sclamp(N)(i)
    ret r
}
