; check — what a failed `check` looks like from the kernel's side. A
; check that does not hold is a breakpoint trap; `__trap` sees the
; platform's `trap_check` cause and the address it stopped at, and
; reports them before ending the machine.
;
;   probe boot os/check.ssa            -> "check failed at 0x8000...."
;   probe boot os/check.ssa arm

data failed = "check failed at 0x"
data other = "trap "
data newline = "\n"

fn vectors(t: ptr) {
    ret
}
fn cause() -> u64 {
    ret 0
}
fn resume() -> ptr {
    ret 0
}
fn psci(code: u64) {
    ret
}

fn __start() {
    h: fn(u64, u64, u64) -> u64 = addr __trap
    hp: ptr = cast h
    vectors(hp)
    ok: u1 = cmp.eq 1: i64, 1
    check ok
    putc(97)
    bad: u1 = cmp.eq 1: i64, 2
    check bad
    putc(98)
    exit()
    ret
}

fn __trap(n: u64, a: u64, b: u64) -> u64 {
    c: u64 = cause()
    chk: u64 = platform trap_check
    is: u1 = cmp.eq c, chk
    if is {
        fp: ptr = addr failed
        fn: i64 = len failed
        say(fp, fn)
        p: ptr = resume()
        pa: u64 = cast p
        print_hex(pa)
    } else {
        op: ptr = addr other
        on: i64 = len other
        say(op, on)
        print_hex(c)
    }
    np: ptr = addr newline
    say(np, 1)
    exit()
    ; the machine ends a little after it is told to; returning would
    ; run the check again (riscv resumes at the ebreak itself)
    loop() {
        continue
    }
}

fn putc(c: u8) {
    uart: ptr = platform uart
    c32: u32 = conv c
    store c32, uart
    ret
}
fn say(p: ptr, n: i64) {
    loop(i: i64 = 0) {
        done: u1 = cmp.ge i, n
        if done {
            break
        }
        c: u8 = load p, i, 1
        putc(c)
        i2: i64 = add i, 1
        continue i2
    }
    ret
}
fn print_hex(v: u64) {
    loop(sh: i64 = 60) {
        neg: u1 = cmp.lt sh, 0
        if neg {
            break
        }
        shu: u64 = conv sh
        t: u64 = shr v, shu
        d: u64 = and t, 15
        big: u1 = cmp.gt d, 9
        base: u64 = if big {
            yield 87
        } else {
            yield 48
        }
        cv: u64 = add d, base
        c: u8 = conv cv
        putc(c)
        sh2: i64 = sub sh, 4
        continue sh2
    }
    ret
}
fn exit() {
    f: ptr = platform finisher
    store 0x5555: u32, f
    psci(0x84000008)
    ret
}
