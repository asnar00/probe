; echo — the second operating system written in probe. A kernel that
; installs a trap handler and serves three system calls — write, read,
; exit — through a table of function values; and a program that uses
; nothing but those calls: it prompts, reads a line, echoes it, and
; stops at "bye".
;
;   printf 'hello\nbye\n' | probe boot os/echo.ssa        (riscv64)
;   printf 'hello\nbye\n' | probe boot os/echo.ssa arm    (aarch64)
;   probe boot os/echo.ssa arm                            (the terminal)
;
; The board is the platform file's: `platform uart` and the status
; register that says a byte has arrived; `vectors`, `cause`, `resume`,
; `resume_at` and `syscall` are functions whose bodies the platform
; supplies (msr/mrs/svc on arm64, csrw/csrr/ecall on riscv64). The
; handler is `fn __trap`: `probe boot` gives it a frame that keeps the
; interrupted code's registers and a return that resumes it.
;
; Input is a stream: `keys: u8$` (lib/stream.ssa), a ring the UART's
; interrupt handler pushes each byte into with the counter's tick it arrived at
; (`uart_irq_on` asks the board for an interrupt per byte), and a
; reader — kept across system calls in `reader` — that `read` moves
; through one line at a time, sleeping (`idle`) until a newline is
; among the unread bytes; so between keystrokes the machine does
; nothing at all. On riscv64 every device interrupt
; is one cause, "external", and the controller names the source
; (`irq_claim`); on arm64 the controller names it outright; the two
; constants `irq_external` and `irq_uart` let one kernel do both. The
; last line says how many interrupts the input took.

data prompt = "> "
data echo = "echo: "
data newline = "\n"
data line: array(u8, 64)
data calls: array(fn(u64, u64) -> u64, 3)
; the input stream's ring: values, ticks of the counter, the header
; (the clock is the counter's), and the reader's view of it (a u8$, 32
; bytes), kept between system calls
data vb: buffer(u8, 512)
data tb: buffer(i64, 512)
data rg: array(u64, 8)
data reader: array(u64, 4)
data start: array(u64, 1)
data uart_irqs: array(u64, 1)
data took = "took "
data irqs = " interrupts\n"

; --- the board ---
fn vectors(t: ptr) {
    ret
}
fn cause() -> u64 {
    ret 0
}
fn resume() -> ptr {
    ret 0
}
fn resume_at(p: ptr) {
    ret
}
fn syscall(n: u64, a: u64, b: u64) -> u64 {
    ret 0
}
fn psci(code: u64) {
    ret
}
fn irq_on() {
    ret
}
fn uart_irq_on() {
    ret
}
fn irq_ack() -> u32 {
    ret 0
}
fn irq_claim() -> u32 {
    ret 0
}
fn irq_done(id: u32) {
    ret
}
fn idle() {
    ret
}
fn now() -> u64 {
    ret 0
}
fn hz() -> u64 {
    ret 0
}

; --- the kernel ---
fn __start() {
    t: ptr = addr calls
    w: fn(u64, u64) -> u64 = addr sys_write
    r: fn(u64, u64) -> u64 = addr sys_read
    x: fn(u64, u64) -> u64 = addr sys_exit
    store w, t
    store r, t, 8
    store x, t, 16
    h: fn(u64, u64, u64) -> u64 = addr __trap
    hp: ptr = cast h
    vectors(hp)
    sp: ptr = addr start
    t0: u64 = now()
    store t0, sp
    rg0: ptr = addr rg
    a: ptr = addr vb
    b: ptr = addr tb
    f: u64 = hz()
    fi: i64 = conv f
    ring_init(rg0, a, b, fi)
    keys: u8$ = stream rg0
    rp: ptr = addr reader
    store keys, rp
    uart_irq_on()
    irq_on()
    main()
    exit()
    ret
}

; a byte arrived: everything the port has goes into the stream, each
; byte with the counter's tick it was taken at
fn __irq() {
    id: u32 = irq_ack()
    ext: u32 = platform irq_external
    is_ext: u1 = cmp.eq id, ext
    src: u32 = if is_ext {
        s: u32 = irq_claim()
        yield s
    } else {
        yield id
    }
    uart_id: u32 = platform irq_uart
    is_uart: u1 = cmp.eq src, uart_id
    if is_uart {
        ip: ptr = addr uart_irqs
        n: u64 = load ip
        n1: u64 = add n, 1
        store n1, ip
        drain()
    }
    irq_done(src)
    ret
}
fn drain() {
    uart: ptr = platform uart
    off: i64 = platform uart_status
    status: ptr = ptradd uart, off
    mask: u8 = platform uart_ready_mask
    ready: u8 = platform uart_ready
    r: ptr = addr rg
    keys: u8$ = stream r
    loop() {
        s: u8 = load status
        m: u8 = and s, mask
        ok: u1 = cmp.eq m, ready
        empty: u1 = cmp.ne ok, 1
        if empty {
            break
        }
        c: u8 = load uart
        t: i64 = tick()
        push keys, t, c
        continue
    }
    ret
}
; the machine's counter since boot
fn tick() -> i64 {
    sp: ptr = addr start
    s: u64 = load sp
    t: u64 = now()
    e: u64 = sub t, s
    ei: i64 = conv e
    ret ei
}

; every trap lands here with the trapped code's first three argument
; registers; what it returns replaces the first. A system call is
; dispatched through the table and resumed past the instruction that
; made it; anything else ends the machine.
fn __trap(n: u64, a: u64, b: u64) -> u64 {
    c: u64 = cause()
    sc: u64 = platform trap_syscall
    is: u1 = cmp.eq c, sc
    r: u64 = if is {
        t: ptr = addr calls
        i: i64 = conv n
        f: fn(u64, u64) -> u64 = load t, i, 8
        v: u64 = f(a, b)
        p: ptr = resume()
        skip: i64 = platform resume_skip
        p2: ptr = ptradd p, skip
        resume_at(p2)
        yield v
    } else {
        exit()
        yield n
    }
    ret r
}

; write(p, n): n bytes from p to the serial port
fn sys_write(p: u64, n: u64) -> u64 {
    q: ptr = cast p
    m: i64 = conv n
    loop(i: i64 = 0) {
        done: u1 = cmp.ge i, m
        if done {
            break
        }
        c: u8 = load q, i, 1
        putc(c)
        i2: i64 = add i, 1
        continue i2
    }
    ret n
}

; read(p, n): a line from the stream into p, at most n bytes, the
; newline dropped; returns the count. Sleeps until a line is there,
; then moves the reader past it and keeps it for the next call.
fn sys_read(p: u64, n: u64) -> u64 {
    q: ptr = cast p
    m: i64 = conv n
    rp: ptr = addr reader
    keys: u8$ = load rp
    ; the unread bytes, up to and including a newline
    line: i64 = loop() {
        have: i64 = count keys
        found: i64 = loop(i: i64 = 0) {
            at_end: u1 = cmp.ge i, have
            if at_end {
                break -1
            }
            c: u8 = peek keys, i
            nl: u1 = cmp.eq c, 10
            if nl {
                break i
            }
            i2: i64 = add i, 1
            continue i2
        }
        ready: u1 = cmp.ge found, 0
        if ready {
            break found
        }
        idle()
        continue
    }
    got: i64 = loop(k: i64 = 0, j: i64 = 0) {
        at_nl: u1 = cmp.ge k, line
        if at_nl {
            break j
        }
        b: u8 = peek keys, k
        k2: i64 = add k, 1
        full: u1 = cmp.ge j, m
        if full {
            continue k2, j
        }
        store b, q, j, 1
        j2: i64 = add j, 1
        continue k2, j2
    }
    past: i64 = add line, 1
    keys2: u8$ = advance(keys, past)
    store keys2, rp
    r: u64 = conv got
    ret r
}


; exit: how many interrupts the input took, then the machine ends
fn sys_exit(a: u64, b: u64) -> u64 {
    ip: ptr = addr uart_irqs
    n: u64 = load ip
    ni: i64 = conv n
    tp: ptr = addr took
    tn: i64 = len took
    say_bytes(tp, tn)
    print_dec(ni)
    ipp: ptr = addr irqs
    ipn: i64 = len irqs
    say_bytes(ipp, ipn)
    exit()
    ret 0
}

; --- the serial port ---
fn putc(c: u8) {
    uart: ptr = platform uart
    c32: u32 = conv c
    store c32, uart
    ret
}
fn say_bytes(p: ptr, n: i64) {
    loop(i: i64 = 0) {
        done: u1 = cmp.ge i, n
        if done {
            break
        }
        c: u8 = load p, i, 1
        putc(c)
        i2: i64 = add i, 1
        continue i2
    }
    ret
}
fn print_dec(v: i64) {
    buf: ptr = scratch 32
    n: i64 = loop(x: i64 = v, i: i64 = 0) {
        d: i64 = rem x, 10
        c: u8 = conv d
        c48: u8 = add c, 48
        store c48, buf, i, 1
        x2: i64 = div x, 10
        i2: i64 = add i, 1
        done: u1 = cmp.eq x2, 0
        if done {
            break i2
        }
        continue x2, i2
    }
    loop(j: i64 = n) {
        z: u1 = cmp.le j, 0
        if z {
            break
        }
        j1: i64 = sub j, 1
        ch: u8 = load buf, j1, 1
        putc(ch)
        continue j1
    }
    ret
}

; end the machine (as os/hello.ssa does)
fn exit() {
    f: ptr = platform finisher
    store 0x5555: u32, f
    psci(0x84000008)
    ret
}

; --- the program: system calls only ---
fn main() {
    buf: ptr = addr line
    lp: u64 = cast buf
    pp: ptr = addr prompt
    ep: ptr = addr echo
    np: ptr = addr newline
    loop() {
        say(pp, 2)
        n: u64 = syscall(1, lp, 64)
        three: u1 = cmp.eq n, 3
        b0: u8 = load buf
        b1: u8 = load buf, 1
        b2: u8 = load buf, 2
        isb: u1 = cmp.eq b0, 98
        isy: u1 = cmp.eq b1, 121
        ise: u1 = cmp.eq b2, 101
        t1: u1 = and three, isb
        t2: u1 = and t1, isy
        bye: u1 = and t2, ise
        if bye {
            break
        }
        say(ep, 6)
        syscall(0, lp, n)
        say(np, 1)
        continue
    }
    syscall(2, 0, 0)
    ret
}
fn say(p: ptr, n: u64) {
    a: u64 = cast p
    syscall(0, a, n)
    ret
}
