; sleep — the fifth operating system written in probe: tasks that
; sleep until a time, and a scheduler that keeps exact time.
;
;   probe boot os/sleep.ssa            (riscv64)
;   probe boot os/sleep.ssa arm        (aarch64)
;   a 100000 +9
;   c 142857 +8
;   a 200000 +10
;   ...
;   18 interrupts, worst +NN us
;
; Besides tasks there are callbacks: `at(t, f, arg)` and `after(d, f,
; arg)` run a function value at a time, inside the interrupt, before
; the scheduler picks a task — fast and exact, so short and never
; sleeping. One is set for 13/25 s and registers another at exactly a
; quarter of a second after its own time — times chosen to share an
; interrupt with nothing else, so every event costs exactly one.
;
; All the memory below the machine's comes from one heap (lib/heap.ssa,
; a buddy allocator) over the RAM the machine has above the image and
; the boot stack — `platform heap_base` to `platform ram_end`, 112 MB
; on these boards, in 4 KB units: the stacks' pool and the frame
; arenas are carved from it at boot, and a task that needs a region of
; its own carves one and gives it back. The kernel seals the heap
; inside every interrupt — nothing allocates in a handler — and
; reports at the end what is still out.
;
; And there is memory with a lifetime of one frame: two arenas
; (lib/arena.ssa) over two data arrays. Every time the scheduler
; wakes a task it writes a record into the current arena — inside the
; interrupt, a bump of the count, nothing more. A frame callback runs
; every tenth of a second (at 0.05, 0.15, ... so a flip never shares
; an interrupt with a wake): it checks the consumer has finished with
; the other arena, then flips. The idle task is the consumer: after
; each flip it prints the closed frame's records — which tasks woke,
; in order — and resets that arena. Produce, flip, consume, reset.
;
; Three tasks wake every 1/10, 1/3 and 1/7 of a second, each deadline
; a `time` — lib/time.ssa's rational seconds, so 3/3 and 7/7 and 10/10
; are the same instant and the three wake on one interrupt, in index
; order. Each prints its letter, its scheduled wake in microseconds
; and how late it woke; after a second the idle task reports how many
; timer interrupts it took (18: twenty wakes, two of them shared) and
; the worst lateness. The timer is armed to the next deadline, never
; to a tick. A task that goes to sleep asks the machine for an
; interrupt (`reschedule`: a software interrupt to this cpu), so the
; switch happens now and in the one place switches happen, `__irq`.

; the heap everything is carved from: its seven words; its memory is
; the machine's
data the_heap: array(u64, 7)
data heap_label = " heap bytes out\n"
; stacks come from a pool (lib/pool.ssa): four of 8 KB in a 64 KB
; block from the heap; a task that ends gives its own back
data stack_pool: array(u64, 5)
; five tasks (0 is the idle task, the boot context): pc, sp, wake time
; (16 bytes, a rational), state (0 free, 1 live, 2 done), and for a
; one-shot task its function, argument, time and stack — 80 bytes each
data tasks: array(u64, 50)
data letters = "?abc*"
data stacks_out = " stacks out\n"
data current: array(u64, 1)
data start: array(u64, 1)
data interrupts: array(u64, 1)
data wakes: array(u64, 1)
data worst: array(i64, 1)
data sep = " +"
data summary = " interrupts, worst +"
data us = " us\n"
; callbacks: up to four of (time, f, arg) — 32 bytes each, f zero
; when the slot is free
data timers: array(u64, 16)
data ping_at: array(u64, 2)
data pong_at: array(u64, 2)
data star_at: array(u64, 2)
data starlabel = "* "
data bang = "! "
data bangbang = "!! "
; the frame arenas: two records of three words over two 512-byte
; blocks from the heap
data arenas: array(u64, 6)
data current_arena: array(u64, 1)
data frames: array(u64, 1)
data consumed: array(u64, 1)
data frame_label = "frame "
data colon = ":"

; --- the board ---
fn vectors(t: ptr) {
    ret
}
fn resume() -> ptr {
    ret 0
}
fn resume_at(p: ptr) {
    ret
}
fn now() -> u64 {
    ret 0
}
fn hz() -> u64 {
    ret 0
}
fn timer_at(t: u64) {
    ret
}
fn timer_off() {
    ret
}
fn irq_on() {
    ret
}
fn irq_ack() -> u32 {
    ret 0
}
fn irq_done(id: u32) {
    ret
}
fn reschedule() {
    ret
}
fn idle() {
    ret
}
fn psci(code: u64) {
    ret
}

; --- time ---
; the machine's counter since boot, as exact seconds
fn now_time() -> time {
    sp: ptr = addr start
    s: u64 = load sp
    t: u64 = now()
    e: u64 = sub t, s
    ei: i64 = conv e
    f: u64 = hz()
    fi: i64 = conv f
    c: time = seconds(ei)
    p: time = period(fi)
    r: time = mul c, p
    ret r
}
; a time as a count of the machine's counter, the tick after it
fn ticks_of(t: time) -> u64 {
    sp: ptr = addr start
    s: u64 = load sp
    f: u64 = hz()
    fi: i64 = conv f
    ft: time = seconds(fi)
    x: time = mul t, ft
    n: i64 = to_seconds(x)
    n1: i64 = add n, 1
    nu: u64 = conv n1
    r: u64 = add s, nu
    ret r
}

; --- the kernel ---
fn task_block(i: i64) -> ptr {
    t: ptr = addr tasks
    off: i64 = mul i, 80
    p: ptr = ptradd t, off
    ret p
}
; a task: a stack from the pool, its function as the place to resume,
; runnable now
fn spawn(i: i64, f: fn()) {
    p: ptr = task_block(i)
    pc: ptr = cast f
    sp: ptr = addr stack_pool
    stack: ptr = pool_take(sp)
    top: ptr = ptradd stack, 4096
    store pc, p
    store top, p, 8
    zero: time = seconds(0)
    store zero, p, 16
    store 1: i64, p, 32
    store stack, p, 72
    ret
}
; a one-shot task: at time t, f(arg), then gone — a free task slot, the
; three words it needs, and the task that runs them
fn run_at(t: time, f: fn(ptr), arg: ptr) {
    i: i64 = loop(j: i64 = 1) {
        has_slot: u1 = cmp.le j, 4
        check has_slot
        bj: ptr = task_block(j)
        st: i64 = load bj, 32
        free: u1 = cmp.eq st, 0
        if free {
            break j
        }
        j1: i64 = add j, 1
        continue j1
    }
    b: ptr = task_block(i)
    store f, b, 40
    store arg, b, 48
    store t, b, 56
    g: fn() = addr oneshot
    spawn(i, g)
    reschedule()
    ret
}
fn oneshot() {
    cp: ptr = addr current
    c: u64 = load cp
    i: i64 = conv c
    b: ptr = task_block(i)
    t: time = load b, 56
    sleep_until(i, t)
    f: fn(ptr) = load b, 40
    arg: ptr = load b, 48
    f(arg)
    store 2: i64, b, 32
    reschedule()
    loop() {
        idle()
        continue
    }
}
fn __start() {
    h: fn(u64, u64, u64) -> u64 = addr __trap
    hp: ptr = cast h
    vectors(hp)
    hm: ptr = platform heap_base
    ram_end: ptr = platform ram_end
    hb: u64 = cast hm
    re: u64 = cast ram_end
    ram: u64 = sub re, hb
    rami: i64 = cast ram
    hpp: ptr = addr the_heap
    heap_init(hpp, hm, rami, 4096)
    sp: ptr = addr stack_pool
    sm: ptr = heap_take(hpp, 65536)
    pool_init(sp, sm, 65536, 8192, 4)
    idle_block: ptr = task_block(0)
    store 1: i64, idle_block, 32
    fa: fn() = addr task_a
    fb: fn() = addr task_b
    fc: fn() = addr task_c
    spawn(1, fa)
    spawn(2, fb)
    spawn(3, fc)
    t0: u64 = now()
    stp: ptr = addr start
    store t0, stp
    timer_off()
    irq_on()
    ; the frame arenas, and the first flip at 0.05 s
    aa: ptr = addr arenas
    mem_a: ptr = heap_take(hpp, 512)
    arena_init(aa, mem_a, 512)
    ab: ptr = ptradd aa, 24
    mem_b: ptr = heap_take(hpp, 512)
    arena_init(ab, mem_b, 512)
    twentieth: time = period(20)
    ff: fn(ptr) = addr flip
    at(twentieth, ff, aa)
    ; a callback at 13/25 of a second
    thirteen: time = seconds(13)
    twentyfifth: time = period(25)
    when: time = mul thirteen, twentyfifth
    pp: ptr = addr ping_at
    store when, pp
    fp: fn(ptr) = addr ping
    at(when, fp, pp)
    reschedule()
    ; the idle task: the consumer of closed frames, and when the twenty
    ; wakes and ten frames are done, the report
    wp: ptr = addr wakes
    loop() {
        consume()
        w: u64 = load wp
        frp: ptr = addr frames
        fr: u64 = load frp
        w20: u1 = cmp.ge w, 20
        f11: u1 = cmp.ge fr, 11
        done: u1 = and w20, f11
        if done {
            ip: ptr = addr interrupts
            n: u64 = load ip
            ni: i64 = conv n
            print_dec(ni)
            say_summary()
            wo: ptr = addr worst
            wv: i64 = load wo
            print_dec(wv)
            say_us()
            spp: ptr = addr stack_pool
            outn: i64 = pool_out(spp)
            print_dec(outn)
            sop: ptr = addr stacks_out
            son: i64 = len stacks_out
            say(sop, son)
            hp2: ptr = addr the_heap
            ho: i64 = heap_out(hp2)
            print_dec(ho)
            hlp: ptr = addr heap_label
            hln: i64 = len heap_label
            say(hlp, hln)
            exit()
            loop() {
                continue
            }
        }
        idle()
        continue
    }
}

; every interrupt: the timer's, or a task asking. Either way: keep
; where the running task is, pick the runnable task with the earliest
; deadline (the idle task when there is none), arm the timer to the
; earliest deadline still to come, and go there.
fn __irq(sp: ptr) -> ptr {
    hp: ptr = addr the_heap
    heap_seal(hp)
    id: u32 = irq_ack()
    timer: u32 = platform irq_timer
    soft: u32 = platform irq_soft
    is_timer: u1 = cmp.eq id, timer
    is_soft: u1 = cmp.eq id, soft
    mine: u1 = or is_timer, is_soft
    back: ptr = if mine {
        if is_timer {
            ip: ptr = addr interrupts
            n: u64 = load ip
            n1: u64 = add n, 1
            store n1, ip
        }
        cp: ptr = addr current
        cur: u64 = load cp
        ci: i64 = conv cur
        me: ptr = task_block(ci)
        pc: ptr = resume()
        store pc, me
        store sp, me, 8
        tnow: time = now_time()
        ; callbacks whose time has come run here, now
        run_due(tnow)
        ; the earliest passed deadline runs; the earliest future one
        ; sets the timer
        best: i64, next: time = loop(i: i64 = 1, b: i64 = 0, bw: time = tnow, nx: time = tnow, have: u1 = 0) {
            over: u1 = cmp.gt i, 4
            if over {
                break b, nx
            }
            p: ptr = task_block(i)
            i2: i64 = add i, 1
            st: i64 = load p, 32
            not_live: u1 = cmp.ne st, 1
            if not_live {
                ; a task that ended, once it is not the one interrupted:
                ; its stack goes back to the pool, its slot is free
                ended: u1 = cmp.eq st, 2
                not_me: u1 = cmp.ne i, ci
                reclaim: u1 = and ended, not_me
                if reclaim {
                    stack: ptr = load p, 72
                    spp: ptr = addr stack_pool
                    pool_give(spp, stack)
                    store 0: i64, p, 32
                }
                continue i2, b, bw, nx, have
            }
            w: time = load p, 16
            due: u1 = cmp.le w, tnow
            if due {
                earlier: u1 = cmp.lt w, bw
                none_yet: u1 = cmp.eq b, 0
                take: u1 = or earlier, none_yet
                if take {
                    continue i2, i, w, nx, have
                }
                continue i2, b, bw, nx, have
            }
            sooner: u1 = cmp.lt w, nx
            first: u1 = cmp.eq have, 0
            take2: u1 = or sooner, first
            if take2 {
                continue i2, b, bw, w, 1
            }
            continue i2, b, bw, nx, have
        }
        ; ... or a callback still to come; a timer left armed in the
        ; past would fire again at once
        next2: time = next_callback(tnow, next)
        later: u1 = cmp.gt next2, tnow
        if later {
            at: u64 = ticks_of(next2)
            timer_at(at)
        } else {
            timer_off()
        }
        ; a switch to a task, on record: a word in this frame's arena
        chosen_task: u1 = cmp.ne best, 0
        switched: u1 = cmp.ne best, ci
        record: u1 = and chosen_task, switched
        if record {
            rec: ptr = current_records()
            r: ptr = arena_alloc(rec, 8)
            store best, r
        }
        bu: u64 = conv best
        store bu, cp
        chosen: ptr = task_block(best)
        pc2: ptr = load chosen
        sp2: ptr = load chosen, 8
        resume_at(pc2)
        yield sp2
    } else {
        yield sp
    }
    irq_done(id)
    heap_unseal(hp)
    ret back
}

; --- callbacks ---
fn timer_slot(i: i64) -> ptr {
    t: ptr = addr timers
    off: i64 = mul i, 32
    p: ptr = ptradd t, off
    ret p
}
; run a function value at a time (inside the interrupt: short, and it
; must not sleep); from a task or from another callback
fn at(t: time, f: fn(ptr), arg: ptr) {
    loop(i: i64 = 0) {
        full: u1 = cmp.ge i, 4
        if full {
            break
        }
        p: ptr = timer_slot(i)
        g: fn(ptr) = load p, 16
        gb: u64 = cast g
        free: u1 = cmp.eq gb, 0
        if free {
            store t, p
            store f, p, 16
            store arg, p, 24
            break
        }
        i1: i64 = add i, 1
        continue i1
    }
    reschedule()
    ret
}
; ... or a duration from now; the time that makes it, for the caller
fn after(d: time, f: fn(ptr), arg: ptr) -> time {
    n: time = now_time()
    t: time = add n, d
    at(t, f, arg)
    ret t
}
; the callbacks whose time has come, in slot order
fn run_due(tnow: time) {
    loop(i: i64 = 0) {
        over: u1 = cmp.ge i, 4
        if over {
            break
        }
        i1: i64 = add i, 1
        p: ptr = timer_slot(i)
        g: fn(ptr) = load p, 16
        gb: u64 = cast g
        free: u1 = cmp.eq gb, 0
        if free {
            continue i1
        }
        t: time = load p
        due: u1 = cmp.le t, tnow
        if due {
            arg: ptr = load p, 24
            none: u64 = const 0
            store none, p, 16
            g(arg)
        }
        continue i1
    }
    ret
}
; the earliest callback time still to come, if sooner than `next`
; (which may be no deadline at all: not after tnow)
fn next_callback(tnow: time, next: time) -> time {
    r: time = loop(i: i64 = 0, nx: time = next) {
        over: u1 = cmp.ge i, 4
        if over {
            break nx
        }
        i1: i64 = add i, 1
        p: ptr = timer_slot(i)
        g: fn(ptr) = load p, 16
        gb: u64 = cast g
        free: u1 = cmp.eq gb, 0
        if free {
            continue i1, nx
        }
        t: time = load p
        future: u1 = cmp.gt t, tnow
        sooner: u1 = cmp.lt t, nx
        none: u1 = cmp.le nx, tnow
        take0: u1 = or sooner, none
        take: u1 = and future, take0
        if take {
            continue i1, t
        }
        continue i1, nx
    }
    ret r
}
; --- frames ---
fn current_records() -> ptr {
    aa: ptr = addr arenas
    cp: ptr = addr current_arena
    c: u64 = load cp
    ci: i64 = conv c
    off: i64 = mul ci, 24
    p: ptr = ptradd aa, off
    ret p
}
; the frame callback: the consumer must be done with the other arena
; (it had a whole frame), then the arenas change places, and the next
; flip is a tenth of a second on
fn flip(arg: ptr) {
    fp: ptr = addr frames
    f: u64 = load fp
    cp2: ptr = addr consumed
    c: u64 = load cp2
    caught_up: u1 = cmp.eq c, f
    check caught_up
    f1: u64 = add f, 1
    store f1, fp
    cp: ptr = addr current_arena
    cur: u64 = load cp
    other: u64 = sub 1, cur
    store other, cp
    ff: fn(ptr) = addr flip
    tenth: time = period(10)
    ; from the frame's own time, not from now: 0.05 + f1/10, exactly
    twentieth: time = period(20)
    fi: i64 = conv f1
    ft: time = seconds(fi)
    step: time = mul tenth, ft
    next: time = add twentieth, step
    at(next, ff, arg)
    ret
}
; the consumer: a frame closed since last time is printed and reset
fn consume() {
    fp: ptr = addr frames
    f: u64 = load fp
    cp2: ptr = addr consumed
    c: u64 = load cp2
    behind: u1 = cmp.lt c, f
    if behind {
        ; the closed frame is the arena not current
        cp: ptr = addr current_arena
        cur: u64 = load cp
        closed: u64 = sub 1, cur
        ci: i64 = conv closed
        off: i64 = mul ci, 24
        aa: ptr = addr arenas
        a: ptr = ptradd aa, off
        lp: ptr = addr frame_label
        ln: i64 = len frame_label
        say(lp, ln)
        c1: u64 = add c, 1
        c1i: i64 = conv c1
        print_dec(c1i)
        colp: ptr = addr colon
        say(colp, 1)
        base: ptr = load a
        used: i64 = arena_used(a)
        loop(i: i64 = 0) {
            done: u1 = cmp.ge i, used
            if done {
                break
            }
            t: i64 = load base, i, 1
            lp2: ptr = addr letters
            l8: u8 = load lp2, t, 1
            putc(32)
            putc(l8)
            i16: i64 = add i, 16
            continue i16
        }
        putc(10)
        arena_reset(a)
        store c1, cp2
    }
    ret
}

; the callbacks themselves: report, and the first registers the second
fn ping(arg: ptr) {
    t: time = load arg
    bp: ptr = addr bang
    bn: i64 = len bang
    report(bp, bn, t)
    ; a one-shot task at 63/100 s: a task, so it may take its time
    sixtythree: time = seconds(63)
    hundredth: time = period(100)
    ts: time = mul sixtythree, hundredth
    sp: ptr = addr star_at
    store ts, sp
    fs: fn(ptr) = addr star
    run_at(ts, fs, sp)
    ; and the next one a quarter of a second after this one's time —
    ; the scheduled time, not the late moment it is running at
    quarter: time = period(4)
    t2: time = add t, quarter
    pp: ptr = addr pong_at
    store t2, pp
    fp: fn(ptr) = addr pong
    at(t2, fp, pp)
    ret
}
; the one-shot task's work: a region of its own from the heap, used
; through an arena, given back — a task's lifetime, carved and returned
fn star(arg: ptr) {
    hp: ptr = addr the_heap
    mem: ptr = heap_take(hp, 4096)
    a: ptr = scratch 24
    arena_init(a, mem, 4096)
    msg: ptr = arena_alloc(a, 64)
    bp: ptr = addr starlabel
    bn: i64 = len starlabel
    loop(i: i64 = 0) {
        done: u1 = cmp.ge i, bn
        if done {
            break
        }
        c: u8 = load bp, i, 1
        store c, msg, i, 1
        i1: i64 = add i, 1
        continue i1
    }
    t: time = load arg
    report(msg, bn, t)
    heap_give(hp, mem, 4096)
    ret
}
fn pong(arg: ptr) {
    t: time = load arg
    bp: ptr = addr bangbang
    bn: i64 = len bangbang
    report(bp, bn, t)
    ret
}
fn report(label: ptr, n: i64, t: time) {
    say(label, n)
    now: time = now_time()
    late: time = sub now, t
    lu: i64 = to_micros(late)
    du: i64 = to_micros(t)
    print_dec(du)
    sp: ptr = addr sep
    sn: i64 = len sep
    say(sp, sn)
    print_dec(lu)
    putc(10)
    ret
}

fn __trap(n: u64, a: u64, b: u64) -> u64 {
    exit()
    ret n
}

; sleep until a time: set the deadline, hand the cpu over, and — the
; interrupt being asynchronous — wait for the time to have come
fn sleep_until(i: i64, t: time) {
    p: ptr = task_block(i)
    store t, p, 16
    reschedule()
    loop() {
        n: time = now_time()
        due: u1 = cmp.ge n, t
        if due {
            break
        }
        idle()
        continue
    }
    ret
}

; --- the tasks: wake every period, report the wake ---
fn task_a() {
    p: time = period(10)
    run(97, 1, p, 10)
    ret
}
fn task_b() {
    p: time = period(3)
    run(98, 2, p, 3)
    ret
}
fn task_c() {
    p: time = period(7)
    run(99, 3, p, 7)
    ret
}
fn run(letter: u8, i: i64, per: time, count: i64) {
    loop(k: i64 = 1) {
        kt: time = seconds(k)
        d: time = mul per, kt
        sleep_until(i, d)
        n: time = now_time()
        late: time = sub n, d
        lu: i64 = to_micros(late)
        du: i64 = to_micros(d)
        putc(letter)
        putc(32)
        print_dec(du)
        sp: ptr = addr sep
        sn: i64 = len sep
        say(sp, sn)
        print_dec(lu)
        putc(10)
        wo: ptr = addr worst
        wv: i64 = load wo
        more: u1 = cmp.gt lu, wv
        if more {
            store lu, wo
        }
        wp: ptr = addr wakes
        w: u64 = load wp
        w1: u64 = add w, 1
        store w1, wp
        last: u1 = cmp.ge k, count
        if last {
            ; done: sleep forever
            far: time = seconds(1000000)
            sleep_until(i, far)
        }
        k1: i64 = add k, 1
        continue k1
    }
}

; --- output ---
fn putc(c: u8) {
    uart: ptr = platform uart
    c32: u32 = conv c
    store c32, uart
    ret
}
fn say(p: ptr, n: i64) {
    loop(i: i64 = 0) {
        done: u1 = cmp.ge i, n
        if done {
            break
        }
        c: u8 = load p, i, 1
        putc(c)
        i2: i64 = add i, 1
        continue i2
    }
    ret
}
fn say_summary() {
    p: ptr = addr summary
    n: i64 = len summary
    say(p, n)
    ret
}
fn say_us() {
    p: ptr = addr us
    n: i64 = len us
    say(p, n)
    ret
}
fn print_dec(v: i64) {
    buf: ptr = scratch 32
    n: i64 = loop(x: i64 = v, i: i64 = 0) {
        d: i64 = rem x, 10
        c: u8 = conv d
        c48: u8 = add c, 48
