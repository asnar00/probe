uint8 out$

on write (uint8 c$)
platform ir
    n: i64 = count(c)
    c2: u8$ = advance(c, n)
    ret c2

write(out$)

on print (string s)
    out$ << s << "\n"

on print (int x$)
platform ir
    f: int[] = unread(x)
    n: i64 = len f
    loop(i: i64 = 0)
        done: u1 = cmp.ge i, n
        if done
            break
        first: u1 = cmp.eq i, 0
        if first
        else
            __out_ch(32)
        v: int = load f, i
        __print_int(v)
        i2: i64 = add i, 1
        continue i2
    __out_ch(10)
    ret
