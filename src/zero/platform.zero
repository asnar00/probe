char out$
char in$

on (char o$) << (int x)
    if (x < 0)
        o$ << "-"
    int m = if (x < 0) then (x) else (0 - x)
    int top = loop (int p = 1) while (m / p <= -10) yields p
        continue (p * 10)
    loop (int p = top) while (p > 0)
        o$ << char(48 - (m / p) % 10)
        continue (p / 10)

on (char o$) << (uint x)
    uint top = loop (uint p = 1) while (x / p >= 10) yields p
        continue (p * 10)
    loop (uint p = top) while (p > 0)
        o$ << char(48 + (x / p) % 10)
        continue (p / 10)

on (char o$) << (float x)
    if (x != x)
        o$ << "nan"
    else if (x - x != x - x)
        if (x < 0.0)
            o$ << "-inf"
        else
            o$ << "inf"
    else
        if (x < 0.0)
            o$ << "-"
        float m = if (x < 0.0) then (0.0 - x) else (x)
        int64 whole = int64(m)
        int64 scaled = int64((m - float(whole)) * 1000000.0 + 0.5)
        int64 carry = if (scaled >= 1000000) then (1) else (0)
        o$ << whole + carry
        o$ << "."
        int64 places, int64 digits = loop (int64 places = 6, int64 digits = scaled - carry * 1000000) while (places > 1) yields places, digits
            if (digits % 10 != 0)
                break
            continue (places - 1, digits / 10)
        int64 top = loop (int64 p = 1, int64 k = 1) while (k < places) yields p
            continue (p * 10, k + 1)
        loop (int64 p = top) while (p > 0)
            o$ << char(48 + (digits / p) % 10)
            continue (p / 10)

type time =
    int64 __steps

on (time t) << (time a) + (time b)
    t << time(a.__steps + b.__steps)

on (time t) << (time a) - (time b)
    t << time(a.__steps - b.__steps)

on (time t) << (time a) * (number k)
    t << time(int64(a.__steps * k))

on (time t) << (number k) * (time a)
    t << time(int64(k * a.__steps))

on (time t) << (time a) / (number k)
    t << time(int64(a.__steps / k))

on (float r) << (time a) / (time b)
    r << float(float64(a.__steps) / float64(b.__steps))

on (bool r) << (time a) < (time b)
    r << a.__steps < b.__steps

on (bool r) << (time a) <= (time b)
    r << a.__steps <= b.__steps

on (bool r) << (time a) > (time b)
    r << a.__steps > b.__steps

on (bool r) << (time a) >= (time b)
    r << a.__steps >= b.__steps

on (char o$) << (time x)
    int64 steps = x.__steps
    int64 n = if (steps < 0) then (0 - steps) else (steps)
    if (steps < 0)
        o$ << char(45)
    int64 unit = if (n == 0) then (1000000000) else (if (n >= 1000000000) then (1000000000) else (if (n >= 1000000) then (1000000) else (if (n >= 1000) then (1000) else (1))))
    o$ << n / unit
    int64 rest = n % unit
    if (rest != 0)
        o$ << char(46)
        int64 scale, int64 digits = loop (int64 scale = unit, int64 digits = rest) while (digits % 10 == 0) yields scale, digits
            continue (scale / 10, digits / 10)
        loop (int64 p = scale / 10) while (p > 0)
            o$ << char(48 + (digits / p) % 10)
            continue (p / 10)
    o$ << char(32)
    if (unit == 1000000)
        o$ << char(109)
    else if (unit == 1000)
        o$ << char(117)
    else if (unit == 1)
        o$ << char(110)
    o$ << char(115)

on (char o$) << (bool b)
    if (b)
        o$ << "true"
    else
        o$ << "false"

on (char o$) << (int x[])
    loop (int i = 0) while (i < count x[])
        if (i > 0)
            o$ << " "
        o$ << x[i]
        continue (i + 1)

on (char o$) << (float x[])
    loop (int i = 0) while (i < count x[])
        if (i > 0)
            o$ << " "
        o$ << x[i]
        continue (i + 1)

on print (string s)
    out$ << s << "\n"

on print (int x[])
    out$ << x[] << "\n"
