char out$
char in$

on (char o$) << (int x)
    if (x < 0)
        o$ << "-"
    int m = x if (x < 0) else 0 - x
    int top = loop (int p = 1) while (m / p <= -10) yields p
        continue (p * 10)
    loop (int p = top) while (p > 0)
        o$ << char(48 - (m / p) % 10)
        continue (p / 10)

on (char o$) << (uint x)
    uint top = loop (uint p = 1) while (x / p >= 10) yields p
        continue (p * 10)
    loop (uint p = top) while (p > 0)
        o$ << char(48 + (x / p) % 10)
        continue (p / 10)

on (char o$) << (float x)
    if (x != x)
        o$ << "nan"
    else if (x - x != x - x)
        if (x < 0.0)
            o$ << "-inf"
        else
            o$ << "inf"
    else
        if (x < 0.0)
            o$ << "-"
        float m = 0.0 - x if (x < 0.0) else x
        int64 whole = int64(m)
        int64 scaled = int64((m - float(whole)) * 1000000.0 + 0.5)
        int64 carry = 1 if (scaled >= 1000000) else 0
        o$ << whole + carry
        o$ << "."
        int64 places, int64 digits = loop (int64 places = 6, int64 digits = scaled - carry * 1000000) while (places > 1) yields places, digits
            if (digits % 10 != 0)
                break
            continue (places - 1, digits / 10)
        int64 top = loop (int64 p = 1, int64 k = 1) while (k < places) yields p
            continue (p * 10, k + 1)
        loop (int64 p = top) while (p > 0)
            o$ << char(48 + (digits / p) % 10)
            continue (p / 10)

type time =
    hidden int64 count
    hidden int64 divisor = 1

type nanoseconds =
    hidden int64 steps

on (time top) << over one divisor (time x, time k)
    int64 unit = loop (int64 p = x.divisor, int64 rest = k.divisor) while (rest != 0) yields p
        continue (rest, p % rest)
    int64 scale = k.divisor / unit
    int64 scaled = x.divisor / unit
    int64 m = 0 - x.count if (x.count < 0) else x.count
    int64 n = 0 - k.count if (k.count < 0) else k.count
    check (x.divisor <= 9223372036854775807 / scale and m <= 4611686018427387903 / scale and n <= 4611686018427387903 / scaled)
    int64 whole = x.count * scale + k.count * scaled
    int64 places = x.divisor * scale
    int64 digits = 0 - whole if (whole < 0) else whole
    int64 carry = loop (int64 p = places, int64 rest = digits) while (rest != 0) yields p
        continue (rest, p % rest)
    top << time(whole / carry, places / carry)

on (int64 steps) << nanoseconds of (time x)
    int64 whole = x.count / x.divisor
    int64 digits = loop (int64 p = 0, int64 rest = x.count % x.divisor, int64 i = 0) while (i < 9) yields p
        continue (p * 10 + rest * 10 / x.divisor, rest * 10 % x.divisor, i + 1)
    steps << whole * 1000000000 + digits

on (time t) << (time a) + (time b)
    t << (time(a.count + b.count, a.divisor) if (a.divisor == b.divisor) else time(a.count + b.count * (a.divisor / b.divisor), a.divisor) if (a.divisor % b.divisor == 0) else time(a.count * (b.divisor / a.divisor) + b.count, b.divisor) if (b.divisor % a.divisor == 0) else over one divisor (a, b))

on (time t) << (time a) - (time b)
    t << (time(a.count - b.count, a.divisor) if (a.divisor == b.divisor) else time(a.count - b.count * (a.divisor / b.divisor), a.divisor) if (a.divisor % b.divisor == 0) else time(a.count * (b.divisor / a.divisor) - b.count, b.divisor) if (b.divisor % a.divisor == 0) else over one divisor (a, time(0 - b.count, b.divisor)))

on (time t) << (time a) * (int k)
    t << time(a.count * k, a.divisor)

on (time t) << (int k) * (time a)
    t << time(k * a.count, a.divisor)

on (time t) << (time a) * (float k)
    t << (time(int64(a.count * (1000000000 / a.divisor) * k), 1000000000) if (1000000000 % a.divisor == 0) else time(int64(float64(a.count) * 1000000000.0 / float64(a.divisor) * k), 1000000000))

on (time t) << (float k) * (time a)
    t << (time(int64(k * (a.count * (1000000000 / a.divisor))), 1000000000) if (1000000000 % a.divisor == 0) else time(int64(k * (float64(a.count) * 1000000000.0 / float64(a.divisor))), 1000000000))

on (time top) << finer divisor (time x, int64 k)
    check (k >= 0 and k <= 9223372036854775807 / x.divisor)
    top << time(x.count, x.divisor * k)

on (time t) << (time a) / (int k)
    t << finer divisor (time(0 - a.count if (k < 0) else a.count, a.divisor), 0 - k if (k < 0) else k)

on (time t) << (time a) / (float k)
    t << (time(int64(a.count * (1000000000 / a.divisor) / k), 1000000000) if (1000000000 % a.divisor == 0) else time(int64(float64(a.count) * 1000000000.0 / float64(a.divisor) / k), 1000000000))

on (float r) << (time a) / (time b)
    r << float(float64(a.count) / float64(b.count) if (a.divisor == b.divisor) else float64(a.count * b.divisor) / float64(b.count * a.divisor))

on (bool r) << (time a) == (time b)
    r << ((a.count == b.count) if (a.divisor == b.divisor) else (a.count * b.divisor == b.count * a.divisor))

on (bool r) << (time a) != (time b)
    r << ((a.count != b.count) if (a.divisor == b.divisor) else (a.count * b.divisor != b.count * a.divisor))

on (bool r) << (time a) < (time b)
    r << ((a.count < b.count) if (a.divisor == b.divisor) else (a.count * b.divisor < b.count * a.divisor))

on (bool r) << (time a) <= (time b)
    r << ((a.count <= b.count) if (a.divisor == b.divisor) else (a.count * b.divisor <= b.count * a.divisor))

on (bool r) << (time a) > (time b)
    r << ((a.count > b.count) if (a.divisor == b.divisor) else (a.count * b.divisor > b.count * a.divisor))

on (bool r) << (time a) >= (time b)
    r << ((a.count >= b.count) if (a.divisor == b.divisor) else (a.count * b.divisor >= b.count * a.divisor))

on (char o$) << (time x)
    o$ << nanoseconds(x.count * (1000000000 / x.divisor) if (1000000000 % x.divisor == 0) else x.count * 1000000000 / x.divisor if (x.count < 9223372036 and x.count > -9223372036) else nanoseconds of (x))

on (char o$) << (nanoseconds x)
    int64 steps = x.steps
    int64 n = 0 - steps if (steps < 0) else steps
    if (steps < 0)
        o$ << char(45)
    int64 unit = 1000000000 if (n == 0) else 1000000000 if (n >= 1000000000) else 1000000 if (n >= 1000000) else 1000 if (n >= 1000) else 1
    o$ << n / unit
    int64 rest = n % unit
    if (rest != 0)
        o$ << char(46)
        int64 scale, int64 digits = loop (int64 scale = unit, int64 digits = rest) while (digits % 10 == 0) yields scale, digits
            continue (scale / 10, digits / 10)
        loop (int64 p = scale / 10) while (p > 0)
            o$ << char(48 + (digits / p) % 10)
            continue (p / 10)
    o$ << char(32)
    if (unit == 1000000)
        o$ << char(109)
    else if (unit == 1000)
        o$ << char(117)
    else if (unit == 1)
        o$ << char(110)
    o$ << char(115)

on (char o$) << (bool b)
    if (b)
        o$ << "true"
    else
        o$ << "false"

on (char o$) << (int x[])
    loop (int i = 0) while (i < [count] (x[]))
        if (i > 0)
            o$ << " "
        o$ << x[i]
        continue (i + 1)

on (char o$) << (float x[])
    loop (int i = 0) while (i < [count] (x[]))
        if (i > 0)
            o$ << " "
        o$ << x[i]
        continue (i + 1)

on print (string s)
    out$ << s << "\n"

on print (int x[])
    out$ << x[] << "\n"
