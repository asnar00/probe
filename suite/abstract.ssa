; abstract 'int' resolves per target policy: i64 on the register machines,
; i32 on wasm32 — and to either under --int=i32/--int=i64. These cases are
; policy-independent by construction: all values fit in i32, nothing
; overflows, and results are non-negative (so the i32 zero-extension
; convention and raw i64 results agree). Memory ops stay concrete-typed —
; a load of 'int' changes access width with the policy.
;! agcd 1071 462 -> 21
;! agcd 48 36 -> 12
;! asum 100 -> 4950
;! asum 0 -> 0
;! afib 15 -> 610
;! aclamp 250 0 100 -> 100
;! aclamp -5 0 100 -> 0
;! aclamp 42 0 100 -> 42
;! aeven 10 -> 1
;! aeven 7 -> 0

fn agcd(a: int, b: int) -> int {
    g: int = loop(x: int = a, y: int = b) {
        done: u1 = cmp.eq y, 0
        if done {
            break x
        }
        r: int = rem x, y
        continue y, r
    }
    ret g
}

fn asum(n: int) -> int {
    r: int = loop(i: int = 0, acc: int = 0) {
        done: u1 = cmp.ge i, n
        if done {
            break acc
        }
        acc2: int = add acc, i
        i2: int = add i, 1
        continue i2, acc2
    }
    ret r
}

fn afib(n: int) -> int {
    small: u1 = cmp.lt n, 2
    if small {
        ret n
    }
    n1: int = sub n, 1
    a: int = afib(n1)
    n2: int = sub n, 2
    b: int = afib(n2)
    r: int = add a, b
    ret r
}

; abstract and concrete types mix freely: u1 conditions, int arithmetic
fn aclamp(v: int, lo: int, hi: int) -> int {
    below: u1 = cmp.lt v, lo
    r: int = if below {
        yield lo
    } else {
        above: u1 = cmp.gt v, hi
        s: int = if above {
            yield hi
        } else {
            yield v
        }
        yield s
    }
    ret r
}

fn aeven(n: int) -> u1 {
    bit: int = and n, 1
    flip: int = xor bit, 1
    r: u1 = conv flip
    ret r
}
