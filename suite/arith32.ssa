; 32-bit ops: results wrap at 32 bits; i32 results print sign-extended,
; u32 results zero-extended (the canonical value of the declared type)
;! add32 0x7fffffff 1 -> -2147483648
;! mul32 65536 65536 -> 0
;! sdiv32 0xfffffff6 3 -> -3
;! srem32 0xfffffff9 4 -> -3
;! lshr32 0x80000000 31 -> 1
;! ashr32 0x80000000 31 -> -1
;! uadd32 0xffffffff 1 -> 0
;! umul32 0xffffffff 0xffffffff -> 1

fn add32(a: i32, b: i32) -> i32 {
entry:
    r: i32 = add a, b
    ret r
}
fn mul32(a: i32, b: i32) -> i32 {
entry:
    r: i32 = mul a, b
    ret r
}
fn sdiv32(a: i32, b: i32) -> i32 {
entry:
    r: i32 = div a, b
    ret r
}
fn srem32(a: i32, b: i32) -> i32 {
entry:
    r: i32 = rem a, b
    ret r
}
fn lshr32(a: u32, b: u32) -> u32 {
entry:
    r: u32 = shr a, b
    ret r
}
fn ashr32(a: i32, b: i32) -> i32 {
entry:
    r: i32 = shr a, b
    ret r
}
fn uadd32(a: u32, b: u32) -> u32 {
entry:
    r: u32 = add a, b
    ret r
}
fn umul32(a: u32, b: u32) -> u32 {
entry:
    r: u32 = mul a, b
    ret r
}
