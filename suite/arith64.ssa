; 64-bit arithmetic, one op per function; signedness comes from the types
;! add 3 4 -> 7
;! add -3 4 -> 1
;! sub 3 10 -> -7
;! mul -3 4 -> -12
;! sdivt -7 2 -> -3
;! sdivt 7 -2 -> -3
;! udivt -1 16 -> 1152921504606846975
;! sremt -7 2 -> -1
;! uremt -1 10 -> 5
;! andt 12 10 -> 8
;! ort 12 10 -> 14
;! xort 12 10 -> 6
;! shlt 3 62 -> -4611686018427387904
;! lshrt -1 60 -> 15
;! shrt -8 2 -> -2

fn add(a: i64, b: i64) -> i64 {
entry:
    r: i64 = add a, b
    ret r
}
fn sub(a: i64, b: i64) -> i64 {
entry:
    r: i64 = sub a, b
    ret r
}
fn mul(a: i64, b: i64) -> i64 {
entry:
    r: i64 = mul a, b
    ret r
}
fn sdivt(a: i64, b: i64) -> i64 {
entry:
    r: i64 = div a, b
    ret r
}
fn udivt(a: u64, b: u64) -> u64 {
entry:
    r: u64 = div a, b
    ret r
}
fn sremt(a: i64, b: i64) -> i64 {
entry:
    r: i64 = rem a, b
    ret r
}
fn uremt(a: u64, b: u64) -> u64 {
entry:
    r: u64 = rem a, b
    ret r
}
fn andt(a: i64, b: i64) -> i64 {
entry:
    r: i64 = and a, b
    ret r
}
fn ort(a: i64, b: i64) -> i64 {
entry:
    r: i64 = or a, b
    ret r
}
fn xort(a: i64, b: i64) -> i64 {
entry:
    r: i64 = xor a, b
    ret r
}
fn shlt(a: i64, b: i64) -> i64 {
entry:
    r: i64 = shl a, b
    ret r
}
fn lshrt(a: u64, b: u64) -> u64 {
entry:
    r: u64 = shr a, b
    ret r
}
fn shrt(a: i64, b: i64) -> i64 {
entry:
    r: i64 = shr a, b
    ret r
}

; MIN div -1 wraps to MIN on every target (wasm needs a guard: it traps)
;! divmin -9223372036854775808 -1 -> -9223372036854775808
;! divmin -9223372036854775808 1 -> -9223372036854775808
;! divmin 100 -1 -> -100
;! divmin 100 7 -> 14
fn divmin(a: i64, b: i64) -> i64 {
    q: i64 = div a, b
    ret q
}
