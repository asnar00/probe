; arbitrary-width integers: iN wraps at N bits and stays sign-extended,
; uN wraps and stays zero-extended; signedness comes from the type
;! add5 15 1 -> -16
;! add5 -16 -1 -> 15
;! uadd5 31 1 -> 0
;! mul5 7 7 -> -15
;! umul3 5 3 -> 7
;! div5 -16 -1 -> -16
;! div5 -7 2 -> -3
;! udiv5 31 4 -> 7
;! rem5 -7 2 -> -1
;! urem5 31 4 -> 3
;! shl5 1 4 -> -16
;! ushl5 3 3 -> 24
;! shr5 -16 2 -> -4
;! ushr5 16 2 -> 4
;! lt5 -1 1 -> 1
;! ult5 31 1 -> 0
;! add1 -1 -1 -> 0
;! uadd1 1 1 -> 0
;! add12 2047 1 -> -2048
;! add40 549755813887 1 -> -549755813888
;! uadd40 1099511627775 1 -> 0
;! ext5to8 -3 -> -3
;! uext5to8 29 -> 29
;! ext5tou8 -3 -> 253
;! uext5toi8 29 -> 29
;! trunc8to5 100 -> 4
;! trunc8to5 -1 -> -1
;! utrunc8to5 255 -> 31
;! bitcast5 -1 -> 31
;! bitcastu5 31 -> -1
;! neg5 -16 -> -16
;! neg5 5 -> -5
;! count5 -> 16
;! sumbytes_u8 -> 32640
;! ushr 4294967295 4 -> 268435455
;! sumbytes i8[-1,2,-3,4] -> 2
;! sumubytes u8[255,1] -> 256
;! sumhalves i16[-1000,1] -> -999
;! sumuhalves u16[65535,1] -> 65536
;! loadu32 u32[4294967295] -> 4294967295
;! loadi32 i32[-1] -> -1
;! storebyte u8[0,0] 200 -> 200

fn add5(a: i5, b: i5) -> i5 {
entry:
    r: i5 = add a, b
    ret r
}
fn uadd5(a: u5, b: u5) -> u5 {
entry:
    r: u5 = add a, b
    ret r
}
fn mul5(a: i5, b: i5) -> i5 {
entry:
    r: i5 = mul a, b
    ret r
}
