entry:
    r: u5 = shr a, b
    ret r
}
fn lt5(a: i5, b: i5) -> u1 {
entry:
    r: u1 = cmp.lt a, b
    ret r
}
fn ult5(a: u5, b: u5) -> u1 {
entry:
    r: u1 = cmp.lt a, b
    ret r
}
fn add1(a: i1, b: i1) -> i1 {
entry:
    r: i1 = add a, b
    ret r
}
fn uadd1(a: u1, b: u1) -> u1 {
entry:
    r: u1 = add a, b
    ret r
