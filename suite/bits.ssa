}
; ext fills by the source's signedness; the result is canonical for its type
fn ext5to8(a: i5) -> i8 {
entry:
    r: i8 = conv a
    ret r
}
fn uext5to8(a: u5) -> u8 {
entry:
    r: u8 = conv a
    ret r
}
fn ext5tou8(a: i5) -> u8 {
entry:
    r: u8 = conv a
    ret r
}
fn uext5toi8(a: u5) -> i8 {
entry:
    r: i8 = conv a
    ret r
}
fn trunc8to5(a: i8) -> i5 {
entry:
    r: i5 = conv a
    ret r
}
fn utrunc8to5(a: u8) -> u5 {
entry:
    r: u5 = conv a
    ret r
}
fn bitcast5(a: i5) -> u5 {
entry:
    r: u5 = cast a
    ret r
}
fn bitcastu5(a: u5) -> i5 {
entry:
    r: i5 = cast a
    ret r
}
; narrow values through calls stay canonical on both sides
fn negate5(a: i5) -> i5 {
entry:
    zero: i5 = const 0
    r: i5 = sub zero, a
    ret r
}
fn neg5(a: i5) -> i5 {
entry:
    r: i5 = negate5(a)
    ret r
}
; count increments of an i5 from 0 until it wraps negative
fn count5() -> i64 {
    zero: i5 = const 0
    n0: i64 = const 0
    r: i64 = loop(i: i5 = zero, n: i64 = n0) {
        neg: u1 = cmp.lt i, zero
        if neg {
            break n
        }
        one: i5 = const 1
        i2: i5 = add i, one
        n1: i64 = const 1
        n2: i64 = add n, n1
        continue i2, n2
    }
    ret r
}
; sum of every u8 value, accumulated in a u16
fn sumbytes_u8() -> u16 {
    zero: u8 = const 0
    acc0: u16 = const 0
    r: u16 = loop(i: u8 = zero, acc: u16 = acc0) {
        w: u16 = conv i
        acc2: u16 = add acc, w
        max: u8 = const 255
        done: u1 = cmp.eq i, max
        if done {
            break acc2
        }
        one: u8 = const 1
        i2: u8 = add i, one
        continue i2, acc2
    }
    ret r
}
; abstract uint follows int's width; this case fits both
fn ushr(a: uint, b: uint) -> uint {
entry:
    r: uint = shr a, b
    ret r
}
; 8- and 16-bit memory, sign- and zero-extending loads
fn sumbytes(p: ptr) -> i64 {
entry:
    one: i64 = const 1
    two: i64 = const 2
    three: i64 = const 3
    p1: ptr = ptradd p, one
    p2: ptr = ptradd p, two
    p3: ptr = ptradd p, three
    a: i8 = load p
    b: i8 = load p1
    c: i8 = load p2
    d: i8 = load p3
    aw: i64 = conv a
    bw: i64 = conv b
    cw: i64 = conv c
    dw: i64 = conv d
    s1: i64 = add aw, bw
    s2: i64 = add s1, cw
    s3: i64 = add s2, dw
    ret s3
}
fn sumubytes(p: ptr) -> u64 {
entry:
    one: i64 = const 1
    p1: ptr = ptradd p, one
    a: u8 = load p
    b: u8 = load p1
    aw: u64 = conv a
    bw: u64 = conv b
    s: u64 = add aw, bw
    ret s
}
fn sumhalves(p: ptr) -> i64 {
entry:
    two: i64 = const 2
    p1: ptr = ptradd p, two
    a: i16 = load p
    b: i16 = load p1
    aw: i64 = conv a
    bw: i64 = conv b
    s: i64 = add aw, bw
    ret s
}
fn sumuhalves(p: ptr) -> u64 {
entry:
    two: i64 = const 2
    p1: ptr = ptradd p, two
    a: u16 = load p
    b: u16 = load p1
    aw: u64 = conv a
    bw: u64 = conv b
    s: u64 = add aw, bw
    ret s
}
fn loadu32(p: ptr) -> u32 {
entry:
    r: u32 = load p
    ret r
}
fn loadi32(p: ptr) -> i32 {
entry:
    r: i32 = load p
    ret r
}
; a byte store must leave its neighbour alone: read back both as a u16
fn storebyte(p: ptr, v: u8) -> u16 {
entry:
    store v, p
    r: u16 = load p
    ret r
}
