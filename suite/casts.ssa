; width changes; i32 args arrive as raw low-32 bit patterns
;! sext32 0xfffffff6 -> -10
;! sext32 10 -> 10
;! zext32 0xfffffff6 -> 4294967286
;! trunc64 0x1ffffffff -> 4294967295
;! bit 7 -> 1
;! bit 6 -> 0
;! sextbit 7 -> -1
;! sextbit 6 -> 0
;! zextbit 7 -> 1

fn @sext32(%a: i32) -> i64 {
^entry:
    %r: i64 = ext %a
    ret %r
}
fn @zext32(%a: u32) -> u64 {
^entry:
    %r: u64 = ext %a
    ret %r
}
fn @trunc64(%a: i64) -> i32 {
^entry:
    %r: i32 = trunc %a
    ret %r
}
fn @bit(%a: u64) -> u1 {
^entry:
    %r: u1 = trunc %a
    ret %r
}
fn @sextbit(%a: i64) -> i64 {
^entry:
    %b: i1 = trunc %a
    %r: i64 = ext %b
    ret %r
}
fn @zextbit(%a: u64) -> u64 {
^entry:
    %b: u1 = trunc %a
    %r: u64 = ext %b
    ret %r
}
