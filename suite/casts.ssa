; width changes: ext fills by the source's signedness, trunc keeps the
; low bits, and the result is canonical for its type
;! sext32 0xfffffff6 -> -10
;! sext32 10 -> 10
;! zext32 0xfffffff6 -> 4294967286
;! trunc64 0x1ffffffff -> -1
;! utrunc64 0x1ffffffff -> 4294967295
;! bit 7 -> 1
;! bit 6 -> 0
;! sextbit 7 -> -1
;! sextbit 6 -> 0
;! zextbit 7 -> 1
;! recast -1 -> 4294967295
;! recast 5 -> 5

fn sext32(a: i32) -> i64 {
entry:
    r: i64 = conv a
    ret r
}
fn zext32(a: u32) -> u64 {
entry:
    r: u64 = conv a
    ret r
}
fn trunc64(a: i64) -> i32 {
entry:
    r: i32 = conv a
    ret r
}
fn utrunc64(a: i64) -> u32 {
entry:
    r: u32 = conv a
    ret r
}
fn bit(a: i64) -> u1 {
entry:
    r: u1 = conv a
    ret r
}
; a signed 1-bit value is 0 or -1: ext replicates the bit
fn sextbit(a: i64) -> i64 {
entry:
    b: i1 = conv a
    r: i64 = conv b
    ret r
}
fn zextbit(a: i64) -> i64 {
entry:
    b: u1 = conv a
    r: i64 = conv b
    ret r
}
; i32 -> u32 keeps the bits and changes the value's reading
fn recast(a: i32) -> u32 {
entry:
    r: u32 = cast a
    ret r
}
