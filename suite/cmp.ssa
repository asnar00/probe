fn @ugt(%a: i64, %b: i64) -> i1 {
^entry:
    %r: i1 = icmp.ugt %a, %b
    ret %r
}
fn @uge(%a: i64, %b: i64) -> i1 {
^entry:
    %r: i1 = icmp.uge %a, %b
    ret %r
}
