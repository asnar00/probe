; loops, block params (including a swap-shaped loop pair), recursion,
; calls — written abstract-first: 'int' resolves per policy, and every
; value here fits both widths
;! sum 10 -> 45
;! sum 0 -> 0
;! sum 100 -> 4950
;! gcd 48 36 -> 12
;! gcd 1071 462 -> 21
;! gcd 7 13 -> 1
;! fib 10 -> 55
;! fib 20 -> 6765
;! fib 1 -> 1
;! hypot2 3 4 -> 25
;! collatz 27 -> 111

fn sum(n: int) -> int {
^entry:
    zero: int = iconst 0
    jmp ^loop(zero, zero)
^loop(i: int, acc: int):
    done: u1 = icmp.ge i, n
    br done, ^exit, ^body
^body:
    acc2: int = iadd acc, i
    one: int = iconst 1
    %i2: int = iadd i, one
    jmp ^loop(%i2, acc2)
^exit:
    ret acc
}

fn gcd(a: int, b: int) -> int {
^entry:
    jmp ^loop(a, b)
^loop(x: int, y: int):
    zero: int = iconst 0
    done: u1 = icmp.eq y, zero
    br done, ^exit, ^step
^step:
    r: int = rem x, y
    jmp ^loop(y, r)
^exit:
    ret x
}

fn fib(n: int) -> int {
^entry:
    two: int = iconst 2
    small: u1 = icmp.lt n, two
    br small, ^base, ^rec
^base:
    ret n
^rec:
    one: int = iconst 1
    n1: int = isub n, one
    a: int = fib(n1)
    n2: int = isub n, two
    b: int = fib(n2)
    r: int = iadd a, b
    ret r
}

fn square(x: int) -> int {
^entry:
    r: int = imul x, x
    ret r
}

fn hypot2(a: int, b: int) -> int {
^entry:
    aa: int = square(a)
    bb: int = square(b)
    s: int = iadd aa, bb
    ret s
}

; steps to reach 1: n -> n/2 (even) | 3n+1 (odd)
fn collatz(n: int) -> int {
^entry:
    zero: int = iconst 0
    jmp ^loop(n, zero)
^loop(x: int, steps: int):
    one: int = iconst 1
    done: u1 = icmp.eq x, one
    br done, ^exit, ^step
^step:
    two: int = iconst 2
    parity: int = and x, one
    odd: u1 = trunc parity
    s2: int = iadd steps, one
    br odd, ^odd, ^even
^odd:
    three: int = iconst 3
    t: int = imul x, three
    t1: int = iadd t, one
    jmp ^loop(t1, s2)
^even:
    h: int = div x, two
    jmp ^loop(h, s2)
^exit:
    ret steps
}
