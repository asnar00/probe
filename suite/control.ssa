; loops, block params (including a swap-shaped loop pair), recursion, calls
;! sum 10 -> 45
;! sum 0 -> 0
;! sum 100 -> 4950
;! gcd 48 36 -> 12
;! gcd 1071 462 -> 21
;! gcd 7 13 -> 1
;! fib 10 -> 55
;! fib 20 -> 6765
;! fib 1 -> 1
;! hypot2 3 4 -> 25
;! collatz 27 -> 111

fn sum(n: i64) -> i64 {
entry:
    zero: i64 = iconst 0
    jmp loop(zero, zero)
loop(i: i64, acc: i64):
    done: u1 = icmp.ge i, n
    br done, exit, body
body:
    acc2: i64 = add acc, i
    one: i64 = iconst 1
    i2: i64 = add i, one
    jmp loop(i2, acc2)
exit:
    ret acc
}

fn gcd(a: i64, b: i64) -> i64 {
entry:
    jmp loop(a, b)
loop(x: i64, y: i64):
    zero: i64 = iconst 0
    done: u1 = icmp.eq y, zero
    br done, exit, step
step:
    r: i64 = rem x, y
    jmp loop(y, r)
exit:
    ret x
}

fn fib(n: i64) -> i64 {
entry:
    two: i64 = iconst 2
    small: u1 = icmp.lt n, two
    br small, base, rec
base:
    ret n
rec:
    one: i64 = iconst 1
    n1: i64 = sub n, one
    a: i64 = fib(n1)
    n2: i64 = sub n, two
    b: i64 = fib(n2)
    r: i64 = add a, b
    ret r
}

fn square(x: i64) -> i64 {
entry:
    r: i64 = mul x, x
    ret r
}

fn hypot2(a: i64, b: i64) -> i64 {
entry:
    aa: i64 = square(a)
    bb: i64 = square(b)
    s: i64 = add aa, bb
    ret s
}

; steps to reach 1: n -> n/2 (even) | 3n+1 (odd)
fn collatz(n: i64) -> i64 {
entry:
    zero: i64 = iconst 0
    jmp loop(n, zero)
loop(x: i64, steps: i64):
    one: i64 = iconst 1
    done: u1 = icmp.eq x, one
    br done, exit, step
step:
    two: i64 = iconst 2
    parity: i64 = and x, one
    odd: u1 = trunc parity
    s2: i64 = add steps, one
    br odd, odd, even
odd:
    three: i64 = iconst 3
    t: i64 = mul x, three
    t1: i64 = add t, one
    jmp loop(t1, s2)
even:
    h: i64 = div x, two
    jmp loop(h, s2)
exit:
    ret steps
}
