    ret r
}
; clamp to [0, 1]: NaN falls through both tests to 0
fn clamp01(a: f32) -> f32 {
    hi: u1 = cmp.gt a, 1.0
    if hi {
        ret 1.0
    }
    ok: u1 = cmp.ge a, 0.0
    if ok {
        ret a
    }
    ret 0.0
}

