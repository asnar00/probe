; comparisons and sign operations by the opcode
fn lt32(a: f32, b: f32) -> u1 {
    r: u1 = cmp.lt a, b
    ret r
}
fn le32(a: f32, b: f32) -> u1 {
    r: u1 = cmp.le a, b
    ret r
}
