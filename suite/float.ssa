; IEEE-style floating point as packs plus integer instructions: generic
; add, sub, mul, div over float(E, M), instantiated for every format below.
; Round to nearest even, subnormals, signed zeros, infinities; every NaN
; comes out as the canonical quiet NaN. Because the generics are named
; after the opcodes and take float(E, M), the plain opcodes on any float
; dispatch to them — and a platform with hardware for that width
; substitutes the instruction.
type float(E, M) = pack { mantissa: u(M), exponent: u(E), sign: u1 }
type f32 = float(8, 23)
type f64 = float(11, 52)

fn fadd8 = add(4, 3)
fn fadd16 = add(5, 10)
fn faddb16 = add(8, 7)
fn fadd32 = add(8, 23)
fn fadd64 = add(11, 52)
fn fsub8 = sub(4, 3)
fn fsub16 = sub(5, 10)
fn fsub32 = sub(8, 23)
fn fsub64 = sub(11, 52)
fn fmul8 = mul(4, 3)
fn fmul16 = mul(5, 10)
fn fmulb16 = mul(8, 7)
fn fmul32 = mul(8, 23)
fn fmul64 = mul(11, 52)
fn fdiv8 = div(4, 3)
fn fdiv16 = div(5, 10)
fn fdiv32 = div(8, 23)
fn fdiv64 = div(11, 52)

