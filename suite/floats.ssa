; floating point across every backend, written with the abstract 'float'
; type (the house style): values chosen exact in BOTH widths, so the same
; expectations hold under --float=f32 and --float=f64. Width-specific
; tests (f32 arithmetic, f64 bit patterns) keep concrete types.
;! favg 2.5 7.5 -> 5.0
;! favg -1.0 4.0 -> 1.5
;! fquad 2.0 -> 17.0
;! fdiv2 7.0 2.0 -> 3.5
;! fmax 2.5 -3.5 -> 2.5
;! fmax -0.5 8.25 -> 8.25
;! f2i 7.9 -> 7
;! f2i -7.9 -> -7
;! i2f 5 -> 5.0
;! i2f -12 -> -12.0
;! fbits 1.0 -> 4607182418800017408
;! fround 2.75 -> 2.0
;! fsum32 0.25 0.5 -> 0.75
;! fpromo 0.5 -> 0.5
;! floop 10 -> 5.5

; (a + b) / 2
fn @favg(%a: float, %b: float) -> float {
^entry:
    %s: float = fadd %a, %b
    %two: float = fconst 2.0
    %r: float = fdiv %s, %two
    ret %r
}

; 3x^2 + 2x + 1
fn @fquad(%x: float) -> float {
^entry:
    %three: float = fconst 3.0
    %two: float = fconst 2.0
    %one: float = fconst 1.0
    %xx: float = fmul %x, %x
    %t1: float = fmul %three, %xx
    %t2: float = fmul %two, %x
    %s1: float = fadd %t1, %t2
    %r: float = fadd %s1, %one
    ret %r
}

fn @fdiv2(%a: float, %b: float) -> float {
^entry:
    %r: float = fdiv %a, %b
    ret %r
}

; branches on float comparison
fn @fmax(%a: float, %b: float) -> float {
    %gt: u1 = fcmp.ogt %a, %b
    %r: float = if %gt {
        yield %a
    } else {
        yield %b
    }
    ret %r
}

; float -> int truncates toward zero on every target
fn @f2i(%x: float) -> int {
^entry:
    %r: int = ftoi %x
    ret %r
}

fn @i2f(%n: int) -> float {
^entry:
    %r: float = itof %n
    ret %r
}

fn @fbits(%x: f64) -> i64 {
^entry:
    %r: i64 = bitcast %x
    ret %r
}

; round toward zero, back to float: trunc(2.75) = 2.0
fn @fround(%x: float) -> float {
^entry:
    %i: int = ftoi %x
    %r: float = itof %i
    ret %r
}

; f32 arithmetic (exact values)
fn @fsum32(%a: f32, %b: f32) -> f32 {
^entry:
    %r: f32 = fadd %a, %b
    ret %r
}

; f32 -> f64 -> f32 round trip of an exact value
fn @fpromo(%a: f32) -> f32 {
^entry:
    %w: f64 = fpromote %a
    %two: f64 = fconst 2.0
    %d: f64 = fmul %w, %two
    %h: f64 = fconst 0.5
    %d2: f64 = fmul %d, %h
    %r: f32 = fdemote %d2
    ret %r
}

; float accumulation in a loop with an int counter: sum of i/2 for i=1..n
; wait: 1+2+..10 = 55, /10 = 5.5 -> mean of 1..n
fn @floop(%n: int) -> float {
    %zero: int = iconst 0
    %fz: float = fconst 0.0
    %r: float = loop(%i: int = %zero, %acc: float = %fz) {
        %done: u1 = icmp.ge %i, %n
        if %done {
            break %acc
        }
        %one: int = iconst 1
        %i2: int = iadd %i, %one
        %fi: float = itof %i2
        %acc2: float = fadd %acc, %fi
        continue %i2, %acc2
    }
    %fn_: float = itof %n
    %m: float = fdiv %r, %fn_
    ret %m
}
