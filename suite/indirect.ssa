; function values: `fn(i64) -> i64` is a type, `addr sq` a value of it,
; and a call through the value looks like any other call — the type
; carries the signature, so the verifier checks it the same way. A
; function value goes anywhere a value goes: parameters, block
; parameters, results, memory.

;! apply_sq 7 -> 49
;! apply_neg 7 -> -7
;! pick 1 5 3 -> 8
;! pick 0 5 3 -> 2
;! twice_sq 3 -> 81
;! via_memory i64[0,0] 6 -> 42
;! fold i64[1,2,3,4] 4 0 -> 10
;! fold i64[1,9,3,4] 4 1 -> 9
;! divmod_ind 17 5 -> 3, 2
;! hyp_ind 0x40400000 0x40800000 -> 0x40a00000
;! fact_ind 5 -> 120
;! chosen 1 10 -> 20
;! chosen 0 10 -> 11
;! fill i64[0,0,0] 3 -> 3
;! stepped 5 -> 10
;! same_fn 1 -> 1
;! same_fn 0 -> 0

type unary = fn(i64) -> i64
type binary = fn(i64, i64) -> i64

fn sq(x: i64) -> i64 {
    r: i64 = mul x, x
    ret r
}
fn neg(x: i64) -> i64 {
    r: i64 = sub 0, x
    ret r
}
fn add64(a: i64, b: i64) -> i64 {
    r: i64 = add a, b
    ret r
}
fn sub64(a: i64, b: i64) -> i64 {
    r: i64 = sub a, b
    ret r
}
fn max64(a: i64, b: i64) -> i64 {
    lt: u1 = cmp.lt a, b
    r: i64 = if lt {
        yield b
    } else {
        yield a
    }
    ret r
}

; a value of the type, called
fn apply(f: unary, x: i64) -> i64 {
    r: i64 = f(x)
    ret r
}
fn apply_sq(x: i64) -> i64 {
    f: unary = addr sq
    r: i64 = apply(f, x)
    ret r
}
fn apply_neg(x: i64) -> i64 {
    f: unary = addr neg
    r: i64 = apply(f, x)
    ret r
}

; chosen by a condition, then called
fn pick(which: u1, a: i64, b: i64) -> i64 {
    f: binary = if which {
        g: binary = addr add64
        yield g
    } else {
        h: binary = addr sub64
        yield h
    }
    r: i64 = f(a, b)
    ret r
}

; twice: f(f(x))
fn twice(f: unary, x: i64) -> i64 {
    y: i64 = f(x)
    z: i64 = f(y)
    ret z
}
fn twice_sq(x: i64) -> i64 {
    f: unary = addr sq
    r: i64 = twice(f, x)
    ret r
}

; stored and loaded like any 64-bit value
fn via_memory(p: ptr, x: i64) -> i64 {
    f: unary = addr sq
    g: unary = addr add6
    store f, p
    store g, p, 8
    f2: unary = load p
    g2: unary = load p, 8
    y: i64 = f2(x)
    z: i64 = g2(y)
    ret z
}
fn add6(x: i64) -> i64 {
    r: i64 = add x, 6
    ret r
}

; a reducer carried around a loop as a block parameter
fn fold(p: ptr, n: i64, which: u1) -> i64 {
    f: binary = if which {
        g: binary = addr max64
        yield g
    } else {
        h: binary = addr add64
        yield h
    }
    acc: i64 = loop(i: i64 = 0, s: i64 = 0, r: binary = f) {
        done: u1 = cmp.ge i, n
        if done {
            break s
        }
        v: i64 = load p, i, 8
        s2: i64 = r(s, v)
        i2: i64 = add i, 1
        continue i2, s2, r
    }
    ret acc
}

; two results through a value
fn divmod(a: i64, b: i64) -> (i64, i64) {
    q: i64 = div a, b
    r: i64 = rem a, b
    ret q, r
}
fn divmod_ind(a: i64, b: i64) -> (i64, i64) {
    f: fn(i64, i64) -> (i64, i64) = addr divmod
    q: i64, r: i64 = f(a, b)
    ret q, r
}

; float arguments and result through a value (a library type; on a
; platform with an FPU they travel in float registers)
fn hyp(a: f32, b: f32) -> f32 {
    aa: f32 = mul a, a
    bb: f32 = mul b, b
    s: f32 = add aa, bb
    r: f32 = sqrt s
    ret r
}
fn hyp_ind(a: f32, b: f32) -> f32 {
    f: fn(f32, f32) -> f32 = addr hyp
    r: f32 = f(a, b)
    ret r
}

; recursion through a value
fn fact(n: i64) -> i64 {
    done: u1 = cmp.le n, 1
    r: i64 = if done {
        yield 1
    } else {
        f: unary = addr fact
        m: i64 = sub n, 1
        p: i64 = f(m)
        q: i64 = mul n, p
        yield q
    }
    ret r
}
fn fact_ind(n: i64) -> i64 {
    f: unary = addr fact
    r: i64 = f(n)
    ret r
}

; a function value returned from a function
fn choose(which: u1) -> unary {
    f: unary = if which {
        g: unary = addr dbl
        yield g
    } else {
        h: unary = addr inc
        yield h
    }
    ret f
}
fn dbl(x: i64) -> i64 {
    r: i64 = add x, x
    ret r
}
fn inc(x: i64) -> i64 {
    r: i64 = add x, 1
    ret r
}
fn chosen(which: u1, x: i64) -> i64 {
    f: unary = choose(which)
    r: i64 = f(x)
    ret r
}

; no results: a callback that writes memory
fn put(p: ptr, i: i64) {
    store i, p, i, 8
    ret
}
fn fill(p: ptr, n: i64) -> i64 {
    f: fn(ptr, i64) = addr put
    loop(i: i64 = 0) {
        done: u1 = cmp.ge i, n
        if done {
            break
        }
        f(p, i)
        i2: i64 = add i, 1
        continue i2
    }
    v: i64 = load p, 16
    s: i64 = add v, 1
    ret s
}

; results ignored at the call site
fn stepped(x: i64) -> i64 {
    f: unary = addr sq
    f(x)
    r: i64 = add x, x
    ret r
}

; a function value is its address: the same function gives the same value
fn same_fn(which: u1) -> u1 {
    f: unary = addr sq
    g: unary = if which {
        h: unary = addr sq
        yield h
    } else {
        h2: unary = addr neg
        yield h2
    }
    fa: u64 = cast f
    ga: u64 = cast g
    eq: u1 = cmp.eq fa, ga
    ret eq
}
