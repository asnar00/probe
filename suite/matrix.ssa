; views with a shape (lib/slice.ssa): `f32[,]` is a rank-2 view — its
; data and, per axis, a count and a stride — so `at a, i` is a row,
; `transpose a` the same memory with its axes swapped, `block` a
; rectangle, `reshape` a shape over a contiguous run; operations of
; rank 2 are the rank-1 ones over each row, and a reduction one rank
; down is one per row.

;! grid -> 66, 20
;! rows_cols -> 6, 15
;! transposed -> 5, 3
;! blocks -> 54, 4
;! strided -> 14, 42
;! cube -> 84, 7
;! rowmax -> 4, 12
;! outside2 -> check
;! ragged -> check
;! dotp 1 2 3 4 -> 30
;! matmul_small -> 212, 64
;! broadcast -> 100, 15
;! heap_buffers u8[0*8192] -> 30, 0
;! normalize -> 0x3f400000, 0x3f000000
;! bilinear -> 3, 11
;! bilinear_edges -> 8, 3
;! bilinear_f32 -> 0x41700000

data m: buffer(i32, 12)
data m2: buffer(i32, 12)
data f: buffer(f32, 16)
data c3: buffer(i32, 24)


; the 3x4 grid 0..11, by indexed stores — every case builds its own,
; since a path may start each case with fresh memory
fn ramp(a: i32[,]) {
    loop(i: i64 = 0) {
        done: u1 = cmp.ge i, 3
        if done {
            break
        }
        loop(j: i64 = 0) {
            done2: u1 = cmp.ge j, 4
            if done2 {
                break
            }
            i4: i64 = mul i, 4
            k: i64 = add i4, j
            v: i32 = conv k
            store v, a, i, j
            j2: i64 = add j, 1
            continue j2
        }
        i2: i64 = add i, 1
        continue i2
    }
    ret
}

; the grid's whole sum, and the element at (1, 2)
fn grid() -> (i32, i32) {
    p: ptr = addr m
    a: i32[,] = slice p, 3, 4
    ramp(a)
    s: i32 = sum a
    x: i32 = load a, 1, 2
    n: i64 = shape a, 1
    n32: i32 = conv n
    y: i32 = mul x, n32
    e: i32 = sub y, 4
    ret s, e
}

; rows: the sum of row 1 (4+5+6+7 = 22) and of column 1 through the
; transpose (1+5+9 = 15)... row 0 = 0..3 sums to 6
fn rows_cols() -> (i32, i32) {
    p: ptr = addr m
    a: i32[,] = slice p, 3, 4
    ramp(a)
    r0: i32[] = at a, 0
    s0: i32 = sum r0
    t: i32[,] = transpose a
    c1: i32[] = at t, 1
    s1: i32 = sum c1
    ret s0, s1
}

; the transpose's shape, and its element (2, 1) — which is (1, 2) of the grid
fn transposed() -> (i64, i32) {
    p: ptr = addr m
    a: i32[,] = slice p, 3, 4
    ramp(a)
    t: i32[,] = transpose a
    n0: i64 = shape t, 0
    n1: i64 = shape t, 1
    ns: i64 = add n0, n1
    n5: i64 = sub ns, 2
    x: i32 = load t, 2, 1
    y: i32 = sub x, 3
    ret n5, y
}

; a 2x2 block at (1, 1): 5 6 / 9 10 sums to 30; doubled through add
; into a second grid's block: 60; its max 20 — and a 1-element block
fn blocks() -> (i32, i32) {
    p: ptr = addr m
    q: ptr = addr m2
    a: i32[,] = slice p, 3, 4
    ramp(a)
    b: i32[,] = slice q, 3, 4
    fill b, 0
    ab: i32[,] = block a, 1, 2, 1, 2
    bb: i32[,] = block b, 1, 2, 1, 2
    add bb, ab, ab
    s: i32 = sum b
    hi: i32 = max bb
    s2: i32 = sub s, 6
    one: i32[,] = block a, 2, 1, 3, 1
    v: i32 = sum one
    w: i32 = sub v, 7
    ret s2, w
}

; a column is a strided rank-1 view: fill it, scale it, sum it — the
; contiguous path is not taken and the answer is the same
fn strided() -> (i32, i32) {
    p: ptr = addr m2
    b: i32[,] = slice p, 3, 4
    fill b, 1
    t: i32[,] = transpose b
    c2: i32[] = at t, 2
    fill c2, 5
    mul c2, c2, 2
    s: i32 = sum c2
    sc: i32 = sub s, 16
    all: i32 = sum b
    a2: i32 = add all, 3
    ret sc, a2
}

; rank 3: 2x3x4 filled with 1, the slab at 1 filled with 3: sums 12 + 36
; = 48... plus a per-slab reduction
fn cube() -> (i32, i32) {
    p: ptr = addr c3
    a: i32[,,] = slice p, 2, 3, 4
    fill a, 1
    s1: i32[,] = at a, 1
    fill s1, 3
    s: i32 = sum a
    q: ptr = addr m2
    per: i32[,] = slice q, 2, 3
    sum per, a
    x: i32 = load per, 1, 0
    y: i32 = sub x, 5
    s2: i32 = add s, 36
    ret s2, y
}

; per-row maxima and sums of the 3x4 grid, into rank-1 views
fn rowmax() -> (i32, i32) {
    p: ptr = addr m
    a: i32[,] = slice p, 3, 4
    ramp(a)
    q: ptr = addr m2
    all: i32[] = slice q
    mx: i32[] = view all, 0, 3
    max mx, a
    x: i32 = load mx, 0
    x2: i32 = add x, 1
    sm: i32[] = view all, 3, 3
    sum sm, a
    y: i32 = load sm, 0
    y2: i32 = add y, 6
    ret x2, y2
}

fn outside2() -> i32 {
    p: ptr = addr m
    a: i32[,] = slice p, 3, 4
    x: i32 = load a, 3, 0
    ret x
}

fn ragged() -> i32 {
    p: ptr = addr m
    q: ptr = addr m2
    a: i32[,] = slice p, 3, 4
    b: i32[,] = slice q, 4, 3
    add b, a, a
    ret 0
}

data ma: buffer(i32, 6)
data mb: buffer(i32, 6)
data mc: buffer(i32, 4)
data fr: buffer(f32, 4)
data fc: buffer(f32, 4)
data fs: buffer(f32, 2)

; the dot of a vector with itself: 1 + 4 + 9 + 16
fn dotp(a0: i32, a1: i32, a2: i32, a3: i32) -> i32 {
    q: ptr = addr m2
    all: i32[] = slice q
    v: i32[] = view all, 0, 4
    store a0, v, 0
    store a1, v, 1
    store a2, v, 2
    store a3, v, 3
    d: i32 = dot v, v
    ret d
}

; [[1 2 3] [4 5 6]] times [[7 8] [9 10] [11 12]] is [[58 64] [139 154]]
fn matmul_small() -> (i32, i32) {
    pa: ptr = addr ma
    pb: ptr = addr mb
    pc: ptr = addr mc
    a: i32[,] = slice pa, 2, 3
    b: i32[,] = slice pb, 3, 2
    c: i32[,] = slice pc, 2, 2
    loop(k: i64 = 0) {
        done: u1 = cmp.ge k, 6
        if done {
            break
        }
        k32: i32 = conv k
        va: i32 = add k32, 1
        vb: i32 = add k32, 7
        i: i64 = div k, 3
        j: i64 = rem k, 3
        store va, a, i, j
        i2: i64 = div k, 2
        j2: i64 = rem k, 2
        store vb, b, i2, j2
        k2: i64 = add k, 1
        continue k2
    }
    matmul c, a, b
    one: i32 = const 1
    x: i32 = load c, 0, 0
    y: i32 = load c, one, one
    z: i32 = load c, 0, one
    t: i32 = add x, y
    ret t, z
}

; row 0 of the grid made [1 2 3 4] (a view: the grid changes too, to 70)
; and added to every row: 70 + 30; the last element 11 + 4
fn broadcast() -> (i32, i32) {
    p: ptr = addr m
    q: ptr = addr m2
    a: i32[,] = slice p, 3, 4
    ramp(a)
    c: i32[,] = slice q, 3, 4
    r: i32[] = at a, 0
    add r, r, 1
    add c, a, r
    s: i32 = sum c
    e: i32 = load c, 2, 3
    ret s, e
}

; a buffer taken from a heap and given back: ten i32 of 3 sum to 30,
; and nothing is out afterwards
fn heap_buffers(mem: ptr) -> (i32, i64) {
    h: ptr = scratch 56
    heap_init(h, mem, 8192, 256)
    b: ptr = buffer_take(h, 4, 10)
    a: i32[] = slice b
    fill a, 3
    s: i32 = sum a
    buffer_give(h, b)
    out: i64 = load h, 32
    ret s, out
}

; rows of [[1 3] [1 1]] divided by their sums, [4 2]: a per-row scalar
; is a column broadcast, which is a row broadcast on the transposes
fn normalize() -> (f32, f32) {
    p: ptr = addr fr
    q: ptr = addr fc
    r: ptr = addr fs
    a: f32[,] = slice p, 2, 2
    c: f32[,] = slice q, 2, 2
    s: f32[] = slice r
    store 1.0, a, 0, 0
    store 3.0, a, 0, 1
    store 1.0, a, 1, 0
    store 1.0, a, 1, 1
    sum s, a
    at: f32[,] = transpose a
    ct: f32[,] = transpose c
    div ct, at, s
    x: f32 = load c, 0, 1
    y: f32 = load c, 1, 0
    ret x, y
}

; --- sampling a view by coordinate (lib/sample.ssa): bilinear, x along
; the columns, y along the rows, the edges clamped ---
; on the 3x4 ramp: (1.5, 0.5) is between 1, 2, 5, 6: 3.5, rounded into
; i32 as 3; (3, 2) is the last element exactly
fn bilinear() -> (i32, i32) {
    p: ptr = addr m
    a: i32[,] = slice p, 3, 4
    ramp(a)
    u: f32 = const 1.5
    v: f32 = const 0.5
    x: i32 = sample a, u, v
    u2: f32 = const 3.0
    v2: f32 = const 2.0
    y: i32 = sample a, u2, v2
    ret x, y
}
; off the left and below the bottom is the corner 8; off the right at
; y = 0.2 is 3 + 4 * 0.2, rounded into i32 as 3
fn bilinear_edges() -> (i32, i32) {
    p: ptr = addr m
    a: i32[,] = slice p, 3, 4
    ramp(a)
    u: f32 = const -1.0
    v: f32 = const 5.0
    x: i32 = sample a, u, v
    u2: f32 = const 3.7
    v2: f32 = const 0.2
    y: i32 = sample a, u2, v2
    ret x, y
}
; a 2x2 of floats 0, 10, 20, 30: the centre is 15.0
fn bilinear_f32() -> f32 {
    p: ptr = addr f
    a: f32[,] = slice p, 2, 2
    store 0.0, a, 0, 0
    store 10.0, a, 0, 1
    store 20.0, a, 1, 0
    store 30.0, a, 1, 1
    h: f32 = const 0.5
    x: f32 = sample a, h, h
    ret x
}
