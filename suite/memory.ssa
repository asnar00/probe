; loads, stores, ptradd, i32 and i64 buffers
;! rw i64[0] 99 -> 99
;! first i64[42,43] -> 42
;! second i64[42,43] -> 43
;! sum4 i32[10,20,30,40] -> 100
;! sum4 i32[-1,1,-1,1] -> 0
;! dot i64[1,2,3] i64[4,5,6] 3 -> 32
;! store32 i32[0,7] 5 -> 12

fn rw(p: ptr, v: i64) -> i64 {
entry:
    store v, p
    r: i64 = load p
    ret r
}

fn first(p: ptr) -> i64 {
entry:
    r: i64 = load p
    ret r
}

fn second(p: ptr) -> i64 {
entry:
    eight: i64 = const 8
    q: ptr = ptradd p, eight
    r: i64 = load q
    ret r
}

fn sum4(p: ptr) -> i32 {
entry:
    jmp loop(0, 0)
loop(i: i64, acc: i32):
    done: u1 = cmp.ge i, 4
    br done, exit, body
body:
    off: i64 = mul i, 4
    q: ptr = ptradd p, off
    v: i32 = load q
    acc2: i32 = add acc, v
    i2: i64 = add i, 1
    jmp loop(i2, acc2)
exit:
    ret acc
}

fn dot(p: ptr, q: ptr, n: i64) -> i64 {
entry:
    jmp loop(0, 0)
loop(i: i64, acc: i64):
    done: u1 = cmp.ge i, n
    br done, exit, body
body:
    off: i64 = mul i, 8
    pa: ptr = ptradd p, off
    qa: ptr = ptradd q, off
    a: i64 = load pa
    b: i64 = load qa
    m: i64 = mul a, b
    acc2: i64 = add acc, m
    i2: i64 = add i, 1
    jmp loop(i2, acc2)
exit:
    ret acc
}

; store an i32 into slot 0, then return buf[0] + buf[1]
fn store32(p: ptr, v: i32) -> i32 {
entry:
    store v, p
    a: i32 = load p
    four: i64 = const 4
    q: ptr = ptradd p, four
    b: i32 = load q
    r: i32 = add a, b
    ret r
}

; --- addressing: base + off, base + index * step ---
; i64[10,20,30,40] is a pointer to four little-endian words
;! ad_word1 i64[10,20,30,40] -> 20
;! ad_at i64[10,20,30,40] 3 -> 40
;! ad_back i64[10,20,30,40] -> 20
;! ad_at32 i32[5,6,7,8] 2 -> 7
;! ad_at8 i8[-1,2,-3,4] 2 -> -3
;! ad_put i32[0,0,0,0] 3 77 -> 77
;! ad_put_off i64[1,2,3] 9 -> 10
fn ad_word1(p: ptr) -> i64 {
    v: i64 = load p, 8
    ret v
}
fn ad_at(p: ptr, i: i64) -> i64 {
    v: i64 = load p, i, 8
    ret v
}
fn ad_back(p: ptr) -> i64 {
    q: ptr = ptradd p, 24
    v: i64 = load q, -16
    ret v
}
fn ad_at32(p: ptr, i: i64) -> i32 {
    v: i32 = load p, i, 4
    ret v
}
fn ad_at8(p: ptr, i: i64) -> i8 {
    v: i8 = load p, i, 1
    ret v
}
fn ad_put(p: ptr, i: i64, v: i32) -> i32 {
    store v, p, i, 4
    r: i32 = load p, 12
    ret r
}
fn ad_put_off(p: ptr, v: i64) -> i64 {
    store v, p, 16
    a: i64 = load p
    b: i64 = load p, 16
    s: i64 = add a, b
    ret s
}
