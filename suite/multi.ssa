; multiple return values: definition, use, and round-trip through calls
;! divmod 17 5 -> 3, 2
;! divmod -17 5 -> -3, -2
;! divmod 100 10 -> 10, 0
;! minmax 4 9 -> 4, 9
;! minmax 9 4 -> 4, 9
;! minmax -1 1 -> -1, 1
;! recombine 17 5 -> 17

fn @divmod(%a: int, %b: int) -> (int, int) {
^entry:
    %q: int = div %a, %b
    %r: int = rem %a, %b
    ret %q, %r
}

fn @minmax(%a: int, %b: int) -> (int, int) {
^entry:
    %lt: u1 = icmp.lt %a, %b
    br %lt, ^ab, ^ba
^ab:
    ret %a, %b
^ba:
    ret %b, %a
}

; q*b + r must reconstruct a — exercises multi-value call results
fn @recombine(%a: int, %b: int) -> int {
^entry:
    %q: int, %r: int = @divmod(%a, %b)
    %t: int = imul %q, %b
    %s: int = iadd %t, %r
    ret %s
}
