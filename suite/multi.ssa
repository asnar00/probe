; multiple return values: definition, use, and round-trip through calls
;! divmod 17 5 -> 3, 2
;! divmod -17 5 -> -3, -2
;! divmod 100 10 -> 10, 0
;! minmax 4 9 -> 4, 9
;! minmax 9 4 -> 4, 9
;! minmax -1 1 -> -1, 1
;! recombine 17 5 -> 17

fn divmod(a: i64, b: i64) -> (i64, i64) {
entry:
    q: i64 = div a, b
    r: i64 = rem a, b
    ret q, r
}

fn minmax(a: i64, b: i64) -> (i64, i64) {
entry:
    lt: u1 = cmp.lt a, b
    br lt, ab, ba
ab:
    ret a, b
ba:
    ret b, a
}

; q*b + r must reconstruct a — exercises multi-value call results
fn recombine(a: i64, b: i64) -> i64 {
entry:
    q: i64, r: i64 = divmod(a, b)
    t: i64 = mul q, b
    s: i64 = add t, r
    ret s
}
