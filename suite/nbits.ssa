; arbitrary-width integers: signedness lives in the type (i5 vs u5), and
; canonical values follow it — signed directives just say -6
;! add5 25 9 -> 2
;! add5 15 16 -> 31
;! mul7 20 13 -> 4
;! sdiv5 -6 2 -> -3
;! sdiv5s -6 2 -> -3
;! udiv5 26 2 -> 13
;! slt5 -6 2 -> 1
;! ult5 26 2 -> 0
;! shl5 3 7 -> 12
;! ashr5s -6 1 -> -3
;! sx5 -6 -> -6
;! zx5 26 -> 26
;! tr5 100 -> 4
;! sx5to12 -6 -> -6
;! add33 4294967296 4294967296 -> 0
;! add33 4294967295 1 -> 4294967296
;! sum17 1000 -> 106284

fn @add5(%a: u5, %b: u5) -> u5 {
^entry:
    %r: u5 = iadd %a, %b
    ret %r
}

fn @mul7(%a: u7, %b: u7) -> u7 {
^entry:
    %r: u7 = imul %a, %b
    ret %r
}

; -6 / 2 = -3
fn @sdiv5(%a: i5, %b: i5) -> i5 {
^entry:
    %r: i5 = div %a, %b
    ret %r
}

; same, sign-extended out to i64 for a readable answer
fn @sdiv5s(%a: i5, %b: i5) -> i64 {
^entry:
    %r: i5 = div %a, %b
    %w: i64 = ext %r
    ret %w
}

; unsigned: 26 / 2
fn @udiv5(%a: u5, %b: u5) -> u5 {
^entry:
    %r: u5 = div %a, %b
    ret %r
}

fn @slt5(%a: i5, %b: i5) -> u1 {
^entry:
    %r: u1 = icmp.lt %a, %b
    ret %r
}

fn @ult5(%a: u5, %b: u5) -> u1 {
^entry:
    %r: u1 = icmp.lt %a, %b
    ret %r
}

; shift amounts reduce mod the width: 7 mod 5 = 2
fn @shl5(%a: u5, %b: u5) -> u5 {
^entry:
    %r: u5 = shl %a, %b
    ret %r
}

fn @ashr5s(%a: i5, %b: i5) -> i64 {
^entry:
    %r: i5 = shr %a, %b
    %w: i64 = ext %r
    ret %w
}

fn @sx5(%a: i5) -> i64 {
^entry:
    %r: i64 = ext %a
    ret %r
}

fn @zx5(%a: u5) -> u64 {
^entry:
    %r: u64 = ext %a
    ret %r
}

fn @tr5(%a: i64) -> i5 {
^entry:
    %r: i5 = trunc %a
    ret %r
}

; sign carries through the widening
fn @sx5to12(%a: i5) -> i12 {
^entry:
    %r: i12 = ext %a
    ret %r
}

; a width bigger than 32: wraps at 2^33
fn @add33(%a: u33, %b: u33) -> u33 {
^entry:
    %r: u33 = iadd %a, %b
    ret %r
}

; loop arithmetic in i17: sum of 0..999 = 499500, mod 2^17 = 106284
fn @sum17(%n: u17) -> u17 {
    %zero: u17 = iconst 0
    %r: u17 = loop(%i: u17 = %zero, %acc: u17 = %zero) {
        %done: u1 = icmp.ge %i, %n
        if %done {
            break %acc
        }
        %one: u17 = iconst 1
        %acc2: u17 = iadd %acc, %i
        %i2: u17 = iadd %i, %one
        continue %i2, %acc2
    }
    ret %r
}
