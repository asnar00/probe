fn @t_make(%n0: i64, %d0: i64) -> (i64, u64) {
    %x: $rat = call @rat_make(%n0, %d0)
    %n: i64, %d: u64 = call @rat_parts(%x)
    ret %n, %d
}

fn @t_lt(%an: i64, %ad: i64, %bn: i64, %bd: i64) -> u1 {
    %x: $rat = call @rat_make(%an, %ad)
    %y: $rat = call @rat_make(%bn, %bd)
    %r: u1 = call @rat_lt(%x, %y)
    ret %r
}

