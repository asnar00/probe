fn @t_to_int(%n0: i64, %d0: i64) -> i64 {
    %x: $rat = call @rat_make(%n0, %d0)
    %r: i64 = call @rat_to_int(%x)
    ret %r
}

fn @t_to_float(%n0: i64, %d0: i64) -> float {
    %x: $rat = call @rat_make(%n0, %d0)
    %r: float = call @rat_to_float(%x)
    ret %r
}

fn @t_nar(%n0: i64, %d0: i64) -> u1 {
    %x: $rat = call @rat_make(%n0, %d0)
    %r: u1 = call @rat_is_nar(%x)
    ret %r
}

; 1 + 1/2 + ... + 1/n, exactly — a rational accumulator in a loop
fn @t_harmonic(%n: i64) -> (i64, u64) {
    %zero: i64 = iconst 0
    %one: i64 = iconst 1
    %z: $rat = call @rat_make(%zero, %one)
    %s: $rat = loop(%i: i64 = %one, %acc: $rat = %z) {
        %done: u1 = icmp.gt %i, %n
        if %done {
            break %acc
        }
        %term: $rat = call @rat_make(%one, %i)
        %acc2: $rat = call @rat_add(%acc, %term)
        %i2: i64 = iadd %i, %one
        continue %i2, %acc2
    }
    %rn: i64, %rd: u64 = call @rat_parts(%s)
    ret %rn, %rd
}
