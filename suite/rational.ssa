; tests for the rational library (lib/rational.ssa, linked in by the
; loader) - see that file for the semantics: canonical reduced form,
; NaR = den 0, exact-or-NaR.
;! t_add 1 2 1 3 -> 5, 6
;! t_add 1 6 1 3 -> 1, 2
;! t_add -1 2 1 3 -> -1, 6
;! t_sub 1 2 1 3 -> 1, 6
;! t_mul 2 3 3 4 -> 1, 2
;! t_mul -2 3 3 4 -> -1, 2
;! t_div 1 2 1 4 -> 2, 1
;! t_div 2 3 -4 5 -> -5, 6
;! t_make 6 -8 -> -3, 4
;! t_make 0 5 -> 0, 1
;! t_lt 1 3 1 2 -> 1
;! t_lt 1 2 1 3 -> 0
;! t_lt -1 2 1 3 -> 1
;! t_eq 2 4 1 2 -> 1
;! t_eq 1 2 1 3 -> 0
;! t_to_int 7 2 -> 3
;! t_to_int -7 2 -> -3
;! t_to_float 3 4 -> 0.75
;! t_nar 1 0 -> 1
;! t_nar 1 2 -> 0
;! t_harmonic 4 -> 25, 12

; ---- test wrappers: build rationals from directive args, return parts ----

fn t_add(an: int, ad: int, bn: int, bd: int) -> (int, uint) {
    x: $rat = rat_make(an, ad)
    y: $rat = rat_make(bn, bd)
    s: $rat = rat_add(x, y)
    n: int, d: uint = rat_parts(s)
    ret n, d
}

fn t_sub(an: int, ad: int, bn: int, bd: int) -> (int, uint) {
    x: $rat = rat_make(an, ad)
    y: $rat = rat_make(bn, bd)
    s: $rat = rat_sub(x, y)
    n: int, d: uint = rat_parts(s)
    ret n, d
}

fn t_mul(an: int, ad: int, bn: int, bd: int) -> (int, uint) {
    x: $rat = rat_make(an, ad)
    y: $rat = rat_make(bn, bd)
    s: $rat = rat_mul(x, y)
    n: int, d: uint = rat_parts(s)
    ret n, d
}

fn t_div(an: int, ad: int, bn: int, bd: int) -> (int, uint) {
    x: $rat = rat_make(an, ad)
    y: $rat = rat_make(bn, bd)
    s: $rat = rat_div(x, y)
    n: int, d: uint = rat_parts(s)
    ret n, d
}

fn t_make(n0: int, d0: int) -> (int, uint) {
    x: $rat = rat_make(n0, d0)
    n: int, d: uint = rat_parts(x)
    ret n, d
}

fn t_lt(an: int, ad: int, bn: int, bd: int) -> u1 {
    x: $rat = rat_make(an, ad)
    y: $rat = rat_make(bn, bd)
    r: u1 = rat_lt(x, y)
    ret r
}

fn t_eq(an: int, ad: int, bn: int, bd: int) -> u1 {
    x: $rat = rat_make(an, ad)
    y: $rat = rat_make(bn, bd)
    r: u1 = rat_eq(x, y)
    ret r
}

fn t_to_int(n0: int, d0: int) -> int {
    x: $rat = rat_make(n0, d0)
    r: int = rat_to_int(x)
    ret r
}

fn t_to_float(n0: int, d0: int) -> float {
    x: $rat = rat_make(n0, d0)
    r: float = rat_to_float(x)
    ret r
}

fn t_nar(n0: int, d0: int) -> u1 {
    x: $rat = rat_make(n0, d0)
    r: u1 = rat_is_nar(x)
    ret r
}

; 1 + 1/2 + ... + 1/n, exactly — a rational accumulator in a loop
fn t_harmonic(n: int) -> (int, uint) {
    zero: int = iconst 0
    one: int = iconst 1
    z: $rat = rat_make(zero, one)
    s: $rat = loop(i: int = one, acc: $rat = z) {
        done: u1 = icmp.gt i, n
        if done {
            break acc
        }
        term: $rat = rat_make(one, i)
        acc2: $rat = rat_add(acc, term)
        %i2: int = iadd i, one
        continue %i2, acc2
    }
    rn: int, rd: uint = rat_parts(s)
    ret rn, rd
}
