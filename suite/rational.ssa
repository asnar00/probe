; tests for the rational library (lib/rational.ssa, linked in by the
; loader) - see that file for the semantics: canonical reduced form,
; NaR = den 0, exact-or-NaR.
;! t_add 1 2 1 3 -> 5, 6
;! t_add 1 6 1 3 -> 1, 2
;! t_add -1 2 1 3 -> -1, 6
;! t_sub 1 2 1 3 -> 1, 6
;! t_mul 2 3 3 4 -> 1, 2
;! t_mul -2 3 3 4 -> -1, 2
;! t_div 1 2 1 4 -> 2, 1
;! t_div 2 3 -4 5 -> -5, 6
;! t_make 6 -8 -> -3, 4
;! t_make 0 5 -> 0, 1
;! t_lt 1 3 1 2 -> 1
;! t_lt 1 2 1 3 -> 0
;! t_lt -1 2 1 3 -> 1
;! t_eq 2 4 1 2 -> 1
;! t_eq 1 2 1 3 -> 0
;! t_to_int 7 2 -> 3
;! t_to_int -7 2 -> -3
;! t_to_float 3 4 -> 0.75
;! t_nar 1 0 -> 1
;! t_nar 1 2 -> 0
;! t_harmonic 4 -> 25, 12

; ---- test wrappers: build rationals from directive args, return parts ----

fn @t_add(%an: i64, %ad: i64, %bn: i64, %bd: i64) -> (i64, u64) {
    %x: $rat = call @rat_make(%an, %ad)
    %y: $rat = call @rat_make(%bn, %bd)
    %s: $rat = call @rat_add(%x, %y)
    %n: i64, %d: u64 = call @rat_parts(%s)
    ret %n, %d
}

