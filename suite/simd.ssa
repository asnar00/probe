; the simdgroup (lib/gpu.ssa): what a group of lanes computes across
; itself. These cases hold on one thread — the CPU paths, and the GPU
; running one — where every reduction is its argument, a shuffle is
; the value, the lane is 0; examples/simd.ssa is the many-lane case.

;! sum_f 0x40400000 -> 0x40400000
;! sum_i 7 -> 7
;! sum_u 9 -> 9
;! lane_zero -> 0
;! first -> 1
;! votes 1 -> 3
;! votes 0 -> 0
;! shuffles 11 -> 33
;! prefix_max -1 -> -2
;! half_sum 0x3c00 -> 0x3c00

fn sum_f(x: f32) -> f32 {
    s: f32 = simd_sum x
    ret s
}
fn sum_i(x: i32) -> i32 {
    s: i32 = simd_sum x
    ret s
}
fn sum_u(x: u32) -> u32 {
    s: u32 = simd_sum x
    ret s
}
fn lane_zero() -> i64 {
    l: i64 = simd_lane()
    ret l
}
fn first() -> u1 {
    f: u1 = simd_first()
    ret f
}
; all, any and the ballot of one vote
fn votes(c: u1) -> u64 {
    a: u1 = simd_all(c)
    n: u1 = simd_any(c)
    b: u64 = simd_ballot(c)
    a64: u64 = conv a
    n64: u64 = conv n
    n2: u64 = shl n64, 1
    s: u64 = or a64, n2
    r: u64 = mul b, s
    ret r
}
; a shuffle from lane 0, a broadcast, an xor: all the value itself
fn shuffles(x: i32) -> i32 {
    zero: i64 = const 0
    one: i64 = const 1
    a: i32 = simd_shuffle x, zero
    b: i32 = simd_broadcast x, zero
    c: i32 = simd_shuffle_xor x, one
    s: i32 = add a, b
    t: i32 = add s, c
    ret t
}
fn prefix_max(x: i32) -> i32 {
    p: i32 = simd_prefix_sum x
    m: i32 = simd_max x
    s: i32 = add p, m
    ret s
}
fn half_sum(x: f16) -> f16 {
    s: f16 = simd_sum x
    ret s
}
