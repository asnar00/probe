; streams (lib/stream.ssa): `u8$` is a reader's view of a ring of bytes
; over time — the ring, a position, a sampling rule, an edge rule — and
; a producer pushes (tick, v) pairs into the ring, ticks of the ring's
; clock. Several views may look at one ring with their own rules. Here
; a program is its own producer.

;! frames -> 15, 5
;! peeked -> 3, 3
;! frames_again -> 0, 5
;! samples -> 3, 3
;! rules -> 4, 3
;! windowed -> 9, 2
;! sliding -> 12, 4
;! early -> check
;! stale -> check
;! unordered -> check
;! regular_frames -> 4, 3000
;! interpolated -> 260, 30
;! interpolated_int -> 2, 7
;! irregular_push -> check
;! biquad_fir -> 0x3f000000, 0x3e800000
;! biquad_iir -> 0x3d000000, 0x3c000000
;! closing -> 0, 1
;! push_after_end -> check
;! positions -> 2, 3000
;! position_end -> 5, -1
;! regular_position -> 3, 3
;! struct_of_streams 7 -> 7, 1
;! unread_view -> 12, 5
;! wrapped -> 57, 7
;! wrapped_history -> 27, 57
;! peeked_across_the_seam -> 7, 12
;! block_across_the_seam -> 340, 4
;! block_with_a_tick -> 36, 4
;! block_too_long -> check
;! queue_pushes -> 3, 4
;! queue_block -> 7, 4
;! queue_full -> check
;! queue_freed -> 12, 8
;! queue_tokens -> 2, 20
;! struct_ring -> 3, 20
;! struct_frame -> 3, 4

; an irregular ring of bytes on a microsecond clock: values and ticks;
; a ring keeps half its slots resident (each item sits in both halves),
; so sixteen slots hold the last eight
data vb: buffer(u8, 16)
data tb: buffer(i64, 16)
data rg: array(u64, 8)
; a regular ring at 1 kHz: values only
data fvb: buffer(f32, 16)
data frg: array(u64, 8)
; the audio rings and a block: the filter reads a frame of 4 and 2
; behind it on both streams, so 6 resident is what it needs — what
; the residency analysis should compute; 16 holds at least 8
data avb: buffer(f32, 16)
data arg: array(u64, 8)
data ovb: buffer(f32, 16)
data org: array(u64, 8)
data blk: buffer(f32, 4)
; blocks pushed whole: four floats across the regular ring's seam, four
; bytes at one tick, and one too long to be resident
data fblk: buffer(f32, 4)
data bblk: buffer(u8, 4)
data big: buffer(f32, 16)
; a byte queue's slots, a plain run: sixteen, of which the queue below
; takes eight, its capacity being its own number and not the buffer's
data pvb: buffer(u8, 16)
data prg: array(u64, 8)
; two rings of int for the struct of streams
data ivb: buffer(int, 16)
data itb: buffer(i64, 16)
data rg2: array(u64, 8)
data ivb2: buffer(int, 16)
data itb2: buffer(i64, 16)

; five items at 1, 2, 3, 4, 5 milliseconds with values 1..5
fn five(s: u8$)
    loop(k: i64 = 1)
        done: u1 = cmp.gt k, 5
        if done
            break
        t: i64 = mul k, 1000
        v: u8 = conv k
        push s, t, v
        k2: i64 = add k, 1
        continue k2
    ret
fn fresh() -> u8$
    r: ptr = addr rg
    a: ptr = addr vb
    b: ptr = addr tb
    ring_init(r, a, b, 1000000)
    s: u8$ = stream r
    ret s

fn queue_ring() -> u8$
    r: ptr = addr prg
    a: ptr = addr pvb
    ring_queue(r, a, 1000000, 8)
    s: u8$ = stream r
    ret s
fn fill_queue(s: u8$, from: i64) -> u8$
    loop(k: i64 = 0)
        done: u1 = cmp.ge k, 8
        if done
            break
        v0: i64 = add from, k
        v: u8 = conv v0
        push_queue(s, v)
        k2: i64 = add k, 1
        continue k2
    ret s

; a queue's push (log 89, question 47): a stream nothing in its store
; keeps history in holds an item only until its reader has passed it,
; so its slots are a plain run with the index of the first in the
; header, item k at slot k - origin, and a push is a store and a count
fn queue_pushes() -> (u8, i64)
    s: u8$ = queue_ring()
    push_queue(s, 1: u8)
    push_queue(s, 2: u8)
    push_queue(s, 3: u8)
    push_queue(s, 4: u8)
    x: u8 = peek_queue(s, 2)
    n: i64 = count s
    ret x, n
; ... and a block of them in one copy, there being no seam to split at
fn queue_block() -> (u8, i64)
    s: u8$ = queue_ring()
    p: ptr = addr bblk
    b: u8[] = slice p
    fill b, 7
    push_queue(s, b)
    last: u8 = latest_queue(s)
    n: i64 = count s
    ret last, n
; the capacity bounds what is unread: a ninth item pushed into eight
; slots nothing has read fails the check at the push, where a ring
; would have overwritten and failed its reader later
fn queue_full() -> u8
    s: u8$ = queue_ring()
    s2: u8$ = fill_queue(s, 1)
    push_queue(s2, 9: u8)
    x: u8 = latest_queue(s2)
    ret x
; ... and the slots come back when the reader has passed them: eight
; pushed and all eight read, `free_queue` moves the origin, and eight
; more fit where the ninth did not. The fourth of them, and the count
fn queue_freed() -> (u8, i64)
    s: u8$ = queue_ring()
    s2: u8$ = fill_queue(s, 1)
    s3: u8$ = advance(s2, 8)
    free_queue(s3)
    s4: u8$ = fill_queue(s3, 9)
    x: u8 = peek_queue(s4, 3)
    n: i64 = count s4
    ret x, n
; a queue of structs, as a ring may be (log 88): one push of the whole
; token, one peek back, the second one's start
fn queue_tokens() -> (i64, i64)
    r: ptr = addr tokr
    sz: i64 = sizeof tok
    vb: ptr = addr tokvb
    buffer_init(vb, sz, 16)
    ring_queue(r, vb, 1000000, 16)
    s: tok$ = stream r
    a: tok = pack 1, 10, 2
    push_queue(s, a)
    b: tok = pack 2, 20, 3
    push_queue(s, b)
    n: i64 = count s
    x: tok = peek_queue(s, 1)
    k: i64 = get x, start
    ret n, k

; a frame holds everything since the reader last looked
fn frames() -> (u8, i64)
    s: u8$ = fresh()
    five(s)
    f: u8[], k0: i64, s2: u8$ = frame(s)
    n: i64 = len f
    total: u8 = sum f
    ret total, n
; ... and nothing the second time; count says how much is waiting
fn frames_again() -> (i64, i64)
    s: u8$ = fresh()
    five(s)
    waiting: i64 = count s
    f: u8[], k0: i64, s2: u8$ = frame(s)
    g: u8[], k1: i64, s3: u8$ = frame(s2)
    n: i64 = len g
    ret n, waiting
; a reader taking less than a frame: peek at the third unread item,
; move on two, and the next frame is what is left
fn peeked() -> (u8, i64)
    s: u8$ = fresh()
    five(s)
    x: u8 = peek s, 2
    s2: u8$ = advance(s, 2)
    f: u8[], k0: i64, s3: u8$ = frame(s2)
    n: i64 = len f
    ret x, n
; nearest at 3.4 ms is the item at 3; hold at 3.9 ms is 3 too
fn samples() -> (u8, u8)
    s: u8$ = fresh()
    five(s)
    t1: time = micros(3400)
    x: u8 = sample s, t1
    h: u8$ = sampling(s, 1)
    t2: time = micros(3900)
    y: u8 = sample h, t2
    ret x, y
; two views of one ring: nearest at 3.6 ms gives 4, hold gives 3
fn rules() -> (u8, u8)
    s: u8$ = fresh()
    five(s)
    t: time = micros(3600)
    x: u8 = sample s, t
    h: u8$ = sampling(s, 1)
    y: u8 = sample h, t
    ret x, y
; the items in [2 ms, 5 ms): 2, 3, 4
fn windowed() -> (u8, u8)
    s: u8$ = fresh()
    five(s)
    t1: time = millis(2)
    t2: time = millis(5)
    w: u8[] = window s, t1, t2
    total: u8 = sum w
    first: u8 = load w, 0
    ret total, first
; twelve items into a ring of sixteen, which keeps the last eight resident
; and stores each item in both halves: a reader six in takes a frame of
; six that runs across the seam as one view, 7 to 12
fn wrapped() -> (u8, u8)
    s: u8$ = fresh()
    loop(k: i64 = 1)
        done: u1 = cmp.gt k, 12
        if done
            break
        t: i64 = mul k, 1000
        v: u8 = conv k
        push s, t, v
        k2: i64 = add k, 1
        continue k2
    s2: u8$ = advance(s, 6)
    f: u8[], k0: i64, s3: u8$ = frame(s2)
    total: u8 = sum f
    first: u8 = load f, 0
    ret total, first
; ... and a history and a window across it: the three behind a reader
; ten in are 8, 9, 10; the window from 7 ms to 13 ms holds 7 to 12
fn wrapped_history() -> (u8, u8)
    s: u8$ = fresh()
    loop(k: i64 = 1)
        done: u1 = cmp.gt k, 12
        if done
            break
        t: i64 = mul k, 1000
        v: u8 = conv k
        push s, t, v
        k2: i64 = add k, 1
        continue k2
    s2: u8$ = advance(s, 10)
    h: u8[] = behind s2, 3
    hs: u8 = sum h
    t1: time = millis(7)
    t2: time = millis(13)
    w: u8[] = window s, t1, t2
    ws: u8 = sum w
    ret hs, ws
; ... and a reader six in peeks across it: the first unread is 7 and
; the latest 12, each one load through the buffer's pointer (log 74)
fn peeked_across_the_seam() -> (u8, u8)
    s: u8$ = fresh()
    loop(k: i64 = 1)
        done: u1 = cmp.gt k, 12
        if done
            break
        t: i64 = mul k, 1000
        v: u8 = conv k
        push s, t, v
        k2: i64 = add k, 1
        continue k2
    s2: u8$ = advance(s, 6)
    a: u8 = peek s2, 0
    z: u8 = latest s2
    ret a, z
; six items into the regular ring of sixteen, then a block of four: it
; lands across the seam, and a reader six in frames the four as one view
fn block_across_the_seam() -> (i32, i64)
    s: f32$ = khz()
    tens(s)
    push s, 50.0
    push s, 60.0
    p: ptr = addr fblk
    b: f32[] = slice p
    store 70.0, b, 0
    store 80.0, b, 1
    store 90.0, b, 2
    store 100.0, b, 3
    push s, b
    s2: f32$ = advance(s, 6)
    f: f32[], k0: i64, s3: f32$ = frame(s2)
    total: f32 = sum f
    n: i64 = len f
    ti: i32 = conv total
    ret ti, n
; three bytes at 1, 2, 3 ms, then a block of four at 6 ms: the frame
; holds all seven, and the window from 6 ms to 7 ms the block
fn block_with_a_tick() -> (u8, i64)
    s: u8$ = fresh()
    push s, 1000, 1
    push s, 2000, 2
    push s, 3000, 3
    p: ptr = addr bblk
    b: u8[] = slice p
    store 6, b, 0
    store 7, b, 1
    store 8, b, 2
    store 9, b, 3
    push s, 6000, b
    f: u8[], k0: i64, s2: u8$ = frame(s)
    total: u8 = sum f
    t1: time = millis(6)
    t2: time = millis(7)
    w: u8[] = window s, t1, t2
    n: i64 = len w
    ret total, n
; a block of sixteen into a ring that keeps eight fails
fn block_too_long() -> i64
    s: f32$ = khz()
    p: ptr = addr big
    b: f32[] = slice p
    fill b, 1.0
    push s, b
    n: i64 = count s
    ret n
; twelve items into a ring of sixteen: the last eight are resident, the
; latest is 12, and the window from 9 ms holds the last four
fn sliding() -> (u8, i64)
    s: u8$ = fresh()
    loop(k: i64 = 1)
        done: u1 = cmp.gt k, 12
        if done
            break
        t: i64 = mul k, 1000
        v: u8 = conv k
        push s, t, v
        k2: i64 = add k, 1
        continue k2
    last: u8 = latest s
    t1: time = millis(9)
    t2: time = millis(13)
    w: u8[] = window s, t1, t2
    n: i64 = len w
    ret last, n
; a sample before the first item fails, unless the edge rule clamps
fn early() -> u8
    s: u8$ = fresh()
    five(s)
    t: time = micros(500)
    x: u8 = sample s, t
    ret x
; a reader that fell behind the resident items fails a check
fn stale() -> i64
    s: u8$ = fresh()
    loop(k: i64 = 1)
        done: u1 = cmp.gt k, 12
        if done
            break
        t: i64 = mul k, 1000
        v: u8 = conv k
        push s, t, v
        k2: i64 = add k, 1
        continue k2
    f: u8[], k0: i64, s2: u8$ = frame(s)
    n: i64 = len f
    ret n
; times must not go backwards
fn unordered() -> u8
    s: u8$ = fresh()
    five(s)
    push s, 1000, 9
    x: u8 = latest s
    ret x

; --- regular rings: item k at tick t0 + k * step of a clock, the
; producer's push without a tick ---
fn khz() -> f32$
    r: ptr = addr frg
    a: ptr = addr fvb
    ring_regular(r, a, 1000, 1, 0)
    s: f32$ = stream r
    ret s
fn tens(s: f32$)
    push s, 10.0
    push s, 20.0
    push s, 30.0
    push s, 40.0
    ret
; four samples at 0, 1, 2, 3 ms: a frame's times are computed from its first index
fn regular_frames() -> (i64, i64)
    s: f32$ = khz()
    tens(s)
    f: f32[], k0: i64, s2: f32$ = frame(s)
    n: i64 = len f
    k3: i64 = add k0, 3
    t3: time = time_at(s, k3)
    us: i64 = to_micros(t3)
    ret n, us
; at 1.6 ms: linear gives 26, nearest gives 30 (as tenths)
fn interpolated() -> (i32, i32)
    s: f32$ = khz()
    tens(s)
    t: time = micros(1600)
    l: f32$ = sampling(s, 2)
    x: f32 = sample l, t
    y: f32 = sample s, t
    x10: f32 = mul x, 10.0
    xi: i32 = conv x10
    yi: i32 = conv y
    ret xi, yi
; on the byte stream, 2.75 ms between 2 and 3 is 2 (rounded once,
; toward zero); a slope going down, 10 to 4, at its midpoint is 7
fn interpolated_int() -> (u8, u8)
    s: u8$ = fresh()
    five(s)
    l: u8$ = sampling(s, 2)
    t: time = micros(2750)
    x: u8 = sample l, t
    s2: u8$ = fresh()
    l2: u8$ = sampling(s2, 2)
    push s2, 1000, 10
    push s2, 2000, 4
    tm: time = micros(1500)
    y: u8 = sample l2, tm
    ret x, y
; the producer closes the stream: `ended` says so to every reader, a
; push after it fails a check
fn closing() -> (u1, u1)
    s: u8$ = fresh()
    five(s)
    before: u1 = ended(s)
    end(s)
    after: u1 = ended(s)
    ret before, after
fn push_after_end() -> u8
    s: u8$ = fresh()
    five(s)
    end(s)
    push s, 6000, 6
    x: u8 = latest s
    ret x
; where a reader stands: after two of five, the third is next, at 3 ms
fn positions() -> (i64, i64)
    s: u8$ = fresh()
    five(s)
    s2: u8$ = advance(s, 2)
    k: i64, t: i64 = position(s2)
    ret k, t
; ... and with nothing unread on an irregular ring, no tick
fn position_end() -> (i64, i64)
    s: u8$ = fresh()
    five(s)
    f: u8[], k0: i64, s2: u8$ = frame(s)
    k: i64, t: i64 = position(s2)
    ret k, t
; on a regular ring the next tick is always known: item 3 is at 3
fn regular_position() -> (i64, i64)
    s: f32$ = khz()
    tens(s)
    s2: f32$ = advance(s, 3)
    k: i64, t: i64 = position(s2)
    ret k, t
; the unread items as a view without moving: after two of five, the
; view holds 3, 4, 5, and the reader still counts five
fn unread_view() -> (u8, i64)
    s: u8$ = fresh()
    five(s)
    s2: u8$ = advance(s, 2)
    u: u8[] = unread(s2)
    total: u8 = sum u
    still: i64 = count s
    ret total, still
; a push without a tick needs a regular ring
fn irregular_push() -> u8
    s: u8$ = fresh()
    push s, 7
    x: u8 = latest s
    ret x

; --- audio: a dense regular stream, a block at a time, through a
; biquad — a node that reads behind its frame on its input and behind
; its own output, so its state is the rings' history, not its own ---
fn audio() -> (f32$, f32$)
    r: ptr = addr arg
    a: ptr = addr avb
    ring_regular(r, a, 48000, 1, 0)
    r2: ptr = addr org
    a2: ptr = addr ovb
    ring_regular(r2, a2, 48000, 1, 0)
    x: f32$ = stream r
    o: f32$ = stream r2
    ret x, o
; a block of four: an impulse, or silence
fn block(first: f32) -> f32[]
    p: ptr = addr blk
    b: f32[] = slice p
    store first, b, 0
    store 0.0, b, 1
    store 0.0, b, 2
    store 0.0, b, 3
    ret b
; one application of y[n] = b0 x[n] + b1 x[n-1] + b2 x[n-2] - a1 y[n-1] - a2 y[n-2]
; to the frame of x since this reader looked, into out; the reader moved on
fn biquad(x: f32$, out: f32$, b0: f32, b1: f32, b2: f32, a1: f32, a2: f32) -> f32$
    f: f32[], k0: i64, x2: f32$ = frame(x)
    hx: f32[] = behind x, 2
    hy: f32[] = last out, 2
    n: i64 = len f
    px1: f32 = tail(hx, 1)
    px2: f32 = tail(hx, 2)
    py1: f32 = tail(hy, 1)
    py2: f32 = tail(hy, 2)
    loop(i: i64 = 0, x1: f32 = px1, xx2: f32 = px2, y1: f32 = py1, y2: f32 = py2) bound 64
        done: u1 = cmp.ge i, n
        if done
            break
        xn: f32 = load f, i
        t0: f32 = mul b0, xn
        t1: f32 = mul b1, x1
        t2: f32 = mul b2, xx2
        u1_: f32 = mul a1, y1
        u2: f32 = mul a2, y2
        s0: f32 = add t0, t1
        s1: f32 = add s0, t2
        s2: f32 = sub s1, u1_
        y: f32 = sub s2, u2
        push out, y
        i2: i64 = add i, 1
        continue i2, xn, x1, y, y1
    ret x2
; an FIR (a = 0): an impulse gives the taps back: 1, 0.5, 0.25, 0
fn biquad_fir() -> (u32, u32)
    x: f32$, o: f32$ = audio()
    imp: f32[] = block(1.0)
    push x, imp
    x2: f32$ = biquad(x, o, 1.0, 0.5, 0.25, 0.0, 0.0)
    op: ptr = addr org
    r: f32$ = stream op
    f: f32[], k0: i64, r2: f32$ = frame(r)
    v1: f32 = load f, 1
    v2: f32 = load f, 2
    w1: u32 = cast v1
    w2: u32 = cast v2
    ret w1, w2
; y[n] = x[n] + 0.5 y[n-1]: an impulse block then a silent one, and the
; decay carries across the blocks through the output's history:
; 1/32 at 5, 1/128 at 7
fn biquad_iir() -> (u32, u32)
    x: f32$, o: f32$ = audio()
    imp: f32[] = block(1.0)
    push x, imp
    x2: f32$ = biquad(x, o, 1.0, 0.0, 0.0, -0.5, 0.0)
    quiet: f32[] = block(0.0)
    push x2, quiet
    x3: f32$ = biquad(x2, o, 1.0, 0.0, 0.0, -0.5, 0.0)
    op: ptr = addr org
    r: f32$ = stream op
    f: f32[], k0: i64, r2: f32$ = frame(r)
    v5: f32 = load f, 5
    v7: f32 = load f, 7
    w5: u32 = cast v5
    w7: u32 = cast v7
    ret w5, w7

; a struct of streams — one ring per field, the front end's form of a
; stream of structs — passed as a parameter: its `int$` field was made
; concrete when the struct was declared, and a body's `int` is abstract
; until the module is resolved; both are the policy's int, and a push
; of one into the other finds the library's `push`
type pair_rings = struct
    a: int$
    b: int$
fn push_pair(r: pair_rings, v: int)
    ra: int$ = get r, a
    x: int = add v, 0
    push ra, 5, x
    rb: int$ = get r, b
    push rb, 5, 1
    ret
fn struct_of_streams(v: int) -> (int, int)
    a: ptr = addr rg
    va: ptr = addr ivb
    ta: ptr = addr itb
    ring_init(a, va, ta, 1000000)
    b: ptr = addr rg2
    vb2: ptr = addr ivb2
    tb2: ptr = addr itb2
    ring_init(b, vb2, tb2, 1000000)
    sa: int$ = stream a
    sb: int$ = stream b
    r: pair_rings = pack sa, sb
    push_pair(r, v)
    x: int = latest sa
    y: int = latest sb
    ret x, y

; a ring whose item is a struct (log 88, question 43): one buffer of
; `sizeof tok` stride, one header, one position, and a token's push is
; one push. Every word that reads an item at a time works on it —
; `push`, `count`, `peek`, `frame` — since `lib/stream.ssa` is written
; over `any`; `sample` and `lerp` are not, having no midpoint between
; two structs, and are refused by name
type tok = struct
    kind: i64
    start: i64
    n: i64
data tokr: array(i64, 8)
data tokvb: array(u8, 400)

fn fresh_toks() -> tok$
    r: ptr = addr tokr
    sz: i64 = sizeof tok
    vb: ptr = addr tokvb
    buffer_init(vb, sz, 16)
    ring_regular(r, vb, 1000000, 1, 0)
    s: tok$ = stream r
    ret s
fn three_toks(s: tok$)
    a: tok = pack 1, 10, 2
    push s, a
    b: tok = pack 2, 20, 3
    push s, b
    c: tok = pack 3, 30, 4
    push s, c
    ret
; three tokens pushed, then counted and peeked: the second one's start
fn struct_ring() -> (i64, i64)
    s: tok$ = fresh_toks()
    three_toks(s)
    n: i64 = count(s)
    x: tok = peek s, 1
    k: i64 = get x, start
    ret n, k
; ... and framed: the view holds all three, the third one's length
fn struct_frame() -> (i64, i64)
    s: tok$ = fresh_toks()
    three_toks(s)
    f: tok[], k0: i64, s2: tok$ = frame(s)
    m: i64 = len f
    y: tok = load f, 2
    v: i64 = get y, n
    ret m, v
