; streams (lib/stream.ssa): `u8$` is a reader's view of a ring of bytes
; over time — the ring, a position, a sampling rule, an edge rule — and
; a producer pushes (t, v) pairs into the ring. Several views may look
; at one ring with their own rules. Here a program is its own producer.

;! frames -> 15, 5
;! peeked -> 3, 3
;! frames_again -> 0, 5
;! samples -> 3, 3
;! rules -> 4, 3
;! windowed -> 9, 2
;! sliding -> 12, 4
;! early -> check
;! stale -> check
;! unordered -> check
;! regular_frames -> 4, 3000
;! interpolated -> 260, 30
;! interpolated_int -> 2, 7
;! irregular_push -> check
;! biquad_fir -> 0x3f000000, 0x3e800000
;! biquad_iir -> 0x3d000000, 0x3c000000

data vb: buffer(u8, 8)
data tb: buffer(time, 8)
data rg: array(u64, 4)
data fvb: buffer(f32, 8)
data ftb: buffer(time, 8)
data frg: array(u64, 4)
; the audio rings and a block: the filter reads a frame of 4 and 2
; behind it on both streams, so 6 resident is what it needs — what
; the residency analysis should compute; 16 holds at least 8
data avb: buffer(f32, 16)
data atb: buffer(time, 16)
data arg: array(u64, 4)
data ovb: buffer(f32, 16)
data otb: buffer(time, 16)
data org: array(u64, 4)
data blk: buffer(f32, 4)

; five items at 1, 2, 3, 4, 5 milliseconds with values 1..5
fn five(s: u8$) {
    loop(k: i64 = 1) {
        done: u1 = cmp.gt k, 5
        if done {
            break
        }
        t: time = millis(k)
        v: u8 = conv k
        push s, t, v
        k2: i64 = add k, 1
        continue k2
    }
    ret
}
fn fresh() -> u8$ {
    r: ptr = addr rg
    a: ptr = addr vb
    b: ptr = addr tb
    ring_init(r, a, b)
    s: u8$ = stream r
    ret s
}

; a frame holds everything since the reader last looked
fn frames() -> (u8, i64) {
    s: u8$ = fresh()
    five(s)
    f: u8[], ft: time[], s2: u8$ = frame(s)
    n: i64 = len f
    total: u8 = sum f
    ret total, n
}
; ... and nothing the second time; count says how much is waiting
fn frames_again() -> (i64, i64) {
    s: u8$ = fresh()
    five(s)
    waiting: i64 = count s
    f: u8[], ft: time[], s2: u8$ = frame(s)
    g: u8[], gt: time[], s3: u8$ = frame(s2)
    n: i64 = len g
    ret n, waiting
}
; a reader taking less than a frame: peek at the third unread item,
; move on two, and the next frame is what is left
fn peeked() -> (u8, i64) {
    s: u8$ = fresh()
    five(s)
    x: u8 = peek s, 2
    s2: u8$ = advance(s, 2)
    f: u8[], ft: time[], s3: u8$ = frame(s2)
    n: i64 = len f
    ret x, n
}
; nearest at 3.4 ms is the item at 3; hold at 3.9 ms is 3 too
fn samples() -> (u8, u8) {
    s: u8$ = fresh()
    five(s)
    t1: time = micros(3400)
    x: u8 = sample s, t1
    h: u8$ = sampling(s, 1)
    t2: time = micros(3900)
    y: u8 = sample h, t2
    ret x, y
}
; two views of one ring: nearest at 3.6 ms gives 4, hold gives 3
fn rules() -> (u8, u8) {
    s: u8$ = fresh()
    five(s)
    t: time = micros(3600)
    x: u8 = sample s, t
    h: u8$ = sampling(s, 1)
    y: u8 = sample h, t
    ret x, y
}
; the items in [2 ms, 5 ms): 2, 3, 4
fn windowed() -> (u8, u8) {
    s: u8$ = fresh()
    five(s)
    t1: time = millis(2)
    t2: time = millis(5)
    w: u8[] = window s, t1, t2
    total: u8 = sum w
    first: u8 = load w, 0
    ret total, first
}
; twelve items into a ring of eight: the newer half slid down when it
; filled, the latest is 12, and the window from 9 ms holds the last four
fn sliding() -> (u8, i64) {
    s: u8$ = fresh()
    loop(k: i64 = 1) {
        done: u1 = cmp.gt k, 12
        if done {
            break
        }
        t: time = millis(k)
        v: u8 = conv k
        push s, t, v
        k2: i64 = add k, 1
        continue k2
    }
    last: u8 = latest s
    t1: time = millis(9)
    t2: time = millis(13)
    w: u8[] = window s, t1, t2
    n: i64 = len w
    ret last, n
}
; a sample before the first item fails, unless the edge rule clamps
fn early() -> u8 {
    s: u8$ = fresh()
    five(s)
    t: time = micros(500)
    x: u8 = sample s, t
    ret x
}
; a reader that fell behind the resident items fails a check
fn stale() -> i64 {
    s: u8$ = fresh()
    loop(k: i64 = 1) {
        done: u1 = cmp.gt k, 12
        if done {
            break
        }
        t: time = millis(k)
        v: u8 = conv k
        push s, t, v
        k2: i64 = add k, 1
        continue k2
    }
    f: u8[], ft: time[], s2: u8$ = frame(s)
    n: i64 = len f
    ret n
}
; times must not go backwards
fn unordered() -> u8 {
    s: u8$ = fresh()
    five(s)
    t: time = millis(1)
    push s, t, 9
    x: u8 = latest s
    ret x
}

; --- regular streams: a sample every dt from t0, the producer's push
; without a time ---
fn khz() -> f32$ {
    r: ptr = addr frg
    a: ptr = addr fvb
    b: ptr = addr ftb
    ring_init(r, a, b)
    s: f32$ = stream r
    dt: time = millis(1)
    t0: time = seconds(0)
    reg: f32$ = regular(s, dt, t0)
    ret reg
}
fn tens(s: f32$) {
    push s, 10.0
    push s, 20.0
    push s, 30.0
    push s, 40.0
    ret
}
; four samples at 0, 1, 2, 3 ms: the frame's times are computed
fn regular_frames() -> (i64, i64) {
    s: f32$ = khz()
    tens(s)
    f: f32[], ft: time[], s2: f32$ = frame(s)
    n: i64 = len f
    t3: time = load ft, 3
    us: i64 = to_micros(t3)
    ret n, us
}
; at 1.6 ms: linear gives 26, nearest gives 30 (as tenths)
fn interpolated() -> (i32, i32) {
    s: f32$ = khz()
    tens(s)
    t: time = micros(1600)
    l: f32$ = sampling(s, 2)
    x: f32 = sample l, t
    y: f32 = sample s, t
    x10: f32 = mul x, 10.0
    xi: i32 = conv x10
    yi: i32 = conv y
    ret xi, yi
}
; on the byte stream, 2.75 ms between 2 and 3 is 2 (rounded once,
; toward zero); a slope going down, 10 to 4, at its midpoint is 7
fn interpolated_int() -> (u8, u8) {
    s: u8$ = fresh()
    five(s)
    l: u8$ = sampling(s, 2)
    t: time = micros(2750)
    x: u8 = sample l, t
    s2: u8$ = fresh()
    l2: u8$ = sampling(s2, 2)
    t1: time = millis(1)
    t2: time = millis(2)
    push s2, t1, 10
    push s2, t2, 4
    tm: time = micros(1500)
    y: u8 = sample l2, tm
    ret x, y
}
; a push without a time needs a regular stream
fn irregular_push() -> u8 {
    s: u8$ = fresh()
    push s, 7
    x: u8 = latest s
    ret x
}

; --- audio: a dense regular stream, a block at a time, through a
; biquad — a node that reads behind its frame on its input and behind
; its own output, so its state is the rings' history, not its own ---
fn audio() -> (f32$, f32$) {
    r: ptr = addr arg
    a: ptr = addr avb
    b: ptr = addr atb
    ring_init(r, a, b)
    r2: ptr = addr org
    a2: ptr = addr ovb
    b2: ptr = addr otb
    ring_init(r2, a2, b2)
    dt: time = period(48000)
    t0: time = seconds(0)
    x0: f32$ = stream r
    x: f32$ = regular(x0, dt, t0)
    o0: f32$ = stream r2
    o: f32$ = regular(o0, dt, t0)
    ret x, o
}
; a block of four: an impulse, or silence
fn block(first: f32) -> f32[] {
    p: ptr = addr blk
    b: f32[] = slice p
    store first, b, 0
    store 0.0, b, 1
    store 0.0, b, 2
    store 0.0, b, 3
    ret b
}
; one application of y[n] = b0 x[n] + b1 x[n-1] + b2 x[n-2] - a1 y[n-1] - a2 y[n-2]
; to the frame of x since this reader looked, into out; the reader moved on
fn biquad(x: f32$, out: f32$, b0: f32, b1: f32, b2: f32, a1: f32, a2: f32) -> f32$ {
    f: f32[], ft: time[], x2: f32$ = frame(x)
    hx: f32[] = behind x, 2
    hy: f32[] = last out, 2
    n: i64 = len f
    px1: f32 = tail(hx, 1)
    px2: f32 = tail(hx, 2)
    py1: f32 = tail(hy, 1)
    py2: f32 = tail(hy, 2)
    loop(i: i64 = 0, x1: f32 = px1, xx2: f32 = px2, y1: f32 = py1, y2: f32 = py2) {
        done: u1 = cmp.ge i, n
        if done {
            break
        }
        xn: f32 = load f, i
        t0: f32 = mul b0, xn
        t1: f32 = mul b1, x1
        t2: f32 = mul b2, xx2
        u1_: f32 = mul a1, y1
        u2: f32 = mul a2, y2
        s0: f32 = add t0, t1
        s1: f32 = add s0, t2
        s2: f32 = sub s1, u1_
        y: f32 = sub s2, u2
        push out, y
        i2: i64 = add i, 1
        continue i2, xn, x1, y, y1
    }
    ret x2
}
; an FIR (a = 0): an impulse gives the taps back: 1, 0.5, 0.25, 0
fn biquad_fir() -> (u32, u32) {
    x: f32$, o: f32$ = audio()
    imp: f32[] = block(1.0)
    push x, imp
    x2: f32$ = biquad(x, o, 1.0, 0.5, 0.25, 0.0, 0.0)
    op: ptr = addr org
    r: f32$ = stream op
    f: f32[], ft: time[], r2: f32$ = frame(r)
    v1: f32 = load f, 1
    v2: f32 = load f, 2
    w1: u32 = cast v1
    w2: u32 = cast v2
    ret w1, w2
}
; y[n] = x[n] + 0.5 y[n-1]: an impulse block then a silent one, and the
; decay carries across the blocks through the output's history:
; 1/32 at 5, 1/128 at 7
fn biquad_iir() -> (u32, u32) {
    x: f32$, o: f32$ = audio()
    imp: f32[] = block(1.0)
    push x, imp
    x2: f32$ = biquad(x, o, 1.0, 0.0, 0.0, -0.5, 0.0)
    quiet: f32[] = block(0.0)
    push x2, quiet
    x3: f32$ = biquad(x2, o, 1.0, 0.0, 0.0, -0.5, 0.0)
    op: ptr = addr org
    r: f32$ = stream op
    f: f32[], ft: time[], r2: f32$ = frame(r)
    v5: f32 = load f, 5
    v7: f32 = load f, 7
    w5: u32 = cast v5
    w7: u32 = cast v7
    ret w5, w7
}
