; the same algorithms as elsewhere, written in structured form —
; these parse through the if/loop sugar and lower to the block graph
;! ssum 10 -> 45
;! ssum 0 -> 0
;! sgcd 1071 462 -> 21
;! sgcd 48 36 -> 12
;! sfib 20 -> 6765
;! sfib 1 -> 1
;! sabs -5 -> 5
;! sabs 5 -> 5
;! sclamp 15 0 10 -> 10
;! sclamp -3 0 10 -> 0
;! sclamp 7 0 10 -> 7
;! smul 3 4 -> 12
;! smul 0 9 -> 0
;! sminmax 9 4 -> 4, 9

fn ssum(n: i64) -> i64 {
    r: i64 = loop(i: i64 = 0, acc: i64 = 0) {
        done: u1 = cmp.ge i, n
        if done {
            break acc
        }
        acc2: i64 = add acc, i
        i2: i64 = add i, 1
        continue i2, acc2
    }
    ret r
}

fn sgcd(a: i64, b: i64) -> i64 {
    g: i64 = loop(x: i64 = a, y: i64 = b) {
        done: u1 = cmp.eq y, 0
        if done {
            break x
        }
        r: i64 = rem x, y
        continue y, r
    }
    ret g
}

fn sfib(n: i64) -> i64 {
    small: u1 = cmp.lt n, 2
    if small {
        ret n
    }
    n1: i64 = sub n, 1
    a: i64 = sfib(n1)
    n2: i64 = sub n, 2
    b: i64 = sfib(n2)
    r: i64 = add a, b
    ret r
}

fn sabs(a: i64) -> i64 {
    neg: u1 = cmp.lt a, 0
    r: i64 = if neg {
        n: i64 = sub 0, a
        yield n
    } else {
        yield a
    }
    ret r
}

fn sclamp(v: i64, lo: i64, hi: i64) -> i64 {
    below: u1 = cmp.lt v, lo
    r: i64 = if below {
        yield lo
    } else {
        above: u1 = cmp.gt v, hi
        s: i64 = if above {
            yield hi
        } else {
            yield v
        }
        yield s
    }
    ret r
}

; multiplication by repeated addition: nested loops
fn smul(a: i64, b: i64) -> i64 {
    total: i64 = loop(i: i64 = 0, t: i64 = 0) {
        done: u1 = cmp.ge i, a
        if done {
            break t
        }
        t2: i64 = loop(j: i64 = 0, s: i64 = t) {
            jdone: u1 = cmp.ge j, b
            if jdone {
                break s
            }
            s2: i64 = add s, 1
            j2: i64 = add j, 1
            continue j2, s2
        }
        i2: i64 = add i, 1
        continue i2, t2
    }
    ret total
}

; structured functions with multiple returns work too
fn sminmax(a: i64, b: i64) -> (i64, i64) {
    lt: u1 = cmp.lt a, b
    if lt {
        ret a, b
    }
    ret b, a
}
