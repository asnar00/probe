; the same algorithms as elsewhere, written in structured form —
; these parse through the if/loop sugar and lower to the block graph
;! ssum 10 -> 45
;! ssum 0 -> 0
;! sgcd 1071 462 -> 21
;! sgcd 48 36 -> 12
;! sfib 20 -> 6765
;! sfib 1 -> 1
;! sabs -5 -> 5
;! sabs 5 -> 5
;! sclamp 15 0 10 -> 10
;! sclamp -3 0 10 -> 0
;! sclamp 7 0 10 -> 7
;! smul 3 4 -> 12
;! smul 0 9 -> 0
;! sminmax 9 4 -> 4, 9

fn ssum(n: i64) -> i64 {
    zero: i64 = iconst 0
    r: i64 = loop(i: i64 = zero, acc: i64 = zero) {
        done: u1 = icmp.ge i, n
        if done {
            break acc
        }
        one: i64 = iconst 1
        acc2: i64 = iadd acc, i
        i2: i64 = iadd i, one
        continue i2, acc2
    }
    ret r
}

fn sgcd(a: i64, b: i64) -> i64 {
    g: i64 = loop(x: i64 = a, y: i64 = b) {
        zero: i64 = iconst 0
        done: u1 = icmp.eq y, zero
        if done {
            break x
        }
        r: i64 = rem x, y
        continue y, r
    }
    ret g
}

fn sfib(n: i64) -> i64 {
    two: i64 = iconst 2
    small: u1 = icmp.lt n, two
    if small {
        ret n
    }
    one: i64 = iconst 1
    n1: i64 = isub n, one
    a: i64 = call sfib(n1)
    n2: i64 = isub n, two
    b: i64 = call sfib(n2)
    r: i64 = iadd a, b
    ret r
}

fn sabs(a: i64) -> i64 {
    zero: i64 = iconst 0
    neg: u1 = icmp.lt a, zero
    r: i64 = if neg {
        n: i64 = isub zero, a
        yield n
    } else {
        yield a
    }
    ret r
}

fn sclamp(v: i64, lo: i64, hi: i64) -> i64 {
    below: u1 = icmp.lt v, lo
    r: i64 = if below {
        yield lo
    } else {
        above: u1 = icmp.gt v, hi
        s: i64 = if above {
            yield hi
        } else {
            yield v
        }
        yield s
    }
    ret r
}

; multiplication by repeated addition: nested loops
fn smul(a: i64, b: i64) -> i64 {
    zero: i64 = iconst 0
    one: i64 = iconst 1
    total: i64 = loop(i: i64 = zero, t: i64 = zero) {
        done: u1 = icmp.ge i, a
        if done {
            break t
        }
        t2: i64 = loop(j: i64 = zero, s: i64 = t) {
            jdone: u1 = icmp.ge j, b
            if jdone {
                break s
            }
            s2: i64 = iadd s, one
            j2: i64 = iadd j, one
            continue j2, s2
        }
        i2: i64 = iadd i, one
        continue i2, t2
    }
    ret total
}

; structured functions with multiple returns work too
fn sminmax(a: i64, b: i64) -> (i64, i64) {
    lt: u1 = icmp.lt a, b
    if lt {
        ret a, b
    }
    ret b, a
}
