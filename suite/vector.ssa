; vectors: `TxN` is N lanes of T — `i32x4`, `f32x4`, `u8x8`, `floatx4`
; with the policy's float, `intx2` with its int, `u1x4` for a
; comparison's result. A vector is a struct of numbered lanes:
; `pack`/`unpack` build and split it, `get v, 2` and `set v, 0, x`
; reach one lane, `splat x` fills every lane. Arithmetic, comparisons
; and conversions on vectors are lane by lane — the scalar operation on
; each lane, the library's for a pack lane — so they run on every
; backend, instruction by instruction; a platform that says `builtin
; vectors` (AIR) takes the whole vector at once, and one with a
; register class and rules for it (NEON on arm64, RVV on riscv64)
; takes whole the operations it has rules for. `Tx1` is T.

;! add4 1 2 3 4 10 20 30 40 -> 22, 44
;! mul_splat 1 2 3 4 3 -> 3, 12
;! lanes 5 6 7 8 -> 7
;! set_lane 5 6 7 8 99 -> 99, 8
;! cmp_lanes 1 5 3 7 4 -> 10
;! dot 1 2 3 4 5 6 7 8 -> 70
;! fadd4 0x3f800000 0x40000000 0x40400000 0x40800000 0x3f000000 -> 0x40200000, 0x40900000
;! fsqrt4 0x40800000 0x41100000 0x41800000 0x42c80000 -> 0x40000000, 0x41200000
;! via_memory i64[0,0,0,0] 9 8 7 6 -> 30
;! widen 200 100 -> 300
;! bytes_sum 1 2 3 4 5 6 7 8 -> 36
;! one_lane 41 -> 42
;! abstract_float 0x3f800000 0x40000000 -> 1
;! fadd2 0x3ff0000000000000 0x4000000000000000 0x3fe0000000000000 -> 0x3ff8000000000000, 0x4004000000000000
;! fma4 0x3f800000 0x40000000 0x40400000 0x40800000 0x40000000 0x3f000000 -> 0x40900000, 0x41080000
;! minmax4 0x3f800000 0x40000000 0x40400000 0x40800000 0x40200000 -> 0x40000000, 0x40800000
;! fmask 0x3f800000 0x7fc00000 0x40400000 0x40800000 0x40000000 -> 12, 15
;! umask 1 0x80000000 3 0xffffffff 2 -> 14, 4
;! shifts 1 2 -8 16 3 1 2 4 -> -32, -2
;! ushr 0xffffffff 4 -> 0x0fffffff
;! fconv 0x402ccccd 0xc02ccccd 0x3f000000 0x42c80000 -> 2, -2
;! iconv 3 -4 5 6 -> 0x40400000, 0xc0800000
;! via_memory_f i64[0,0,0,0] 0x3f800000 0x40000000 0x40400000 0x40800000 -> 0x40400000, 0x40800000
;! vloop 5 1 2 3 4 -> 20, 40
;! many 1 -> 55, 55
;! masks 1 5 3 7 2 6 -> 6, 15
;! fnegabs 0xc0000000 -> 0x40000000, 0x40000000
;! bits 0x40000000 0x3f800000 -> 0x40000000, 0x40400000
;! i64x2ops 5 -7 3 2 -> 8, -9
;! cmp2 0x3ff0000000000000 0x4008000000000000 0x4000000000000000 5 -7 3 2 -> 2, 1

type v4 = i32x4

; (the native runner returns two values at most; the qemu and wasm
; paths any number — so two lanes come back, chosen to differ)
fn add4(a0: i32, a1: i32, a2: i32, a3: i32, b0: i32, b1: i32, b2: i32, b3: i32) -> (i32, i32) {
    a: v4 = pack a0, a1, a2, a3
    b: v4 = pack b0, b1, b2, b3
    c: v4 = add a, b
    r0: i32, r1: i32, r2: i32, r3: i32 = unpack c
    ret r1, r3
}

fn mul_splat(a0: i32, a1: i32, a2: i32, a3: i32, k: i32) -> (i32, i32) {
    a: i32x4 = pack a0, a1, a2, a3
    ks: i32x4 = splat k
    c: i32x4 = mul a, ks
    r0: i32, r1: i32, r2: i32, r3: i32 = unpack c
    ret r0, r3
}

fn lanes(a0: i32, a1: i32, a2: i32, a3: i32) -> i32 {
    a: i32x4 = pack a0, a1, a2, a3
    x: i32 = get a, 2
    ret x
}

fn set_lane(a0: i32, a1: i32, a2: i32, a3: i32, x: i32) -> (i32, i32) {
    a: i32x4 = pack a0, a1, a2, a3
    b: i32x4 = set a, 1, x
    r0: i32, r1: i32, r2: i32, r3: i32 = unpack b
    ret r1, r3
}

; a comparison gives a vector of u1; here folded into a mask
fn cmp_lanes(a0: i32, a1: i32, a2: i32, a3: i32, k: i32) -> u8 {
    a: i32x4 = pack a0, a1, a2, a3
    ks: i32x4 = splat k
    m: u1x4 = cmp.gt a, ks
    r0: u1, r1: u1, r2: u1, r3: u1 = unpack m
    b0: u8 = conv r0
    b1: u8 = conv r1
    b2: u8 = conv r2
    b3: u8 = conv r3
    s1: u8 = shl b1, 1
    s2: u8 = shl b2, 2
    s3: u8 = shl b3, 3
    o1: u8 = or b0, s1
    o2: u8 = or o1, s2
    o3: u8 = or o2, s3
    ret o3
}

; a horizontal sum, lane by lane
fn dot(a0: i32, a1: i32, a2: i32, a3: i32, b0: i32, b1: i32, b2: i32, b3: i32) -> i32 {
    a: i32x4 = pack a0, a1, a2, a3
    b: i32x4 = pack b0, b1, b2, b3
    p: i32x4 = mul a, b
    p0: i32, p1: i32, p2: i32, p3: i32 = unpack p
    s01: i32 = add p0, p1
    s23: i32 = add p2, p3
    s: i32 = add s01, s23
    ret s
}

; float lanes: each lane's add is the float library's, or the FPU's
fn fadd4(a0: f32, a1: f32, a2: f32, a3: f32, h: f32) -> (f32, f32) {
    a: f32x4 = pack a0, a1, a2, a3
    hs: f32x4 = splat h
    c: f32x4 = add a, hs
    r0: f32, r1: f32, r2: f32, r3: f32 = unpack c
    ret r1, r3
}

; a library operation on every lane
fn fsqrt4(a0: f32, a1: f32, a2: f32, a3: f32) -> (f32, f32) {
    a: f32x4 = pack a0, a1, a2, a3
    c: f32x4 = sqrt a
    r0: f32, r1: f32, r2: f32, r3: f32 = unpack c
    ret r0, r3
}

; stored and loaded whole: lanes consecutive in memory
fn via_memory(p: ptr, a0: i64, a1: i64, a2: i64, a3: i64) -> i64 {
    a: i64x4 = pack a0, a1, a2, a3
    store a, p
    b: i64x4 = load p
    x: i64 = load p, 16
    b0: i64, b1: i64, b2: i64, b3: i64 = unpack b
    s0: i64 = add b0, b1
    s1: i64 = add b2, b3
    s: i64 = add s0, s1
    t: i64 = add s, x
    u: i64 = sub t, b2
    ret u
}

; conversion lane by lane
fn widen(a: u8, b: u8) -> i32 {
    v: u8x2 = pack a, b
    w: i32x2 = conv v
    w0: i32, w1: i32 = unpack w
    s: i32 = add w0, w1
    ret s
}

; eight byte lanes, as a block parameter
fn bytes_sum(a: u8, b: u8, c: u8, d: u8, e: u8, f: u8, g: u8, h: u8) -> i32 {
    v: u8x8 = pack a, b, c, d, e, f, g, h
    s: i32 = loop(i: i64 = 0, acc: i32 = 0, w: u8x8 = v) {
        done: u1 = cmp.ge i, 1
        if done {
            break acc
        }
        x0: u8, x1: u8, x2: u8, x3: u8, x4: u8, x5: u8, x6: u8, x7: u8 = unpack w
        y0: i32 = conv x0
        y1: i32 = conv x1
        y2: i32 = conv x2
        y3: i32 = conv x3
        y4: i32 = conv x4
        y5: i32 = conv x5
        y6: i32 = conv x6
        y7: i32 = conv x7
        t0: i32 = add y0, y1
        t1: i32 = add y2, y3
        t2: i32 = add y4, y5
        t3: i32 = add y6, y7
        u0: i32 = add t0, t1
        u1: i32 = add t2, t3
        acc2: i32 = add u0, u1
        i2: i64 = add i, 1
        continue i2, acc2, w
    }
    ret s
}

; Tx1 is T
fn one_lane(x: i32) -> i32x1 {
    y: i32x1 = add x, 1
    ret y
}

; an abstract lane type: the policy's float, whatever it is — and a + b
; is b + a in every lane
fn abstract_float(a: float, b: float) -> u1 {
    v: floatx2 = pack a, b
    w: floatx2 = pack b, a
    s: floatx2 = add v, w
    r0: float, r1: float = unpack s
    same: u1 = cmp.eq r0, r1
    ret same
}

; --- the cases below reach every kind of vector instruction a platform
; may take whole (NEON on arm64: targets/arm64.platform); everywhere
; else they are the lanes, which is what the rules are checked against ---

fn fadd2(a0: f64, a1: f64, h: f64) -> (f64, f64) {
    a: f64x2 = pack a0, a1
    hs: f64x2 = splat h
    c: f64x2 = add a, hs
    r0: f64, r1: f64 = unpack c
    ret r0, r1
}

; a*b + c in one rounding per lane
fn fma4(a0: f32, a1: f32, a2: f32, a3: f32, b: f32, c: f32) -> (f32, f32) {
    a: f32x4 = pack a0, a1, a2, a3
    bs: f32x4 = splat b
    cs: f32x4 = splat c
    f: f32x4 = fma a, bs, cs
    r0: f32, r1: f32, r2: f32, r3: f32 = unpack f
    ret r1, r3
}

fn minmax4(a0: f32, a1: f32, a2: f32, a3: f32, k: f32) -> (f32, f32) {
    a: f32x4 = pack a0, a1, a2, a3
    ks: f32x4 = splat k
    lo: f32x4 = min a, ks
    hi: f32x4 = max a, ks
    l0: f32, l1: f32, l2: f32, l3: f32 = unpack lo
    h0: f32, h1: f32, h2: f32, h3: f32 = unpack hi
    ret l1, h3
}

; a comparison's lanes as a mask; a NaN lane is greater than nothing
; and unequal to everything
fn fmask(a0: f32, a1: f32, a2: f32, a3: f32, k: f32) -> (u8, u8) {
    a: f32x4 = pack a0, a1, a2, a3
    ks: f32x4 = splat k
    g: u1x4 = cmp.gt a, ks
    n: u1x4 = cmp.ne a, ks
    g0: u1, g1: u1, g2: u1, g3: u1 = unpack g
    n0: u1, n1: u1, n2: u1, n3: u1 = unpack n
    gm: u8 = mask4(g0, g1, g2, g3)
    nm: u8 = mask4(n0, n1, n2, n3)
    ret gm, nm
}

fn mask4(b0: u1, b1: u1, b2: u1, b3: u1) -> u8 {
    c0: u8 = conv b0
    c1: u8 = conv b1
    c2: u8 = conv b2
    c3: u8 = conv b3
    s1: u8 = shl c1, 1
    s2: u8 = shl c2, 2
    s3: u8 = shl c3, 3
    o1: u8 = or c0, s1
    o2: u8 = or o1, s2
    o3: u8 = or o2, s3
    ret o3
}

; unsigned lanes compare unsigned; the same bits cast to signed lanes
; compare signed
fn umask(a0: u32, a1: u32, a2: u32, a3: u32, k: u32) -> (u8, u8) {
    a: u32x4 = pack a0, a1, a2, a3
    ks: u32x4 = splat k
    u: u1x4 = cmp.gt a, ks
    sa: i32x4 = cast a
    sk: i32x4 = cast ks
    s: u1x4 = cmp.gt sa, sk
    u0: u1, u1: u1, u2: u1, u3: u1 = unpack u
    s0: u1, s1: u1, s2: u1, s3: u1 = unpack s
    um: u8 = mask4(u0, u1, u2, u3)
    sm: u8 = mask4(s0, s1, s2, s3)
    ret um, sm
}

; shifts by a vector of counts; a signed right shift keeps the sign
fn shifts(a0: i32, a1: i32, a2: i32, a3: i32, n0: i32, n1: i32, n2: i32, n3: i32) -> (i32, i32) {
    a: i32x4 = pack a0, a1, a2, a3
    n: i32x4 = pack n0, n1, n2, n3
    l: i32x4 = shl a, n
    r: i32x4 = shr a, n
    l2: i32 = get l, 2
    r2: i32 = get r, 2
    ret l2, r2
}

fn ushr(a: u32, n: u32) -> u32 {
    v: u32x4 = splat a
    ns: u32x4 = splat n
    r: u32x4 = shr v, ns
    x: u32 = get r, 0
    ret x
}

; float to integer truncates toward zero
fn fconv(a0: f32, a1: f32, a2: f32, a3: f32) -> (i32, i32) {
    a: f32x4 = pack a0, a1, a2, a3
    i: i32x4 = conv a
    r0: i32 = get i, 0
    r1: i32 = get i, 1
    ret r0, r1
}

fn iconv(a0: i32, a1: i32, a2: i32, a3: i32) -> (f32, f32) {
    a: i32x4 = pack a0, a1, a2, a3
    f: f32x4 = conv a
    r0: f32 = get f, 0
    r1: f32 = get f, 1
    ret r0, r1
}

; float lanes through memory, at the alignment of a lane
fn via_memory_f(p: ptr, a0: f32, a1: f32, a2: f32, a3: f32) -> (f32, f32) {
    a: f32x4 = pack a0, a1, a2, a3
    store a, p
    b: f32x4 = load p
    c: f32x4 = add b, b
    store c, p, 16
    x: f32 = load p, 20
    y: f32 = load p, 8
    ret y, x
}

; a vector carried around a loop: sum of i * k over i < n, in every lane
fn vloop(n: i64, k0: i32, k1: i32, k2: i32, k3: i32) -> (i32, i32) {
    w: i32x4 = pack k0, k1, k2, k3
    z: i32x4 = sub w, w
    acc: i32x4 = loop(i: i64 = 0, s: i32x4 = z) {
        done: u1 = cmp.ge i, n
        if done {
            break s
        }
        i32v: i32 = conv i
        iv: i32x4 = splat i32v
        p: i32x4 = mul iv, w
        s1: i32x4 = add s, p
        i1: i64 = add i, 1
        continue i1, s1
    }
    r0: i32, r1: i32, r2: i32, r3: i32 = unpack acc
    ret r1, r3
}

; ten vectors live at once: more than the registers, so some spill
fn many(a: i32) -> (i32, i32) {
    b1: i32 = add a, 1
    b2: i32 = add a, 2
    b3: i32 = add a, 3
    b4: i32 = add a, 4
    b5: i32 = add a, 5
    b6: i32 = add a, 6
    b7: i32 = add a, 7
    b8: i32 = add a, 8
    b9: i32 = add a, 9
    v0: i32x4 = splat a
    v1: i32x4 = splat b1
    v2: i32x4 = splat b2
    v3: i32x4 = splat b3
    v4: i32x4 = splat b4
    v5: i32x4 = splat b5
    v6: i32x4 = splat b6
    v7: i32x4 = splat b7
    v8: i32x4 = splat b8
    v9: i32x4 = splat b9
    s01: i32x4 = add v0, v1
    s23: i32x4 = add v2, v3
    s45: i32x4 = add v4, v5
    s67: i32x4 = add v6, v7
    s89: i32x4 = add v8, v9
    t0: i32x4 = add s01, s23
    t1: i32x4 = add s45, s67
    t2: i32x4 = add t0, t1
    t3: i32x4 = add t2, s89
    r0: i32 = get t3, 0
    r3: i32 = get t3, 3
    ret r0, r3
}

; masks combined: lo < a < hi, and either
fn masks(a0: i32, a1: i32, a2: i32, a3: i32, lo: i32, hi: i32) -> (u8, u8) {
    a: i32x4 = pack a0, a1, a2, a3
    los: i32x4 = splat lo
    his: i32x4 = splat hi
    g: u1x4 = cmp.gt a, los
    l: u1x4 = cmp.lt a, his
    both: u1x4 = and g, l
    either: u1x4 = or g, l
    b0: u1, b1: u1, b2: u1, b3: u1 = unpack both
    e0: u1, e1: u1, e2: u1, e3: u1 = unpack either
    bm: u8 = mask4(b0, b1, b2, b3)
    em: u8 = mask4(e0, e1, e2, e3)
    ret bm, em
}

fn fnegabs(x: f32) -> (f32, f32) {
    v: f32x4 = splat x
    n: f32x4 = neg v
    a: f32x4 = abs v
    n0: f32 = get n, 0
    a0: f32 = get a, 0
    ret n0, a0
}

; the bits of float lanes, and back
fn bits(x: f32, one: f32) -> (u32, f32) {
    v: f32x4 = splat x
    u: u32x4 = cast v
    b1: u32 = get u, 1
    back: f32x4 = cast u
    ones: f32x4 = splat one
    s: f32x4 = add back, ones
    s0: f32 = get s, 0
    ret b1, s0
}

fn i64x2ops(a0: i64, a1: i64, b0: i64, b1: i64) -> (i64, i64) {
    a: i64x2 = pack a0, a1
    b: i64x2 = pack b0, b1
    s: i64x2 = add a, b
    d: i64x2 = sub a, b
    s0: i64 = get s, 0
    d1: i64 = get d, 1
    ret s0, d1
}

; two-lane comparisons: doubles, and 64-bit integers
fn cmp2(x0: f64, x1: f64, k: f64, a0: i64, a1: i64, b0: i64, b1: i64) -> (u8, u8) {
    x: f64x2 = pack x0, x1
    ks: f64x2 = splat k
    g: u1x2 = cmp.gt x, ks
    a: i64x2 = pack a0, a1
    b: i64x2 = pack b0, b1
    h: u1x2 = cmp.gt a, b
    g0: u1, g1: u1 = unpack g
    h0: u1, h1: u1 = unpack h
    gm: u8 = mask2(g0, g1)
    hm: u8 = mask2(h0, h1)
    ret gm, hm
}

fn mask2(b0: u1, b1: u1) -> u8 {
    c0: u8 = conv b0
    c1: u8 = conv b1
    s1: u8 = shl c1, 1
    o: u8 = or c0, s1
    ret o
}
