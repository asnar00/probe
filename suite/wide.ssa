fn add(a: u128, b: u128) -> u128 {
    r: u128 = add a, b
    ret r
}
fn sub(a: u128, b: u128) -> u128 {
    r: u128 = sub a, b
    ret r
}
fn mul(a: u128, b: u128) -> u128 {
    r: u128 = mul a, b
    ret r
}
fn div(a: u128, b: u128) -> u128 {
    r: u128 = div a, b
    ret r
}
fn rem(a: u128, b: u128) -> u128 {
    r: u128 = rem a, b
    ret r
}
fn sdiv(a: i128, b: i128) -> i128 {
    r: i128 = div a, b
    ret r
}
fn srem(a: i128, b: i128) -> i128 {
    r: i128 = rem a, b
    ret r
}
fn smul(a: i128, b: i128) -> i128 {
    r: i128 = mul a, b
    ret r
}
fn shl(a: u128, k: u64) -> u128 {
    kw: u128 = conv k
    r: u128 = shl a, kw
    ret r
}
fn shr(a: u128, k: u64) -> u128 {
    kw: u128 = conv k
    r: u128 = shr a, kw
    ret r
}
fn sar(a: i128, k: u64) -> i128 {
    kw: i128 = conv k
    r: i128 = shr a, kw
    ret r
}
fn shl7(a: u128) -> u128 {
    r: u128 = shl a, 7
    ret r
}
fn shr100(a: u128) -> u128 {
    r: u128 = shr a, 100
    ret r
}
fn sar100(a: i128) -> i128 {
    r: i128 = shr a, 100
    ret r
}
fn ult(a: u128, b: u128) -> u1 {
    r: u1 = cmp.lt a, b
    ret r
}
fn ule(a: u128, b: u128) -> u1 {
    r: u1 = cmp.le a, b
    ret r
}
fn eq(a: u128, b: u128) -> u1 {
    r: u1 = cmp.eq a, b
    ret r
}
fn slt(a: i128, b: i128) -> u1 {
    r: u1 = cmp.lt a, b
    ret r
}
fn sge(a: i128, b: i128) -> u1 {
    r: u1 = cmp.ge a, b
    ret r
}
fn ext(a: i64) -> i128 {
    r: i128 = conv a
    ret r
}
fn zext(a: u64) -> u128 {
    r: u128 = conv a
    ret r
}
fn trunc(a: u128) -> i32 {
    r: i32 = conv a
    ret r
}
fn add256lo(a: u256, b: u256) -> u128 {
    s: u256 = add a, b
    r: u128 = conv s
    ret r
}
fn add256hi(a: u256, b: u256) -> u128 {
    s: u256 = add a, b
    h: u256 = shr s, 128
    r: u128 = conv h
    ret r
}
fn mul256lo(a: u256, b: u256) -> u128 {
    s: u256 = mul a, b
    r: u128 = conv s
    ret r
}
fn mul256hi(a: u256, b: u256) -> u128 {
    s: u256 = mul a, b
    h: u256 = shr s, 128
    r: u128 = conv h
    ret r
}

type wide = pack { lo: u100, hi: u28, tag: u8 }

fn mkwide(lo: u128, hi: u28, tag: u8) -> u128 {
    l: u100 = conv lo
    p: wide = pack l, hi, tag
    bits: u136 = cast p
    r: u128 = conv bits
    ret r
}
fn mkwide_top(lo: u128, hi: u28, tag: u8) -> u8 {
    l: u100 = conv lo
    p: wide = pack l, hi, tag
    bits: u136 = cast p
    t: u136 = shr bits, 128
    r: u8 = conv t
    ret r
}
fn gethi(p: wide) -> u28 {
    r: u28 = get p, hi
    ret r
}
fn gettag(p: wide) -> u8 {
    r: u8 = get p, tag
    ret r
}
fn getlo(p: wide) -> u128 {
    l: u100 = get p, lo
    r: u128 = conv l
    ret r
}
fn settag(p: wide, t: u8) -> u128 {
    q: wide = set p, tag, t
    bits: u136 = cast q
    r: u128 = conv bits
    ret r
}
fn sethi(p: wide, h: u28) -> u128 {
    q: wide = set p, hi, h
    bits: u136 = cast q
    r: u128 = conv bits
    ret r
}
fn sum_mem(p: ptr) -> u128 {
    a: u128 = load p
    q: ptr = ptradd p, 16
    b: u128 = load q
    s: u128 = add a, b
    ret s
}
fn sumsq(n: i64) -> u128 {
    r: u128 = loop(i: i64 = 1, acc: u128 = 0) {
        done: u1 = cmp.gt i, n
        if done {
            break acc
        }
        w: u128 = conv i
        sq: u128 = mul w, w
        acc2: u128 = add acc, sq
        i2: i64 = add i, 1
        continue i2, acc2
    }
    ret r
}
