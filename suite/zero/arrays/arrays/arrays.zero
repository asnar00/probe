type point =
    int x, y

type span =
    point from, to
    bool open

int marks[] = [3, 4]
int total$ << 0

on (int n) << listed()
    int a[] = [1, 2, 3, 4]
    n << count a[]

on (int n) << third()
    int a[] = [10, 20, 30, 40]
    n << a[2]

on (int n) << ranged to (int m)
    int a[] = [1 through m]
    n << a[count a[] - 1] * 10 + a[0]

on (int n) << texted()
    char c[] = "hello"
    n << count c[]

on (int n) << summed()
    int a[] = [1, 2, 3, 4]
    n << a[] + _

on (int n) << mapped()
    int a[] = [1, 2, 3, 4]
    int b[] = a[] + 1
    n << b[] + _

on (int n) << zipped()
    int a[] = [1, 2, 3, 4]
    int b[] = [4, 5, 6]
    int c[] = a[] + b[]
    n << count c[] * 100 + c[3] * 10 + (c[] + _) - 25

on (int n) << walked()
    int a[] = [1, 2, 3, 4]
    for (x in a[])
        total$ << total$ + x
    n << total$

on (int d) << doubled (int x)
    d << x * 2

on (int n) << each doubled()
    int a[] = [1, 2, 3, 4]
    int j[] = doubled (a[])
    n << j[] + _

on (int n) << total of (int x[])
    n << x[] + _

on (int n) << handed()
    int a[] = [1, 2, 3]
    n << [total of] (a[]) * 10 + [total of] ([4, 5])

on (int r[]) << squares to (int k)
    r[] << [1 through k] * [1 through k]

on (int n) << squared()
    int s[] = squares to (4)
    n << s[3]

on (int n) << framed()
    int x$ << 1 << 2 << 3
    int f[] = frame x$
    n << (f[] + _) * 10 + count x$

on said whole()
    int a[] = [1, 2, 3]
    out$ << a[] << "\n"

on (int n) << marked()
    n << marks[] + _ + marks[0]

on (bool same) << the same()
    int a[] = [1, 2, 3]
    int b[] = [1, 2, 3]
    same << a[] [==] b[]

on (bool same) << differing by an item()
    int a[] = [1, 2, 3]
    int b[] = [1, 5, 3]
    same << a[] [==] b[]

on (bool same) << differing by length()
    int a[] = [1, 2, 3]
    same << a[] [==] [1, 2]

on (bool same) << two empty()
    int a[] = []
    int b[] = []
    same << a[] [==] b[]

on (bool differ) << not the same()
    int a[] = [1, 2, 3]
    differ << a[] [!=] [1, 2, 4]

on (bool same) << a text and its letters()
    string s = "abc"
    char cs[] = "abc"
    same << s [==] cs[]

on (int n) << compared for a condition()
    int a[] = [1, 2, 3]
    n << if (a[] [==] [1 through 3]) then (7) else (0)

on (bool same) << what arrived()
    int x$ << 4 << 5 << 6
    same << frame x$ [==] [4, 5, 6]

on (bool a, bool b) << two points()
    point p = point(1, 2)
    point q = point(1, 2)
    point r = point(1, 3)
    a << p == q
    b << p == r

on (bool b) << points apart()
    b << point(1, 2) != point(2, 1)

on (bool a, bool b) << two spans()
    span s = span(point(1, 2), point(3, 4), true)
    a << s == span(point(1, 2), point(3, 4), true)
    b << s == span(point(1, 2), point(3, 5), true)

on (int n) << points listed()
    point ps[] = [point(1, 2), point(3, 4), point(5, 6)]
    n << count ps[]

on (bool a, bool b) << points the same()
    point ps[] = [point(1, 2), point(3, 4)]
    point qs[] = [point(1, 2), point(3, 4)]
    a << ps[] [==] qs[]
    b << ps[] [!=] qs[]

on (bool a, bool b) << points differing()
    point ps[] = [point(1, 2), point(3, 4)]
    a << ps[] [==] [point(1, 2), point(3, 5)]
    b << ps[] [==] [point(1, 2)]

on (bool same) << points that arrived()
    point x$ << point(4, 5) << point(6, 7)
    same << frame x$ [==] [point(4, 5), point(6, 7)]
