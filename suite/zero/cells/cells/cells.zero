type token =
    int kind, start, n

type Mode = off | on | auto

type Vec =
    float x, y, z = 0

type duo =
    int x, y

int seen$ << 0
int high$
bool flag$
Mode mode$ << auto
Vec origin$ << Vec(1, 2, 3)
int doubling$ << 1
int both$ << 5
token t$

on bump()
    seen$ << seen$ + 1

on (int n) << bumped twice()
    bump()
    bump()
    n << seen$

on step (int i)
    seen$ << seen$ + 1

on (int n) << bumped (int k) times
    step ([1 through k])
    n << seen$

on (int n) << counted up to (int k)
    seen$ << (seen$ + 1) while (_ <= k)
    n << seen$

on (int n) << one more()
    bump()
    int x = seen$ + 1
    n << x

on (int n) << the latest()
    bump()
    n << latest seen$

on (int n) << before any()
    n << high$

on (int n) << made()
    bump()
    bump()
    t$ << token(3, seen$, 1)
    n << (peek t$ at (0)).start

on (int n) << past (int limit)
    bump()
    n << (1 if (seen$ > limit) else 0)

on (int n) << checked()
    bump()
    check (seen$ == 1)
    n << seen$

on (bool b) << raised()
    flag$ << true
    b << flag$

on (bool b) << is auto()
    b << mode$ == auto

on (bool b) << switched on()
    mode$ << on
    b << mode$ == Mode.on

on (int n) << origin sum()
    n << int(origin$.x + origin$.y + origin$.z)

on (int n) << moved origin()
    origin$ << Vec(4, 5, 6)
    n << int(origin$.x + origin$.z)

on (int n) << twice (int x)
    n << x * 2

on (int n) << twice seen()
    bump()
    bump()
    bump()
    n << twice (seen$)

on (int n) << summed to seen()
    bump()
    bump()
    bump()
    n << [1 through seen$] + _

on (int n) << doubled past (int limit)
    doubling$ << (doubling$ * 2) while (_ < limit)
    n << doubling$

on (int n) << counted()
    both$ << both$ + 1
    n << both$ * 10 + count both$

on (int n) << local up to (int k)
    int i$ << 0 << (i$ + 1) while (_ <= k)
    n << i$

on (int n) << local doubled past (int k)
    int i$ << 1 << (i$ * 2) until (i$ >= k)
    n << i$

on (int n) << local doubled (int k)
    int i$ << 1 << (i$ * 2) (k) times
    n << i$

on (int n) << local chosen (int k)
    int i$ << 1
    i$ << i$ + 10 if (k > 0)
    i$ << i$ * 2
    n << latest i$

on (int n) << local before any()
    int i$
    n << i$ + 1

on (int n) << local struct (int k)
    token t$ << token(1, 0, 0) << token(t$.kind + 1, t$.start + t$.kind, t$.n * 2 + 1) (k) times
    token last = t$
    n << last.kind * 100 + last.start * 10 + last.n

on (int n) << local by the candidate (int k)
    token t$ << token(1, 0, 0) << token(t$.kind + 1, t$.kind, 0) while (_.kind <= k)
    n << t$.kind * 10 + t$.start

on (int n) << local and counted (int k)
    int i$ << 0 << (i$ + 1) while (_ <= k)
    n << count i$ * 100 + i$

on (int n) << local pushed round a loop (int k)
    int i$ << 0
    loop (int j = 0) while (j < k)
        i$ << i$ + j
        continue (j + 1)
    n << i$

on (int n) << local counted far (int k)
    int i$ << 0 << (i$ + 1) while (i$ < k)
    n << count i$

on (int n) << local summed round a loop (int k)
    int s$
    loop (int j = 1) while (j <= k)
        s$ << s$ + j
        continue (j + 1)
    n << s$

on (int n) << local pair round a loop (int k)
    duo p$ << duo(0, 1)
    loop (int j = 0) while (j < k)
        p$ << duo(p$.y, p$.x + p$.y)
        continue (j + 1)
    n << p$.x

on (int n) << how many of (int x$)
    n << count x$

on (int n) << local handed on()
    int i$ << 4 << 5 << 6
    n << how many of (i$)

on local shown()
    int i$ << 3
    i$ << i$ + 4
    out$ << i$
