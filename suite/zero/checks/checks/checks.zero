on (int n) = within (int k)
    check (k < 5)
    n = k

on (int s) = guarded sum (int k)
    check (k >= 0)
    s = [0 through k] + _

on (int v) = small (int i)
    check (i < 4)
    v = i

on (int n) = bounded (int k)
    n = small ([1 to k + 1]) + _

on (int n) = either (int k)
    if (k > 10)
        check (k < 100)
        n = 2
    else
        n = 1

on (int n) = outside()
    int i$ = [1, 2]
    n = i$[5]

on (int n) = after printing()
    print "so far"
    int k = 1
    check (k == 2)
    n = k
