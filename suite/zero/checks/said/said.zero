int kept$

on (int n) << kept up (int k)
    kept$ << 1 (k) times
    n << peek kept$ at (0) + count kept$ - 1

on (int n) << counted (int k)
    int s$
    s$ << 1 (k) times
    n << count s$

on (int n) << looked()
    n << outside()

on (int n) << share (int a) among (int k)
    n << a / k

on (int n) << left of (int a) among (int k)
    n << a % k

on (int n) << halved (int a)
    n << a / 2

on (int n) << shared safely (int a, int k)
    n << a / k if (k != 0) else 0
