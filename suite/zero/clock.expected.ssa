fn __set___node2_fin(v: u1)
    p: ptr = addr __ctx_mem
    c: __ctx = load p
    c2: __ctx = set c, __node2_fin, v
    store c2, p
    ret

; a feature's effective state: its own enabled and its ancestors', read by every gate
fn __on_platform() -> u1
    own: u1 = __get___enabled_platform()
    ret own
fn __on_clock() -> u1
    own: u1 = __get___enabled_clock()
    ret own

; node 1: write (out$) — run when an input has more than the node has seen, or has ended and the node has not run since
fn __node1() -> u1
    fin: u1 = __get___node1_fin()
    notfin: u1 = xor fin, 1
    _1: u8$ = __get___node1_c()
    _2: i64 = received(_1)
    _3: i64 = __get___node1_c_seen()
    _4: u1 = cmp.gt _2, _3
    _5: u1 = ended(_1)
    _6: u1 = and _5, notfin
    _7: u1 = or _4, _6
    on: u1 = __on_platform()
    due: u1 = and _7, on
    ran: u1 = if due
        _8: u8$ = write(_1, 0: i64)
        __set___node1_c(_8)
        _9: i64 = received(_8)
        __set___node1_c_seen(_9)
        _10: u1 = ended(_8)
        __set___node1_fin(_10)
        yield 1
    else
        yield 0
    ret ran

; node 2: int t$ = ticks (5) at (4 hz) — run when an input has more than the node has seen, or has ended and the node has not run since
fn __node2() -> u1
    fin: u1 = __get___node2_fin()
    notfin: u1 = xor fin, 1
    on: u1 = __on_clock()
    due: u1 = and notfin, on
    ran: u1 = if due
        _1: int$ = __get_t()
        _2: int = const 5
        ticks(_1, _2, 4: i64)
        __set___node2_fin(1)
        yield 1
    else
        yield 0
    ret ran

; the scheduler (log 25, 78): the node graph is acyclic, so one pass in producer-before-consumer order settles it — every node at the start, and after a push into a stream the nodes it reaches
fn __run()
    p: ptr = addr __running
    busy: i64 = load p
    idle: u1 = cmp.eq busy, 0
    if idle
        store 1: i64, p
        r1: u1 = __node1()
        r2: u1 = __node2()
        store 0: i64, p
    ret

; feature platform (layer platform)
fn write(c: u8$, __hz: i64) -> u8$
    n: i64 = count(c)
    c2: u8$ = advance(c, n)
    ret c2

; feature clock (layer runtime)
fn ticks(t: int$, n: int, __hz: i64)
    _1: int = const 1
    __push(t, _1)
    __sleep(__hz)
    loop()
        _2: int = latest t
        _3: int = add _2, 1
        _4: u1 = cmp.le _3, n
        if _4
        else
            break
        __push(t, _3)
        __sleep(__hz)
        continue
    ret
fn value_at(m: int) -> int
    _1: int$ = __get_t()
    _2: i64 = conv m
    _3: time = millis(_2)
    v: int = sample _1, _3
    ret v
fn where_it_stands() -> (int, int)
    _1: int$ = __get_t()
    _2: int$ = advance(_1, 2)
    __set_t(_2)
    _3: int$ = __get_t()
    _4: i64, _5: i64 = position(_3)
    i: int = conv _4
    tick: int = conv _5
    ret i, tick

; a stream's ring, carved from the arena: cap items resident (64 unless more are), twice that in slots since the ring mirrors each item (log 65), and a tick per item unless regular; a reader's view at its start
fn __stream_int(hz: i64, cap: i64) -> int$
    a: ptr = addr __arena
    r: ptr = arena_alloc(a, 64)
    slots: i64 = mul cap, 2
    sz: i64 = sizeof int
    bytes: i64 = mul sz, slots
    total: i64 = add bytes, 16
    vb: ptr = arena_alloc(a, total)
    buffer_init(vb, sz, slots)
    tbytes: i64 = mul slots, 8
    ttotal: i64 = add tbytes, 16
    tb: ptr = arena_alloc(a, ttotal)
    buffer_init(tb, 8, slots)
    ring_init(r, vb, tb, hz)
    s: int$ = stream r
    ret s
fn __regular_u8(hz: i64, cap: i64) -> u8$
    a: ptr = addr __arena
    r: ptr = arena_alloc(a, 64)
    slots: i64 = mul cap, 2
    sz: i64 = sizeof u8
    bytes: i64 = mul sz, slots
    total: i64 = add bytes, 16
    vb: ptr = arena_alloc(a, total)
    buffer_init(vb, sz, slots)
    ring_regular(r, vb, hz, 1, 0)
    s: u8$ = stream r
    ret s
