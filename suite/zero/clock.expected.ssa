    v: u8$ = get c, __node1_c
    ret v

fn __set___node1_c(v: u8$)
    p: ptr = addr __ctx_mem
    c: __ctx = load p
    c2: __ctx = set c, __node1_c, v
    store c2, p
    ret

fn __get___node1_c_seen() -> i64
    p: ptr = addr __ctx_mem
    c: __ctx = load p
    v: i64 = get c, __node1_c_seen
    ret v

fn __set___node1_c_seen(v: i64)
    p: ptr = addr __ctx_mem
    c: __ctx = load p
    c2: __ctx = set c, __node1_c_seen, v
    store c2, p
    ret

fn __get___node1_fin() -> u1
    p: ptr = addr __ctx_mem
    c: __ctx = load p
    v: u1 = get c, __node1_fin
    ret v

fn __set___node1_fin(v: u1)
    p: ptr = addr __ctx_mem
    c: __ctx = load p
    c2: __ctx = set c, __node1_fin, v
