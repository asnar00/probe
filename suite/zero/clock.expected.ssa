; a stream's storage, carved from the arena: cap items (64 unless more are) — a ring keeps them in twice that many slots, each item in both halves so that every window is one view (log 65), and a tick per item unless regular; a queue keeps them in a plain run of cap slots, item k at k minus the origin (log 89) — and a reader's view at its start
fn __regular_int(hz: i64, cap: index) -> int$
    a: ptr = addr __arena
    r: ptr = arena_alloc(a, 64)
    slots: index = mul cap, 2
    sz: index = sizeof int
    bytes: index = mul sz, slots
    total: index = add bytes, 16
    vb: ptr = arena_alloc(a, total)
    buffer_init(vb, sz, slots)
    ring_regular(r, vb, hz, 1, 0)
    s: int$ = stream r
    ret s
fn __stream_int(hz: i64, cap: index) -> int$
    a: ptr = addr __arena
    r: ptr = arena_alloc(a, 64)
    slots: index = mul cap, 2
    sz: index = sizeof int
    bytes: index = mul sz, slots
    total: index = add bytes, 16
    vb: ptr = arena_alloc(a, total)
    buffer_init(vb, sz, slots)
    tbytes: index = mul slots, 8
    ttotal: index = add tbytes, 16
    tb: ptr = arena_alloc(a, ttotal)
    buffer_init(tb, 8, slots)
    ring_init(r, vb, tb, hz)
    s: int$ = stream r
    ret s
fn __regular_u8(hz: i64, cap: index) -> u8$
    a: ptr = addr __arena
    r: ptr = arena_alloc(a, 64)
    slots: index = mul cap, 2
    sz: index = sizeof u8
    bytes: index = mul sz, slots
    total: index = add bytes, 16
    vb: ptr = arena_alloc(a, total)
    buffer_init(vb, sz, slots)
    ring_regular(r, vb, hz, 1, 0)
    s: u8$ = stream r
    ret s

; a stream read at a time where the compiler does not know its rate (fm3 question 120, log 248): the time comes as a tick of the stream's clock and what is left over of one, `left` parts of `over`, worked out in integers where the read is; the item at or before it is found by the library's `before`, arithmetic on a ring with a rate and a search by halves over the ticks on one without, bounded by what the ring keeps; `rule` is what the stream's declaration says of a time between two items (fm3 question 127, log 250), 0 the item at or before, 1 `nearest`, the later item where it is strictly closer, 2 `linear`, the two blended by how far along the tick is. Before the first item the read gives `zero`, after the latest the latest; a time whose item the ring no longer keeps fails the ring's own check
fn __at_int(s: int$, tick: i64, left: i64, over: i64, rule: i64, zero: int) -> int
    r: ptr = get s, ring
    lo: index = before(s, tick)
    base: index = ring_base(r)
    early: u1 = cmp.lt lo, 0
    v: int = if early
        whole: u1 = cmp.eq base, 0
        check whole
        yield zero
    else
        pushed: index = load r
        kl: index = add base, lo
        kh: index = add kl, 1
        more: u1 = cmp.lt kh, pushed
        near: u1 = cmp.eq rule, 1
        both: u1 = and more, near
        k: index = if both
            tl: i64 = tick_of(s, kl)
            th: i64 = tick_of(s, kh)
            dl: i64 = sub tick, tl
            dh: i64 = sub th, tick
            a1: i64 = mul dh, over
            a2: i64 = sub a1, left
            b1: i64 = mul dl, over
            b2: i64 = add b1, left
            closer: u1 = cmp.lt a2, b2
            kk: index = if closer
                yield kh
            else
                yield kl
            yield kk
        else
            yield kl
        vals: int[] = ring_values(r)
        i: index = ring_index(s, k)
        x: int = load vals, i
        yield x
    ret v
fn __said_where_it_stands() -> (int, i64)
    __w1: i64 = const 1000000000
    r0: int, r1: __time = where_it_stands()
    c1: i64 = get r1, count
    d1: i64 = get r1, divisor
    w1: i64 = div c1, d1
    m1: i64 = rem c1, d1
    a1: i64 = mul w1, __w1
    b1: i64 = mul m1, __w1
    q1: i64 = div b1, d1
    n1: i64 = add a1, q1
    ret r0, n1
fn __said_marked_when() -> i64
    __w1: i64 = const 1000000000
    r0: __time = marked_when()
    c0: i64 = get r0, count
    d0: i64 = get r0, divisor
    w0: i64 = div c0, d0
    m0: i64 = rem c0, d0
    a0: i64 = mul w0, __w1
    b0: i64 = mul m0, __w1
    q0: i64 = div b0, d0
    n0: i64 = add a0, q0
    ret n0
fn __said_none_marked_when() -> i64
    __w1: i64 = const 1000000000
    r0: __time = none_marked_when()
    c0: i64 = get r0, count
    d0: i64 = get r0, divisor
    w0: i64 = div c0, d0
    m0: i64 = rem c0, d0
    a0: i64 = mul w0, __w1
    b0: i64 = mul m0, __w1
    q0: i64 = div b0, d0
    n0: i64 = add a0, q0
    ret n0
