}

fn __set___node1_fin(v: u1) {
    p: ptr = addr __ctx_mem
    c: __ctx = load p
    c2: __ctx = set c, __node1_fin, v
    store c2, p
    ret
}

; a feature's effective state: its own enabled and its ancestors', read by every gate
fn __on_platform() -> u1 {
    own: u1 = __get___enabled_platform()
    ret own
}
fn __on_clock() -> u1 {
    own: u1 = __get___enabled_clock()
    ret own
}

; node 1: int t$ = ticks (5) at (4 hz) — run when an input has more than the node has seen, or has ended and the node has not run since
fn __node1() -> u1 {
    fin: u1 = __get___node1_fin()
    notfin: u1 = xor fin, 1
    on: u1 = __on_clock()
    due: u1 = and notfin, on
    ran: u1 = if due {
        _1: int$ = __get_t()
        _2: int = const 5
        ticks(_1, _2, 4: i64)
        __set___node1_fin(1)
        yield 1
    } else {
        yield 0
    }
    ret ran
}

; the scheduler (log 25): passes over the nodes in declaration order until a pass runs nothing
fn __run() {
    p: ptr = addr __running
    busy: i64 = load p
    idle: u1 = cmp.eq busy, 0
    if idle {
        store 1: i64, p
        loop() {
            r1: u1 = __node1()
            if r1 {
                continue
            } else {
                break
            }
        }
        store 0: i64, p
    }
    ret
}

; feature platform (layer platform)
fn print(s: u8$) {
    q: ptr = addr __out_n
    k0: i64 = load q
    o: ptr = addr __out
    f: u8[] = unread(s)
    p: ptr(u8) = ptr f
    n: i64 = len f
    k1: i64 = loop(i: i64 = 0, k: i64 = k0) {
        done: u1 = cmp.ge i, n
        if done {
            break k
        }
        c: u8 = load p, i
        room: u1 = cmp.lt k, 4095
        if room {
            store c, o, k, 1
        }
        i2: i64 = add i, 1
        k2: i64 = add k, 1
        continue i2, k2
    }
    room2: u1 = cmp.lt k1, 4095
    k4: i64 = if room2 {
        store 10: u8, o, k1, 1
        k3: i64 = add k1, 1
        yield k3
    } else {
        yield k1
    }
    store k4, q
    ret
}
fn print__ints(x: int$) {
    f: int[] = unread(x)
    n: i64 = len f
    loop(i: i64 = 0) {
        done: u1 = cmp.ge i, n
        if done {
            break
        }
        first: u1 = cmp.eq i, 0
        if first {
        } else {
            __out_ch(32)
        }
        v: int = load f, i
        __print_int(v)
        i2: i64 = add i, 1
        continue i2
    }
    __out_ch(10)
    ret
}

; feature clock (layer runtime)
fn ticks(t: int$, n: int, __hz: i64) {
    _1: int = const 1
    __push(t, _1)
    __sleep(__hz)
    loop() {
        _2: int = latest t
        _3: int = add _2, 1
        _4: u1 = cmp.le _3, n
        if _4 {
        } else {
            break
        }
        __push(t, _3)
        __sleep(__hz)
        continue
    }
    ret
}
fn value_at(m: int) -> int {
    _1: int$ = __get_t()
    _2: i64 = conv m
    _3: time = millis(_2)
    v: int = sample _1, _3
    ret v
}
fn where_it_stands() -> (int, int) {
    _1: int$ = __get_t()
    _2: int$ = advance(_1, 2)
    __set_t(_2)
    _3: int$ = __get_t()
    _4: i64, _5: i64 = position(_3)
    i: int = conv _4
    tick: int = conv _5
    ret i, tick
}

; a stream's ring, carved from the arena: cap items (64 unless more are resident), and a tick per item unless regular; a reader's view at its start
fn __stream_int(hz: i64, cap: i64) -> int$ {
    a: ptr = addr __arena
    r: ptr = arena_alloc(a, 64)
    sz: i64 = sizeof int
    bytes: i64 = mul sz, cap
    total: i64 = add bytes, 16
    vb: ptr = arena_alloc(a, total)
    buffer_init(vb, sz, cap)
    tbytes: i64 = mul cap, 8
    ttotal: i64 = add tbytes, 16
    tb: ptr = arena_alloc(a, ttotal)
    buffer_init(tb, 8, cap)
    ring_init(r, vb, tb, hz)
    s: int$ = stream r
    ret s
}
