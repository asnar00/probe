int t$ nearest = ticks(5) at (4 hz)

on (int t$) << ticks (int n)
    t$ << 1 << (t$ + 1) while (_ <= n)

on (int v) << value at (int m)
    v << t$ at (m ms)

on (int i, time tick) << where it stands()
    advance t$ by (2)
    i << position t$
    tick << time of t$

int mark$
int pace$ at (2 hz)

on mark thrice()
    mark$ << 1
    pace$ << 0
    mark$ << 2
    pace$ << 0
    mark$ << 3

on (int v) << marked at (int m)
    mark thrice()
    v << mark$ at (m ms)

on (int v) << none marked at (int m)
    v << mark$ at (m ms)

on (int n) << paced()
    n << pace$

on (time t) << marked when()
    mark thrice()
    t << time of mark$

on (int v) << marked at its own time()
    mark thrice()
    v << mark$ at (time of mark$)

on (time t) << none marked when()
    t << time of mark$

on (int v) << ticked at its own time()
    v << t$ at (time of t$)
