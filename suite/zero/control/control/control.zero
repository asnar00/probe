on (int s) = sign of (int x)
    if (x < 0)
        s = -1
    else if (x > 0)
        s = 1

on (int a) = magnitude of (int x)
    int m = x
    if (x < 0)
        m = -x
    a = m

on describe (int x)
    if (x < 0)
        out$ << "negative" << "\n"
    else
        out$ << "not negative" << "\n"

on (int s) = sum to (int n)
    s = [0 through n] + _

on (int s) = sum below (int n)
    s = [0 to n] + _

on (int g) = gcd of (int a) and (int b)
    g = loop (int x = a, int y = b) while (y != 0) yields x
        int r = x % y
        continue (y, r)

on (int p) = power of two above (int n)
    int q = loop (int q = 1) yields q
        if (q > n)
            break
        q = q * 2
    p = q

on (int d) = digits of (int n)
    int x, int count = loop (int x = n, int count = 1) yields x, count
        if (x < 10)
            break
        continue (x / 10, count + 1)
    d = count

on (int n) = collatz steps (int start)
    n = loop (int x = start, int steps = 0) yields steps
        if (x == 1)
            break
        if (x % 2 == 0)
            x = x / 2
        else
            x = 3 * x + 1
        steps = steps + 1

on (int r) = row (int i)
    r = [0 through i] + _

on (int t) = triangle (int n)
    t = row ([1 to n + 1]) + _

on (int n) = two counters()
    int a = loop (int i = 0) while (i < 3) yields i
        continue (i + 1)
    int b = loop (int i = 0) while (i < 5) yields i
        continue (i + 1)
    n = a * 10 + b

on ticks ()
    for (i in [1 through 3])
        out$ << "tick" << "\n"

on blast off ()
    for (i in [3 through 1])
        if (i == 1)
            out$ << "one" << "\n"
        else
            out$ << "more" << "\n"

on halves ()
    for (i in [0 to 4])
        if (i % 2 == 0)
            continue
        out$ << "odd" << "\n"

on step (int i)
    out$ << "step" << "\n"

on steps from (int a) to (int b)
    step ([a through b])

on (int d) = gives twice (int x)
    d = x * 2
