on (number n) = smaller of (number a) and (number b)
    n = if (a < b) then (a) else (b)

on (int q, int r) = divide (int a) by (int b)
    q = a / b
    r = a - q * b

on (int s) = sum of (int a) and (int b) and (int c)
    s = a + b + c

on (int m) = mean of (int a) and (int b)
    int q, int r = divide (a + b) by (2)
    m = q

on (int d) = double (int x)
    d = x * 2

on (int n) = negated (int x)
    n = -x

on (bool yes) = (int a) is less than (int b)
    yes = a < b

on (int c) = clamp (int x) between (int lo) and (int hi)
    c = if (x < lo) then (lo) else (if (x > hi) then (hi) else (x))

on (int32 y) = narrow (int32 x)
    int32 big = 1000000
    y = smaller of (x) and (big)

on (int r) = first positive of (int a) and (int b)
    if (a > 0)
        r = a
    r = b

on (int lo, int hi) = ordered (int a) and (int b)
    lo = if (a < b) then (a) else (b)
    hi = a + b - lo

on (int p) = power of two above (int n)
    loop (int q = 1)
        if (q > n)
            p = q
        continue (q * 2)

on describe (int x)
    out$ << "int" << "\n"

on describe (float x)
    out$ << "float" << "\n"

on describe (bool b)
    out$ << "bool" << "\n"

on describe (string s)
    out$ << "string" << "\n"

on describe a word()
    describe "hi"

on describe a decimal()
    describe (2.5)

on (int32 k) = kind of (number x)
    k = 1

on (int32 k) = kind of (int x)
    k = 2

on (int32 k) = kind of (int32 x)
    k = 3

on (int32 k) = kind at thirty two bits (int32 x)
    k = kind of (x)

on (int32 k) = kind at sixty four bits (int64 x)
    k = kind of (x)

on (int32 k) = kind of a float (float32 x)
    k = kind of (x)

on (int32 k) = kind of a decimal()
    k = kind of (2.5)

on (int a) = area of (int w) by (int h)
    a = w * h

on (int a) = area of (int side)
    a = side * side

on (int32 w) = width of (int32 x)
    w = 32

on (int32 w) = width of (int64 x)
    w = 64

on (int32 w) = int width()
    int x = 2147483647
    int y = x + 1
    w = if (y < 0) then (32) else (64)

on (bool ok) = literal takes the int width()
    ok = width of (3) == int width()

on (int32 w) = width at thirty two bits()
    w = width of (int32(3))

on (int32 w) = width at sixty four bits()
    w = width of (int64(3))

on (int32 w) = float width of (float32 x)
    w = 32

on (int32 w) = float width of (float64 x)
    w = 64

on (int32 w) = float width()
    float x = 16777217.0
    float y = x - 16777216.0
    w = if (y == 0.0) then (32) else (64)

on (bool ok) = literal takes the float width()
    ok = float width of (2.5) == float width()

on (int32 w) = float width at thirty two bits()
    w = float width of (float32(2.5))

on (int32 w) = float width at sixty four bits()
    w = float width of (float64(2.5))
