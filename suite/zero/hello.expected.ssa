; a stream's ring, carved from the arena: cap items (64 unless more are resident), and a tick per item unless regular; a reader's view at its start
fn __stream_int(hz: i64, cap: i64) -> int$
    a: ptr = addr __arena
    r: ptr = arena_alloc(a, 64)
    sz: i64 = sizeof int
    bytes: i64 = mul sz, cap
    total: i64 = add bytes, 16
    vb: ptr = arena_alloc(a, total)
    buffer_init(vb, sz, cap)
    tbytes: i64 = mul cap, 8
    ttotal: i64 = add tbytes, 16
    tb: ptr = arena_alloc(a, ttotal)
    buffer_init(tb, 8, cap)
    ring_init(r, vb, tb, hz)
    s: int$ = stream r
    ret s
fn __regular_int(hz: i64, cap: i64) -> int$
    a: ptr = addr __arena
    r: ptr = arena_alloc(a, 64)
    sz: i64 = sizeof int
    bytes: i64 = mul sz, cap
    total: i64 = add bytes, 16
    vb: ptr = arena_alloc(a, total)
    buffer_init(vb, sz, cap)
    ring_regular(r, vb, hz, 1, 0)
    s: int$ = stream r
    ret s
fn __regular_u8(hz: i64, cap: i64) -> u8$
    a: ptr = addr __arena
    r: ptr = arena_alloc(a, 64)
    sz: i64 = sizeof u8
    bytes: i64 = mul sz, cap
    total: i64 = add bytes, 16
    vb: ptr = arena_alloc(a, total)
    buffer_init(vb, sz, cap)
    ring_regular(r, vb, hz, 1, 0)
    s: u8$ = stream r
    ret s

; a view's items as a new stream (log 38): what `frame`, `behind`, `from ... to` and a string literal give
fn __copy_int(v: int[]) -> int$
    n: i64 = len v
    least: i64 = const 64
    cap: i64 = max(n, least)
    s: int$ = __stream_int(1000000, cap)
    t: i64 = __now()
    loop(i: i64 = 0)
        done: u1 = cmp.ge i, n
        if done
            break
        x: int = load v, i
        push s, t, x
        i2: i64 = add i, 1
        continue i2
    ret s
