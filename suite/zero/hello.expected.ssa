; feature countdown (layer runtime)
fn run__countdown()
    count_down()
    run__before_countdown()
    ret
fn count_down()
    i: int$ = __regular_int(1, 64)
    loop(_1: int = 10)
        _2: u1 = cmp.ge _1, 1
