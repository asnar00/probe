
; the arena every sequence is carved from, emptied before every case
data __heap: array(u8, 65536)
data __arena: array(i64, 3)

; the output device (section 15, question 45, log 87): `out$` looks like
; a stream, but a push into it writes a character to the place and
; stores nothing, so these two are the platform's write — one character,
; and a block of them. There is no capacity, because there is no
; storage. Under the runner the place is the capture below, which
; `__out_len` and `__out_byte` read back; a real platform's body per
; kind of place — a UART store on the boards, a write to the console
; under an OS, the browser's log — is a `platform <target>` block on
; each of these, beside the `ir` body, and is milestone 1's. The
; output is the context's (fm3 question 107): how much has been written
; is its field `__out_n`, and its capture, a half of `__out` for each
; of the store's two contexts, is where its field `__out_p` points
data __out: array(u8, 65536)

fn __out_ch(c: u8)
    _this: ptr = context()
    x: __ctx = load _this
    n: index = get x, __out_n
    p: ptr = get x, __out_p
    n2: index = add n, 1
    x2: __ctx = set x, __out_n, n2
    store x2, _this
    store c, p, n, 1
    ret

fn __out_block(v: u8[])
    _this: ptr = context()
    k: index = len v
    x: __ctx = load _this
    n: index = get x, __out_n
    n2: index = add n, k
    fits: u1 = cmp.le n2, 32768
    check fits
    p: ptr = get x, __out_p
    x2: __ctx = set x, __out_n, n2
    store x2, _this
    e: ptr(u8) = ptradd p, n
    d: u8[] = pack e, k, 1
    copy d, v
    ret

; what the device was given, read back by the test runner: the capture
; is the runner's, not the store's, and the runner is handed a machine
; word whatever an `index` is
fn __out_len() -> i64
    _this: ptr = context()
    x: __ctx = load _this
    n: index = get x, __out_n
    w: i64 = conv n
    ret w

fn __out_byte(i: i64) -> u8
    _this: ptr = context()
    x: __ctx = load _this
    p: ptr = get x, __out_p
    b: u8 = load p, i, 1
    ret b

; when it was written (question 55, fm3 log 95): each time the virtual
; clock moves, `__wait` stores the time it reached at the place in the
; output where it begins to apply, a word for each byte of the capture
; and one for its end, indexed by how many bytes the device had been
; given. A word that is zero says the clock did not move there. The
; runner reads a word for each byte it read, and one more, for a case
; that asserts on time. The marks are the context's as the capture is,
; a half of `__out_t` each, where its field `__out_m` points
data __out_t: array(i64, 65538)

fn __out_mark(i: i64) -> i64
    _this: ptr = context()
    x: __ctx = load _this
    p: ptr = get x, __out_m
    w: i64 = load p, i, 8
    ret w

; the input device (section 15, log 62, question 45): a character
; arriving, which under the runner is a case's `with in "text"`. Its
; ring is the device's own lookahead, sized by the runner, which a
; consumer wired to `in$` reads with `peek`, `advance` and `count`
fn __in_ch(c: u8)
    _this: ptr = context()
    k: __ctx = load _this
    s: u8$ = get k, in
    push_queue(s, c)
    ret

; a string literal's bytes: a view of n bytes at p, which `__copy_u8` makes a stream
fn __str(p: ptr, n: index) -> u8[]
    q: ptr(u8) = cast p
    v: u8[] = pack q, n, 1
    ret v

; a step of a rate passes (fm3 log 194): the clock moved on by d of its
; own steps, which can only be later, and the place marked
fn __step(d: i64)
    _this: ptr = context()
    x: __ctx = load _this
    c: i64 = get x, __clock
    m: i64 = add c, d
    x2: __ctx = set x, __clock, m
    store x2, _this
    n: index = get x, __out_n
    a: ptr = get x, __out_m
    store m, a, n, 8
    ret


; the context: one field per feature-scope variable — name: scope, merge (feature)
;   __enabled_platform: user, last (platform)
;   __enabled_hello: user, last (hello)
;   __enabled_countdown: user, last (countdown)
;   __enabled_bye: user, last (bye)
;   __on_countdown: user, last (countdown)
;   __on_bye: user, last (bye)
;   out: the output device, which stores nothing (platform)
;   in: user, last (platform)
;   i: no storage, no word reading it: a push into it calls its edges (countdown)
;   __out_n, __clock, __out_p, __out_m: the context's own output and clock (question 107): how much it has written, its time, its capture and its marks
type __ctx = struct
    __out_n: index
    __clock: i64
    __out_p: ptr
    __enabled_platform: u1
    __enabled_hello: u1
    __enabled_countdown: u1
    __enabled_bye: u1
    __on_countdown: u1
    __on_bye: u1
    in: u8$
    __out_m: ptr

data __ctx_mem: array(__ctx, 2)
data __s11 = "hello world"
data __s12 = "goodbye"

; before every case: the arena emptied, and the current context made new
fn __zero_reset()
    a: ptr = addr __arena
    h: ptr = addr __heap
    arena_init(a, h, 65536)
    __zero_new()
    ret

; the current context at its first values, its streams made in the arena
fn __zero_new()
    cx: ptr = context()
    cm: ptr = addr __ctx_mem
    second: u1 = cmp.ne cx, cm
    sw: index = conv second
    ob: ptr(array(u8, 65536)) = addr __out
    oi: index = mul sw, 32768
    oq: ptr(u8) = index ob, oi
    op: ptr = cast oq
    mb: ptr(array(i64, 65538)) = addr __out_t
    ms: index = mul sw, 32769
    mq: ptr(i64) = index mb, ms
    om: ptr = cast mq
    was: __ctx = load cx
    mn: index = get was, __out_n
    loop(mi: index = 0) bound 32768
        store 0: i64, om, mi, 8
        md: u1 = cmp.ge mi, mn
        if md
            break
        mi2: index = add mi, 1
        continue mi2
    _1: u8$ = __queue_u8(1000000, 512)
    _2: __ctx = pack 0, 0, op, 1, 1, 1, 1, 1, 1, _1, om
    p: ptr = context()
    store _2, p
    ret

; the runner's: the k-th of the store's contexts is the current one
fn __zero_context(k: i32)
    p: ptr(array(__ctx, 2)) = addr __ctx_mem
    i: index = conv k
    e: ptr(__ctx) = index p, i
    c: ptr = cast e
    context_set(c)
    ret

fn __set___enabled_platform(v: u1)
    p: ptr = context()
    c: __ctx = load p
    c2: __ctx = set c, __enabled_platform, v
    store c2, p
    ret

fn __set___enabled_hello(v: u1)
    p: ptr = context()
    c: __ctx = load p
    c0: __ctx = set c, __enabled_hello, v
    own1: u1 = get c, __enabled_countdown
    on1: u1 = and own1, v
    c1: __ctx = set c0, __on_countdown, on1
    own2: u1 = get c, __enabled_bye
    on2: u1 = and own2, v
    c2: __ctx = set c1, __on_bye, on2
    store c2, p
    ret

fn __set___enabled_countdown(v: u1)
    p: ptr = context()
    c: __ctx = load p
    c0: __ctx = set c, __enabled_countdown, v
    up: u1 = get c, __enabled_hello
    on: u1 = and v, up
    c1: __ctx = set c0, __on_countdown, on
    store c1, p
    ret

fn __set___enabled_bye(v: u1)
    p: ptr = context()
    c: __ctx = load p
    c0: __ctx = set c, __enabled_bye, v
    up: u1 = get c, __enabled_hello
    on: u1 = and v, up
    c1: __ctx = set c0, __on_bye, on
    store c1, p
    ret

; feature platform (layer platform)
; ... and the same over the output device, where a push is the platform's write (log 87)
fn __out__int(x: int)
    _1: u1 = cmp.lt x, 0
    if _1
        _2: u8 = const 45
        __out_ch(_2)
    _3: u1 = cmp.lt x, 0
    m: int = if _3
        yield x
    else
        _4: int = sub 0, x
        yield _4
    top: int = loop(p: int = 1)
        _5: int = div m, p
        _6: u1 = cmp.le _5, -10
        if _6
        else
            break p
        _7: int = mul p, 10
        continue _7
    loop(p_2: int = top)
        _8: u1 = cmp.gt p_2, 0
        if _8
        else
            break
        _9: int = div m, p_2
        _10: int = rem _9, 10
        _11: int = sub 48, _10
        _12: u8 = conv _11
        __out_ch(_12)
        _13: int = div p_2, 10
        continue _13
    ret

; feature hello (layer runtime)
fn run__before_countdown()
    _this: ptr = context()
    _1: __ctx = load _this
    on: u1 = get _1, __enabled_hello
    if on
    else
        ret
    hello()
    ret
fn hello()
    _1: ptr = addr __s11
    _2: index = len __s11
    _3: u8[] = __str(_1, _2)
    __out_block(_3)
    _4: u8 = const 10
    __out_ch(_4)
    ret

; feature countdown (layer runtime)
fn run__before_bye()
    _this: ptr = context()
    _1: __ctx = load _this
    on: u1 = get _1, __on_countdown
    if on
    else
        run__before_countdown()
        ret
    count_down()
    run__before_countdown()
    ret
fn count_down()
    _this: ptr = context()
    _1: __ctx = load _this
    _2: u1 = get _1, __on_countdown
    loop(_3: int = 10)
        _4: u1 = cmp.ge _3, 1
        if _4
        else
            break
        if _2
            __out__int(_3)
            _5: u8 = const 10
            __out_ch(_5)
        __step(1000000)
        _6: int = sub _3, 1
        continue _6
    ret

; feature bye (layer runtime)
fn run()
    _this: ptr = context()
    _1: __ctx = load _this
    on: u1 = get _1, __on_bye
    if on
    else
        run__before_bye()
        ret
    run__before_bye()
    goodbye()
    ret
fn goodbye()
    _1: ptr = addr __s12
    _2: index = len __s12
    _3: u8[] = __str(_1, _2)
    __out_block(_3)
    _4: u8 = const 10
    __out_ch(_4)
    ret

; a stream's storage, carved from the arena: cap items (64 unless more are) — a ring keeps them in twice that many slots, each item in both halves so that every window is one view (log 65), and a tick per item unless regular; a queue keeps them in a plain run of cap slots, item k at k minus the origin (log 89) — and a reader's view at its start
fn __queue_u8(hz: i64, cap: index) -> u8$
    a: ptr = addr __arena
    r: ptr = arena_alloc(a, 64)
    sz: index = sizeof u8
    bytes: index = mul sz, cap
    total: index = add bytes, 16
    vb: ptr = arena_alloc(a, total)
    buffer_init(vb, sz, cap)
    ring_queue(r, vb, hz, cap)
    s: u8$ = stream r
    ret s
