; a feature's effective state: its own enabled and its ancestors', read by every gate
fn __on_platform() -> u1
    own: u1 = __get___enabled_platform()
    ret own
fn __on_hello() -> u1
    own: u1 = __get___enabled_hello()
    ret own
fn __on_countdown() -> u1
    own: u1 = __get___enabled_countdown()
    up: u1 = __on_hello()
    on: u1 = and own, up
    ret on
fn __on_bye() -> u1
    own: u1 = __get___enabled_bye()
    up: u1 = __on_hello()
    on: u1 = and own, up
    ret on

; node 1: write (out$) — run when an input has more than the node has seen, or has ended and the node has not run since
fn __node1() -> u1
    fin: u1 = __get___node1_fin()
    notfin: u1 = xor fin, 1
    _1: u8$ = __get___node1_c()
    _2: i64, _3: i64 = position(_1)
    _4: i64 = count _1
    _5: i64 = add _2, _4
    _6: i64 = __get___node1_c_seen()
    _7: u1 = cmp.gt _5, _6
    _8: u1 = ended(_1)
    _9: u1 = and _8, notfin
    _10: u1 = or _7, _9
    on: u1 = __on_platform()
    due: u1 = and _10, on
    ran: u1 = if due
        _11: u8$ = write(_1, 0: i64)
        __set___node1_c(_11)
        _12: i64, _13: i64 = position(_11)
        _14: i64 = count _11
        _15: i64 = add _12, _14
        __set___node1_c_seen(_15)
        _16: u1 = ended(_11)
        __set___node1_fin(_16)
        yield 1
    else
        yield 0
    ret ran

; the scheduler (log 25): passes over the nodes in declaration order until a pass runs nothing
fn __run()
    p: ptr = addr __running
    busy: i64 = load p
    idle: u1 = cmp.eq busy, 0
    if idle
        store 1: i64, p
        loop()
            r1: u1 = __node1()
            if r1
                continue
            else
                break
        store 0: i64, p
    ret

; feature platform (layer platform)
fn write(c: u8$, __hz: i64) -> u8$
    n: i64 = count(c)
    c2: u8$ = advance(c, n)
    ret c2
