    h: ptr = addr __heap
    arena_init(a, h, 65536)
    k: ptr = addr __clock
    z: time = seconds(0)
    store z, k
    r: ptr = addr __running
    store 0: i64, r
    _1: u8$ = __regular_u8(1000000, 4096)
    _2: __ctx = pack 1, 1, 1, 1, _1, _1, 0, 0
    p: ptr = addr __ctx_mem
    store _2, p
    ret

; after the case's context is set: the nodes run
fn __zero_start()
    __run()
    ret

