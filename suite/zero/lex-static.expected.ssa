    sw: index = conv second
    ob: ptr(array(u8, 65536)) = addr __out
    oi: index = mul sw, 32768
    oq: ptr(u8) = index ob, oi
    op: ptr = cast oq
    _1: u8$ = __queue_u8(1000000, 512)
    _2: token$ = __queue_token(1000000, 64)
    _3: u8$ = __queue_u8(1000000, 64)
    _4: token$ = __queue_token(1000000, 64)
    _5: index = get _3, pos
    _6: __ctx = pack 0, 0, op, _1, _2, _3, _4, _1, 0, 0, _5
    p: ptr = context()
    store _6, p
    ret

; the runner's: the k-th of the store's contexts is the current one
fn __zero_context(k: i32)
