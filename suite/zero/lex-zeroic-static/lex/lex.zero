type kind = space | word | number | mark

type token =
    kind kind
    index start, n

token t$ = lex(in$)
char src$
token u$ = lex(src$)

on (kind k) << kind of (char c)
    k << space if (c <= 32)
         else mark if (c > 122)
         else word if (c >= 97)
         else mark if (c > 57)
         else number if (c >= 48)
         else mark

on (token t$) << lex (char c$)
    kind k$ = if (empty c$) then (space) else (kind of (c$))
    bool new$ = k$ == mark or k$ != k$[-1]
    index start$ = if (new$) then (position c$) else (start$[-1])
    index n$ = if (new$) then (1) else (n$[-1] + 1)
    t$ << token(k$[-1], start$[-1], n$[-1]) if (new$ and k$[-1] != space)

on arrive first()
    src$ << "let x = 4"

on arrive again()
    src$ << "2;\n"
    end src$

on (int a, int b) << two arrivals()
    arrive first()
    a << count u$
    arrive again()
    b << count u$

on (int s) << number start()
    arrive first()
    arrive again()
    token x = peek u$ at (3)
    s << x.start

on (int n) << number length()
    arrive first()
    arrive again()
    token x = peek u$ at (3)
    n << x.n

on (kind a, kind b) << kinds()
    arrive first()
    arrive again()
    token x = peek u$ at (0)
    token y = peek u$ at (1)
    a << x.kind
    b << y.kind

on (kind k) << third kind()
    arrive first()
    arrive again()
    token x = peek u$ at (2)
    k << x.kind

on (kind a, kind b) << kinds tail()
    arrive first()
    arrive again()
    token x = peek u$ at (3)
    token y = peek u$ at (4)
    a << x.kind
    b << y.kind

on (bool same) << lexed right()
    arrive first()
    arrive again()
    token got[] = frame u$
    same << got[] [==] [token(word, 0, 3), token(word, 4, 1), token(mark, 6, 1), token(number, 8, 2), token(mark, 10, 1)]

on (int a, int b) << a word at the end()
    src$ << "let"
    a << count u$
    end src$
    b << count u$

on (int n) << lexed()
    n << count t$
