    _6: u1 = and _5, notfin
    _7: u1 = or _4, _6
    on: u1 = __on_lex()
    due: u1 = and _7, on
    ran: u1 = if due
        _8: __s_token = __get_t()
        _9: u8$ = lex(_8, _1, 0: i64)
        __set___node2_c(_9)
        _10: i64 = received(_9)
        __set___node2_c_seen(_10)
        _11: u1 = ended(_9)
        __set___node2_fin(_11)
        yield 1
    else
        yield 0
    ret ran

; the scheduler (log 25): passes over the nodes in declaration order until a pass runs nothing
fn __run()
    p: ptr = addr __running
    busy: i64 = load p
    idle: u1 = cmp.eq busy, 0
    if idle
        store 1: i64, p
        loop()
            r1: u1 = __node1()
            r2: u1 = __node2()
            any2: u1 = or r1, r2
            if any2
                continue
            else
                break
        store 0: i64, p
    ret

; feature platform (layer platform)
fn write(c: u8$, __hz: i64) -> u8$
    n: i64 = count(c)
    c2: u8$ = advance(c, n)
    ret c2

