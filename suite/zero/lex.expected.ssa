    _5: u1 = ended(_1)
    _6: u1 = and _5, notfin
    _7: u1 = or _4, _6
    on: u1 = __on_platform()
    due: u1 = and _7, on
    ran: u1 = if due
        _8: u8$ = write(_1, 0: i64)
        __set___node1_c(_8)
        _9: i64 = received(_8)
        __set___node1_c_seen(_9)
        _10: u1 = ended(_8)
        __set___node1_fin(_10)
        yield 1
    else
        yield 0
    ret ran

; node 2: token t$ = lex (in$) — run when an input has more than the node has seen, or has ended and the node has not run since
