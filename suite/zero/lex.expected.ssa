
; the arena every sequence is carved from, emptied before every case
data __heap: array(u8, 65536)
data __arena: array(i64, 3)

; the store's virtual clock (log 63): integer ticks on a clock of a
; million a second, the bootstrap's step; zero at every case, moved by
; a rated task sleeping between its pushes and by nothing else; a push
; into a stream without a rate is stamped with it. Exact time is the
; boundary's: `x$ at (t)` and `position` convert once, in the library
data __clock: array(i64, 1)
; the scheduler is running: a push from inside a task does not start it again
data __running: array(i64, 1)

fn __now() -> i64
    p: ptr = addr __clock
    k: i64 = load p
    ret k

; a task wired at a rate, after each push: the clock moves on one
; period, in whole ticks, as a rated ring steps
fn __sleep(hz: i64)
    rated: u1 = cmp.gt hz, 0
    if rated
        p: ptr = addr __clock
        c: i64 = load p
        d: i64 = div 1000000, hz
        c2: i64 = add c, d
        store c2, p
    ret

; the output stream `out$` (section 15, log 57), read back by the runner
; through the platform feature's own reader, which nothing advances:
; how many bytes it holds, and each one
fn __out_len() -> i64
    s: u8$ = __get_out()
    n: i64 = count(s)
    ret n

fn __out_byte(i: i64) -> u8
    s: u8$ = __get_out()
    b: u8 = peek(s, i)
    ret b

; the input stream `in$` (section 15, log 62): one byte the platform
; pushes, which under the runner is a case's `with in "text"`
fn __in_ch(c: u8)
    s: u8$ = __get_in()
    __push(s, c)
    ret

; a string literal's bytes: a view of n bytes at p, which `__copy_u8` makes a stream
fn __str(p: ptr, n: i64) -> u8[]
    q: ptr(u8) = cast p
    v: u8[] = pack q, n, 1
    ret v

; a push into any stream (log 38): stamped with the clock on a ring
; without a rate, the next sample on one with a rate
fn __push(s: number$, v: number)
    r: ptr = get s, ring
    step: i64 = load r, 40
    regular: u1 = cmp.gt step, 0
    if regular
        push(s, v)
    else
        t: i64 = __now()
        push(s, t, v)
    ret
fn __push(s: number$, block: number[])
    r: ptr = get s, ring
    step: i64 = load r, 40
    regular: u1 = cmp.gt step, 0
    if regular
        push(s, block)
    else
        t: i64 = __now()
        push(s, t, block)
    ret

type token = struct
    kind: int
    start: int
    n: int
; a stream of token: one ring per field
type __s_token = struct
    kind: int$
    start: int$
    n: int$

; the context: one field per feature-scope variable — name: scope, merge (feature)
;   __enabled_platform: user, last (platform)
;   __enabled_lex: user, last (lex)
;   out: user, last (platform)
;   in: user, last (platform)
;   t: user, last (lex)
;   __node1_c: node, last (platform)
;   __node1_c_seen: node, last (platform)
;   __node1_fin: node, last (platform)
;   __node2_c: node, last (lex)
;   __node2_c_seen: node, last (lex)
;   __node2_fin: node, last (lex)
type __ctx = struct
    __enabled_platform: u1
    __enabled_lex: u1
    out: u8$
    in: u8$
    t: __s_token
    __node1_c: u8$
    __node1_c_seen: i64
    __node1_fin: u1
    __node2_c: u8$
    __node2_c_seen: i64
    __node2_fin: u1

data __ctx_mem: array(__ctx, 1)
data __s6 = "2;\n"

; before every case: the arena emptied, the variables at their initial values
fn __zero_reset()
    a: ptr = addr __arena
    h: ptr = addr __heap
    arena_init(a, h, 65536)
    k: ptr = addr __clock
    store 0: i64, k
    r: ptr = addr __running
    store 0: i64, r
    _1: u8$ = __regular_u8(1000000, 4096)
    _2: u8$ = __stream_u8(1000000, 512)
    _3: int$ = __stream_int(1000000, 64)
    _4: int$ = __stream_int(1000000, 64)
    _5: int$ = __stream_int(1000000, 64)
    _6: __s_token = pack _3, _4, _5
    _7: __ctx = pack 1, 1, _1, _2, _6, _1, 0, 0, _2, 0, 0
    p: ptr = addr __ctx_mem
    store _7, p
    ret

; after the case's context is set: the nodes run
fn __zero_start()
    __run()
    ret

