type token =
    int kind
    index start, n

token t$ = lex(in$)
char src$
token u$ = lex(src$)

on (int k) << kind of (char c)
    k << 0 if (c <= 32)
         else 3 if (c > 122)
         else 1 if (c >= 97)
         else 3 if (c > 57)
         else 2 if (c >= 48)
         else 3

on (token t$) << lex (char c$)
    loop
        if (count c$ == 0)
            break
        int k = kind of (peek c$ at (0))
        index start = position c$
        if (k == 0)
            advance c$ by (1)
            continue
        if (k == 3)
            t$ << token(3, start, 1)
            advance c$ by (1)
            continue
        index n = loop (index i = 1, index m = -1) yields m
            if (i >= count c$)
                if (ended c$)
                    break (i)
                break
            if (kind of (peek c$ at (i)) == k)
                continue (i + 1, -1)
            break (i)
        if (n < 0)
            break
        t$ << token(k, start, n)
        advance c$ by (n)

on arrive first()
    src$ << "let x = 4"

on arrive again()
    src$ << "2;\n"
    end src$

on (int a, int b) << two arrivals()
    arrive first()
    a << count u$
    arrive again()
    b << count u$

on (int s) << number start()
    arrive first()
    arrive again()
    token x = peek u$ at (3)
    s << x.start

on (int n) << number length()
    arrive first()
    arrive again()
    token x = peek u$ at (3)
    n << x.n

on (int a, int b) << kinds()
    arrive first()
    arrive again()
    token x = peek u$ at (0)
    token y = peek u$ at (1)
    a << x.kind
    b << y.kind

on (int k) << third kind()
    arrive first()
    arrive again()
    token x = peek u$ at (2)
    k << x.kind

on (int a, int b) << kinds tail()
    arrive first()
    arrive again()
    token x = peek u$ at (3)
    token y = peek u$ at (4)
    a << x.kind
    b << y.kind

on (int a, int b) << a word at the end()
    src$ << "let"
    a << count u$
    end src$
    b << count u$

on (int n) << lexed()
    n << count t$
