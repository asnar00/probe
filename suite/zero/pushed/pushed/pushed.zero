on (int d) << double (int x)
    d << x * 2

on (bool yes) << (int a) is under (int b)
    yes << a < b

on (int n) << smaller of (int a) and (int b)
    n << if (a < b) then (a) else (b)

on (int s) << sign of (int x)
    if (x < 0)
        s << -1
    else if (x > 0)
        s << 1

on (int r) << first positive of (int a) and (int b)
    if (a > 0)
        r << a
    r << b

on (int r) << first positive of (int a) and (int b) on one line
    r << a if (a > 0)
    r << b

on (int p) << power of two above (int n)
    loop (int q = 1)
        if (q > n)
            p << q
        continue (q * 2)

on (int g) << gcd of (int a) and (int b)
    g << loop (int x = a, int y = b) while (y != 0) yields x
        continue (y, x % y)

on (int q, int r) << divide (int a) by (int b)
    q << a / b
    r << a - q * b

on (int hi, int lo) << ordered (int a) and (int b)
    lo << if (a < b) then (a) else (b)
    hi << a + b - lo

on (int q, int r) << both of (int a) by (int b)
    q, r << divide (a) by (b)

on (int n) << sum of (int x[])
    n << x[] + _

on (int n) << summed()
    n << [sum of] ([1, 2, 3, 4])

int seen$ << 5

on (int n) << read()
    n << seen$

on (int n) << halved (int x)
    int half = x / 2
    n << half

on (int n) << larger of (int a) and (int b)
    n << a if (a > b) else b

on (int k) << class of (int c)
    k << 0 if (c <= 32)
         else 3 if (c > 122)
         else 1 if (c >= 97)
         else 3 if (c > 57)
         else 2 if (c >= 48)
         else 3

on (int n) << into a hundred (int x)
    check (x != 0)
    n << 100 / x

on (int n) << guarded (int x)
    n << 0 if (x == 0) else into a hundred (x)

on say how many (int x)
    out$ << "none" if (x == 0)
         else "one" if (x == 1)
         else "many"

int level$
int capped$ = capped (level$)
out$ << (capped$ << " ") forever

on (int e$) << capped (int x$)
    e$ << 9 if (x$ > 9) else x$

on levels()
    level$ << 3 << 12 << 9
