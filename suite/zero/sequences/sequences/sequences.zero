int marks$ = [3, 4]
int total = 0

on (int n) = how many()
    int i$ = [1, 2, 3, 4]
    n = count i$

on (int n) = third()
    int i$ = [10, 20, 30, 40]
    n = i$[2]

on (int n) = through()
    int i$ = [1 through 4]
    n = count i$ * 10 + i$[3]

on (int n) = up to (int m)
    int i$ = [0 to m]
    n = i$[count i$ - 1]

on (int n) = down()
    int i$ = [5 through 1]
    n = i$[0] * 10 + i$[4]

on (int n) = nothing()
    int i$
    n = count i$

on (int s) = summed()
    int i$ = [1, 2, 3, 4]
    s = i$ + _

on (int p) = product()
    int i$ = [1, 2, 3, 4]
    p = i$ * _

on (int n) = mapped()
    int i$ = [1, 2, 3, 4]
    int j$ = i$ + 1
    n = j$ + _

on (int n) = zipped()
    int i$ = [1, 2, 3, 4]
    int j$ = [4, 5, 6]
    int k$ = i$ + j$
    n = count k$ * 100 + k$[3] * 10 + (k$ + _) - 25

on (int d) = doubled (int x)
    d = x * 2

on (int n) = mapped call()
    int j$ = doubled ([1, 2, 3, 4])
    n = j$ + _

on (int p) = scaled (int a) by (int b)
    p = a * b

on (int n) = zipped call()
    int i$ = [1, 2, 3, 4]
    int j$ = [4, 5, 6]
    int k$ = scaled (i$) by (j$)
    n = k$ + _

on (number n) = smaller of (number a) and (number b)
    n = if (a < b) then (a) else (b)

on (int m) = smallest()
    int i$ = [4, 1, 3]
    m = smaller of (i$) and (_)

on (int m) = smallest of none()
    int i$
    m = smaller of (i$) and (_)

on (int n) = iterated()
    int i$ = [1, 2, 3, 4]
    for (x in i$)
        total = total + x
    n = total

on (int n) = sum of (int x$)
    n = x$ + _

on (int n) = passed()
    n = sum of ([1, 2, 3])

on (int r$) = squares to (int k)
    r$ = [1 through k] * [1 through k]

on (int n) = squared()
    int s$ = squares to (4)
    n = s$[3]

on (int n) = letters()
    string s = "hello"
    n = count s

on (int n) = first byte()
    string s = "hello"
    n = int(s[0])

on (int n) = marks total()
    n = marks$ + _

on (int n) = halves()
    float f$ = [1.5, 2.5]
    n = int((f$ + _) * 2)

on (int n) = pushed into()
    int i$ = [1, 2]
    i$ << 3
    n = count i$ * 10 + latest i$

on (int n) = read ahead()
    int i$ = [5, 6, 7]
    advance i$ by (1)
    n = i$[0] * 10 + count i$

on (int n) = framed sum()
    int i$ = [1 through 4]
    int f$ = frame i$
    n = (f$ + _) * 10 + count i$

on (int n) = bytes pushed()
    uint8 b$ = "hi"
    b$ << 33
    n = count b$ * 100 + int(b$[2])
