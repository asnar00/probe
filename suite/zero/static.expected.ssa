    _3: int$ = __regular_int(1, 64)
    _4: __ctx = pack _1, _2, _3, _1, 0, 0, _3, 0, 0
    p: ptr = addr __ctx_mem
    store _4, p
    ret

; after the case's context is set: the nodes run
fn __zero_start()
    __run()
    ret

