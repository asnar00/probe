    notfin: u1 = xor fin, 1
    _1: int$ = __get___node2_i()
    _2: i64 = received(_1)
    _3: i64 = __get___node2_i_seen()
    _4: u1 = cmp.gt _2, _3
    _5: u1 = ended(_1)
    _6: u1 = and _5, notfin
    _7: u1 = or _4, _6
    ran: u1 = if _7
        _8: int$ = __edge1(_1, 0: i64)
        __set___node2_i(_8)
        _9: i64 = received(_8)
        __set___node2_i_seen(_9)
        _10: u1 = ended(_8)
        __set___node2_fin(_10)
