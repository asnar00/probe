    c: __ctx = load p
    c2: __ctx = set c, __node1_i, v
    store c2, p
    ret

fn __get___node1_i_seen() -> i64
    p: ptr = addr __ctx_mem
    c: __ctx = load p
    v: i64 = get c, __node1_i_seen
    ret v

fn __set___node1_i_seen(v: i64)
    p: ptr = addr __ctx_mem
    c: __ctx = load p
    c2: __ctx = set c, __node1_i_seen, v
    store c2, p
    ret

fn __get___node1_fin() -> u1
    p: ptr = addr __ctx_mem
    c: __ctx = load p
    v: u1 = get c, __node1_fin
    ret v

fn __set___node1_fin(v: u1)
    p: ptr = addr __ctx_mem
    c: __ctx = load p
    c2: __ctx = set c, __node1_fin, v
    store c2, p
    ret

; node 1: out$ << i$ << "\n" — run when an input has more than the node has seen, or has ended and the node has not run since
fn __node1() -> u1
