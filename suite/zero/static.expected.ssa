fn goodbye()
    _1: ptr = addr __s12
    _2: i64 = len __s12
    _3: u8[] = __str(_1, _2)
    __out_block(_3)
    _4: u8 = const 10
    __out_ch(_4)
    ret

; a stream's storage, carved from the arena: cap items (64 unless more are) — a ring keeps them in twice that many slots, each item in both halves so that every window is one view (log 65), and a tick per item unless regular; a queue keeps them in a plain run of cap slots, item k at k minus the origin (log 89) — and a reader's view at its start
fn __queue_u8(hz: i64, cap: i64) -> u8$
    a: ptr = addr __arena
    r: ptr = arena_alloc(a, 64)
    sz: i64 = sizeof u8
    bytes: i64 = mul sz, cap
    total: i64 = add bytes, 16
    vb: ptr = arena_alloc(a, total)
    buffer_init(vb, sz, cap)
    ring_queue(r, vb, hz, cap)
    s: u8$ = stream r
    ret s
