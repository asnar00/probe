; feature hello (layer runtime)
fn run__hello()
    hello()
    ret
fn hello()
    _1: ptr = addr __s11
    _2: i64 = len __s11
    _3: u8[] = __str(_1, _2)
    __out_block(_3)
    _4: u8 = const 10
    __out_ch(_4)
    ret

