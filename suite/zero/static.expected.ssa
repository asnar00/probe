    _2: i64 = received(_1)
    _3: i64 = __get___node1_c_seen()
    _4: u1 = cmp.gt _2, _3
    _5: u1 = ended(_1)
    _6: u1 = and _5, notfin
    _7: u1 = or _4, _6
    ran: u1 = if _7
        _8: u8$ = write(_1, 0: i64)
        __set___node1_c(_8)
        _9: i64 = received(_8)
        __set___node1_c_seen(_9)
        _10: u1 = ended(_8)
        __set___node1_fin(_10)
        yield 1
    else
        yield 0
    ret ran

; node 2: out$ << i$ << "\n" — run when an input has more than the node has seen, or has ended and the node has not run since
fn __node2() -> u1
