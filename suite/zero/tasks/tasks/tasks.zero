int x$
int d$ = doubled(x$)
int e$ = closer(x$)
int y$
int q$ = doubled(y$)
int w$ << count up to (3) << count down from (3)
int size = 4
int z$ = count down from (size)
int left$
int right$
right$ << (left$ << 0) forever
int v$
int r$ = runs(v$)

on (int i$) << count down from (int n)
    i$ << n << (i$ - 1) while (_ > 0)

on (int i$) << count up to (int n)
    i$ << 1 << (i$ + 1) while (_ <= n)

on (int i$) << sawtooth (int n)
    i$ << count up to (n) << count down from (n)

on (int d$) << doubled (int x$)
    d$ << x$ * 2

on (int e$) << closer (int x$)
    e$ << 99 if (empty x$)

on (int r$) << runs (int x$)
    r$ << count x$
    advance x$ by (count x$)

on (int n) << sawtoothed()
    int i$ = sawtooth(5)
    int f[] = frame i$
    n << [count] (f[]) * 100 + f[4] * 10 + f[9]

on (int n) << counted down()
    int i$ << count down from (3)
    n << count i$ * 10 + latest i$

on (int n) << counted up()
    int i$ << 0 << count up to (4)
    n << peek i$ at (1) * 10 + latest i$

on (int n) << wired at feature scope()
    n << count w$ * 100 + peek w$ at (2) * 10 + latest w$

on (int n) << wired from a variable()
    n << count z$

on (int a, int b) << fed twice()
    x$ << 1 << 2
    a << count d$
    x$ << 3
    b << latest d$

on (int n) << carried between runs()
    x$ << 1 << 2
    x$ << 3
    int f[] = frame d$
    n << f[0] * 100 + f[1] * 10 + f[2]

on (int a, int b) << closed()
    x$ << 5
    a << count e$
    end x$
    b << latest e$ * 10 + count e$

on (int n) << closed once()
    end x$
    y$ << 1
    n << count e$ * 10 + count q$

on (int k, time t) << rated()
    int c$ = count down from (3) at (1 hz)
    advance c$ by (2)
    k << position c$
    t << time of c$

on (int n) << sampled at a rate()
    int c$ = count down from (3) at (1 hz)
    n << c$ at (1 s)

on (int k, time t) << composed at a rate()
    int s$ = sawtooth(2) at (1 hz)
    advance s$ by (3)
    k << position s$
    t << time of s$

on (int n) << fed a literal()
    int d$ << doubled ([1, 2, 3])
    n << count d$ * 10 + latest d$

on (int n) << run now moves the reader()
    int i$ << 1 << 2 << 3
    int d$ << doubled (frame i$)
    n << count i$ * 10 + count d$

on (int n) << run now inside a loop()
    int i$ << 1 << 2 << 3 << 4
    int d$
    loop (int k = 10) while (k < 12)
        i$ << k
        d$ << doubled (frame i$)
        continue (k + 1)
    n << count d$ * 10 + latest d$

on (int n) << a task run now inside a loop()
    int i$ << 1 << 2 << 3 << 4
    int r$
    loop (int k = 10) while (k < 12)
        i$ << k
        r$ << runs(i$)
        continue (k + 1)
    n << count r$ * 10 + latest r$

on (int a, int b) << edged()
    left$ << 1 << 2
    a << count right$
    int r[] = frame right$
    b << r[0] * 1000 + r[1] * 100 + r[2] * 10 + r[3]

on (int n) << a batch()
    v$ << 1 << 2 << 3
    n << count r$ * 10 + latest r$

on (int n) << nothing pushed (int k)
    v$ << [k to 1]
    n << count r$

on (int n) << ended twice()
    v$ << 7
    end v$
    end v$
    n << count r$ * 10 + latest r$
