int i$ at (1 hz)
int half$ at (2 hz)
int d$ = doubled(i$)
out$ << (d$ << "\n") forever
out$ << (half$ << "\n") forever

on (int d$) << doubled (int x$)
    d$ << x$ * 2

on count down()
    i$ << [10 through 1]

on launch()
    count down()
    out$ << "liftoff" << "\n"

on late()
    half$ << 0
    i$ << 4
    out$ << "done" << "\n"

on one()
    i$ << 3

on later()
    half$ << 0
    one()
    out$ << "done" << "\n"
