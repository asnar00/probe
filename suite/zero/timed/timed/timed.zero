int i$ at (1 hz)
int half$ at (2 hz)
int tick$ at (1 hz)
int d$ = doubled(i$)
out$ << (d$ << "\n") forever
out$ << (half$ << "\n") forever
out$ << (tick$ << "\n") forever

on (int d$) << doubled (int x$)
    loop
        if (count x$ == 0)
            break
        d$ << peek x$ at (0) * 2
        advance x$ by (1)

on count down()
    i$ << [10 through 1]

on launch()
    count down()
    out$ << "liftoff" << "\n"

on late()
    half$ << 0
    i$ << 4
    out$ << "done" << "\n"

on one()
    i$ << 3

on later()
    half$ << 0
    one()
    out$ << "done" << "\n"

on ticks()
    tick$ << 0 << (tick$ + 1) while (_ < 4)
