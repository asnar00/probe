type Vec =
    float x, y, z = 0

type Tristate = no | yes | maybe

on (Vec v) << (Vec a) + (Vec b)
    v << Vec(a.x + b.x, a.y + b.y, a.z + b.z)

on (Vec v) << (Vec a) * (float k)
    v << Vec(a.x * k, a.y * k, a.z * k)

on (int n) << sum of fields (Vec v)
    n << int(v.x + v.y + v.z)

on (int n) << added()
    Vec a(1, 2, 3)
    Vec b(10, 20, 30)
    n << sum of fields (a + b)

on (int n) << scaled()
    Vec a(1, 2, 3)
    n << sum of fields (a * 2.5)

on (int n) << by name()
    Vec v(z = 3, x = 1)
    n << sum of fields (v)

on (int n) << defaulted()
    Vec v
    n << sum of fields (v)

on (Tristate t) << flipped (Tristate x)
    t << if (x == yes) then (no) else (if (x == no) then (yes) else (maybe))

on (bool b) << is maybe (Tristate t)
    b << t == Tristate.maybe

on (int n) << widened (int32 x)
    n << int(x) * 2

on (uint8 b) << low byte (int x)
    b << uint8(x)

on (int n) << halved()
    float x = 7.0
    n << int(x / 2)

on (bool b) << flags()
    bool a = true
    b << a == false

on greet (string who)
    out$ << who << "\n"

on hello()
    greet "world"

on (string s) << name()
    s << "zero"

on named()
    print (name())

char said$

on said fifteen()
    said$ << "fifteen letters"
    out$ << frame said$

on said sixteen()
    said$ << "sixteen letters!"
    out$ << frame said$

on (Vec v) << (Vec a) * (Vec b)
    v << Vec(a.x * b.x, a.y * b.y, a.z * b.z)

on (int n) << scaled by a vec()
    Vec a(1, 2, 3)
    Vec b(2, 2, 2)
    n << sum of fields (a * b)

on (float64 q) << ratio of (int32 a) to (int32 b)
    q << a / b

on (int n) << ratio times ten (int32 a) and (int32 b)
    n << int(ratio of (a) to (b) * 10)

on (int64 p) << product of (int32 a) and (int32 b)
    p << a * b

on (int64 s) << mixed sum()
    int32 a = 5
    int64 b = 6
    s << a + b

on (int n) << mixed float()
    int16 a = 3
    float32 x = 0.5
    float64 y = a + x
    n << int(y * 2)

on (bool b) << compared across widths()
    int16 a = 300
    float32 x = 299.5
    b << a > x

on (number n) << smaller of (number a) and (number b)
    n << if (a < b) then (a) else (b)

on (int n) << smaller across types()
    int16 a = 7
    float32 x = 2.5
    n << int(smaller of (a) and (x) * 2)

on (int64 w) << widened on assignment()
    int32 x = 40
    w << x

on (int32 y) << narrowed explicitly()
    int64 big = 300000
    y << int32(big)

on (int n) << mixed wide()
    int64 a = 3
    float64 x = 0.5
    float64 y = a + x
    n << int(y * 2)

on (int64 d) << rounding above fifty three bits()
    int64 big = 9007199254740993
    float64 f = big
    d << int64(f) - big

on (bool b) << compared above fifty three bits()
    int64 a = 9007199254740993
    float64 x = 9007199254740992.0
    b << a > x

on (int n) << smaller across wide types()
    int64 a = 7
    float64 x = 2.5
    n << int(smaller of (a) and (x) * 2)

on (int n) << picked wide (bool c)
    int64 a = 9
    float32 x = 1.5
    float64 y = if (c) then (a) else (x)
    n << int(y * 2)

type Span =
    index start, n = 0

on (index p) << where it stands()
    int x$ << [10, 20, 30, 40]
    advance x$ by (2)
    p << position x$

on (int v) << peeked (index i)
    int x$ << [10, 20, 30, 40]
    v << peek x$ at (i)

on (int v) << subscripted (index i)
    int x[] = [10, 20, 30, 40]
    v << x[i]

on (int v) << first after moving (index n)
    int x$ << [10, 20, 30, 40]
    advance x$ by (n)
    v << peek x$ at (0)

on (bool b) << more waiting than (index k)
    int x[] = [10, 20, 30, 40]
    index n = count x[]
    b << n > k

on (index n) << last place()
    int x[] = [10, 20, 30, 40]
    n << count x[] - 1

on (int v) << the last one()
    int x[] = [10, 20, 30, 40]
    v << x[count x[] - 1]

on (index e) << end of span()
    Span s(3, 4)
    e << s.start + s.n

on (index k) << first above (int limit)
    int x[] = [10, 20, 30, 40]
    k << loop (index i = 0) yields i
        if (i >= count x[])
            break
        if (x[i] > limit)
            break
        continue (i + 1)

on (index j) << one past (index i)
    j << i + 1

on (index j) << two past (index i)
    j << one past (one past (i))

on (int n) << as an int (index i)
    int k = i
    n << k * 2

on (index i) << as an index (int n)
    index k = n
    i << k + 1

on (int s) << mixed (index i) and (int n)
    s << i + n
