type Vec =
    float x, y, z = 0

type Tristate = no | yes | maybe

on (Vec v) = (Vec a) + (Vec b)
    v = Vec(a.x + b.x, a.y + b.y, a.z + b.z)

on (Vec v) = (Vec a) * (float k)
    v = Vec(a.x * k, a.y * k, a.z * k)

on (int n) = sum of fields (Vec v)
    n = int(v.x + v.y + v.z)

on (int n) = added()
    Vec a(1, 2, 3)
    Vec b(10, 20, 30)
    n = sum of fields (a + b)

on (int n) = scaled()
    Vec a(1, 2, 3)
    n = sum of fields (a * 2.5)

on (int n) = by name()
    Vec v(z = 3, x = 1)
    n = sum of fields (v)

on (int n) = defaulted()
    Vec v
    n = sum of fields (v)

on (Tristate t) = flipped (Tristate x)
    t = if (x == yes) then (no) else (if (x == no) then (yes) else (maybe))

on (bool b) = is maybe (Tristate t)
    b = t == Tristate.maybe

on (int n) = widened (int32 x)
    n = int(x) * 2

on (uint8 b) = low byte (int x)
    b = uint8(x)

on (int n) = halved()
    float x = 7.0
    n = int(x / 2)

on (bool b) = flags()
    bool a = true
    b = a == false

on greet (string who)
    print who

on hello()
    greet "world"

on (string s) = name()
    s = "zero"

on named()
    print (name())

on (Vec v) = (Vec a) * (Vec b)
    v = Vec(a.x * b.x, a.y * b.y, a.z * b.z)

on (int n) = scaled by a vec()
    Vec a(1, 2, 3)
    Vec b(2, 2, 2)
    n = sum of fields (a * b)

on (float64 q) = ratio of (int32 a) to (int32 b)
    q = a / b

on (int n) = ratio times ten (int32 a) and (int32 b)
    n = int(ratio of (a) to (b) * 10)

on (int64 p) = product of (int32 a) and (int32 b)
    p = a * b

on (int64 s) = mixed sum()
    int32 a = 5
    int64 b = 6
    s = a + b

on (int n) = mixed float()
    int16 a = 3
    float32 x = 0.5
    float64 y = a + x
    n = int(y * 2)

on (bool b) = compared across widths()
    int16 a = 300
    float32 x = 299.5
    b = a > x

on (number n) = smaller of (number a) and (number b)
    n = if (a < b) then (a) else (b)

on (int n) = smaller across types()
    int16 a = 7
    float32 x = 2.5
    n = int(smaller of (a) and (x) * 2)

on (int64 w) = widened on assignment()
    int32 x = 40
    w = x

on (int32 y) = narrowed explicitly()
    int64 big = 300000
    y = int32(big)
