int up$
int seen$ << 0
int beat$ at (1 hz)
int src$
int first$
int kept$
int some$
out$ << (up$ << "\n") forever
out$ << (beat$ << "\n") forever
first$ << src$ (3) times
out$ << (first$ << "\n") forever
some$ << kept$ (2) times
out$ << (some$ << "\n") forever
int flow$
int till$
int key$
int open$
till$ << flow$ until (flow$ == 3)
out$ << (till$ << "\n") forever
open$ << flow$ until (ended key$)
int x$
int sum$
int from$ << 100
int evens$
int twice$
int y$
int tot$
sum$ << sum$ + x$ forever
from$ << from$ + x$ forever
evens$ << evens$ + x$ if (x$ % 2 == 0) forever
twice$ << x$ * 2 forever
tot$ << tot$ + y$ forever
out$ << (tot$ << "\n") forever
int w$
int tally$
tally$ << tally$ + w$ forever
out$ << (tally$ << " ") forever

on hello thrice()
    out$ << "hello\n" (3) times

on up to (int k)
    up$ << 0
    up$ << up$ + 1 (k) times

on chained()
    up$ << 0 << (up$ + 1) (4) times

on none()
    up$ << 7 (0) times
    out$ << "none"

on (int n) << twice (int k)
    n << k * 2

on called (int k)
    up$ << twice (k) (3) times

on summed (int a)
    up$ << a + twice (a) (2) times

on bracketed (int a)
    up$ << (a) (3) times

on maybe (int c)
    up$ << 5 if (c > 0) (2) times
    out$ << "done"

on (int n) << three (int k) times
    n << 3 * k

on bump (int k) times
    seen$ << seen$ + 1 (k) times

on (int n) << bumped by (int k)
    bump (k) times
    n << seen$

on the name()
    up$ << (three (4) times)

on the name twice()
    up$ << three (4) times (2) times

on a range()
    up$ << [1 through 2] (2) times

on beats()
    beat$ << 0
    beat$ << beat$ + 1 (3) times

on first three()
    src$ << [1 through 5]

on first two()
    kept$ << [5 through 9]
    out$ << count kept$

on counted to five()
    up$ << 1 << (up$ + 1) until (up$ == 5)

on counted under five()
    up$ << 1 << (up$ + 1) while (_ < 5)

on counted to five by the item()
    up$ << 1 << (up$ + 1) until (_ == 5)

on once()
    up$ << 9 until (true)

on (int n) << doubled past (int limit)
    seen$ << 1
    seen$ << seen$ * 2 until (seen$ > limit)
    n << seen$

on maybe to three (int c)
    up$ << 1 << (up$ + 1) if (c > 0) until (up$ == 3)
    out$ << "done"

on maybe under three (int c)
    up$ << 1 << (up$ + 1) if (c > 0) while (_ < 3)
    out$ << "done"

on beats to three()
    beat$ << 0 << (beat$ + 1) until (beat$ == 3)

on flowed to three()
    flow$ << [1 through 5]

on (int n) << flowed to the end of the key()
    flow$ << 1 << 2
    end key$
    flow$ << 3 << 4
    n << count open$

on (int a, int b) << sums()
    x$ << 1 << 2 << 3 << 4
    a << sum$
    b << from$

on (int c, int d) << some and twice()
    x$ << 1 << 2 << 3 << 4
    c << evens$
    d << twice$

on (int n) << summed to (int k)
    x$ << [1 through k]
    n << sum$

on running()
    y$ << [1 through 4]

on (int n) << tallied()
    w$ << 1 << 2 << 3
    n << tally$
