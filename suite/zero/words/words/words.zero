int up$
int seen$ << 0
int beat$ at (1 hz)
int src$
int first$
int kept$
int some$
out$ << (up$ << "\n") forever
out$ << (beat$ << "\n") forever
first$ << src$ (3) times
out$ << (first$ << "\n") forever
some$ << kept$ (2) times
out$ << (some$ << "\n") forever
int flow$
int till$
int key$
int open$
till$ << flow$ until (flow$ == 3)
out$ << (till$ << "\n") forever
open$ << flow$ until (ended key$)
int x$
int sum$
int from$ << 100
int evens$
int twice$
int y$
int tot$
sum$ << sum$ + x$ forever
from$ << from$ + x$ forever
evens$ << evens$ + x$ if (x$ % 2 == 0) forever
twice$ << x$ * 2 forever
tot$ << tot$ + y$ forever
out$ << (tot$ << "\n") forever
int w$
int tally$
tally$ << tally$ + w$ forever
out$ << (tally$ << " ") forever
int tick$ at (1 hz)
int hold$
int held$
held$ << tick$ until (ended hold$)
out$ << (held$ << "\n") forever
int tock$ at (1 hz)
int stop$
int stopped$
stopped$ << tock$ until (stop$ == 1)
out$ << (stopped$ << "\n") forever
int through$
int gate$
int let$
int passed$
let$ << through$ if (gate$ == 0) forever
passed$ << passed$ + let$ forever
int fed$
int two$ = twofold (fed$)
int twos$
twos$ << twos$ + two$ forever
int lead$
int beside$
out$ << (lead$ << " " << beside$ << "\n") forever
int begun$ << 5
int since$
since$ << since$ + begun$ forever
int shut$
int ran$
ran$ << ran$ + shut$ forever
int raw$
int dbl$ = twofold (raw$)

on (int d$) << twofold (int p$)
    d$ << p$ * 2

on hello thrice()
    out$ << "hello\n" (3) times

on up to (int k)
    up$ << 0
    up$ << up$ + 1 (k) times

on chained()
    up$ << 0 << (up$ + 1) (4) times

on none()
    up$ << 7 (0) times
    out$ << "none"

on (int n) << twice (int k)
    n << k * 2

on called (int k)
    up$ << twice (k) (3) times

on summed (int a)
    up$ << a + twice (a) (2) times

on bracketed (int a)
    up$ << (a) (3) times

on maybe (int c)
    up$ << 5 if (c > 0) (2) times
    out$ << "done"

on (int n) << three (int k) times
    n << 3 * k

on bump (int k) times
    seen$ << seen$ + 1 (k) times

on (int n) << bumped by (int k)
    bump (k) times
    n << seen$

on the name()
    up$ << (three (4) times)

on the name twice()
    up$ << three (4) times (2) times

on a range()
    up$ << [1 through 2] (2) times

on beats()
    beat$ << 0
    beat$ << beat$ + 1 (3) times

on first three()
    src$ << [1 through 5]

on first two()
    kept$ << [5 through 9]
    out$ << [count] (frame kept$)

on counted to five()
    up$ << 1 << (up$ + 1) until (up$ == 5)

on counted under five()
    up$ << 1 << (up$ + 1) while (_ < 5)

on counted to five by the item()
    up$ << 1 << (up$ + 1) until (_ == 5)

on once()
    up$ << 9 until (true)

on (int n) << doubled past (int limit)
    seen$ << 1
    seen$ << seen$ * 2 until (seen$ > limit)
    n << seen$

on maybe to three (int c)
    up$ << 1 << (up$ + 1) if (c > 0) until (up$ == 3)
    out$ << "done"

on maybe under three (int c)
    up$ << 1 << (up$ + 1) if (c > 0) while (_ < 3)
    out$ << "done"

on beats to three()
    beat$ << 0 << (beat$ + 1) until (beat$ == 3)

on flowed to three()
    flow$ << [1 through 5]

on (int n) << flowed to the end of the key()
    flow$ << 1 << 2
    end key$
    flow$ << 3 << 4
    n << count open$

on (int a, int b) << sums()
    x$ << 1 << 2 << 3 << 4
    a << sum$
    b << from$

on (int c, int d) << some and twice()
    x$ << 1 << 2 << 3 << 4
    c << evens$
    d << twice$

on (int n) << summed to (int k)
    x$ << [1 through k]
    n << sum$

on running()
    y$ << [1 through 4]

on (int n) << tallied()
    w$ << 1 << 2 << 3
    n << tally$

on passed till the hold ends()
    tick$ << 0 << 1 << 2
    end hold$
    tick$ << 3

on passed till the stop()
    tock$ << 0 << 1
    stop$ << 0
    tock$ << 2
    stop$ << 1
    tock$ << 3
    stop$ << 0
    tock$ << 4

on (int n) << gated (int k)
    gate$ << 0 (k) times
    through$ << 5
    gate$ << 1
    through$ << 7
    n << passed$

on (int n) << climbed to (int k)
    up$ << 1 << (up$ + 1) while (_ <= k)
    n << up$

on (int n) << tallied to (int k)
    w$ << [1 through k]
    n << tally$

on (int n) << asked of the stop (int k)
    stop$ << 0 (k) times
    stop$ << 2
    n << stop$ + k

on (int n) << beaten to (int k)
    beat$ << 1 << (beat$ + 1) while (_ <= k)
    n << beat$

on (int n, int m) << fed to (int k)
    fed$ << 1 << (fed$ + 1) while (_ <= k)
    n << fed$
    m << twos$

on labelled()
    lead$ << 1
    beside$ << 3 << 4
    lead$ << 2
    beside$ << 5
    lead$ << 3

on (int n) << labelled past (int k)
    beside$ << 3 (k) times
    lead$ << 1
    n << beside$

on (int a, int b) << begun at five (int k)
    begun$ << begun$ + 1 (k) times
    a << begun$
    b << since$

on (int a, bool b) << shut after (int k)
    shut$ << 1 (k) times
    end shut$
    end shut$
    a << ran$
    b << ended shut$

on shut and pushed()
    shut$ << 1
    end shut$
    shut$ << 2

on (int n) << twofold to (int k)
    raw$ << 1 << (raw$ + 1) while (_ <= k)
    n << dbl$
