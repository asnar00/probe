int x$
int d$ = doubled(x$)
int y$
int q$ = doubled(y$)
int lit$ << [1, 2, 3]
int dl$ = doubled(lit$)
int ran$ << [1 through 5]
int dr$ = doubled(ran$)
int c$
int once$ = doubled(c$)
int twice$ = doubled(once$)
int p$
int w$ = placed(p$)
int r$
int v$ = placed(r$)
char text$
int cl$ = classes(text$)
int typed$ = classes(in$)
int s$
int ds$ = doubled(s$)
int old$
int olds$ = doubled by walking(old$)
int m$
int t$ = trebled(m$)
int a$
int sa$ = summed(a$)
int b$
int sb$ = summed(b$)
int sl$ = summed(lit$)
int e$
int de$ = differenced(e$)
int f$
int ff$ = fibbed(f$)
int g$
int sg$ = shuffled(g$)
char word$
int rw$ = repeats(word$)
int h$
int rh$ = risen(h$)
int fi$
int pos$ = positive(fi$)
int ch$
int cd$ = changes(ch$)
int ev$
int tens$ = tenths(ev$)
int plain$
int en$
int den$ = doubled(en$)
int cl2$
int cls$ = closer(cl2$)
int tin$
int tot$ = totalled(tin$)
int fin$ = capped(tot$)
int cnt$
int how$ = counted(cnt$)
int st$ << 4 << 5
int sts$ = totalled(st$)
int lo$
int louds$ = doubled(lo$)
int dec$
int decs$ = decades(dec$)

on (int d$) << doubled (int x$)
    d$ << x$ * 2

on (int d$) << doubled by walking (int x$)
    loop
        if (count x$ - position x$ == 0)
            break
        d$ << peek x$ at (0) * 2
        advance x$ by (1)

on (int w$) << placed (int x$)
    index at$ = position x$
    w$ << x$ * 10 + at$

on (int t$) << trebled (int x$)
    int two$ = x$ * 2
    t$ << two$ + x$

on (int k) << class of (char c)
    k << 0 if (c <= 32)
         else 1 if (c >= 97)
         else 2

on (int k$) << classes (char c$)
    k$ << class of (c$)

on (int a, bool b) << one at a time()
    x$ << 1
    a << count d$
    x$ << 2 << 3
    b << frame d$ [==] [2, 4, 6]

on (bool b) << as a block()
    y$ << [4, 5, 6]
    b << frame q$ [==] [8, 10, 12]

on (bool b) << said()
    x$ << 1 << 2 << 3
    b << frame d$ [==] [2, 4, 6]

on (bool b) << walked()
    old$ << 1 << 2 << 3
    b << frame olds$ [==] [2, 4, 6]

on (bool b) << from a literal()
    b << frame dl$ [==] [2, 4, 6]

on (bool b) << from a range()
    b << frame dr$ [==] [2, 4, 6, 8, 10]

on (bool b) << through two()
    c$ << 1 << 2 << 3
    b << frame twice$ [==] [4, 8, 12]

on (bool a, bool b) << wired twice()
    p$ << 5 << 6
    r$ << 7
    p$ << 8
    a << frame w$ [==] [50, 61, 82]
    b << frame v$ [==] [70]

on (bool b) << over text()
    text$ << "ab 1"
    text$ << "c"
    b << frame cl$ [==] [1, 1, 0, 2, 1]

on (bool b) << typed()
    b << frame typed$ [==] [1, 2]

on (int a, bool b) << also read()
    s$ << 1 << 2
    a << count s$
    b << frame ds$ [==] [2, 4]

on (int n) << many (int k)
    y$ << [1 through k]
    n << count q$ * 1000 + peek q$ at (k - 1)

on (bool b) << a line said()
    m$ << 4 << 5
    b << frame t$ [==] [12, 15]

on (int s$) << summed (int x$)
    int t$ = t$[-1] + x$
    s$ << t$

on (int d$) << differenced (int x$)
    d$ << x$ - x$[-1]

on (int y$) << fibbed (int x$)
    int f$ = x$ + f$[-1] + f$[-2]
    y$ << f$

on (int o$) << shuffled (int x$)
    o$ << q$ + r$
    int r$ = q$ * 2
    int q$ = x$ + p$[-1]
    int p$ = q$ + 1

on (int n$) << repeats (char c$)
    int same$ = same$[-1] + 1 if (c$ == c$[-1]) else 0
    n$ << same$

on (int r$) << risen (int x$)
    bool up$ = x$ > x$[-1] and x$[-1] > 0 or x$ == 100
    r$ << 1 if (up$) else 0

on (bool b) << between (int lo) and (int hi) holds (int x)
    b << x >= lo and x <= hi

on (int n) << joined (int x)
    bool inside = between (1) and (9) holds (x)
    bool odd = x % 2 == 1
    n << 1 if (inside and odd or x == 100) else 0

on (bool m, bool k) << a running sum()
    a$ << 1 << 2 << 3
    b$ << 10
    a$ << 4
    m << frame sa$ [==] [1, 3, 6, 10]
    k << frame sb$ [==] [10]

on (bool b) << summed from a literal()
    b << frame sl$ [==] [1, 3, 6]

on (bool b) << a difference()
    e$ << 5 << 8
    e$ << 6
    b << frame de$ [==] [5, 3, -2]

on (bool b) << two back()
    f$ << 1 << 0 << 0 << 0 << 0
    b << frame ff$ [==] [1, 1, 2, 3, 5]

on (bool b) << lines shuffled()
    g$ << 1 << 1
    b << frame sg$ [==] [3, 9]

on (bool b) << kept through a block()
    word$ << "aab"
    word$ << "bb"
    b << frame rw$ [==] [0, 1, 0, 1, 2]

on (bool b) << two conditions()
    h$ << 3 << 5 << 4 << 100 << 0 << 7
    b << frame rh$ [==] [0, 1, 0, 1, 0, 0]

on (int e$) << positive (int x$)
    e$ << x$ if (x$ > 0)

on (int c$) << changes (int x$)
    c$ << x$ if (x$ != x$[-1])

on (int t$) << tenths (int x$)
    t$ << x$ if (x$ % 10 == 0)

on (bool b) << filtered()
    fi$ << 3 << -1 << 0 << 7
    b << frame pos$ [==] [3, 7]

on (bool b) << changed()
    ch$ << 1 << 1 << 2 << 2 << 2 << 1
    b << frame cd$ [==] [1, 2, 1]

on (int n) << every tenth to (int k)
    ev$ << [1 through k]
    n << count tens$ * 1000 + peek tens$ at (count tens$ - 1)

on (int n) << pushed above two (int k)
    plain$ << k if (k > 2)
    plain$ << 9
    n << count plain$ * 10 + peek plain$ at (0)

on (int e$) << closer (int x$)
    e$ << 99 if (empty x$)

on (int t$) << totalled (int x$)
    int sum$ = sum$[-1] + x$
    t$ << sum$[-1] if (empty x$)

on (int o$) << capped (int x$)
    o$ << x$
    o$ << -1 if (empty x$)

on (int n$) << counted (int x$)
    n$ << position x$ if (empty x$)

on (int a, bool b) << no stray zero()
    en$ << 1 << 2
    end en$
    a << count den$
    end en$
    b << frame den$ [==] [2, 4]

on (int a, bool b) << closed()
    cl2$ << 5
    a << count cls$
    end cl2$
    end cl2$
    b << frame cls$ [==] [99]

on (int a, bool b) << a chain ends()
    tin$ << 1 << 2 << 3
    a << count fin$
    end tin$
    b << frame fin$ [==] [6, -1]

on (bool b) << how many came()
    cnt$ << 7 << 7 << 7
    end cnt$
    b << frame how$ [==] [3]

on (int a, bool b) << a stored input ends()
    a << count sts$
    end st$
    b << frame sts$ [==] [9]

on pushed after its end()
    en$ << 1
    end en$
    en$ << 2

on (int a, int b) << an output ends()
    lo$ << 1
    a << 1 if (ended louds$) else 0
    end lo$
    b << 1 if (ended louds$) else 0

on (int r$) << decades (int x$)
    bool new$ = x$ / 10 != x$[-1] / 10
    int n$ = 1 if (new$) else n$[-1] + 1
    int first$ = x$ if (new$) else first$[-1]
    r$ << first$[-1] * 100 + n$[-1] if (new$ and n$[-1] > 0)

on (int n) << tens to (int k)
    dec$ << [1 through k]
    n << count decs$ * 100000 + peek decs$ at (count decs$ - 1)

on (bool b) << many whole (int k)
    y$ << [1 through k]
    b << frame q$ [==] [1 through k] * 2

on (bool b) << every tenth whole (int k)
    ev$ << [1 through k]
    b << frame tens$ [==] [1 through k / 10] * 10

on (bool b) << pushed above two whole (int k)
    plain$ << k if (k > 2)
    plain$ << 9
    b << frame plain$ [==] [k, 9]

on (bool b) << tens whole()
    dec$ << [1 through 25]
    b << frame decs$ [==] [9, 1010]
