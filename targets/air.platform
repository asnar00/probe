; targets/air.platform — what Apple's GPUs compute with their own
; instructions, as LLVM operations and air intrinsics (see
; targets/arm64.platform for the form; src/emit_air.rs for the target).
; Values are their bits, as on wasm; the emitter bitcasts around a rule.
; Nothing here is fast-math: what Apple's compiler does with these is
; what `probe testfloat air` will measure. There is no double on an
; Apple GPU, so f64 stays the library's.

target air

; vectors reach the emitter whole, as <N x T>
ext vectors
builtin vectors

ext FP
class f32 = f32
class f16 = f16

fadd = add(f32, f32) -> f32
fsub = sub(f32, f32) -> f32
fmul = mul(f32, f32) -> f32
fdiv = div(f32, f32) -> f32
fneg = neg(f32) -> f32
air.sqrt.f32 = sqrt(f32) -> f32
air.fma.f32 = fma(f32, f32, f32) -> f32
air.fabs.f32 = abs(f32) -> f32
fcmp.oeq = eq(f32, f32) -> u1
fcmp.une = ne(f32, f32) -> u1
fcmp.olt = lt(f32, f32) -> u1
fcmp.ole = le(f32, f32) -> u1
fcmp.ogt = gt(f32, f32) -> u1
fcmp.oge = ge(f32, f32) -> u1

fadd = add(f16, f16) -> f16
fsub = sub(f16, f16) -> f16
fmul = mul(f16, f16) -> f16
fdiv = div(f16, f16) -> f16

; a threadgroup's barrier (lib/gpu.ssa has the one-thread form); its
; memory is the program's `group` items
ext group
air.wg.barrier = group_sync() -> ()

; the simdgroup (lib/gpu.ssa has the one-thread forms). A lane index
; and the width are the kernel's to know: the wrapper leaves them in
; each thread's header, where these two rules read them.
ext simd
air.simd_lane = simd_lane() -> i64
air.simd_size = simd_size() -> i64
air.simd_is_first = simd_first() -> u1
air.simd_all = simd_all(u1) -> u1
air.simd_any = simd_any(u1) -> u1
air.simd_ballot.i64 = simd_ballot(u1) -> u64
air.simd_sum.f32 = simd_sum(f32) -> f32
air.simd_product.f32 = simd_product(f32) -> f32
air.simd_max.f32 = simd_max(f32) -> f32
air.simd_min.f32 = simd_min(f32) -> f32
air.simd_prefix_inclusive_sum.f32 = simd_prefix_sum(f32) -> f32
air.simd_shuffle.f32 = simd_shuffle(f32, i64) -> f32
air.simd_broadcast.f32 = simd_broadcast(f32, i64) -> f32
air.simd_shuffle_xor.f32 = simd_shuffle_xor(f32, i64) -> f32
air.simd_shuffle_down.f32 = simd_shuffle_down(f32, i64) -> f32
air.simd_shuffle_up.f32 = simd_shuffle_up(f32, i64) -> f32
air.simd_sum.f16 = simd_sum(f16) -> f16
air.simd_max.f16 = simd_max(f16) -> f16
air.simd_min.f16 = simd_min(f16) -> f16
air.simd_prefix_inclusive_sum.f16 = simd_prefix_sum(f16) -> f16
air.simd_shuffle.f16 = simd_shuffle(f16, i64) -> f16
air.simd_broadcast.f16 = simd_broadcast(f16, i64) -> f16
air.simd_sum.s.i32 = simd_sum(i32) -> i32
air.simd_sum.u.i32 = simd_sum(u32) -> u32
air.simd_product.s.i32 = simd_product(i32) -> i32
air.simd_max.s.i32 = simd_max(i32) -> i32
air.simd_max.u.i32 = simd_max(u32) -> u32
air.simd_min.s.i32 = simd_min(i32) -> i32
air.simd_min.u.i32 = simd_min(u32) -> u32
air.simd_prefix_inclusive_sum.s.i32 = simd_prefix_sum(i32) -> i32
air.simd_prefix_inclusive_sum.u.i32 = simd_prefix_sum(u32) -> u32
air.simd_shuffle.s.i32 = simd_shuffle(i32, i64) -> i32
air.simd_shuffle.u.i32 = simd_shuffle(u32, i64) -> u32
air.simd_broadcast.s.i32 = simd_broadcast(i32, i64) -> i32
air.simd_broadcast.u.i32 = simd_broadcast(u32, i64) -> u32
air.simd_shuffle_xor.s.i32 = simd_shuffle_xor(i32, i64) -> i32
air.simd_shuffle_xor.u.i32 = simd_shuffle_xor(u32, i64) -> u32
air.simd_shuffle_down.s.i32 = simd_shuffle_down(i32, i64) -> i32
air.simd_shuffle_up.s.i32 = simd_shuffle_up(i32, i64) -> i32

; fibres (lib/fibre.ssa) are a machine's way of running a group on one
; thread; a GPU runs its bodies one after another if asked
ext fibres
const fibre_lr = 0
const fibre_sp = 8
const fibre_stacks = 0

; the current thread: its header, which every function's tls names
ext thread
air.thread = thread_reg() -> ptr
