; targets/arm64.platform — what this target computes with its own
; instructions, as rules over the library's operations and types.
;
;   class s = f32                          ; f32 values live in s registers
;   fadd {s}, {s}, {s} = add(f32, f32) -> f32
;
; A `class` line gives the types named a register class — the slot letter
; the learned templates use for it — so the allocator keeps such values
; in that file and nothing moves between files except where a value
; really changes class (a `cast` to its bits, a call boundary, a field
; read). A one-line rule is a learned template and the library instance
; it computes; the template's slots are the result, then the arguments,
; in order. A rule that takes several instructions is a header with
; indented lines over a, b, c and r, plus literals for condition and
; immediate slots. Types are written by their program names (f32 is
; float(8, 23) in lib/float.ssa). The library remains the reference:
; --soft compiles with no rules and the two must agree (probe testfloat
; checks both against TestFloat). Rules name the nearest-even instances,
; which is what the instructions compute; other rounding modes stay in
; the library.
;
; Variants: the file is one extension group, FP; `targets/arm64-nofp.
; platform` is this target without it (an OS kernel that may not touch
; the FP registers). `target` names the backend; a variant says `base`.

target arm64

; the qemu virt board: a PL011 UART. There is no finisher device; the
; machine is ended through PSCI (a hypervisor call with the SYSTEM_OFF
; function id in x0), so `finisher` is a harmless RAM address that a
; program written for riscv may store to, and `psci` the real exit
ext virt
const uart = 0x9000000
const finisher = 0x41300000
; the machine's memory: 128 MB from 0x40000000; the image is at
; 0x40200000, the boot stack at 0x41000000 (probe boot's preamble),
; and what is above that is a program's to carve — its heap (the
; finisher address above is inside it and harmless: a stray store)
const heap_base = 0x41400000
const ram_end = 0x48000000
psci(code: u64) -> ()
    hvc 0
; the UART's receive side: the flag register, its "receive FIFO empty"
; bit, and that bit's value when a byte is waiting
const uart_status = 0x18
const uart_ready_mask = 0x10
const uart_ready = 0
; a supervisor call leaves the return address after itself
const resume_skip = 0
; the exception class of a supervisor call (ESR_EL1.EC = 0x15), and of
; a failed `check` (a breakpoint, 0x3c)
const trap_syscall = 21
const trap_check = 60

; traps at EL1. `fn __trap(a: u64, b: u64, c: u64) -> u64` is the
; handler (see ssa.md: it gets the trapped code's first argument
; registers and its result replaces the first); `probe boot` lays a
; vector table of branches to it in the 2K before its entry, so the
; base to install is the entry less 2048
ext traps
vectors(t: ptr) -> ()
    sub t, t, 2048
    msr vbar_el1, t
cause() -> u64
    mrs r, esr_el1
    lsr r, r, 26
resume() -> ptr
    mrs r, elr_el1
resume_at(p: ptr) -> ()
    msr elr_el1, p
syscall(n: u64, a: u64, b: u64) -> u64
    svc 0

; interrupts and time on the virt board: the generic timer's counter
; and frequency, the EL1 physical timer (compare value, control), its
; interrupt through the GICv2 — distributor at 0x08000000 (control 0,
; set-enable 0x100: the timer is PPI 30), cpu interface at 0x08010000
; (control 0, priority mask 4, acknowledge 0xc, end 0x10) — and the
; IRQ mask bit of PSTATE (daif bit 2)
ext time
const irq_timer = 30
; a software-generated interrupt to this cpu (SGI 0, through the
; distributor's SGIR at 0xf00, target list filter "self"): a task
; asking to be rescheduled
const irq_soft = 0
; the GIC names every source itself, so there is no "external" cause
; to claim from: irq_external is an id that never arrives, and the
; UART is SPI 33
const irq_external = 1023
const irq_uart = 33
now() -> u64
    mrs r, cntpct_el0
hz() -> u64
    mrs r, cntfrq_el0
timer_at(t: u64) -> () with on: u64
    msr cntp_cval_el0, t
    movz on, 1
    msr cntp_ctl_el0, on
timer_off() -> () with off: u64
    movz off, 0
    msr cntp_ctl_el0, off
irq_on() -> () with gic: ptr, v: u32
    movz gic, 0x0800, lsl 16
    movz v, 1
    str v, [gic, 0]
    movz v, 0x4000, lsl 16
    str v, [gic, 256]
    movz v, 1
    str v, [gic, 256]
    movz gic, 0x0801, lsl 16
    movz v, 255
    str v, [gic, 4]
    movz v, 1
    str v, [gic, 0]
    msr daifclr, 2
irq_ack() -> u32 with gic: ptr
    movz gic, 0x0801, lsl 16
    ldr r, [gic, 12]
irq_claim() -> u32 with gic: ptr
    movz gic, 0x0801, lsl 16
    ldr r, [gic, 12]
; the UART's receive interrupt: SPI 33 enabled in the distributor
; (set-enable register 1, bit 1) and targeted at cpu 0 (the byte for
; source 33 of the targets registers), and the PL011's receive mask
; bit (IMSC, offset 0x38)
uart_irq_on() -> () with gic: ptr, v: u32, uart: ptr
    movz gic, 0x0800, lsl 16
    movz v, 2
    str v, [gic, 260]
    movz v, 1
    strb v, [gic, 2081]
    movz uart, 0x0900, lsl 16
    movz v, 16
    str v, [uart, 56]
irq_done(id: u32) -> () with gic: ptr
    movz gic, 0x0801, lsl 16
    str id, [gic, 16]
reschedule() -> () with gic: ptr, v: u32
    movz gic, 0x0800, lsl 16
    movz v, 0x0200, lsl 16
    str v, [gic, 3840]
idle() -> ()
    wfi

; integer min and max (lib/int.ssa): a compare and a conditional select
ext select
min(i32, i32) -> i32
    cmp a, b
    csel r, a, b, lt
max(i32, i32) -> i32
    cmp a, b
    csel r, a, b, gt
min(u32, u32) -> u32
    cmp a, b
    csel r, a, b, lo
max(u32, u32) -> u32
    cmp a, b
    csel r, a, b, hi
min(i64, i64) -> i64
    cmp a, b
    csel r, a, b, lt
max(i64, i64) -> i64
    cmp a, b
    csel r, a, b, gt
min(u64, u64) -> u64
    cmp a, b
    csel r, a, b, lo
max(u64, u64) -> u64
    cmp a, b
    csel r, a, b, hi

ext FP
class s = f32
class d = f64

; --- arithmetic ---
fadd {s}, {s}, {s} = add(f32, f32) -> f32
fsub {s}, {s}, {s} = sub(f32, f32) -> f32
fmul {s}, {s}, {s} = mul(f32, f32) -> f32
fdiv {s}, {s}, {s} = div(f32, f32) -> f32
fsqrt {s}, {s} = sqrt(f32) -> f32
fneg {s}, {s} = neg(f32) -> f32
fabs {s}, {s} = abs(f32) -> f32
fmin {s}, {s}, {s} = min(f32, f32) -> f32
fmax {s}, {s}, {s} = max(f32, f32) -> f32
fmadd {s}, {s}, {s}, {s} = fma(f32, f32, f32) -> f32

fadd {d}, {d}, {d} = add(f64, f64) -> f64
fsub {d}, {d}, {d} = sub(f64, f64) -> f64
fmul {d}, {d}, {d} = mul(f64, f64) -> f64
fdiv {d}, {d}, {d} = div(f64, f64) -> f64
fsqrt {d}, {d} = sqrt(f64) -> f64
fneg {d}, {d} = neg(f64) -> f64
fabs {d}, {d} = abs(f64) -> f64
fmin {d}, {d}, {d} = min(f64, f64) -> f64
fmax {d}, {d}, {d} = max(f64, f64) -> f64
fmadd {d}, {d}, {d}, {d} = fma(f64, f64, f64) -> f64

; --- comparison: fcmp sets NZCV, and these conditions read it as IEEE
; wants (unordered compares false, except ne) ---
eq(f32, f32) -> u1
    fcmp a, b
    cset r, eq
ne(f32, f32) -> u1
    fcmp a, b
    cset r, ne
lt(f32, f32) -> u1
    fcmp a, b
    cset r, lo
le(f32, f32) -> u1
    fcmp a, b
    cset r, ls
gt(f32, f32) -> u1
    fcmp a, b
    cset r, gt
ge(f32, f32) -> u1
    fcmp a, b
    cset r, ge

eq(f64, f64) -> u1
    fcmp a, b
    cset r, eq
ne(f64, f64) -> u1
    fcmp a, b
    cset r, ne
lt(f64, f64) -> u1
    fcmp a, b
    cset r, lo
le(f64, f64) -> u1
    fcmp a, b
    cset r, ls
gt(f64, f64) -> u1
    fcmp a, b
    cset r, gt
ge(f64, f64) -> u1
    fcmp a, b
    cset r, ge

; --- conversion: float to float, integer to float (rounded), float to
; integer (toward zero, saturating, NaN to 0: fcvtz's own rules, which
; are the library's) ---
fcvt {d}, {s} = conv(f32) -> f64
fcvt {s}, {d} = conv(f64) -> f32
scvtf {s}, {w} = conv(i32) -> f32
scvtf {d}, {w} = conv(i32) -> f64
ucvtf {s}, {w} = conv(u32) -> f32
ucvtf {d}, {w} = conv(u32) -> f64
scvtf {s}, {x} = conv(i64) -> f32
scvtf {d}, {x} = conv(i64) -> f64
ucvtf {s}, {x} = conv(u64) -> f32
ucvtf {d}, {x} = conv(u64) -> f64
fcvtzs {w}, {s} = conv(f32) -> i32
fcvtzu {w}, {s} = conv(f32) -> u32
fcvtzs {x}, {s} = conv(f32) -> i64
fcvtzu {x}, {s} = conv(f32) -> u64
fcvtzs {w}, {d} = conv(f64) -> i32
fcvtzu {w}, {d} = conv(f64) -> u32
fcvtzs {x}, {d} = conv(f64) -> i64
fcvtzu {x}, {d} = conv(f64) -> u64

; NEON: vectors of 64 or 128 bits in the same file as the floats —
; lanes of 8, 16, 32 or 64 bits (.8b/.16b, .4h/.8h, .2s/.4s, .2d). The
; library defines a vector operation lane by lane (ssa.md: Vectors); a
; rule here takes the whole vector in one instruction, and the parser
; keeps a vector of a classed type whole only for the operations that
; have one — everything else (a divide of i32x4, an i64x4) stays lane
; by lane. A vector of u1 lanes holds each lane as 0 or 1 in a 128/N-bit
; lane of a whole register, which is what `neg` makes of a comparison's
; all-ones (a 64-bit vector's comparison is widened first).
; targets/arm64-noneon.platform is this target without them: the same
; programs lane by lane, which is what these rules are checked against.
ext NEON
class v = f32x4, f64x2, f32x2, i32x4, u32x4, i64x2, u64x2, i32x2, u32x2, i16x4, u16x4, i8x8, u8x8, i16x8, u16x8, i8x16, u8x16, u1x2, u1x4, u1x8, u1x16


; --- f32x4 ---
fadd {v}.4s, {v}.4s, {v}.4s = add(f32x4, f32x4) -> f32x4
fsub {v}.4s, {v}.4s, {v}.4s = sub(f32x4, f32x4) -> f32x4
fmul {v}.4s, {v}.4s, {v}.4s = mul(f32x4, f32x4) -> f32x4
fdiv {v}.4s, {v}.4s, {v}.4s = div(f32x4, f32x4) -> f32x4
fmin {v}.4s, {v}.4s, {v}.4s = min(f32x4, f32x4) -> f32x4
fmax {v}.4s, {v}.4s, {v}.4s = max(f32x4, f32x4) -> f32x4
fsqrt {v}.4s, {v}.4s = sqrt(f32x4) -> f32x4
fneg {v}.4s, {v}.4s = neg(f32x4) -> f32x4
fabs {v}.4s, {v}.4s = abs(f32x4) -> f32x4
fma(f32x4, f32x4, f32x4) -> f32x4 with t: f32x4
    mov t.16b, c.16b
    fmla t.4s, a.4s, b.4s
    mov r.16b, t.16b
eq(f32x4, f32x4) -> u1x4 with t: u1x4
    fcmeq t.4s, a.4s, b.4s
    neg r.4s, t.4s
gt(f32x4, f32x4) -> u1x4 with t: u1x4
    fcmgt t.4s, a.4s, b.4s
    neg r.4s, t.4s
ge(f32x4, f32x4) -> u1x4 with t: u1x4
    fcmge t.4s, a.4s, b.4s
    neg r.4s, t.4s
lt(f32x4, f32x4) -> u1x4 with t: u1x4
    fcmgt t.4s, b.4s, a.4s
    neg r.4s, t.4s
le(f32x4, f32x4) -> u1x4 with t: u1x4
    fcmge t.4s, b.4s, a.4s
    neg r.4s, t.4s
ne(f32x4, f32x4) -> u1x4 with t: u1x4
    fcmeq t.4s, a.4s, b.4s
    mvn t.16b, t.16b
    neg r.4s, t.4s
scvtf {v}.4s, {v}.4s = conv(i32x4) -> f32x4
ucvtf {v}.4s, {v}.4s = conv(u32x4) -> f32x4
fcvtzs {v}.4s, {v}.4s = conv(f32x4) -> i32x4
fcvtzu {v}.4s, {v}.4s = conv(f32x4) -> u32x4

; --- f64x2 ---
fadd {v}.2d, {v}.2d, {v}.2d = add(f64x2, f64x2) -> f64x2
fsub {v}.2d, {v}.2d, {v}.2d = sub(f64x2, f64x2) -> f64x2
fmul {v}.2d, {v}.2d, {v}.2d = mul(f64x2, f64x2) -> f64x2
fdiv {v}.2d, {v}.2d, {v}.2d = div(f64x2, f64x2) -> f64x2
fmin {v}.2d, {v}.2d, {v}.2d = min(f64x2, f64x2) -> f64x2
fmax {v}.2d, {v}.2d, {v}.2d = max(f64x2, f64x2) -> f64x2
fsqrt {v}.2d, {v}.2d = sqrt(f64x2) -> f64x2
fneg {v}.2d, {v}.2d = neg(f64x2) -> f64x2
fabs {v}.2d, {v}.2d = abs(f64x2) -> f64x2
fma(f64x2, f64x2, f64x2) -> f64x2 with t: f64x2
    mov t.16b, c.16b
    fmla t.2d, a.2d, b.2d
    mov r.16b, t.16b
eq(f64x2, f64x2) -> u1x2 with t: u1x2
    fcmeq t.2d, a.2d, b.2d
    neg r.2d, t.2d
gt(f64x2, f64x2) -> u1x2 with t: u1x2
    fcmgt t.2d, a.2d, b.2d
    neg r.2d, t.2d
ge(f64x2, f64x2) -> u1x2 with t: u1x2
    fcmge t.2d, a.2d, b.2d
    neg r.2d, t.2d
lt(f64x2, f64x2) -> u1x2 with t: u1x2
    fcmgt t.2d, b.2d, a.2d
    neg r.2d, t.2d
le(f64x2, f64x2) -> u1x2 with t: u1x2
    fcmge t.2d, b.2d, a.2d
    neg r.2d, t.2d
ne(f64x2, f64x2) -> u1x2 with t: u1x2
    fcmeq t.2d, a.2d, b.2d
    mvn t.16b, t.16b
    neg r.2d, t.2d
scvtf {v}.2d, {v}.2d = conv(i64x2) -> f64x2
ucvtf {v}.2d, {v}.2d = conv(u64x2) -> f64x2
fcvtzs {v}.2d, {v}.2d = conv(f64x2) -> i64x2
fcvtzu {v}.2d, {v}.2d = conv(f64x2) -> u64x2

; --- f32x2 ---
fadd {v}.2s, {v}.2s, {v}.2s = add(f32x2, f32x2) -> f32x2
fsub {v}.2s, {v}.2s, {v}.2s = sub(f32x2, f32x2) -> f32x2
fmul {v}.2s, {v}.2s, {v}.2s = mul(f32x2, f32x2) -> f32x2
fdiv {v}.2s, {v}.2s, {v}.2s = div(f32x2, f32x2) -> f32x2
fmin {v}.2s, {v}.2s, {v}.2s = min(f32x2, f32x2) -> f32x2
fmax {v}.2s, {v}.2s, {v}.2s = max(f32x2, f32x2) -> f32x2
fsqrt {v}.2s, {v}.2s = sqrt(f32x2) -> f32x2
fneg {v}.2s, {v}.2s = neg(f32x2) -> f32x2
fabs {v}.2s, {v}.2s = abs(f32x2) -> f32x2
fma(f32x2, f32x2, f32x2) -> f32x2 with t: f32x2
    mov t.16b, c.16b
    fmla t.2s, a.2s, b.2s
    mov r.16b, t.16b
eq(f32x2, f32x2) -> u1x2 with t: u1x2
    fcmeq t.2s, a.2s, b.2s
    sshll t.2d, t.2s, #0
    neg r.2d, t.2d
gt(f32x2, f32x2) -> u1x2 with t: u1x2
    fcmgt t.2s, a.2s, b.2s
    sshll t.2d, t.2s, #0
    neg r.2d, t.2d
ge(f32x2, f32x2) -> u1x2 with t: u1x2
    fcmge t.2s, a.2s, b.2s
    sshll t.2d, t.2s, #0
    neg r.2d, t.2d
lt(f32x2, f32x2) -> u1x2 with t: u1x2
    fcmgt t.2s, b.2s, a.2s
    sshll t.2d, t.2s, #0
    neg r.2d, t.2d
le(f32x2, f32x2) -> u1x2 with t: u1x2
    fcmge t.2s, b.2s, a.2s
    sshll t.2d, t.2s, #0
    neg r.2d, t.2d
ne(f32x2, f32x2) -> u1x2 with t: u1x2
    fcmeq t.2s, a.2s, b.2s
    mvn t.16b, t.16b
    sshll t.2d, t.2s, #0
    neg r.2d, t.2d
scvtf {v}.2s, {v}.2s = conv(i32x2) -> f32x2
ucvtf {v}.2s, {v}.2s = conv(u32x2) -> f32x2
fcvtzs {v}.2s, {v}.2s = conv(f32x2) -> i32x2
fcvtzu {v}.2s, {v}.2s = conv(f32x2) -> u32x2

; --- i32x4 ---
add {v}.4s, {v}.4s, {v}.4s = add(i32x4, i32x4) -> i32x4
sub {v}.4s, {v}.4s, {v}.4s = sub(i32x4, i32x4) -> i32x4
and {v}.16b, {v}.16b, {v}.16b = and(i32x4, i32x4) -> i32x4
orr {v}.16b, {v}.16b, {v}.16b = or(i32x4, i32x4) -> i32x4
eor {v}.16b, {v}.16b, {v}.16b = xor(i32x4, i32x4) -> i32x4
mul {v}.4s, {v}.4s, {v}.4s = mul(i32x4, i32x4) -> i32x4
sshl {v}.4s, {v}.4s, {v}.4s = shl(i32x4, i32x4) -> i32x4
shr(i32x4, i32x4) -> i32x4 with t: i32x4
    neg t.4s, b.4s
    sshl r.4s, a.4s, t.4s
eq(i32x4, i32x4) -> u1x4 with t: u1x4
    cmeq t.4s, a.4s, b.4s
    neg r.4s, t.4s
gt(i32x4, i32x4) -> u1x4 with t: u1x4
    cmgt t.4s, a.4s, b.4s
    neg r.4s, t.4s
ge(i32x4, i32x4) -> u1x4 with t: u1x4
    cmge t.4s, a.4s, b.4s
    neg r.4s, t.4s
lt(i32x4, i32x4) -> u1x4 with t: u1x4
    cmgt t.4s, b.4s, a.4s
    neg r.4s, t.4s
le(i32x4, i32x4) -> u1x4 with t: u1x4
    cmge t.4s, b.4s, a.4s
    neg r.4s, t.4s
ne(i32x4, i32x4) -> u1x4 with t: u1x4
    cmeq t.4s, a.4s, b.4s
    mvn t.16b, t.16b
    neg r.4s, t.4s

; --- u32x4 ---
add {v}.4s, {v}.4s, {v}.4s = add(u32x4, u32x4) -> u32x4
sub {v}.4s, {v}.4s, {v}.4s = sub(u32x4, u32x4) -> u32x4
and {v}.16b, {v}.16b, {v}.16b = and(u32x4, u32x4) -> u32x4
orr {v}.16b, {v}.16b, {v}.16b = or(u32x4, u32x4) -> u32x4
eor {v}.16b, {v}.16b, {v}.16b = xor(u32x4, u32x4) -> u32x4
mul {v}.4s, {v}.4s, {v}.4s = mul(u32x4, u32x4) -> u32x4
sshl {v}.4s, {v}.4s, {v}.4s = shl(u32x4, u32x4) -> u32x4
shr(u32x4, u32x4) -> u32x4 with t: u32x4
    neg t.4s, b.4s
    ushl r.4s, a.4s, t.4s
eq(u32x4, u32x4) -> u1x4 with t: u1x4
    cmeq t.4s, a.4s, b.4s
    neg r.4s, t.4s
gt(u32x4, u32x4) -> u1x4 with t: u1x4
    cmhi t.4s, a.4s, b.4s
    neg r.4s, t.4s
ge(u32x4, u32x4) -> u1x4 with t: u1x4
    cmhs t.4s, a.4s, b.4s
    neg r.4s, t.4s
lt(u32x4, u32x4) -> u1x4 with t: u1x4
    cmhi t.4s, b.4s, a.4s
    neg r.4s, t.4s
le(u32x4, u32x4) -> u1x4 with t: u1x4
    cmhs t.4s, b.4s, a.4s
    neg r.4s, t.4s
ne(u32x4, u32x4) -> u1x4 with t: u1x4
    cmeq t.4s, a.4s, b.4s
    mvn t.16b, t.16b
    neg r.4s, t.4s

; --- i64x2 ---
