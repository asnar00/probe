    cmeq t.16b, a.16b, b.16b
    mvn t.16b, t.16b
    neg r.16b, t.16b

; --- u8x16 ---
add {v}.16b, {v}.16b, {v}.16b = add(u8x16, u8x16) -> u8x16
sub {v}.16b, {v}.16b, {v}.16b = sub(u8x16, u8x16) -> u8x16
and {v}.16b, {v}.16b, {v}.16b = and(u8x16, u8x16) -> u8x16
orr {v}.16b, {v}.16b, {v}.16b = or(u8x16, u8x16) -> u8x16
eor {v}.16b, {v}.16b, {v}.16b = xor(u8x16, u8x16) -> u8x16
mul {v}.16b, {v}.16b, {v}.16b = mul(u8x16, u8x16) -> u8x16
sshl {v}.16b, {v}.16b, {v}.16b = shl(u8x16, u8x16) -> u8x16
shr(u8x16, u8x16) -> u8x16 with t: u8x16
    neg t.16b, b.16b
    ushl r.16b, a.16b, t.16b
eq(u8x16, u8x16) -> u1x16 with t: u1x16
    cmeq t.16b, a.16b, b.16b
    neg r.16b, t.16b
gt(u8x16, u8x16) -> u1x16 with t: u1x16
    cmhi t.16b, a.16b, b.16b
    neg r.16b, t.16b
ge(u8x16, u8x16) -> u1x16 with t: u1x16
    cmhs t.16b, a.16b, b.16b
    neg r.16b, t.16b
lt(u8x16, u8x16) -> u1x16 with t: u1x16
    cmhi t.16b, b.16b, a.16b
    neg r.16b, t.16b
le(u8x16, u8x16) -> u1x16 with t: u1x16
    cmhs t.16b, b.16b, a.16b
    neg r.16b, t.16b
ne(u8x16, u8x16) -> u1x16 with t: u1x16
    cmeq t.16b, a.16b, b.16b
    mvn t.16b, t.16b
    neg r.16b, t.16b

; --- widening and narrowing between lane widths, and the floats' ---
sshll {v}.2d, {v}.2s, #0 = conv(i32x2) -> i64x2
xtn {v}.2s, {v}.2d = conv(i64x2) -> i32x2
ushll {v}.2d, {v}.2s, #0 = conv(u32x2) -> u64x2
xtn {v}.2s, {v}.2d = conv(u64x2) -> u32x2
sshll {v}.4s, {v}.4h, #0 = conv(i16x4) -> i32x4
xtn {v}.4h, {v}.4s = conv(i32x4) -> i16x4
ushll {v}.4s, {v}.4h, #0 = conv(u16x4) -> u32x4
xtn {v}.4h, {v}.4s = conv(u32x4) -> u16x4
sshll {v}.8h, {v}.8b, #0 = conv(i8x8) -> i16x8
xtn {v}.8b, {v}.8h = conv(i16x8) -> i8x8
ushll {v}.8h, {v}.8b, #0 = conv(u8x8) -> u16x8
xtn {v}.8b, {v}.8h = conv(u16x8) -> u8x8
fcvtl {v}.2d, {v}.2s = conv(f32x2) -> f64x2
fcvtn {v}.2s, {v}.2d = conv(f64x2) -> f32x2

; --- integer min, max, abs, neg (lib/int.ssa) over vectors ---
smin {v}.4s, {v}.4s, {v}.4s = min(i32x4, i32x4) -> i32x4
smax {v}.4s, {v}.4s, {v}.4s = max(i32x4, i32x4) -> i32x4
abs {v}.4s, {v}.4s = abs(i32x4) -> i32x4
neg {v}.4s, {v}.4s = neg(i32x4) -> i32x4
umin {v}.4s, {v}.4s, {v}.4s = min(u32x4, u32x4) -> u32x4
umax {v}.4s, {v}.4s, {v}.4s = max(u32x4, u32x4) -> u32x4
abs {v}.2d, {v}.2d = abs(i64x2) -> i64x2
neg {v}.2d, {v}.2d = neg(i64x2) -> i64x2
smin {v}.2s, {v}.2s, {v}.2s = min(i32x2, i32x2) -> i32x2
smax {v}.2s, {v}.2s, {v}.2s = max(i32x2, i32x2) -> i32x2
abs {v}.2s, {v}.2s = abs(i32x2) -> i32x2
neg {v}.2s, {v}.2s = neg(i32x2) -> i32x2
umin {v}.2s, {v}.2s, {v}.2s = min(u32x2, u32x2) -> u32x2
umax {v}.2s, {v}.2s, {v}.2s = max(u32x2, u32x2) -> u32x2
smin {v}.4h, {v}.4h, {v}.4h = min(i16x4, i16x4) -> i16x4
smax {v}.4h, {v}.4h, {v}.4h = max(i16x4, i16x4) -> i16x4
abs {v}.4h, {v}.4h = abs(i16x4) -> i16x4
neg {v}.4h, {v}.4h = neg(i16x4) -> i16x4
umin {v}.4h, {v}.4h, {v}.4h = min(u16x4, u16x4) -> u16x4
umax {v}.4h, {v}.4h, {v}.4h = max(u16x4, u16x4) -> u16x4
smin {v}.8b, {v}.8b, {v}.8b = min(i8x8, i8x8) -> i8x8
smax {v}.8b, {v}.8b, {v}.8b = max(i8x8, i8x8) -> i8x8
abs {v}.8b, {v}.8b = abs(i8x8) -> i8x8
neg {v}.8b, {v}.8b = neg(i8x8) -> i8x8
umin {v}.8b, {v}.8b, {v}.8b = min(u8x8, u8x8) -> u8x8
umax {v}.8b, {v}.8b, {v}.8b = max(u8x8, u8x8) -> u8x8
smin {v}.8h, {v}.8h, {v}.8h = min(i16x8, i16x8) -> i16x8
smax {v}.8h, {v}.8h, {v}.8h = max(i16x8, i16x8) -> i16x8
abs {v}.8h, {v}.8h = abs(i16x8) -> i16x8
neg {v}.8h, {v}.8h = neg(i16x8) -> i16x8
umin {v}.8h, {v}.8h, {v}.8h = min(u16x8, u16x8) -> u16x8
umax {v}.8h, {v}.8h, {v}.8h = max(u16x8, u16x8) -> u16x8
smin {v}.16b, {v}.16b, {v}.16b = min(i8x16, i8x16) -> i8x16
smax {v}.16b, {v}.16b, {v}.16b = max(i8x16, i8x16) -> i8x16
abs {v}.16b, {v}.16b = abs(i8x16) -> i8x16
neg {v}.16b, {v}.16b = neg(i8x16) -> i8x16
umin {v}.16b, {v}.16b, {v}.16b = min(u8x16, u8x16) -> u8x16
umax {v}.16b, {v}.16b, {v}.16b = max(u8x16, u8x16) -> u8x16

; --- across the lanes (lib/reduce.ssa): a reduction into lane 0, read
; out; pairwise where there is no reduction (two lanes; f32x4's sum, in
; the tree's order) ---
sum(f32x4) -> f32 with t: f32x4
    faddp t.4s, a.4s, a.4s
    faddp r, t.2s
max(f32x4) -> f32
    fmaxv r, a.4s
min(f32x4) -> f32
    fminv r, a.4s
sum(f64x2) -> f64
    faddp r, a.2d
max(f64x2) -> f64
    fmaxp r, a.2d
min(f64x2) -> f64
    fminp r, a.2d
sum(f32x2) -> f32
    faddp r, a.2s
max(f32x2) -> f32
    fmaxp r, a.2s
min(f32x2) -> f32
    fminp r, a.2s
sum(i32x4) -> i32 with t: i32x4
    addv t, a.4s
    umov r, t.s[0]
min(i32x4) -> i32 with t: i32x4
    sminv t, a.4s
    umov r, t.s[0]
max(i32x4) -> i32 with t: i32x4
    smaxv t, a.4s
    umov r, t.s[0]
sum(u32x4) -> u32 with t: u32x4
    addv t, a.4s
    umov r, t.s[0]
min(u32x4) -> u32 with t: u32x4
    uminv t, a.4s
    umov r, t.s[0]
max(u32x4) -> u32 with t: u32x4
    umaxv t, a.4s
    umov r, t.s[0]
sum(i64x2) -> i64 with t: i64x2
    addp t, a.2d
    umov r, t.d[0]
sum(u64x2) -> u64 with t: u64x2
    addp t, a.2d
    umov r, t.d[0]
sum(i32x2) -> i32 with t: i32x2
    addp t.2s, a.2s, a.2s
    umov r, t.s[0]
min(i32x2) -> i32 with t: i32x2
    sminp t.2s, a.2s, a.2s
    umov r, t.s[0]
max(i32x2) -> i32 with t: i32x2
    smaxp t.2s, a.2s, a.2s
    umov r, t.s[0]
sum(u32x2) -> u32 with t: u32x2
    addp t.2s, a.2s, a.2s
    umov r, t.s[0]
min(u32x2) -> u32 with t: u32x2
    uminp t.2s, a.2s, a.2s
    umov r, t.s[0]
max(u32x2) -> u32 with t: u32x2
    umaxp t.2s, a.2s, a.2s
    umov r, t.s[0]
sum(i16x4) -> i16 with t: i16x4
    addv t, a.4h
    smov r, t.h[0]
min(i16x4) -> i16 with t: i16x4
    sminv t, a.4h
    smov r, t.h[0]
max(i16x4) -> i16 with t: i16x4
    smaxv t, a.4h
    smov r, t.h[0]
sum(u16x4) -> u16 with t: u16x4
    addv t, a.4h
    umov r, t.h[0]
min(u16x4) -> u16 with t: u16x4
    uminv t, a.4h
    umov r, t.h[0]
max(u16x4) -> u16 with t: u16x4
    umaxv t, a.4h
    umov r, t.h[0]
sum(i8x8) -> i8 with t: i8x8
    addv t, a.8b
    smov r, t.b[0]
min(i8x8) -> i8 with t: i8x8
    sminv t, a.8b
    smov r, t.b[0]
max(i8x8) -> i8 with t: i8x8
    smaxv t, a.8b
    smov r, t.b[0]
sum(u8x8) -> u8 with t: u8x8
    addv t, a.8b
    umov r, t.b[0]
min(u8x8) -> u8 with t: u8x8
    uminv t, a.8b
    umov r, t.b[0]
max(u8x8) -> u8 with t: u8x8
    umaxv t, a.8b
    umov r, t.b[0]
sum(i16x8) -> i16 with t: i16x8
    addv t, a.8h
    smov r, t.h[0]
min(i16x8) -> i16 with t: i16x8
    sminv t, a.8h
    smov r, t.h[0]
max(i16x8) -> i16 with t: i16x8
    smaxv t, a.8h
    smov r, t.h[0]
sum(u16x8) -> u16 with t: u16x8
    addv t, a.8h
    umov r, t.h[0]
min(u16x8) -> u16 with t: u16x8
    uminv t, a.8h
    umov r, t.h[0]
max(u16x8) -> u16 with t: u16x8
    umaxv t, a.8h
    umov r, t.h[0]
sum(i8x16) -> i8 with t: i8x16
    addv t, a.16b
    smov r, t.b[0]
min(i8x16) -> i8 with t: i8x16
    sminv t, a.16b
    smov r, t.b[0]
max(i8x16) -> i8 with t: i8x16
    smaxv t, a.16b
    smov r, t.b[0]
sum(u8x16) -> u8 with t: u8x16
    addv t, a.16b
    umov r, t.b[0]
min(u8x16) -> u8 with t: u8x16
    uminv t, a.16b
    umov r, t.b[0]
max(u8x16) -> u8 with t: u8x16
    umaxv t, a.16b
    umov r, t.b[0]
all(u1x2) -> u1 with t: u1x2
    xtn t.2s, a.2d
    uminp t.2s, t.2s, t.2s
    umov r, t.s[0]
any(u1x2) -> u1 with t: u1x2
    xtn t.2s, a.2d
    umaxp t.2s, t.2s, t.2s
    umov r, t.s[0]
all(u1x4) -> u1 with t: u1x4
    uminv t, a.4s
    umov r, t.s[0]
any(u1x4) -> u1 with t: u1x4
    umaxv t, a.4s
    umov r, t.s[0]
all(u1x8) -> u1 with t: u1x8
    uminv t, a.8h
    umov r, t.h[0]
any(u1x8) -> u1 with t: u1x8
    umaxv t, a.8h
    umov r, t.h[0]
all(u1x16) -> u1 with t: u1x16
    uminv t, a.16b
    umov r, t.b[0]
any(u1x16) -> u1 with t: u1x16
    umaxv t, a.16b
    umov r, t.b[0]

; --- a cast between vectors of one shape: the same bits ---
mov {v}.16b, {v}.16b = cast(i16x4) -> u16x4
mov {v}.16b, {v}.16b = cast(u16x4) -> i16x4
mov {v}.16b, {v}.16b = cast(f32x4) -> i32x4
mov {v}.16b, {v}.16b = cast(f32x4) -> u32x4
mov {v}.16b, {v}.16b = cast(i32x4) -> f32x4
mov {v}.16b, {v}.16b = cast(i32x4) -> u32x4
mov {v}.16b, {v}.16b = cast(u32x4) -> f32x4
mov {v}.16b, {v}.16b = cast(u32x4) -> i32x4
mov {v}.16b, {v}.16b = cast(f32x2) -> i32x2
mov {v}.16b, {v}.16b = cast(f32x2) -> u32x2
mov {v}.16b, {v}.16b = cast(i32x2) -> f32x2
mov {v}.16b, {v}.16b = cast(i32x2) -> u32x2
mov {v}.16b, {v}.16b = cast(u32x2) -> f32x2
mov {v}.16b, {v}.16b = cast(u32x2) -> i32x2
mov {v}.16b, {v}.16b = cast(f64x2) -> i64x2
mov {v}.16b, {v}.16b = cast(f64x2) -> u64x2
mov {v}.16b, {v}.16b = cast(i64x2) -> f64x2
mov {v}.16b, {v}.16b = cast(i64x2) -> u64x2
mov {v}.16b, {v}.16b = cast(u64x2) -> f64x2
mov {v}.16b, {v}.16b = cast(u64x2) -> i64x2
mov {v}.16b, {v}.16b = cast(i8x8) -> u8x8
mov {v}.16b, {v}.16b = cast(u8x8) -> i8x8
mov {v}.16b, {v}.16b = cast(i16x8) -> u16x8
mov {v}.16b, {v}.16b = cast(u16x8) -> i16x8
mov {v}.16b, {v}.16b = cast(i8x16) -> u8x16
mov {v}.16b, {v}.16b = cast(u8x16) -> i8x16

; --- u1xN: the lanes 0 or 1 ---
and {v}.16b, {v}.16b, {v}.16b = and(u1x2, u1x2) -> u1x2
orr {v}.16b, {v}.16b, {v}.16b = or(u1x2, u1x2) -> u1x2
eor {v}.16b, {v}.16b, {v}.16b = xor(u1x2, u1x2) -> u1x2
and {v}.16b, {v}.16b, {v}.16b = and(u1x4, u1x4) -> u1x4
orr {v}.16b, {v}.16b, {v}.16b = or(u1x4, u1x4) -> u1x4
eor {v}.16b, {v}.16b, {v}.16b = xor(u1x4, u1x4) -> u1x4
and {v}.16b, {v}.16b, {v}.16b = and(u1x8, u1x8) -> u1x8
orr {v}.16b, {v}.16b, {v}.16b = or(u1x8, u1x8) -> u1x8
eor {v}.16b, {v}.16b, {v}.16b = xor(u1x8, u1x8) -> u1x8
and {v}.16b, {v}.16b, {v}.16b = and(u1x16, u1x16) -> u1x16
orr {v}.16b, {v}.16b, {v}.16b = or(u1x16, u1x16) -> u1x16
eor {v}.16b, {v}.16b, {v}.16b = xor(u1x16, u1x16) -> u1x16

; fibres: a stack switch. Saves the callee-saved registers and sp
; where `save` points (13 words: x19..x28, x29, x30, sp), loads the
; other set from `to`, and the return goes where that set's x30 says.
; A fibre that has never run is a frame whose x30 is its entry and
; whose sp is the top of its stack (lib/fibre.ssa).
ext fibres
const fibre_lr = 88
const fibre_sp = 96
const fibre_stacks = 1
fibre_switch(save: ptr, to: ptr) -> () with t: ptr called
    str x19, [save, 0]
    str x20, [save, 8]
    str x21, [save, 16]
    str x22, [save, 24]
    str x23, [save, 32]
    str x24, [save, 40]
    str x25, [save, 48]
    str x26, [save, 56]
    str x27, [save, 64]
    str x28, [save, 72]
    str x29, [save, 80]
    str x30, [save, 88]
    add t, sp, 0
    str t, [save, 96]
    ldr x19, [to, 0]
    ldr x20, [to, 8]
    ldr x21, [to, 16]
    ldr x22, [to, 24]
    ldr x23, [to, 32]
    ldr x24, [to, 40]
    ldr x25, [to, 48]
    ldr x26, [to, 56]
    ldr x27, [to, 64]
    ldr x28, [to, 72]
    ldr x29, [to, 80]
    ldr x30, [to, 88]
    ldr t, [to, 96]
    mov sp, t

; the current thread's key: tpidrro_el0, which macOS keeps unique per
; thread and cannot be written from user space (tpidr_el0 is the
; kernel's, rewritten at every context switch), and which is zero at
; boot. lib/thread.ssa maps the key to the thread's block.
ext thread
thread_key() -> ptr
    mrs r, tpidrro_el0

; cores: a secondary core is off until PSCI CPU_ON (hvc: x0 the call,
; x1 the target core, x2 where it starts, x3 a word it starts with)
; and starts with the MMU off and no stack. `core_boot` is where: x0
; is the record lib/core.ssa built — its stack top at 0, its main at
; 8, and its key for `thread()` at 24 — so it sets sp and tpidrro_el0
; and jumps to main with the record in x0. `core_ram` is RAM for a
; core's block and stacks, 1 MB each, beyond the heap.
ext cores
const core_ram = 0x46000000
core_boot() -> () with t: ptr called
    ldr t, [x0, 0]
    mov sp, t
    ldr t, [x0, 24]
    msr tpidrro_el0, t
    ldr t, [x0, 8]
    br t
core_start(core: i64, entry: ptr, rec: ptr) -> () called
    mov x3, x2
    mov x2, x1
    mov x1, x0
    movz x0, 3
    movk x0, 0xC400, lsl 16
    hvc 0
core_idle() -> ()
    wfi
