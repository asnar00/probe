; targets/arm64.platform — the library instances this target computes
; with its own instructions. A rule is a signature — the generic, its
; width arguments, its parameter and result types, exactly as the library
; instantiates it — then the learned templates that compute it. a, b, c
; are the arguments and r the result, in integer registers (a float is
; its bits); s0/s1/s2 and d0/d1/d2 are scratch float registers (v16..v18,
; caller-saved, never allocated); anything else is a literal for an
; immediate or condition slot. Each line must resolve to a template the
; learner verified: `fmov s0, a` with a 32-bit `a` is `fmov {s}, {w}`.
;
; The rules name the nearest-even instances (round = 0), which is what
; the instructions compute; other rounding modes stay in the library.
; The library remains the reference: --soft compiles with no rules and
; the two must agree (probe testfloat checks both against TestFloat).

; --- arithmetic ---

add(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: float(8, 23)
    fmov s0, a
    fmov s1, b
    fadd s0, s0, s1
    fmov r, s0

sub(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: float(8, 23)
    fmov s0, a
    fmov s1, b
    fsub s0, s0, s1
    fmov r, s0

mul(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: float(8, 23)
    fmov s0, a
    fmov s1, b
    fmul s0, s0, s1
    fmov r, s0

div(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: float(8, 23)
    fmov s0, a
    fmov s1, b
    fdiv s0, s0, s1
    fmov r, s0

sqrt(8, 23, 0)(a: float(8, 23)) -> r: float(8, 23)
    fmov s0, a
    fsqrt s0, s0
    fmov r, s0

neg(8, 23, 0)(a: float(8, 23)) -> r: float(8, 23)
    fmov s0, a
    fneg s0, s0
    fmov r, s0

abs(8, 23, 0)(a: float(8, 23)) -> r: float(8, 23)
    fmov s0, a
    fabs s0, s0
    fmov r, s0

min(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: float(8, 23)
    fmov s0, a
    fmov s1, b
    fmin s0, s0, s1
    fmov r, s0

max(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: float(8, 23)
    fmov s0, a
    fmov s1, b
    fmax s0, s0, s1
    fmov r, s0

fma(8, 23, 0)(a: float(8, 23), b: float(8, 23), c: float(8, 23)) -> r: float(8, 23)
    fmov s0, a
    fmov s1, b
    fmov s2, c
    fmadd s0, s0, s1, s2
    fmov r, s0

add(11, 52, 0)(a: float(11, 52), b: float(11, 52)) -> r: float(11, 52)
    fmov d0, a
    fmov d1, b
    fadd d0, d0, d1
    fmov r, d0

sub(11, 52, 0)(a: float(11, 52), b: float(11, 52)) -> r: float(11, 52)
    fmov d0, a
    fmov d1, b
    fsub d0, d0, d1
    fmov r, d0

mul(11, 52, 0)(a: float(11, 52), b: float(11, 52)) -> r: float(11, 52)
    fmov d0, a
    fmov d1, b
    fmul d0, d0, d1
    fmov r, d0

div(11, 52, 0)(a: float(11, 52), b: float(11, 52)) -> r: float(11, 52)
    fmov d0, a
    fmov d1, b
    fdiv d0, d0, d1
    fmov r, d0

sqrt(11, 52, 0)(a: float(11, 52)) -> r: float(11, 52)
    fmov d0, a
    fsqrt d0, d0
    fmov r, d0

neg(11, 52, 0)(a: float(11, 52)) -> r: float(11, 52)
    fmov d0, a
    fneg d0, d0
    fmov r, d0

abs(11, 52, 0)(a: float(11, 52)) -> r: float(11, 52)
    fmov d0, a
    fabs d0, d0
    fmov r, d0

min(11, 52, 0)(a: float(11, 52), b: float(11, 52)) -> r: float(11, 52)
    fmov d0, a
    fmov d1, b
    fmin d0, d0, d1
    fmov r, d0

max(11, 52, 0)(a: float(11, 52), b: float(11, 52)) -> r: float(11, 52)
    fmov d0, a
    fmov d1, b
    fmax d0, d0, d1
    fmov r, d0

fma(11, 52, 0)(a: float(11, 52), b: float(11, 52), c: float(11, 52)) -> r: float(11, 52)
    fmov d0, a
    fmov d1, b
    fmov d2, c
    fmadd d0, d0, d1, d2
    fmov r, d0

; --- comparison: fcmp sets NZCV, and these conditions read it as IEEE
; wants (unordered compares false, except ne) ---

eq(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: u1
    fmov s0, a
    fmov s1, b
    fcmp s0, s1
    cset r, eq

ne(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: u1
    fmov s0, a
    fmov s1, b
    fcmp s0, s1
    cset r, ne

lt(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: u1
    fmov s0, a
    fmov s1, b
    fcmp s0, s1
    cset r, lo

le(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: u1
    fmov s0, a
    fmov s1, b
    fcmp s0, s1
    cset r, ls

gt(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: u1
    fmov s0, a
    fmov s1, b
    fcmp s0, s1
    cset r, gt

ge(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: u1
    fmov s0, a
    fmov s1, b
    fcmp s0, s1
    cset r, ge

eq(11, 52, 0)(a: float(11, 52), b: float(11, 52)) -> r: u1
    fmov d0, a
    fmov d1, b
    fcmp d0, d1
    cset r, eq

ne(11, 52, 0)(a: float(11, 52), b: float(11, 52)) -> r: u1
    fmov d0, a
    fmov d1, b
    fcmp d0, d1
    cset r, ne

lt(11, 52, 0)(a: float(11, 52), b: float(11, 52)) -> r: u1
    fmov d0, a
    fmov d1, b
    fcmp d0, d1
    cset r, lo

le(11, 52, 0)(a: float(11, 52), b: float(11, 52)) -> r: u1
    fmov d0, a
    fmov d1, b
    fcmp d0, d1
    cset r, ls

gt(11, 52, 0)(a: float(11, 52), b: float(11, 52)) -> r: u1
    fmov d0, a
    fmov d1, b
    fcmp d0, d1
    cset r, gt

ge(11, 52, 0)(a: float(11, 52), b: float(11, 52)) -> r: u1
    fmov d0, a
    fmov d1, b
    fcmp d0, d1
    cset r, ge

; --- conversion: float to float, integer to float (rounded), float to
; integer (toward zero, saturating, NaN to 0 — fcvtz's own rules, which
; are the library's) ---

conv(8, 23, 11, 52, 0)(a: float(8, 23)) -> r: float(11, 52)
    fmov s0, a
    fcvt d0, s0
    fmov r, d0

conv(11, 52, 8, 23, 0)(a: float(11, 52)) -> r: float(8, 23)
    fmov d0, a
    fcvt s0, d0
    fmov r, s0

conv(32, 8, 23, 0)(a: i32) -> r: float(8, 23)
    scvtf s0, a
    fmov r, s0

conv(32, 11, 52, 0)(a: i32) -> r: float(11, 52)
    scvtf d0, a
    fmov r, d0

conv(32, 8, 23, 0)(a: u32) -> r: float(8, 23)
    ucvtf s0, a
    fmov r, s0

conv(32, 11, 52, 0)(a: u32) -> r: float(11, 52)
    ucvtf d0, a
    fmov r, d0

conv(64, 8, 23, 0)(a: i64) -> r: float(8, 23)
    scvtf s0, a
    fmov r, s0

conv(64, 11, 52, 0)(a: i64) -> r: float(11, 52)
    scvtf d0, a
    fmov r, d0

conv(64, 8, 23, 0)(a: u64) -> r: float(8, 23)
    ucvtf s0, a
    fmov r, s0

conv(64, 11, 52, 0)(a: u64) -> r: float(11, 52)
    ucvtf d0, a
    fmov r, d0

conv(8, 23, 32)(a: float(8, 23)) -> r: i32
    fmov s0, a
    fcvtzs r, s0

conv(8, 23, 32)(a: float(8, 23)) -> r: u32
    fmov s0, a
    fcvtzu r, s0

conv(8, 23, 64)(a: float(8, 23)) -> r: i64
    fmov s0, a
    fcvtzs r, s0

conv(8, 23, 64)(a: float(8, 23)) -> r: u64
    fmov s0, a
    fcvtzu r, s0

conv(11, 52, 32)(a: float(11, 52)) -> r: i32
    fmov d0, a
    fcvtzs r, d0

conv(11, 52, 32)(a: float(11, 52)) -> r: u32
    fmov d0, a
    fcvtzu r, d0

conv(11, 52, 64)(a: float(11, 52)) -> r: i64
    fmov d0, a
    fcvtzs r, d0

conv(11, 52, 64)(a: float(11, 52)) -> r: u64
    fmov d0, a
    fcvtzu r, d0
