inst ushll {v}.8h, {v}.8b, #0
inst xtn {v}.8b, {v}.8h
inst fcvtl {v}.2d, {v}.2s
inst fcvtn {v}.2s, {v}.2d
inst dup {v}.8b, {w}
inst dup {v}.4h, {w}
inst dup {v}.2s, {w}
