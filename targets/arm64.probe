inst abs {v}.8b, {v}.8b
inst abs {v}.16b, {v}.16b
inst abs {v}.4h, {v}.4h
inst abs {v}.8h, {v}.8h
inst abs {v}.2s, {v}.2s
inst abs {v}.4s, {v}.4s
inst abs {v}.2d, {v}.2d
inst mov {v}.16b, {v}.16b
inst sshll {v}.2d, {v}.2s, #0
inst ushll {v}.2d, {v}.2s, #0
inst xtn {v}.2s, {v}.2d
inst sshll {v}.4s, {v}.4h, #0
inst ushll {v}.4s, {v}.4h, #0
