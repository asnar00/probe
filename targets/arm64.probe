; AArch64 probe seed.
; Registers x31/w31 mean sp or zr depending on context, so classes stop at 30.

triple arm64
width 4

reg x = x0..x30
reg w = w0..w30
reg s = s0..s31
reg d = d0..d31
reg v = v0..v31
reg q = q0..q31
reg h = h0..h31
reg b = b0..b31

; --- three-register ALU ---
inst add {x}, {x}, {x}
inst sub {x}, {x}, {x}
inst and {x}, {x}, {x}
inst orr {x}, {x}, {x}
inst eor {x}, {x}, {x}
inst mul {x}, {x}, {x}
inst sdiv {x}, {x}, {x}
inst udiv {x}, {x}, {x}
inst lsl {x}, {x}, {x}
inst lsr {x}, {x}, {x}
inst asr {x}, {x}, {x}
inst add {w}, {w}, {w}
inst sub {w}, {w}, {w}
inst mul {w}, {w}, {w}

; 4-register: needed for srem/urem (r = a - (a/b)*b)
inst msub {x}, {x}, {x}, {x}
inst madd {x}, {x}, {x}, {x}

; --- immediates ---
inst add {x}, {x}, #{i 0..4095}
inst sub {x}, {x}, #{i 0..4095}
inst movz {x}, #{i 0..65535}
inst movz {x}, #{i 0..65535}, lsl #16
inst movz {x}, #{i 0..65535}, lsl #32
inst movz {x}, #{i 0..65535}, lsl #48
inst movk {x}, #{i 0..65535}
inst movk {x}, #{i 0..65535}, lsl #16
inst movk {x}, #{i 0..65535}, lsl #32
inst movk {x}, #{i 0..65535}, lsl #48
inst movn {x}, #{i 0..65535}
; the address of a data item, relative to the instruction
inst adr {x}, #{i -1048576..1048575}

; shift-by-constant: alias of ubfm/sbfm with a nonlinear encoding —
; expect these to be learned as lookup tables, not linear fields
inst lsl {x}, {x}, #{i 0..63}
inst lsr {x}, {x}, #{i 0..63}
inst asr {x}, {x}, #{i 0..63}

; logical immediate: famously nonlinear (immr/imms run-length encoding).
; kept here deliberately — the learner should FAIL it honestly.
inst orr {x}, {x}, #{i 0..4095}

; --- compare and conditionals ---
inst cmp {x}, {x}
inst cmp {x}, #{i 0..4095}
inst cset {x}, {e eq|ne|lt|le|gt|ge|lo|ls|hi|hs}
inst csel {x}, {x}, {x}, {e eq|ne|lt|le|gt|ge|lo|ls|hi|hs}

; --- extends (for sext/zext/trunc) ---
inst sxtw {x}, {w}
inst sxtb {w}, {w}
inst sxth {w}, {w}
inst uxtb {w}, {w}
inst uxth {w}, {w}
inst mov {w}, {w}
inst mov {x}, {x}

; --- memory (scaled unsigned offset, and register offset) ---
inst ldr {x}, [{x}, #{i 0..32760 /8}]
inst str {x}, [{x}, #{i 0..32760 /8}]
inst ldr {w}, [{x}, #{i 0..16380 /4}]
inst str {w}, [{x}, #{i 0..16380 /4}]
inst ldr {x}, [{x}, {x}]
inst str {x}, [{x}, {x}]
inst ldrsw {x}, [{x}, #{i 0..16380 /4}]
inst ldr {w}, [{x}, {x}]

; --- branches (pc-relative, signed offsets) ---
inst b #{i -134217728..134217724 /4}
inst bl #{i -134217728..134217724 /4}
inst b.{e eq|ne|lt|le|gt|ge|lo|ls|hi|hs} #{i -1048576..1048572 /4}
inst cbz {x}, #{i -1048576..1048572 /4}
inst cbnz {x}, #{i -1048576..1048572 /4}
inst ret
inst ret {x}
inst br {x}
inst blr {x}

; --- 32-bit (w) forms: needed for every i32 SSA op ---
inst and {w}, {w}, {w}
inst orr {w}, {w}, {w}
inst eor {w}, {w}, {w}
inst sdiv {w}, {w}, {w}
inst udiv {w}, {w}, {w}
inst lsl {w}, {w}, {w}
inst lsr {w}, {w}, {w}
inst asr {w}, {w}, {w}
inst msub {w}, {w}, {w}, {w}
inst madd {w}, {w}, {w}, {w}
inst add {w}, {w}, #{i 0..4095}
inst sub {w}, {w}, #{i 0..4095}
inst movz {w}, #{i 0..65535}
inst movz {w}, #{i 0..65535}, lsl #16
inst movk {w}, #{i 0..65535}
inst movk {w}, #{i 0..65535}, lsl #16
inst movn {w}, #{i 0..65535}
inst cmp {w}, {w}
inst cmp {w}, #{i 0..4095}
inst cset {w}, {e eq|ne|lt|le|gt|ge|lo|ls|hi|hs}
inst csel {w}, {w}, {w}, {e eq|ne|lt|le|gt|ge|lo|ls|hi|hs}
inst cbz {w}, #{i -1048576..1048572 /4}
inst cbnz {w}, #{i -1048576..1048572 /4}

; --- bitfield moves: the machinery behind every narrow type ---
; sbfm/ubfm with raw immr/imms are linear (the sbfx/ubfx/bfi aliases fold
; lsb+width into imms, which is not); the emitter computes the raw fields.
; sbfm #0,#N-1 sign-extends an N-bit value, ubfm #0,#N-1 zero-extends,
; ubfm #lsb,#lsb+w-1 extracts a field, bfm #(-lsb mod size),#w-1 inserts one.
inst sbfm {w}, {w}, #{i 0..31}, #{i 0..31}
inst ubfm {w}, {w}, #{i 0..31}, #{i 0..31}
inst bfm {w}, {w}, #{i 0..31}, #{i 0..31}
inst sbfm {x}, {x}, #{i 0..63}, #{i 0..63}
inst ubfm {x}, {x}, #{i 0..63}, #{i 0..63}
inst bfm {x}, {x}, #{i 0..63}, #{i 0..63}

; --- byte and halfword memory (8/16-bit types, sign- or zero-extending) ---
inst ldrb {w}, [{x}, #{i 0..4095}]
inst ldrsb {w}, [{x}, #{i 0..4095}]
inst ldrh {w}, [{x}, #{i 0..8190 /2}]
inst ldrsh {w}, [{x}, #{i 0..8190 /2}]
inst strb {w}, [{x}, #{i 0..4095}]
inst strh {w}, [{x}, #{i 0..8190 /2}]

; --- stack and frame machinery (spills, prologue/epilogue) ---
; sp isn't in the x class (encoding 31 means sp/zr by context), so it
; appears literally in these templates
inst add sp, sp, #{i 0..4095}
inst sub sp, sp, #{i 0..4095}
; the address of a frame's scratch area
inst add {x}, sp, #{i 0..4095}
inst str {x}, [sp, #{i 0..32760 /8}]
inst ldr {x}, [sp, #{i 0..32760 /8}]
inst str {w}, [sp, #{i 0..16380 /4}]
inst ldr {w}, [sp, #{i 0..16380 /4}]
inst stp {x}, {x}, [sp, #{i -512..504 /8}]
inst ldp {x}, {x}, [sp, #{i -512..504 /8}]
inst mov x29, sp
inst mov sp, x29

; --- floating point: the platform's native fadd, and moves in and out of
; the integer registers our values live in ---
inst fadd {s}, {s}, {s}
inst fsub {s}, {s}, {s}
inst fmul {s}, {s}, {s}
inst fdiv {s}, {s}, {s}
inst fadd {d}, {d}, {d}
inst fsub {d}, {d}, {d}
inst fmul {d}, {d}, {d}
inst fdiv {d}, {d}, {d}
inst fsqrt {s}, {s}
inst fsqrt {d}, {d}
inst fneg {s}, {s}
inst fneg {d}, {d}
inst fabs {s}, {s}
inst fabs {d}, {d}
; min/max propagate NaN and order -0 below +0 (IEEE minimum/maximum);
; fmadd is a*b + c with one rounding
inst fmin {s}, {s}, {s}
inst fmax {s}, {s}, {s}
inst fmin {d}, {d}, {d}
inst fmax {d}, {d}, {d}
inst fmadd {s}, {s}, {s}, {s}
inst fmadd {d}, {d}, {d}, {d}
; compare sets NZCV; cset with lo/ls/gt/ge/eq/ne reads it as IEEE wants
; (unordered is false for all but ne)
inst fcmp {s}, {s}
inst fcmp {d}, {d}
; conversions: between the two float widths, and to and from integers
; (round to nearest for int -> float, truncate toward zero, saturating,
; for float -> int)
inst fcvt {d}, {s}
inst fcvt {s}, {d}
inst scvtf {s}, {w}
inst scvtf {s}, {x}
inst scvtf {d}, {w}
inst scvtf {d}, {x}
inst ucvtf {s}, {w}
inst ucvtf {s}, {x}
inst ucvtf {d}, {w}
inst ucvtf {d}, {x}
inst fcvtzs {w}, {s}
inst fcvtzs {x}, {s}
inst fcvtzs {w}, {d}
inst fcvtzs {x}, {d}
inst fcvtzu {w}, {s}
inst fcvtzu {x}, {s}
inst fcvtzu {w}, {d}
inst fcvtzu {x}, {d}
inst fmov {s}, {w}
inst fmov {w}, {s}
; float values live in s/d registers of their own: register moves, and
; spills and reloads of the whole 64-bit register
inst fmov {s}, {s}
inst fmov {d}, {d}
inst str {d}, [sp, #{i 0..32760 /8}]
inst ldr {d}, [sp, #{i 0..32760 /8}]
inst fmov {d}, {x}
inst fmov {x}, {d}
; enabling the FPU on bare metal (cpacr_el1.FPEN), and the barrier after
inst msr cpacr_el1, {x}
inst isb

; --- hypervisor call: the qemu bare-metal harness exits via PSCI ---
inst hvc #{i 0..65535}

; --- traps at EL1: the vector table base, the syndrome and return
; address of the exception taken, the return from it, and a supervisor
; call to take one on purpose ---
inst msr vbar_el1, {x}
inst mrs {x}, esr_el1
inst mrs {x}, elr_el1
inst msr elr_el1, {x}
inst eret
inst svc #{i 0..65535}

; --- interrupts and the generic timer: the counter and its frequency,
; the EL1 physical timer's compare value and control, the interrupt
; mask bits of PSTATE, and waiting for an interrupt ---
inst mrs {x}, cntpct_el0
inst mrs {x}, cntfrq_el0
inst msr cntp_cval_el0, {x}
inst msr cntp_ctl_el0, {x}
inst msr daifclr, #{i 0..15}
; the read-only thread id register: unique per thread under macOS, zero at boot
inst mrs {x}, tpidrro_el0
inst msr tpidrro_el0, {x}
inst msr daifset, #{i 0..15}
inst wfi
; switching stacks: an interrupt handler that returns the frame to resume
inst mov sp, {x}
; a failed check: a breakpoint exception (ESR_EL1.EC = 0x3c)
inst brk #{i 0..65535}

; --- NEON: vectors of 64 or 128 bits — lanes of 8, 16, 32 or 64 bits
; (.8b/.16b, .4h/.8h, .2s/.4s, .2d) in the same file as the floats. The
; rules in targets/arm64.platform take a vector operation whole where
; the library defines it lane by lane ---
inst fadd {v}.2s, {v}.2s, {v}.2s
inst fsub {v}.2s, {v}.2s, {v}.2s
inst fmul {v}.2s, {v}.2s, {v}.2s
inst fdiv {v}.2s, {v}.2s, {v}.2s
inst fmin {v}.2s, {v}.2s, {v}.2s
inst fmax {v}.2s, {v}.2s, {v}.2s
inst fmla {v}.2s, {v}.2s, {v}.2s
inst fcmeq {v}.2s, {v}.2s, {v}.2s
inst fcmgt {v}.2s, {v}.2s, {v}.2s
inst fcmge {v}.2s, {v}.2s, {v}.2s
inst fsqrt {v}.2s, {v}.2s
inst fneg {v}.2s, {v}.2s
inst fabs {v}.2s, {v}.2s
inst scvtf {v}.2s, {v}.2s
inst ucvtf {v}.2s, {v}.2s
inst fcvtzs {v}.2s, {v}.2s
inst fcvtzu {v}.2s, {v}.2s
inst fadd {v}.4s, {v}.4s, {v}.4s
inst fsub {v}.4s, {v}.4s, {v}.4s
inst fmul {v}.4s, {v}.4s, {v}.4s
inst fdiv {v}.4s, {v}.4s, {v}.4s
inst fmin {v}.4s, {v}.4s, {v}.4s
inst fmax {v}.4s, {v}.4s, {v}.4s
inst fmla {v}.4s, {v}.4s, {v}.4s
inst fcmeq {v}.4s, {v}.4s, {v}.4s
inst fcmgt {v}.4s, {v}.4s, {v}.4s
inst fcmge {v}.4s, {v}.4s, {v}.4s
inst fsqrt {v}.4s, {v}.4s
inst fneg {v}.4s, {v}.4s
inst fabs {v}.4s, {v}.4s
inst scvtf {v}.4s, {v}.4s
inst ucvtf {v}.4s, {v}.4s
inst fcvtzs {v}.4s, {v}.4s
inst fcvtzu {v}.4s, {v}.4s
inst fadd {v}.2d, {v}.2d, {v}.2d
inst fsub {v}.2d, {v}.2d, {v}.2d
inst fmul {v}.2d, {v}.2d, {v}.2d
inst fdiv {v}.2d, {v}.2d, {v}.2d
inst fmin {v}.2d, {v}.2d, {v}.2d
inst fmax {v}.2d, {v}.2d, {v}.2d
inst fmla {v}.2d, {v}.2d, {v}.2d
inst fcmeq {v}.2d, {v}.2d, {v}.2d
inst fcmgt {v}.2d, {v}.2d, {v}.2d
inst fcmge {v}.2d, {v}.2d, {v}.2d
inst fsqrt {v}.2d, {v}.2d
inst fneg {v}.2d, {v}.2d
inst fabs {v}.2d, {v}.2d
inst scvtf {v}.2d, {v}.2d
inst ucvtf {v}.2d, {v}.2d
inst fcvtzs {v}.2d, {v}.2d
inst fcvtzu {v}.2d, {v}.2d
inst add {v}.8b, {v}.8b, {v}.8b
inst sub {v}.8b, {v}.8b, {v}.8b
inst cmeq {v}.8b, {v}.8b, {v}.8b
inst cmgt {v}.8b, {v}.8b, {v}.8b
inst cmge {v}.8b, {v}.8b, {v}.8b
inst cmhi {v}.8b, {v}.8b, {v}.8b
inst cmhs {v}.8b, {v}.8b, {v}.8b
inst sshl {v}.8b, {v}.8b, {v}.8b
inst ushl {v}.8b, {v}.8b, {v}.8b
inst neg {v}.8b, {v}.8b
inst mul {v}.8b, {v}.8b, {v}.8b
inst add {v}.4h, {v}.4h, {v}.4h
inst sub {v}.4h, {v}.4h, {v}.4h
inst cmeq {v}.4h, {v}.4h, {v}.4h
inst cmgt {v}.4h, {v}.4h, {v}.4h
inst cmge {v}.4h, {v}.4h, {v}.4h
inst cmhi {v}.4h, {v}.4h, {v}.4h
inst cmhs {v}.4h, {v}.4h, {v}.4h
inst sshl {v}.4h, {v}.4h, {v}.4h
inst ushl {v}.4h, {v}.4h, {v}.4h
inst neg {v}.4h, {v}.4h
inst mul {v}.4h, {v}.4h, {v}.4h
inst add {v}.2s, {v}.2s, {v}.2s
inst sub {v}.2s, {v}.2s, {v}.2s
inst cmeq {v}.2s, {v}.2s, {v}.2s
inst cmgt {v}.2s, {v}.2s, {v}.2s
inst cmge {v}.2s, {v}.2s, {v}.2s
inst cmhi {v}.2s, {v}.2s, {v}.2s
inst cmhs {v}.2s, {v}.2s, {v}.2s
inst sshl {v}.2s, {v}.2s, {v}.2s
inst ushl {v}.2s, {v}.2s, {v}.2s
inst neg {v}.2s, {v}.2s
inst mul {v}.2s, {v}.2s, {v}.2s
inst add {v}.16b, {v}.16b, {v}.16b
inst sub {v}.16b, {v}.16b, {v}.16b
inst cmeq {v}.16b, {v}.16b, {v}.16b
inst cmgt {v}.16b, {v}.16b, {v}.16b
inst cmge {v}.16b, {v}.16b, {v}.16b
inst cmhi {v}.16b, {v}.16b, {v}.16b
inst cmhs {v}.16b, {v}.16b, {v}.16b
inst sshl {v}.16b, {v}.16b, {v}.16b
inst ushl {v}.16b, {v}.16b, {v}.16b
inst neg {v}.16b, {v}.16b
inst mul {v}.16b, {v}.16b, {v}.16b
inst add {v}.8h, {v}.8h, {v}.8h
inst sub {v}.8h, {v}.8h, {v}.8h
inst cmeq {v}.8h, {v}.8h, {v}.8h
inst cmgt {v}.8h, {v}.8h, {v}.8h
inst cmge {v}.8h, {v}.8h, {v}.8h
inst cmhi {v}.8h, {v}.8h, {v}.8h
inst cmhs {v}.8h, {v}.8h, {v}.8h
inst sshl {v}.8h, {v}.8h, {v}.8h
inst ushl {v}.8h, {v}.8h, {v}.8h
