inst sub {v}.4s, {v}.4s, {v}.4s
inst cmeq {v}.4s, {v}.4s, {v}.4s
inst cmgt {v}.4s, {v}.4s, {v}.4s
inst cmge {v}.4s, {v}.4s, {v}.4s
inst cmhi {v}.4s, {v}.4s, {v}.4s
inst cmhs {v}.4s, {v}.4s, {v}.4s
inst sshl {v}.4s, {v}.4s, {v}.4s
inst ushl {v}.4s, {v}.4s, {v}.4s
inst neg {v}.4s, {v}.4s
inst mul {v}.4s, {v}.4s, {v}.4s
inst add {v}.2d, {v}.2d, {v}.2d
inst sub {v}.2d, {v}.2d, {v}.2d
inst cmeq {v}.2d, {v}.2d, {v}.2d
inst cmgt {v}.2d, {v}.2d, {v}.2d
inst cmge {v}.2d, {v}.2d, {v}.2d
inst cmhi {v}.2d, {v}.2d, {v}.2d
inst cmhs {v}.2d, {v}.2d, {v}.2d
inst sshl {v}.2d, {v}.2d, {v}.2d
inst ushl {v}.2d, {v}.2d, {v}.2d
