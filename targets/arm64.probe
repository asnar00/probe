inst smov {w}, {v}.b[{i 0..15}]
inst smov {w}, {v}.h[{i 0..7}]
inst fmov {x}, {v}.d[1]
inst fmov {v}.d[1], {x}
; a vector in memory is aligned only to its lanes (ssa.md: a struct of
; lanes at their natural offsets), and with the MMU off an access must
; be aligned to its size: ld1/st1 access lane by lane. The q forms are
; for the stack, which is 16-aligned
inst ld1 {{{v}.8b}}, [{x}]
inst st1 {{{v}.8b}}, [{x}]
inst ld1 {{{v}.4h}}, [{x}]
inst st1 {{{v}.4h}}, [{x}]
inst ld1 {{{v}.2s}}, [{x}]
inst st1 {{{v}.2s}}, [{x}]
inst ld1 {{{v}.16b}}, [{x}]
inst st1 {{{v}.16b}}, [{x}]
inst ld1 {{{v}.8h}}, [{x}]
inst st1 {{{v}.8h}}, [{x}]
inst ld1 {{{v}.4s}}, [{x}]
inst st1 {{{v}.4s}}, [{x}]
inst ld1 {{{v}.2d}}, [{x}]
inst st1 {{{v}.2d}}, [{x}]
; one lane to and from memory: a u1x4 or u1x2 mask is 4 or 2 bytes there
inst ld1 {{{v}.s}}[0], [{x}]
inst st1 {{{v}.s}}[0], [{x}]
inst ld1 {{{v}.h}}[0], [{x}]
inst st1 {{{v}.h}}[0], [{x}]
inst ldr {q}, [sp, #{i 0..65520 /16}]
inst str {q}, [sp, #{i 0..65520 /16}]
