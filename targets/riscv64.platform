lt(i64x2, i64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmslt.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
le(i64x2, i64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmsle.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
gt(i64x2, i64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmslt.vv v0, b, a
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
ge(i64x2, i64x2) -> u1x2 with t: u1x2
