; targets/riscv64.platform — what this target computes with its own
; instructions (see targets/arm64.platform for the form). Both float
; widths share the f register file; a 32-bit value in it is NaN-boxed.
;
; Not here, deliberately: min/max (fmin/fmax return the number when one
; operand is NaN; the library returns NaN) and float-to-integer (fcvt.w.s
; gives the maximum integer for NaN; the library gives 0). Those stay in
; the library.

class f = f32, f64

; --- arithmetic ---
fadd.s {f}, {f}, {f} = add(f32, f32) -> f32
fsub.s {f}, {f}, {f} = sub(f32, f32) -> f32
fmul.s {f}, {f}, {f} = mul(f32, f32) -> f32
fdiv.s {f}, {f}, {f} = div(f32, f32) -> f32
fsqrt.s {f}, {f} = sqrt(f32) -> f32
fneg.s {f}, {f} = neg(f32) -> f32
fabs.s {f}, {f} = abs(f32) -> f32
fmadd.s {f}, {f}, {f}, {f} = fma(f32, f32, f32) -> f32

fadd.d {f}, {f}, {f} = add(f64, f64) -> f64
fsub.d {f}, {f}, {f} = sub(f64, f64) -> f64
fmul.d {f}, {f}, {f} = mul(f64, f64) -> f64
fdiv.d {f}, {f}, {f} = div(f64, f64) -> f64
fsqrt.d {f}, {f} = sqrt(f64) -> f64
fneg.d {f}, {f} = neg(f64) -> f64
fabs.d {f}, {f} = abs(f64) -> f64
fmadd.d {f}, {f}, {f}, {f} = fma(f64, f64, f64) -> f64

; --- comparison: feq/flt/fle give 0 for unordered; ne is not eq, and
; gt/ge are lt/le with the operands swapped ---
feq.s {r}, {f}, {f} = eq(f32, f32) -> u1
ne(f32, f32) -> u1
    feq.s r, a, b
    xori r, r, 1
flt.s {r}, {f}, {f} = lt(f32, f32) -> u1
fle.s {r}, {f}, {f} = le(f32, f32) -> u1
gt(f32, f32) -> u1
    flt.s r, b, a
ge(f32, f32) -> u1
    fle.s r, b, a

feq.d {r}, {f}, {f} = eq(f64, f64) -> u1
ne(f64, f64) -> u1
    feq.d r, a, b
    xori r, r, 1
flt.d {r}, {f}, {f} = lt(f64, f64) -> u1
fle.d {r}, {f}, {f} = le(f64, f64) -> u1
gt(f64, f64) -> u1
    flt.d r, b, a
ge(f64, f64) -> u1
    fle.d r, b, a

; --- conversion: float to float, integer to float ---
fcvt.d.s {f}, {f} = conv(f32) -> f64
fcvt.s.d {f}, {f} = conv(f64) -> f32
fcvt.s.w {f}, {r} = conv(i32) -> f32
fcvt.d.w {f}, {r} = conv(i32) -> f64
fcvt.s.wu {f}, {r} = conv(u32) -> f32
fcvt.d.wu {f}, {r} = conv(u32) -> f64
fcvt.s.l {f}, {r} = conv(i64) -> f32
fcvt.d.l {f}, {r} = conv(i64) -> f64
fcvt.s.lu {f}, {r} = conv(u64) -> f32
fcvt.d.lu {f}, {r} = conv(u64) -> f64
