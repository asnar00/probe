; --- u64x2 ---
add(u64x2, u64x2) -> u64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vadd.vv r, a, b
sub(u64x2, u64x2) -> u64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vsub.vv r, a, b
mul(u64x2, u64x2) -> u64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmul.vv r, a, b
and(u64x2, u64x2) -> u64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vand.vv r, a, b
or(u64x2, u64x2) -> u64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vor.vv r, a, b
xor(u64x2, u64x2) -> u64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vxor.vv r, a, b
shl(u64x2, u64x2) -> u64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vsll.vv r, a, b
shr(u64x2, u64x2) -> u64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vsrl.vv r, a, b
eq(u64x2, u64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmseq.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
ne(u64x2, u64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmsne.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
lt(u64x2, u64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmsltu.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
le(u64x2, u64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmsleu.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
gt(u64x2, u64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmsltu.vv v0, b, a
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
ge(u64x2, u64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmsleu.vv v0, b, a
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0

; --- a cast between vectors of one width: the same bits ---
vmv1r.v {v}, {v} = cast(i32x4) -> u32x4
vmv1r.v {v}, {v} = cast(u32x4) -> i32x4
vmv1r.v {v}, {v} = cast(f32x4) -> u32x4
vmv1r.v {v}, {v} = cast(u32x4) -> f32x4
vmv1r.v {v}, {v} = cast(f32x4) -> i32x4
vmv1r.v {v}, {v} = cast(i32x4) -> f32x4
vmv1r.v {v}, {v} = cast(i64x2) -> u64x2
vmv1r.v {v}, {v} = cast(u64x2) -> i64x2
vmv1r.v {v}, {v} = cast(f64x2) -> u64x2
vmv1r.v {v}, {v} = cast(u64x2) -> f64x2
vmv1r.v {v}, {v} = cast(f64x2) -> i64x2
vmv1r.v {v}, {v} = cast(i64x2) -> f64x2

; --- u1x4, u1x2: the lanes 0 or 1 ---
and(u1x4, u1x4) -> u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vand.vv r, a, b
or(u1x4, u1x4) -> u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vor.vv r, a, b
xor(u1x4, u1x4) -> u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vxor.vv r, a, b
and(u1x2, u1x2) -> u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vand.vv r, a, b
or(u1x2, u1x2) -> u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vor.vv r, a, b
xor(u1x2, u1x2) -> u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vxor.vv r, a, b

; fibres: a stack switch (see targets/arm64.platform). The saved set
; is s0..s11 (x8, x9, x18..x27), ra (x1) and sp (x2): 14 words.
ext fibres
const fibre_lr = 96
const fibre_sp = 104
const fibre_stacks = 1
fibre_switch(save: ptr, to: ptr) -> () called
    sd x8, 0(save)
    sd x9, 8(save)
    sd x18, 16(save)
    sd x19, 24(save)
    sd x20, 32(save)
    sd x21, 40(save)
    sd x22, 48(save)
    sd x23, 56(save)
    sd x24, 64(save)
    sd x25, 72(save)
    sd x26, 80(save)
    sd x27, 88(save)
    sd x1, 96(save)
    sd x2, 104(save)
    ld x8, 0(to)
    ld x9, 8(to)
    ld x18, 16(to)
    ld x19, 24(to)
    ld x20, 32(to)
    ld x21, 40(to)
    ld x22, 48(to)
    ld x23, 56(to)
    ld x24, 64(to)
    ld x25, 72(to)
    ld x26, 80(to)
    ld x27, 88(to)
    ld x1, 96(to)
    ld x2, 104(to)

; the current thread's key: tp (x4), zero at boot
ext thread
thread_key() -> ptr
    addi r, x4, 0

; cores: every hart runs the reset vector; the boot preamble parks
; harts other than 0 until a record for them appears in the mailbox
; (`core_mailbox`, a word per hart) and an interrupt (CLINT msip)
; wakes them, then sets sp and tp from it and jumps to its main.
; `core_start` puts the record there and rings the bell; the entry is
; the preamble's business here. `core_ram` as on arm64.
ext cores
const core_mailbox = 0x80FF0000
const core_ram = 0x86000000
core_start(core: i64, entry: ptr, rec: ptr) -> () with a: ptr, b: ptr, c: ptr called
    addi a, x0, 128
    slli a, a, 24
    lui b, 4080
    add a, a, b
    slli b, x10, 3
    add a, a, b
    sd x12, 0(a)
    lui b, 8192
    slli c, x10, 2
    add b, b, c
    addi c, x0, 1
    sw c, 0(b)
core_idle() -> ()
    wfi
