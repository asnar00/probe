; targets/riscv64.platform — what this target computes with its own
; instructions (see targets/arm64.platform for the form). Both float
; widths share the f register file; a 32-bit value in it is NaN-boxed.
;
; Not here, deliberately: min/max (fmin/fmax return the number when one
; operand is NaN; the library returns NaN) and float-to-integer (fcvt.w.s
; gives the maximum integer for NaN; the library gives 0). Those stay in
; the library.
;
; Variants: the groups are the RISC-V extensions — M (integer multiply
; and divide, which the emitters otherwise assume), F (f32), D (f64).
; `targets/rv64im.platform` is this target without F and D, `rv64i`
; without M as well; on those the missing operations are the library's.

target riscv64

; the qemu virt board: a 16550 UART, and the test finisher that ends
; the machine (store 0x5555 for exit code 0)
ext virt
const uart = 0x10000000
const finisher = 0x100000
; the machine's memory: 128 MB from 0x80000000; the image is at the
; bottom, the boot stack 8 MB up (probe boot's preamble), and what
; is above that is a program's to carve — its heap
const heap_base = 0x80800000
const ram_end = 0x88000000
; the UART's receive side: the line status register, its "data ready"
; bit, and that bit's value when a byte is waiting
const uart_status = 5
const uart_ready_mask = 1
const uart_ready = 1
; an environment call leaves the return address on itself: skip 4
const resume_skip = 4
; mcause of an environment call from M-mode, and of a failed `check`
; (a breakpoint)
const trap_syscall = 11
const trap_check = 3

; traps in M-mode. `probe boot` lays a 16-entry vector table (one
; jump each) in the 64 bytes before __trap's entry — entry 0 for
; exceptions, the rest for interrupts by cause — so mtvec (0x305)
; takes the entry less 64, in vectored mode (low bit 1); mcause is
; 0x342, mepc 0x341
ext traps
vectors(t: ptr) -> ()
    addi t, t, -64
    ori t, t, 1
    csrw 0x305, t
cause() -> u64
    csrr r, 0x342
resume() -> ptr
    csrr r, 0x341
resume_at(p: ptr) -> ()
    csrw 0x341, p
syscall(n: u64, a: u64, b: u64) -> u64
    ecall

; interrupts and time on the virt board: the counter is the `time` CSR
; (0xc01), the CLINT's mtime, at 10 MHz; the timer interrupt fires
; when mtime reaches mtimecmp (0x02004000 for hart 0) and is cleared by
; moving mtimecmp; enabling it is mie.MTIE (bit 7) and mstatus.MIE (bit
; 3); mcause's low bits say which interrupt (7: the machine timer)
ext time
const irq_timer = 7
; the machine software interrupt: a task asking to be rescheduled
; raises it by writing the CLINT's msip (0x02000000); taking it needs
; mie.MSIE (bit 3), and finishing it clears msip
const irq_soft = 3
; device interrupts arrive as one cause, external (11), and the PLIC
; (0x0c000000) says which source: the UART is source 10. A program
; that sees irq_external asks irq_claim for the source, and irq_done
; completes it
const irq_external = 11
const irq_uart = 10
now() -> u64
    csrr r, 0xc01
hz() -> u64
    lui r, 0x989
    addi r, r, 0x680
; arming the timer also enables its interrupt (mie.MTIE), as arm64's
; timer control does; irq_on leaves it alone, since mtimecmp resets to
; zero and an enabled, unarmed timer fires at once
timer_at(t: u64) -> () with base: ptr, bits: u64
    lui base, 0x2004
    sd t, 0(base)
    lui bits, 0
    addi bits, bits, 128
    csrs 0x304, bits
timer_off() -> () with base: ptr, never: u64
    lui base, 0x2004
    lui never, 0
    addi never, never, -1
    sd never, 0(base)
irq_on() -> () with bits: u64
    lui bits, 0
    addi bits, bits, 1024
    add bits, bits, bits
    addi bits, bits, 8
    csrs 0x304, bits
    lui bits, 0
    addi bits, bits, 8
    csrs 0x300, bits
; the UART's receive interrupt: the device's enable (IER, offset 1),
; then the PLIC's priority for source 10 (offset 4 * 10), its enable
; bit for hart 0's M-mode context (0x0c002000), and that context's
; threshold (0x0c200000) at zero
uart_irq_on() -> () with base: ptr, v: u32
    lui base, 0x10000
    lui v, 0
    addi v, v, 1
    sb v, 1(base)
    lui base, 0xc000
    sw v, 40(base)
    lui base, 0xc002
    lui v, 0
    addi v, v, 1024
    sw v, 0(base)
    lui base, 0xc200
    lui v, 0
    sw v, 0(base)
irq_claim() -> u32 with base: ptr
    lui base, 0xc200
    lwu r, 4(base)
irq_ack() -> u32
    csrr r, 0x342
    andi r, r, 255
irq_done(id: u32) -> () with base: ptr, zero: u32
    lui base, 0x2000
    lui zero, 0
    sw zero, 0(base)
    lui base, 0xc200
    sw id, 4(base)
reschedule() -> () with base: ptr, one: u32
    lui base, 0x2000
    lui one, 0
    addi one, one, 1
    sw one, 0(base)
idle() -> ()
    wfi

ext M
builtin mul, div, rem

ext F
class f = f32

; --- arithmetic ---
fadd.s {f}, {f}, {f} = add(f32, f32) -> f32
fsub.s {f}, {f}, {f} = sub(f32, f32) -> f32
fmul.s {f}, {f}, {f} = mul(f32, f32) -> f32
fdiv.s {f}, {f}, {f} = div(f32, f32) -> f32
fsqrt.s {f}, {f} = sqrt(f32) -> f32
fneg.s {f}, {f} = neg(f32) -> f32
fabs.s {f}, {f} = abs(f32) -> f32
fmadd.s {f}, {f}, {f}, {f} = fma(f32, f32, f32) -> f32

feq.s {r}, {f}, {f} = eq(f32, f32) -> u1
ne(f32, f32) -> u1
    feq.s r, a, b
    xori r, r, 1
flt.s {r}, {f}, {f} = lt(f32, f32) -> u1
fle.s {r}, {f}, {f} = le(f32, f32) -> u1
gt(f32, f32) -> u1
    flt.s r, b, a
ge(f32, f32) -> u1
    fle.s r, b, a

fcvt.s.w {f}, {r} = conv(i32) -> f32
fcvt.s.wu {f}, {r} = conv(u32) -> f32
fcvt.s.l {f}, {r} = conv(i64) -> f32
fcvt.s.lu {f}, {r} = conv(u64) -> f32

ext D
class f = f64
fadd.d {f}, {f}, {f} = add(f64, f64) -> f64
fsub.d {f}, {f}, {f} = sub(f64, f64) -> f64
fmul.d {f}, {f}, {f} = mul(f64, f64) -> f64
fdiv.d {f}, {f}, {f} = div(f64, f64) -> f64
fsqrt.d {f}, {f} = sqrt(f64) -> f64
fneg.d {f}, {f} = neg(f64) -> f64
fabs.d {f}, {f} = abs(f64) -> f64
fmadd.d {f}, {f}, {f}, {f} = fma(f64, f64, f64) -> f64

; --- comparison: feq/flt/fle give 0 for unordered; ne is not eq, and
; gt/ge are lt/le with the operands swapped ---
feq.d {r}, {f}, {f} = eq(f64, f64) -> u1
ne(f64, f64) -> u1
    feq.d r, a, b
    xori r, r, 1
flt.d {r}, {f}, {f} = lt(f64, f64) -> u1
fle.d {r}, {f}, {f} = le(f64, f64) -> u1
gt(f64, f64) -> u1
    flt.d r, b, a
ge(f64, f64) -> u1
    fle.d r, b, a

; --- conversion: float to float, integer to float ---
fcvt.d.s {f}, {f} = conv(f32) -> f64
fcvt.s.d {f}, {f} = conv(f64) -> f32
fcvt.d.w {f}, {r} = conv(i32) -> f64
fcvt.d.wu {f}, {r} = conv(u32) -> f64
fcvt.d.l {f}, {r} = conv(i64) -> f64
fcvt.d.lu {f}, {r} = conv(u64) -> f64

; V: 128-bit vectors — four f32 or i32 lanes (e32, vl 4), two f64 or
; i64 lanes (e64, vl 2) — the types below in a class of their own, and
; a rule per operation the library defines lane by lane. Every rule
; sets the vtype it runs under first (vsetivli: the one piece of
; machine state a rule carries, set by whoever needs it); the emitter
; does the same before its own lane moves and loads. A comparison
; leaves its mask in v0 and merges 1 over 0 into the result, so a
; `u1xN` holds each lane as 0 or 1. Not here, as for scalars: min/max
; and float-to-integer (the NaN cases differ from the library's).
; targets/riscv64-nov.platform is this target without them.
ext V
class v = f32x4, f64x2, i32x4, u32x4, i64x2, u64x2, u1x4, u1x2


; --- f32x4 ---
add(f32x4, f32x4) -> f32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vfadd.vv r, a, b
sub(f32x4, f32x4) -> f32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vfsub.vv r, a, b
mul(f32x4, f32x4) -> f32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vfmul.vv r, a, b
div(f32x4, f32x4) -> f32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vfdiv.vv r, a, b
sqrt(f32x4) -> f32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vfsqrt.v r, a
neg(f32x4) -> f32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vfsgnjn.vv r, a, a
abs(f32x4) -> f32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vfsgnjx.vv r, a, a
fma(f32x4, f32x4, f32x4) -> f32x4 with t: f32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmv1r.v t, c
    vfmacc.vv t, a, b
    vmv1r.v r, t
eq(f32x4, f32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmfeq.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
ne(f32x4, f32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmfne.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
lt(f32x4, f32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmflt.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
le(f32x4, f32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmfle.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
gt(f32x4, f32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmflt.vv v0, b, a
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
ge(f32x4, f32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmfle.vv v0, b, a
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0

; --- f64x2 ---
add(f64x2, f64x2) -> f64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vfadd.vv r, a, b
sub(f64x2, f64x2) -> f64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vfsub.vv r, a, b
mul(f64x2, f64x2) -> f64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vfmul.vv r, a, b
div(f64x2, f64x2) -> f64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vfdiv.vv r, a, b
sqrt(f64x2) -> f64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vfsqrt.v r, a
neg(f64x2) -> f64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vfsgnjn.vv r, a, a
abs(f64x2) -> f64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vfsgnjx.vv r, a, a
fma(f64x2, f64x2, f64x2) -> f64x2 with t: f64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmv1r.v t, c
    vfmacc.vv t, a, b
    vmv1r.v r, t
eq(f64x2, f64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmfeq.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
ne(f64x2, f64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmfne.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
lt(f64x2, f64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmflt.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
le(f64x2, f64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmfle.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
gt(f64x2, f64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmflt.vv v0, b, a
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
ge(f64x2, f64x2) -> u1x2 with t: u1x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmfle.vv v0, b, a
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
conv(i32x4) -> f32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vfcvt.f.x.v r, a
conv(u32x4) -> f32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vfcvt.f.xu.v r, a

; --- i32x4 ---
add(i32x4, i32x4) -> i32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vadd.vv r, a, b
sub(i32x4, i32x4) -> i32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vsub.vv r, a, b
mul(i32x4, i32x4) -> i32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmul.vv r, a, b
and(i32x4, i32x4) -> i32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vand.vv r, a, b
or(i32x4, i32x4) -> i32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vor.vv r, a, b
xor(i32x4, i32x4) -> i32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vxor.vv r, a, b
shl(i32x4, i32x4) -> i32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vsll.vv r, a, b
shr(i32x4, i32x4) -> i32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vsra.vv r, a, b
eq(i32x4, i32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmseq.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
ne(i32x4, i32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmsne.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
lt(i32x4, i32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmslt.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
le(i32x4, i32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmsle.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
gt(i32x4, i32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmslt.vv v0, b, a
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
ge(i32x4, i32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmsle.vv v0, b, a
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0

; --- u32x4 ---
add(u32x4, u32x4) -> u32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vadd.vv r, a, b
sub(u32x4, u32x4) -> u32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vsub.vv r, a, b
mul(u32x4, u32x4) -> u32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmul.vv r, a, b
and(u32x4, u32x4) -> u32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vand.vv r, a, b
or(u32x4, u32x4) -> u32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vor.vv r, a, b
xor(u32x4, u32x4) -> u32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vxor.vv r, a, b
shl(u32x4, u32x4) -> u32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vsll.vv r, a, b
shr(u32x4, u32x4) -> u32x4
    vsetivli x0, 4, e32, m1, ta, ma
    vsrl.vv r, a, b
eq(u32x4, u32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmseq.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
ne(u32x4, u32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmsne.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
lt(u32x4, u32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmsltu.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
le(u32x4, u32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmsleu.vv v0, a, b
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
gt(u32x4, u32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmsltu.vv v0, b, a
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
ge(u32x4, u32x4) -> u1x4 with t: u1x4
    vsetivli x0, 4, e32, m1, ta, ma
    vmsleu.vv v0, b, a
    vmv.v.i t, 0
    vmerge.vim r, t, 1, v0
conv(i64x2) -> f64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vfcvt.f.x.v r, a
conv(u64x2) -> f64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vfcvt.f.xu.v r, a

; --- i64x2 ---
add(i64x2, i64x2) -> i64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vadd.vv r, a, b
sub(i64x2, i64x2) -> i64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vsub.vv r, a, b
mul(i64x2, i64x2) -> i64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vmul.vv r, a, b
and(i64x2, i64x2) -> i64x2
    vsetivli x0, 2, e64, m1, ta, ma
    vand.vv r, a, b
or(i64x2, i64x2) -> i64x2
    vsetivli x0, 2, e64, m1, ta, ma
