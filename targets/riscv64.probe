; RISC-V RV64IM probe seed — mainly here to prove the learner is
; target-agnostic. B-type and J-type immediates are famously scrambled
; across the encoding; the per-bit learner should handle them unchanged.

triple riscv64
attr +m,+f,+d,+v
width 4

reg r = x0..x31
reg f = f0..f31
reg v = v0..v31
; the destination of an instruction that reads the mask v0 may not be v0
reg vn = v1..v31

inst add {r}, {r}, {r}
inst sub {r}, {r}, {r}
inst and {r}, {r}, {r}
inst or {r}, {r}, {r}
inst xor {r}, {r}, {r}
inst sll {r}, {r}, {r}
inst srl {r}, {r}, {r}
inst sra {r}, {r}, {r}
inst mul {r}, {r}, {r}
inst div {r}, {r}, {r}
inst divu {r}, {r}, {r}
inst rem {r}, {r}, {r}
inst remu {r}, {r}, {r}

inst addi {r}, {r}, {i -2048..2047}
inst andi {r}, {r}, {i -2048..2047}
inst ori {r}, {r}, {i -2048..2047}
inst xori {r}, {r}, {i -2048..2047}
inst slti {r}, {r}, {i -2048..2047}
inst slli {r}, {r}, {i 0..63}
inst srli {r}, {r}, {i 0..63}
inst srai {r}, {r}, {i 0..63}
inst lui {r}, {i 0..1048575}

inst ld {r}, {i -2048..2047}({r})
inst sd {r}, {i -2048..2047}({r})
inst lw {r}, {i -2048..2047}({r})
inst lwu {r}, {i -2048..2047}({r})
inst sw {r}, {i -2048..2047}({r})
inst lb {r}, {i -2048..2047}({r})
inst lbu {r}, {i -2048..2047}({r})
inst lh {r}, {i -2048..2047}({r})
inst lhu {r}, {i -2048..2047}({r})
inst sb {r}, {i -2048..2047}({r})
inst sh {r}, {i -2048..2047}({r})

; scrambled-immediate territory
inst beq {r}, {r}, {i -4096..4094 /2}
inst bne {r}, {r}, {i -4096..4094 /2}
inst blt {r}, {r}, {i -4096..4094 /2}
inst bge {r}, {r}, {i -4096..4094 /2}
inst jal {r}, {i -1048576..1048574 /2}
inst jalr {r}, {i -2048..2047}({r})

; --- comparisons (no flags on RISC-V; icmp lowers to slt/sltu sequences) ---
inst slt {r}, {r}, {r}
inst sltu {r}, {r}, {r}
inst sltiu {r}, {r}, {i -2048..2047}

; --- 32-bit (W) forms: results sign-extend, the natural i32 convention ---
inst addw {r}, {r}, {r}
inst subw {r}, {r}, {r}
inst mulw {r}, {r}, {r}
inst divw {r}, {r}, {r}
inst divuw {r}, {r}, {r}
inst remw {r}, {r}, {r}
inst remuw {r}, {r}, {r}
inst sllw {r}, {r}, {r}
inst srlw {r}, {r}, {r}
inst sraw {r}, {r}, {r}
inst addiw {r}, {r}, {i -2048..2047}

; --- floating point (F and D): native fadd, and moves to and from the
; integer registers our values live in ---
inst fadd.s {f}, {f}, {f}
inst fsub.s {f}, {f}, {f}
inst fmul.s {f}, {f}, {f}
inst fdiv.s {f}, {f}, {f}
inst fadd.d {f}, {f}, {f}
inst fsub.d {f}, {f}, {f}
inst fmul.d {f}, {f}, {f}
inst fdiv.d {f}, {f}, {f}
inst fsqrt.s {f}, {f}
inst fsqrt.d {f}, {f}
inst fneg.s {f}, {f}
inst fneg.d {f}, {f}
inst fabs.s {f}, {f}
inst fabs.d {f}, {f}
; fused multiply-add (fmin/fmax are left to the library: the hardware
; returns the number when one operand is NaN, where the library, arm64,
; and wasm return NaN)
inst fmadd.s {f}, {f}, {f}, {f}
inst fmadd.d {f}, {f}, {f}, {f}
; compares write 0/1 to an integer register; NaN gives 0
inst feq.s {r}, {f}, {f}
inst flt.s {r}, {f}, {f}
inst fle.s {r}, {f}, {f}
inst feq.d {r}, {f}, {f}
inst flt.d {r}, {f}, {f}
inst fle.d {r}, {f}, {f}
; conversions between the float widths and from integers (float -> int
; is left to the library: the hardware returns the maximum integer for
; NaN where the library, arm64, and wasm give 0)
inst fcvt.d.s {f}, {f}
inst fcvt.s.d {f}, {f}
inst fcvt.s.w {f}, {r}
inst fcvt.s.wu {f}, {r}
inst fcvt.s.l {f}, {r}
inst fcvt.s.lu {f}, {r}
inst fcvt.d.w {f}, {r}
inst fcvt.d.wu {f}, {r}
inst fcvt.d.l {f}, {r}
inst fcvt.d.lu {f}, {r}
inst fmv.w.x {f}, {r}
inst fmv.x.w {r}, {f}
inst fmv.d.x {f}, {r}
; float values live in f registers of their own: register moves (fmv.d
; copies all 64 bits, NaN boxing included), spills and reloads
inst fmv.d {f}, {f}
inst fsd {f}, {i -2048..2047}({r})
inst fld {f}, {i -2048..2047}({r})
inst fmv.x.d {r}, {f}
; enabling the FPU on bare metal: set mstatus.FS through a CSR write
inst csrrs {r}, {i 0..4095}, {r}
; traps in M-mode: a CSR read and write (the trap vector, cause and
; return address are CSRs), the return from a trap, and an environment
; call to take one on purpose
inst csrr {r}, {i 0..4095}
inst csrw {i 0..4095}, {r}
inst mret
inst ecall
; interrupts: set and clear bits of a CSR (mie, mstatus), and wait
inst csrs {i 0..4095}, {r}
inst csrc {i 0..4095}, {r}
inst wfi
; a failed check: a breakpoint exception (mcause 3)
inst ebreak
; the address of a data item: auipc's page plus an addi
inst auipc {r}, {i 0..1048575}

; --- V: vectors of 64 or 128 bits, lanes of 8 to 64 bits; every
; instruction runs under the vtype the rule or the emitter sets just
; before it (vsetivli: lanes and their width). v0 is the mask register;
; the pool is v24..v31 (saved by the callee, as this compiler has all
; callees), arguments cross in v8..v15, temporaries v16..v23 ---
inst vsetivli x0, 4, e32, m1, ta, ma
inst vsetivli x0, 2, e64, m1, ta, ma
inst vsetivli x0, 16, e8, m1, ta, ma
inst vsetivli x0, 2, e32, m1, ta, ma
inst vsetivli x0, 4, e16, m1, ta, ma
inst vsetivli x0, 8, e8, m1, ta, ma
inst vsetivli x0, 8, e16, m1, ta, ma
inst vsetivli x0, 2, e8, m1, ta, ma
inst vsetivli x0, 2, e16, m1, ta, ma
inst vsetivli x0, 4, e8, m1, ta, ma
inst vadd.vv {v}, {v}, {v}
inst vsub.vv {v}, {v}, {v}
inst vmul.vv {v}, {v}, {v}
inst vand.vv {v}, {v}, {v}
inst vor.vv {v}, {v}, {v}
inst vxor.vv {v}, {v}, {v}
inst vsll.vv {v}, {v}, {v}
inst vsra.vv {v}, {v}, {v}
inst vsrl.vv {v}, {v}, {v}
inst vfadd.vv {v}, {v}, {v}
inst vfsub.vv {v}, {v}, {v}
inst vfmul.vv {v}, {v}, {v}
inst vfdiv.vv {v}, {v}, {v}
inst vfsgnjn.vv {v}, {v}, {v}
inst vfsgnjx.vv {v}, {v}, {v}
inst vfmacc.vv {v}, {v}, {v}
inst vfsqrt.v {v}, {v}
inst vfcvt.f.x.v {v}, {v}
inst vfcvt.f.xu.v {v}, {v}
inst vmv1r.v {v}, {v}
inst vsext.vf2 {v}, {v}
inst vzext.vf2 {v}, {v}
inst vfwcvt.f.f.v {v}, {v}
inst vfncvt.f.f.w {v}, {v}
inst vnsrl.wi {v}, {v}, 0
inst vmin.vv {v}, {v}, {v}
inst vmax.vv {v}, {v}, {v}
inst vminu.vv {v}, {v}, {v}
inst vmaxu.vv {v}, {v}, {v}
inst vrsub.vx {v}, {v}, x0
inst vredsum.vs {v}, {v}, {v}
inst vredmin.vs {v}, {v}, {v}
inst vredmax.vs {v}, {v}, {v}
inst vredminu.vs {v}, {v}, {v}
inst vredmaxu.vs {v}, {v}, {v}
inst vmfeq.vv v0, {v}, {v}
inst vmfne.vv v0, {v}, {v}
inst vmflt.vv v0, {v}, {v}
inst vmfle.vv v0, {v}, {v}
inst vmseq.vv v0, {v}, {v}
inst vmsne.vv v0, {v}, {v}
inst vmslt.vv v0, {v}, {v}
inst vmsltu.vv v0, {v}, {v}
inst vmsle.vv v0, {v}, {v}
inst vmsleu.vv v0, {v}, {v}
inst vmv.v.i {v}, 0
inst vmerge.vim {vn}, {v}, 1, v0
inst vmerge.vvm {vn}, {v}, {v}, v0
inst vmv.x.s {r}, {v}
inst vmv.s.x {v}, {r}
inst vmv.v.x {v}, {r}
inst vslidedown.vi {v}, {v}, {i 0..15}
inst vslide1up.vx {v}, {v}, {r}
inst vle8.v {v}, ({r})
inst vse8.v {v}, ({r})
inst vle16.v {v}, ({r})
inst vse16.v {v}, ({r})
inst vle32.v {v}, ({r})
inst vse32.v {v}, ({r})
inst vle64.v {v}, ({r})
inst vse64.v {v}, ({r})
