; RISC-V RV64IM probe seed — mainly here to prove the learner is
; target-agnostic. B-type and J-type immediates are famously scrambled
; across the encoding; the per-bit learner should handle them unchanged.

triple riscv64
attr +m,+f,+d
width 4

reg r = x0..x31

inst add {r}, {r}, {r}
inst sub {r}, {r}, {r}
inst and {r}, {r}, {r}
inst or {r}, {r}, {r}
inst xor {r}, {r}, {r}
inst sll {r}, {r}, {r}
inst srl {r}, {r}, {r}
inst sra {r}, {r}, {r}
inst mul {r}, {r}, {r}
inst div {r}, {r}, {r}
inst divu {r}, {r}, {r}
inst rem {r}, {r}, {r}
inst remu {r}, {r}, {r}

inst addi {r}, {r}, {i -2048..2047}
inst andi {r}, {r}, {i -2048..2047}
inst ori {r}, {r}, {i -2048..2047}
inst xori {r}, {r}, {i -2048..2047}
inst slti {r}, {r}, {i -2048..2047}
inst slli {r}, {r}, {i 0..63}
inst srli {r}, {r}, {i 0..63}
inst srai {r}, {r}, {i 0..63}
inst lui {r}, {i 0..1048575}

inst ld {r}, {i -2048..2047}({r})
inst sd {r}, {i -2048..2047}({r})
inst lw {r}, {i -2048..2047}({r})
inst sw {r}, {i -2048..2047}({r})

; scrambled-immediate territory
inst beq {r}, {r}, {i -4096..4094 /2}
inst bne {r}, {r}, {i -4096..4094 /2}
inst blt {r}, {r}, {i -4096..4094 /2}
inst bge {r}, {r}, {i -4096..4094 /2}
inst jal {r}, {i -1048576..1048574 /2}
inst jalr {r}, {i -2048..2047}({r})

; --- comparisons (no flags on RISC-V; icmp lowers to slt/sltu sequences) ---
inst slt {r}, {r}, {r}
inst sltu {r}, {r}, {r}
inst sltiu {r}, {r}, {i -2048..2047}

; --- 32-bit (W) forms: results sign-extend, the natural i32 convention ---
inst addw {r}, {r}, {r}
inst subw {r}, {r}, {r}
inst mulw {r}, {r}, {r}
inst divw {r}, {r}, {r}
inst divuw {r}, {r}, {r}
inst remw {r}, {r}, {r}
inst remuw {r}, {r}, {r}
inst sllw {r}, {r}, {r}
inst srlw {r}, {r}, {r}
inst sraw {r}, {r}, {r}
inst addiw {r}, {r}, {i -2048..2047}

; --- floating point (F and D extensions) ---
reg f = f0..f31

inst fadd.d {f}, {f}, {f}
inst fsub.d {f}, {f}, {f}
inst fmul.d {f}, {f}, {f}
inst fdiv.d {f}, {f}, {f}
inst fadd.s {f}, {f}, {f}
inst fsub.s {f}, {f}, {f}
inst fmul.s {f}, {f}, {f}
inst fdiv.s {f}, {f}, {f}

; comparisons write integer registers directly
inst feq.d {r}, {f}, {f}
inst flt.d {r}, {f}, {f}
inst fle.d {r}, {f}, {f}
inst feq.s {r}, {f}, {f}
inst flt.s {r}, {f}, {f}
inst fle.s {r}, {f}, {f}

; conversions (rtz = round toward zero on float->int)
inst fcvt.d.l {f}, {r}
inst fcvt.d.w {f}, {r}
inst fcvt.s.l {f}, {r}
inst fcvt.s.w {f}, {r}
inst fcvt.d.lu {f}, {r}
inst fcvt.d.wu {f}, {r}
inst fcvt.s.lu {f}, {r}
inst fcvt.s.wu {f}, {r}
inst fcvt.l.d {r}, {f}, rtz
inst fcvt.w.d {r}, {f}, rtz
inst fcvt.l.s {r}, {f}, rtz
inst fcvt.w.s {r}, {f}, rtz
inst fcvt.lu.d {r}, {f}, rtz
inst fcvt.wu.d {r}, {f}, rtz
inst fcvt.lu.s {r}, {f}, rtz
inst fcvt.wu.s {r}, {f}, rtz
inst fcvt.d.s {f}, {f}
inst fcvt.s.d {f}, {f}

; bit-pattern moves and register moves
inst fmv.x.d {r}, {f}
inst fmv.d.x {f}, {r}
inst fmv.x.w {r}, {f}
inst fmv.w.x {f}, {r}
inst fmv.d {f}, {f}
inst fmv.s {f}, {f}

; float memory
inst fld {f}, {i -2048..2047}({r})
inst fsd {f}, {i -2048..2047}({r})
inst flw {f}, {i -2048..2047}({r})
inst fsw {f}, {i -2048..2047}({r})

; --- system: enable the FPU at boot (mstatus.FS) ---
inst csrrs {r}, mstatus, {r}
