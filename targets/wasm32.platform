    f32.reinterpret_i32
    f32.abs
    i32.reinterpret_f32

min(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: float(8, 23)
    local.get a
    f32.reinterpret_i32
    local.get b
    f32.reinterpret_i32
    f32.min
    i32.reinterpret_f32

max(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: float(8, 23)
    local.get a
    f32.reinterpret_i32
    local.get b
    f32.reinterpret_i32
    f32.max
    i32.reinterpret_f32

add(11, 52, 0)(a: float(11, 52), b: float(11, 52)) -> r: float(11, 52)
    local.get a
    f64.reinterpret_i64
    local.get b
    f64.reinterpret_i64
