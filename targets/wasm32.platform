; targets/wasm32.platform — the library instances this target computes
; with its own instructions (see targets/arm64.platform for the form).
; wasm is a stack machine: a line is one op, `local.get a` pushes an
; argument, and the rule leaves r on the stack for the emitter to store.
; Floats travel as their bits, so every rule reinterprets on the way in
; and out.
;
; Not here: fma (wasm has no fused multiply-add), so it stays in the
; library.

; --- arithmetic ---

add(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: float(8, 23)
    local.get a
    f32.reinterpret_i32
    local.get b
    f32.reinterpret_i32
    f32.add
    i32.reinterpret_f32

sub(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: float(8, 23)
    local.get a
    f32.reinterpret_i32
    local.get b
    f32.reinterpret_i32
    f32.sub
    i32.reinterpret_f32

mul(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: float(8, 23)
    local.get a
    f32.reinterpret_i32
    local.get b
    f32.reinterpret_i32
    f32.mul
    i32.reinterpret_f32

div(8, 23, 0)(a: float(8, 23), b: float(8, 23)) -> r: float(8, 23)
    local.get a
    f32.reinterpret_i32
    local.get b
    f32.reinterpret_i32
    f32.div
    i32.reinterpret_f32

sqrt(8, 23, 0)(a: float(8, 23)) -> r: float(8, 23)
    local.get a
    f32.reinterpret_i32
    f32.sqrt
    i32.reinterpret_f32

neg(8, 23, 0)(a: float(8, 23)) -> r: float(8, 23)
    local.get a
    f32.reinterpret_i32
    f32.neg
    i32.reinterpret_f32

abs(8, 23, 0)(a: float(8, 23)) -> r: float(8, 23)
