; targets/wasm32.platform — what this target computes with its own
; instructions (see targets/arm64.platform for the form). wasm is a stack
; machine: a rule is one op, its arguments already on the stack and its
; result left there; a class names the local type its values get.
;
; Not here: fma (wasm has no fused multiply-add), so it stays in the
; library.

target wasm32

ext FP
class f32 = f32
class f64 = f64

; --- arithmetic ---
f32.add = add(f32, f32) -> f32
f32.sub = sub(f32, f32) -> f32
f32.mul = mul(f32, f32) -> f32
f32.div = div(f32, f32) -> f32
f32.sqrt = sqrt(f32) -> f32
f32.neg = neg(f32) -> f32
f32.abs = abs(f32) -> f32
f32.min = min(f32, f32) -> f32
f32.max = max(f32, f32) -> f32

f64.add = add(f64, f64) -> f64
f64.sub = sub(f64, f64) -> f64
f64.mul = mul(f64, f64) -> f64
f64.div = div(f64, f64) -> f64
f64.sqrt = sqrt(f64) -> f64
f64.neg = neg(f64) -> f64
f64.abs = abs(f64) -> f64
f64.min = min(f64, f64) -> f64
f64.max = max(f64, f64) -> f64

; --- comparison ---
f32.eq = eq(f32, f32) -> u1
f32.ne = ne(f32, f32) -> u1
f32.lt = lt(f32, f32) -> u1
f32.le = le(f32, f32) -> u1
f32.gt = gt(f32, f32) -> u1
f32.ge = ge(f32, f32) -> u1

f64.eq = eq(f64, f64) -> u1
f64.ne = ne(f64, f64) -> u1
f64.lt = lt(f64, f64) -> u1
f64.le = le(f64, f64) -> u1
f64.gt = gt(f64, f64) -> u1
f64.ge = ge(f64, f64) -> u1

; --- conversion: float to float, integer to float, float to integer
; (trunc_sat: toward zero, saturating, NaN to 0, as the library) ---
f64.promote_f32 = conv(f32) -> f64
f32.demote_f64 = conv(f64) -> f32
f32.convert_i32_s = conv(i32) -> f32
f64.convert_i32_s = conv(i32) -> f64
f32.convert_i32_u = conv(u32) -> f32
f64.convert_i32_u = conv(u32) -> f64
f32.convert_i64_s = conv(i64) -> f32
f64.convert_i64_s = conv(i64) -> f64
f32.convert_i64_u = conv(u64) -> f32
f64.convert_i64_u = conv(u64) -> f64
i32.trunc_sat_f32_s = conv(f32) -> i32
i32.trunc_sat_f32_u = conv(f32) -> u32
i64.trunc_sat_f32_s = conv(f32) -> i64
i64.trunc_sat_f32_u = conv(f32) -> u64
i32.trunc_sat_f64_s = conv(f64) -> i32
i32.trunc_sat_f64_u = conv(f64) -> u32
i64.trunc_sat_f64_s = conv(f64) -> i64
i64.trunc_sat_f64_u = conv(f64) -> u64

; fibres: wasm has one stack and cannot switch it; lib/fibre.ssa runs
; fibres one after another here (fibre_stacks = 0), which is right for
; bodies that never wait on each other and nothing else
ext fibres
const fibre_lr = 0
const fibre_sp = 8
const fibre_stacks = 0
