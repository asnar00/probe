; --- conversion: float to float, integer to float, float to integer
; (trunc_sat: toward zero, saturating, NaN to 0, as the library) ---

conv(8, 23, 11, 52, 0)(a: float(8, 23)) -> r: float(11, 52)
    local.get a
    f32.reinterpret_i32
    f64.promote_f32
    i64.reinterpret_f64

conv(11, 52, 8, 23, 0)(a: float(11, 52)) -> r: float(8, 23)
    local.get a
    f64.reinterpret_i64
    f32.demote_f64
    i32.reinterpret_f32

conv(32, 8, 23, 0)(a: i32) -> r: float(8, 23)
    local.get a
    f32.convert_i32_s
    i32.reinterpret_f32

conv(32, 11, 52, 0)(a: i32) -> r: float(11, 52)
    local.get a
    f64.convert_i32_s
    i64.reinterpret_f64

conv(32, 8, 23, 0)(a: u32) -> r: float(8, 23)
    local.get a
    f32.convert_i32_u
    i32.reinterpret_f32

conv(32, 11, 52, 0)(a: u32) -> r: float(11, 52)
    local.get a
    f64.convert_i32_u
    i64.reinterpret_f64

conv(64, 8, 23, 0)(a: i64) -> r: float(8, 23)
    local.get a
    f32.convert_i64_s
    i32.reinterpret_f32

conv(64, 11, 52, 0)(a: i64) -> r: float(11, 52)
    local.get a
    f64.convert_i64_s
    i64.reinterpret_f64

conv(64, 8, 23, 0)(a: u64) -> r: float(8, 23)
    local.get a
    f32.convert_i64_u
    i32.reinterpret_f32

conv(64, 11, 52, 0)(a: u64) -> r: float(11, 52)
    local.get a
    f64.convert_i64_u
    i64.reinterpret_f64

conv(8, 23, 32)(a: float(8, 23)) -> r: i32
    local.get a
    f32.reinterpret_i32
    i32.trunc_sat_f32_s

conv(8, 23, 32)(a: float(8, 23)) -> r: u32
    local.get a
    f32.reinterpret_i32
    i32.trunc_sat_f32_u

conv(8, 23, 64)(a: float(8, 23)) -> r: i64
    local.get a
    f32.reinterpret_i32
    i64.trunc_sat_f32_s

conv(8, 23, 64)(a: float(8, 23)) -> r: u64
    local.get a
    f32.reinterpret_i32
    i64.trunc_sat_f32_u

conv(11, 52, 32)(a: float(11, 52)) -> r: i32
